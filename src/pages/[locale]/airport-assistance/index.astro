---
import hktFacilities from '../../../data/airport-facilities-hkt-reviewed.json';
import dmkFacilities from '../../../data/airport-facilities-dmk-reviewed.json';
import bkkFacilities from '../../../data/airport-facilities-bkk-reviewed.json';
import SiteFooter from '../../../components/SiteFooter.astro';
import AirportPageMetadata from '../../../components/AirportPageMetadata.astro';
import AirportScheduleDates from '../../../components/AirportScheduleDates.astro';
import AirportKoreanReview from '../../../components/AirportKoreanReview.astro';
import DetailHeader from '../../../components/DetailHeader.astro';
import { airportMarkets,airportMarketData,airportPairs } from '../../../lib/airport-markets';
import {airportUI} from '../../../i18n/airport-ui';
export function getStaticPaths(){return airportMarkets.filter(m=>m.locale!=='ko').map(m=>({params:{locale:m.locale},props:{market:m}}));}
const {market}=Astro.props;
const t=airportUI[market.locale],data=airportMarketData(market.locale);
const routes=data.routes;
const airportCodes=[...new Set([...((bkkFacilities.locales as any)[market.locale]?['BKK']:[]),...((dmkFacilities.locales as any)[market.locale]?['DMK']:[]),...((hktFacilities.locales as any)[market.locale]?['HKT']:[])].concat(routes.flatMap((r:any)=>[r.originIata,r.destinationIata]).concat(data.services.map((s:any)=>s.airportIata).filter(Boolean))))];
---
<!doctype html><html lang={market.lang}><head><link rel="icon" href="/favicon.ico?v=20261013" sizes="16x16 32x32 48x48" /><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261013" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261013" /><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="index,follow"/><title>{t[0]} · {market.name} | ThaiLiveNow</title><meta name="description" content={t[1]}/><AirportPageMetadata title={`${t[0]} · ${market.name}`} description={t[1]} locale={market.locale} lang={market.lang}/></head><body><DetailHeader locale={market.locale}/><main translate="no"><h1>{t[0]}</h1><p>{t[1]}</p>{data.status==='researching'&&<aside class="review-note">{t[19]}</aside>}<label for="search">{t[2]}</label><input id="search" type="search"/><label for="direction">{t[13]}</label><select id="direction"><option value="">{t[1]}</option><option value="to-thailand">{t[3]}</option><option value="from-thailand">{t[4]}</option></select>
{routes.length>0&&<><label for="thai-airport">{t[23]}</label><select id="thai-airport"><option value="">{t[25]}</option>{[...new Set(routes.map((r:any)=>r.thaiAirport))].map(code=><option value={code}>{routes.find((r:any)=>r.airportNames?.[String(code)])?.airportNames?.[String(code)]||data.airportNames?.[String(code)]||code}</option>)}</select><label for="other-airport">{t[24]}</label><select id="other-airport"><option value="">{t[25]}</option>{[...new Set(routes.map((r:any)=>r.originIata===r.thaiAirport?r.destinationIata:r.originIata))].map(code=><option value={code}>{routes.find((r:any)=>r.airportNames?.[String(code)])?.airportNames?.[String(code)]||data.airportNames?.[String(code)]||code}</option>)}</select></>}
{routes.map((r:any)=><article data-route data-flight-number={r.flightNumber || ''} data-direction={r.direction} data-thai-airport={r.thaiAirport} data-other-airport={r.originIata===r.thaiAirport?r.destinationIata:r.originIata} data-search={`${r.originIata} ${r.destinationIata} ${r.flightNumber || ''} ${r.airline} ${r.origin || ''} ${r.destination || ''}`.toLowerCase()}><h2><a href={`/${market.locale}/airport-assistance/routes/${r.id}/`}>{r.originIata} → {r.destinationIata}</a></h2><p><a href={`/${market.locale}/airport-assistance/airlines/${r.airlineId}/`}>{r.airline}</a></p>{r.flightNumber&&<p>{r.flightNumber}</p>}{r.observedStatusText&&<p class="observed-status">{r.observedStatusText}</p>}{r.observedChange&&<p class="observed-change">{r.observedChange}</p>}{r.description&&<p>{r.description}</p>}{(r.validFrom||r.operatingDates?.length)&&<AirportScheduleDates route={r} locale={market.locale} />}{r.durationMinutes&&<p>{r.durationType==='airborne'?t[17]:t[16]}: {Math.floor(r.durationMinutes/60)} h {r.durationMinutes%60} min</p>}<p>{t[14]}: {r.checkedAt}</p>{r.sources.map((url:string)=><a href={url} target="_blank" rel="noopener noreferrer">{t[10]} ↗</a>)}</article>)}
{data.coverage?.length>0&&<section aria-label="Research coverage">{data.coverage.map((item:any)=><article class="coverage"><h2>{item.title}</h2>{item.text&&<p>{item.text}</p>}{item.checkedAt&&<p>{t[14]}: {item.checkedAt}</p>}{item.sources?.map((url:string)=><p><a href={url} target="_blank" rel="noopener noreferrer">{t[10]} ↗</a></p>)}</article>)}</section>}
<p id="no-results" hidden>{t[18]}</p>
{airportCodes.length>0&&<section><h2>{t[15]}</h2><div class="links">{airportCodes.map(code=><a href={`/${market.locale}/airport-assistance/airports/${String(code).toLowerCase()}/`}>{routes.find((r:any)=>r.airportNames?.[String(code)])?.airportNames?.[String(code)]||data.airportNames?.[String(code)]||code} ({code}) →</a>)}</div></section>}
{data.airlines.length>0&&<section><h2>{t[6]}</h2>{data.airlines.map((a:any)=><article><h3><a href={`/${market.locale}/airport-assistance/airlines/${a.id}/`}>{a.name}</a></h3>{a.note&&<p>{a.note}</p>}</article>)}</section>}
{data.guides.length>0&&<section>{data.guides.map((g:any)=><article><h2><a href={`/${market.locale}/airport-assistance/guides/${g.id}/`}>{g.title}</a></h2>{g.description&&<p>{g.description}</p>}</article>)}</section>}
{airportPairs(data).length>0&&<section><h2>{t[13]}</h2>{airportPairs(data).map(pair=><article><a href={`/${market.locale}/airport-assistance/pairs/${pair.id}/`}>{pair.other} ↔ {pair.thai} →</a></article>)}</section>}
<nav aria-label={t[0]}>{airportMarkets.map(m=><a href={`/${m.locale}/airport-assistance/`} aria-current={m.locale===market.locale?'page':undefined}>{m.name}</a>)}</nav></main><script>
import {flightNumberKey} from '../../../lib/airport-flight-search';
const search=document.querySelector<HTMLInputElement>('#search')!,direction=document.querySelector<HTMLSelectElement>('#direction')!;
const thaiAirport=document.querySelector<HTMLSelectElement>('#thai-airport');
const otherAirport=document.querySelector<HTMLSelectElement>('#other-airport');
function filter(){const q=search.value.trim().toLowerCase();let count=0;document.querySelectorAll<HTMLElement>('[data-route]').forEach(r=>{const text=r.dataset.search||'';r.hidden=!(text.includes(q)||text.replace(/\s+/g,'').includes(q.replace(/\s+/g,'')) || (flightNumberKey(q)!==null && flightNumberKey(q)===flightNumberKey(r.dataset.flightNumber||'')))||!!(direction.value&&r.dataset.direction!==direction.value)||!!(thaiAirport?.value&&r.dataset.thaiAirport!==thaiAirport.value)||!!(otherAirport?.value&&r.dataset.otherAirport!==otherAirport.value);if(!r.hidden)count++;});document.querySelector<HTMLElement>('#no-results')!.hidden=count>0||!(q||direction.value||thaiAirport?.value||otherAirport?.value);}thaiAirport?.addEventListener('change',()=>{if(otherAirport){otherAirport.value='';const rows=[...document.querySelectorAll<HTMLElement>('[data-route]')];for(const option of otherAirport.options){option.disabled=!!option.value&&!!thaiAirport.value&&!rows.some(row=>row.dataset.thaiAirport===thaiAirport.value&&row.dataset.otherAirport===option.value);}}filter();});otherAirport?.addEventListener('change',filter);search.addEventListener('input',filter);direction.addEventListener('change',filter);
</script><AirportKoreanReview locale={market.locale}/><SiteFooter locale={market.locale}/></body></html>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,sans-serif;line-height:1.8}header{display:flex;align-items:center;justify-content:space-between;background:white;border-bottom:1px solid #e4eaee;padding:18px 28px}main{max-width:1100px;margin:auto;padding:40px 28px}h1{font-size:32px;line-height:1.4}a{color:#2e7c89;font-weight:700}label{display:block;font-size:13px;font-weight:700;margin-top:16px}input,select{max-width:520px;width:100%;padding:12px;border:1px solid #dce5e8;border-radius:8px;background:white;font:inherit}article{border:1px solid #e4eaee;border-radius:14px;background:white;padding:24px;margin-top:28px}article[hidden]{display:none}.review-note{padding:16px 20px;background:#eaf4f5;border:1px solid #cfe3e6;border-radius:12px;margin:24px 0;font-size:14px}section{margin-top:32px}.links{display:flex;flex-wrap:wrap;gap:18px}nav{display:flex;flex-wrap:wrap;gap:16px;margin-top:40px}nav a{font-size:13px}@media(max-width:600px){main{padding:28px 18px}h1{font-size:26px}}
</style>
