---
import AirportAssistanceHub from '../../../components/AirportAssistanceHub.astro';
import {airportMarkets} from '../../../lib/airport-markets';
export function getStaticPaths(){return airportMarkets.filter(m=>m.locale!=='ko'&&m.locale!=='en-us').map(m=>({params:{locale:m.locale},props:{market:m}}));}
const {market}=Astro.props;
---
<AirportAssistanceHub market={market}/>
