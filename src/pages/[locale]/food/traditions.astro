---
import FoodLayout from '../../../components/FoodLayout.astro';
import FoodMarks from '../../../components/FoodMarks.astro';
import FoodCards from '../../../components/FoodCards.astro';
import FoodFilter from '../../../components/FoodFilter.astro';
import FoodPhoto from '../../../components/FoodPhoto.astro';
import FoodText from '../../../components/FoodText.astro';
import FruitCards from '../../../components/FruitCards.astro';
import FruitCalendar from '../../../components/FruitCalendar.astro';
import FruitPrices from '../../../components/FruitPrices.astro';
import {foodLocales,foodData,getFoodPack,fmt} from '../../../lib/food-localized.mjs';
export function getStaticPaths(){return foodLocales.map(locale=>({params:{locale},props:{locale}}));}
const {locale}=Astro.props;
const pack=getFoodPack(locale),data=foodData(locale),ui=pack.ui;
const base=`/${locale}/food/`;
const food=data;
const p=pack.pages.traditions;
const faq=p.faq;
---
<FoodLayout locale={locale} ui={ui} data={data} title={p.title} description={p.description} breadcrumbs={[[ui.foodCrumb,base]]} sourceIds={['central','north','isan','phuket','songkhla','khantoke']} faq={faq}>
<div class="food-detail"><header class="food-hero"><span class="food-eyebrow">{p.eyebrow}</span><h1><FoodMarks text={p.h1} br/></h1><p class="food-intro">{p.intro}</p></header>
<div class="food-note"><p><FoodMarks text={p.note}/></p></div>
<section><h2>{p.basicsH2}</h2><dl>{p.basics.map(([dt,dd])=><div><dt>{dt}</dt><dd><FoodMarks text={dd}/></dd></div>)}</dl></section>
<section><h2>{p.regionsH2}</h2>{food.regions.map(r=><article class="food-region"><span class="food-eyebrow">{r.name}</span><h3>{r.subtitle}</h3><p>{r.text}</p><div class="food-related">{food.cities.filter(c=>c.region===r.id).map(c=><a href={`${base}cities/${c.id}/`}>{fmt(p.cityLinkTpl,{name:c.name})}</a>)}</div></article>)}</section>
<section><h2>{p.orderH2}</h2><ol class="food-steps">{p.order.map(step=><li><span><FoodMarks text={step}/></span></li>)}</ol></section>
<section class="food-faq"><h2>{p.faqH2}</h2>{faq.map(([q,a])=><article><h3>{q}</h3><p>{a}</p></article>)}</section></div>
<section><h2>{p.cardsH2}</h2><FoodCards ids={food.traditional} locale={locale} ui={ui} data={data}/></section><section><h2>{p.moreH2}</h2><div class="food-related"><a href={base}>{p.hubLink}</a><a href={`/${locale}/food-delivery/`}>{p.deliveryLink}</a></div></section>
</FoodLayout>
