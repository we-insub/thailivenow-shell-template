---
import DetailHeader from '../../../../components/DetailHeader.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
const airports=[['bkk','Suvarnabhumi Airport'],['dmk','Don Mueang International Airport'],['hkt','Phuket International Airport'],['cnx','Chiang Mai International Airport']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Thailand airport guides: Bangkok, Phuket and Chiang Mai | ThaiLiveNow</title><meta name="description" content="Choose Suvarnabhumi, Don Mueang, Phuket or Chiang Mai for English airport arrival, departure and facility guidance, with retained official sources."/></head><body><DetailHeader locale="en"/><main class="thai-detail"><a href="/en/">← ThaiLiveNow</a><h1>Thailand airports: choose your airport</h1><p>Choose the airport you will use for arrival or departure. Read its facility and passenger guidance, then search airline counters, contacts and flight records across countries when you need more help.</p><div class="airport-grid">{airports.map(([id,name])=><article><p>{id.toUpperCase()}</p><h2>{name}</h2><a href={`/en/airport-assistance/airports/${id}/`}>Read the airport guide →</a></article>)}</div><section><h2>Flight delayed or baggage missing?</h2><p><a href="/en/airport-assistance/">Search all country flight, airline and airport-contact records →</a></p></section></main><SiteFooter locale="en"/></body></html>
<style>:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,sans-serif;line-height:1.8}main{max-width:1060px;margin:auto;padding:36px 24px 64px}h1{font-size:34px;line-height:1.4}a{color:#267e89}p{color:#61717e}.airport-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:32px 0}.airport-grid article{padding:24px;border:1px solid #dce5e8;border-radius:14px;background:white}h2{font-size:23px}@media(max-width:650px){main{padding:28px 16px}.airport-grid{grid-template-columns:1fr}h1{font-size:28px}}</style>
