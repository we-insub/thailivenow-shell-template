---
import {transportTagged,transportData,transportText,transportFormat,transportPageLocale} from '../../../../../lib/transport-localization.mjs';
import TransportSourceDates from '../../../../../components/TransportSourceDates.astro';
import SiteFooter from '../../../../../components/SiteFooter.astro';
import DetailHeader from '../../../../../components/DetailHeader.astro';
import TransportPlaceMap from '../../../../../components/TransportPlaceMap.astro';
import boatsSource from '../../../../../data/transport/boats.json';
import destinationsSource from '../../../../../data/transport/boat-destinations.json';
import {boatRouteNames,boatDestinationPath} from '../../../../../lib/boat-guide';
const transportLocale=transportPageLocale(Astro.url.pathname);
const f=transportTagged(transportLocale);
const boats=transportData(boatsSource,transportLocale);
const destinations=transportData(destinationsSource,transportLocale);
export function getStaticPaths(){return boatsSource.piers.filter(p=>p.coordinates).map(p=>({params:{id:p.id},props:{pier:p}}));}
const {pier:pierSource}=Astro.props;
const pier=transportData(pierSource,transportLocale);
const routes=boats.routes.filter(r=>pier.servedBy.includes(r.id));
const nearby=destinations.filter(d=>d.pierId===pier.id||d.alternative?.pierId===pier.id);
const conditions=routes.flatMap(r=>r.stops.filter(s=>s.pierId===pier.id&&s.condition_ko).map(s=>s.condition_ko));
const faq=[['어떤 배가 이 선착장에 서나요?',routes.map(r=>transportData(boatRouteNames[r.id],transportLocale)).join(' · ')+'. 출발 선착장에도 정차하는 노선을 골라야 해요.'],['여기서 내리면 어디로 갈 수 있나요?',nearby.length?nearby.map(d=>d.name+' ('+(d.pierId===pier.id&&d.mode==='walk'?'도보 연결':'호텔 셔틀 환승')+')').join(' · '):'하선 후 실제 목적지까지의 도보·차량 경로를 확인하세요.'],['호텔 셔틀과 일반 관광 보트는 같은가요?','다른 서비스예요. 호텔 전용 부두가 일반 블루·익스프레스 노선에 모두 포함되는 것은 아니에요. 호텔 이름을 선택해 공공 보트 하선 지점과 별도 셔틀 승선 지점을 확인하세요.'],...(conditions.length?[['모든 운행편이 정차하나요?',[...new Set(conditions)].join(' · ')+'. 당일 정차·귀가편을 확인하세요.']]:[])];
const schema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
const points=[{name:pier.name_en+' 선착장',lng:pier.coordinates.lng,lat:pier.coordinates.lat,text:pier.name_th||'강변 선착장 위치를 확인하세요.',url:'/ko/transport/guides/boat/'}];
---
<!doctype html><html lang="ko"><head><link rel="icon" href="/favicon.ico?v=20261013" sizes="16x16 32x32 48x48" /><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261013" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261013" /><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{`${pier.name_en} 선착장 | 방콕 보트 이용 안내 | ThaiLiveNow`}</title><meta name="description" content={`${pier.name_ko} (${pier.name_en}) 선착장의 위치와 정차하는 보트 노선을 살펴보세요. ${pier.destinationNote_ko || "운영사 안내와 선착장 지도에서 이동할 곳에 맞는 배를 찾아보세요."}`}/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body><DetailHeader/><main><a href="/ko/transport/guides/boat/">보트·페리 안내 →</a><h1>{pier.name_ko} ({pier.name_en}) 선착장</h1>{pier.name_th&&<p>{pier.name_th}</p>}<p>{f`${pier.name_ko} 선착장에서 배를 타실 계획인가요? 아래 지도에서 선착장 위치를 살펴본 뒤 출발지와 목적지에 모두 정차하는 노선을 골라보세요. 같은 선착장에서도 진행 방향과 시간대에 따라 이용할 배가 달라질 수 있어요.`}</p>{pier.destinationNote_ko&&<p>{pier.destinationNote_ko}</p>}{pier.id==='pier-i'&&<p>아이콘시암은 강변에 여러 부두가 있어요. 지도는 아이콘시암 부두 위치를 표시하며, 이용할 보트의 탑승 부두는 현장 표지에서 확인하세요.</p>}{pier.id==='pier-a'&&<p>관광 보트는 일부 시간대에만 아시아티크까지 연장 운행해요. 운영사 예약 안내와 지도 시간표의 시간이 달라 당일 연장편을 확인하세요.</p>}<TransportPlaceMap points={points} title="선착장 위치"/>{nearby.length>0&&<section><h2>여기서 내리면 어디로 갈 수 있나요?</h2>{nearby.map(d=><article><h3>{d.name}</h3><p>{d.pierId===pier.id&&d.mode==='walk'?'하선 후 도보':'호텔 전용 셔틀로 환승'}</p><p>{d.pierId===pier.id?d.afterAlighting:d.alternative.text}</p><a href={boatDestinationPath(d.id)}>가는 배·승선 방법·FAQ →</a></article>)}</section>}<h2>이 선착장에 정차하는 배</h2>{routes.map(r=><article><h3>{transportData(boatRouteNames[r.id],transportLocale)}</h3><p>{r.displayNote}</p><a href={`/ko/transport/guides/boat/?route=${r.id}#boat-map`}>이 노선·대표 선착장 보기 →</a><br/><a href={boats.operators.find(o=>o.id===r.operatorId)?.officialSite}>운영사 정차·승차권 안내 ↗</a></article>)}{pier.crossRiverTo&&<section><h2>강을 건너는 횡단페리</h2><p>왓아룬과 타티엔 선착장 사이를 연결하는 횡단페리예요. 강을 따라가는 보트와 구분하고 현장 운행·승차권 안내를 확인하세요.</p><a href="/ko/attractions/wat-arun/">왓아룬 · 선착장과 도보 이동 지도 →</a></section>}<section id="faq"><h2>자주 묻는 질문</h2>{faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section><h2>방문 전에 확인하세요</h2><p>목적지에 정차하는 배인지 매표소에서 먼저 물어보고, 진행 방향을 확인한 뒤 기다리세요. 배가 완전히 정박하면 직원 안내에 따라 승선하시면 돼요. 내릴 선착장 이름을 기억해두고, 하선한 뒤에는 목적지까지 걷거나 갈아탈 교통편을 이용하세요.</p><a href={pier.coordinates.osmSourceUrl||"https://www.openstreetmap.org/copyright"}>시설 위치: OpenStreetMap · ODbL</a><TransportSourceDates/></main><SiteFooter/></body></html>
<style>:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,"Apple SD Gothic Neo",sans-serif;line-height:1.8}main{max-width:960px;margin:auto;padding:32px 20px}h1{font-size:30px}h2{margin-top:32px}article{padding:20px;border:1px solid #dce5e8;background:white;border-radius:12px;margin:12px 0}a{color:#267e89}h3{margin:0}details{background:white;border:1px solid #dce5e8;border-radius:10px;padding:16px;margin:10px 0}summary{cursor:pointer;font-weight:700}</style>
