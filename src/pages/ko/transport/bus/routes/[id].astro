---
import TransportGuidePage from '../../../../../components/TransportGuidePage.astro';
import BusRouteServices from '../../../../../components/BusRouteServices.astro';
import {routes,terminals,routeGuide} from '../../../../../lib/bus-guides';
export function getStaticPaths(){return routes.map(route=>({params:{id:route.id},props:{route}}));}
const {route}=Astro.props;
const terminal=terminals.find(t=>t.id===route.terminalId)!;
---
<TransportGuidePage guide={routeGuide(route)}><BusRouteServices slot="before-map" route={route} terminal={terminal}/></TransportGuidePage>
