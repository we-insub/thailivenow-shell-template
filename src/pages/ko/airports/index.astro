---
import DetailHeader from '../../../components/DetailHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
const airports=[
 {id:'bkk',code:'BKK',name:'수완나폼공항',english:'Suvarnabhumi Airport',text:'도착·출발·환승 안내부터 층별 지도, 흡연실, 방콕 시내 교통과 항공사 카운터까지 주제별로 볼 수 있어요.'},
 {id:'dmk',code:'DMK',name:'돈므앙공항',english:'Don Mueang International Airport',text:'체크인과 국제선 출국심사, 탑승게이트 도착 권고 시간부터 식당·은행·ATM 위치까지 볼 수 있어요.'},
 {id:'hkt',code:'HKT',name:'푸껫공항',english:'Phuket International Airport',text:'국제선 도착홀과 수하물 찾는 곳, 셀프 체크인 기기와 의료실·ATM 위치를 살펴보세요.'},
 {id:'cnx',code:'CNX',name:'치앙마이공항',english:'Chiang Mai International Airport',text:'공항 운영 시간과 출발 수속, 도착 후 Grab·셔틀·시내버스 이용 안내를 볼 수 있어요.'},
];
---
<!doctype html>
<html lang="ko"><head>
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
 <link rel="icon" href="/favicon.ico?v=20261013"/>
 <title>태국 공항 안내 · 수완나품·돈므앙·푸껫·치앙마이 | ThaiLiveNow</title>
 <meta name="description" content="수완나품·돈므앙·푸껫·치앙마이공항의 한국어 이용 안내입니다. 이용할 공항을 선택하고 시설 위치와 출발·도착 안내, 항공사 카운터와 연결 항공편을 살펴보세요."/>
</head><body>
 <DetailHeader locale="ko"/>
 <main>
  <a class="back" href="/ko/">← 태국라이브나우 홈</a>
  <h1>태국 공항</h1>
  <p class="intro">태국에 도착하거나 귀국편을 타기 전, 이용할 공항을 골라보세요. 공항 안에서 필요한 시설과 이용 방법을 한국어로 읽고, 항공사 카운터와 연결 항공편도 함께 살펴볼 수 있어요.</p>
  <section aria-labelledby="airport-list-title">
   <h2 id="airport-list-title">어느 공항을 이용하시나요?</h2>
   <div class="airport-grid">{airports.map(airport=><a class="airport-card" href={`/ko/airport-assistance/airports/${airport.id}/`}>
    <span class="airport-code">{airport.code}</span><h3>{airport.name}</h3><span class="english" lang="en">{airport.english}</span>
    <p>{airport.text}</p><span class="more">공항 이용 안내 보기 →</span>
   </a>)}</div>
  </section>
  <section class="related" aria-labelledby="flight-help-title">
   <h2 id="flight-help-title">항공편 지연·결항이나 수하물 문제가 생겼나요?</h2>
   <p>항공사에 요청할 사항과 수하물 신고 절차는 항공편 대응 안내에서 확인하실 수 있어요.</p>
   <a href="/ko/airport-assistance/">항공편 지연·결항·수하물 안내 →</a>
  </section>
 </main><SiteFooter locale="ko"/>
</body></html>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,"Apple SD Gothic Neo",sans-serif;line-height:1.8}main{max-width:1100px;margin:auto;padding:40px 24px 72px}a{color:#2e7c89}.back{font-size:14px}h1{font-size:36px;line-height:1.35;margin:20px 0}h2{font-size:24px;line-height:1.5}h3{font-size:23px;line-height:1.4;margin:9px 0 4px}.intro{max-width:780px;font-size:17px;color:#61717e}section{margin-top:40px}.airport-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.airport-card{display:flex;flex-direction:column;align-items:flex-start;min-width:0;padding:26px;border:1px solid #dce5e8;border-radius:16px;background:white;text-decoration:none;color:#253545}.airport-card:hover{border-color:#2e7c89;background:#f2f8f9}.airport-card:focus-visible{outline:3px solid #2e7c89;outline-offset:4px}.airport-code{font-weight:750;letter-spacing:1px;color:#2e7c89}.english{font-size:14px;color:#61717e}.airport-card p{color:#61717e;overflow-wrap:anywhere}.more{margin-top:auto;padding-top:10px;font-weight:700;color:#2e7c89}.related p{color:#61717e}.related a{font-weight:700}@media(max-width:650px){main{padding:28px 16px 48px}h1{font-size:29px}h2{font-size:22px}.airport-grid{grid-template-columns:1fr;gap:16px}.airport-card{padding:22px}}
</style>
