---
import DetailHeader from '../../../components/DetailHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import AirportPageMetadata from '../../../components/AirportPageMetadata.astro';
import AirportSources from '../../../components/AirportSources.astro';
import RuntimeDate from '../../../components/RuntimeDate.astro';
import data from '../../../../public/data/airport-assistance.json';
import {incidents} from '../../../lib/airport-assistance-editorial.mjs';
const title='태국 여행 중 지연·결항·수하물 문제, 지금 무엇부터 해야 할까요?';
const description='비행기가 늦어지거나 결항됐을 때, 짐이 나오지 않거나 캐리어가 파손됐을 때 공항에서 먼저 할 일을 안내해요. 항공사 이름·코드로 신고·확인서 방법을 찾고 보상과 여행보험 서류를 준비해보세요.';
const core=data.guides.filter(g=>[...incidents.map(i=>i.id),'insurance-claim','caat-passenger-rights'].includes(g.id));
const sources=[...new Set(core.flatMap(g=>[...(g.sources||[]),...(g.sections||[]).flatMap(s=>s.sources||[])]))];
const faq=[{q:'항공사에 사고를 신고하면 보험금도 함께 청구되나요?',a:'아니요. 항공사에 신고하는 절차와 보험사에 청구하는 절차는 따로 진행해야 해요. 항공사의 확인서·접수 기록과 지출 영수증을 보관하고, 가입한 특약에서 요구하는 서류를 준비해주세요.'},{q:'공동운항편은 어느 항공사에 문의하나요?',a:'항공권을 판매한 항공사와 실제 운항사가 다를 수 있어요. 실제 운항사를 먼저 살펴보세요. 경유편에서 짐이 나오지 않는다면 마지막 구간을 실제로 운항한 항공사에 먼저 신고해주세요.'},{q:'항공사 코드는 어디에서 찾나요?',a:'편명 앞의 영문·숫자 두 글자를 보시면 돼요. 예를 들어 OZ742의 OZ는 아시아나항공, KE657의 KE는 대한항공이에요. 항공사별 안내 검색에서 한국어·영문 항공사 이름이나 코드를 입력할 수 있어요.'}];
---
<!doctype html><html lang="ko"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="icon" href="/favicon.ico?v=20261013"/><title>{title} | ThaiLiveNow</title><meta name="description" content={description}/><AirportPageMetadata title={title} description={description}/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))})}/></head><body><DetailHeader/><main class="assistance-hub"><header><p class="eyebrow">지연·결항·수하물 안내</p><h1>태국 여행 중 비행기나 짐에 문제가 생겼나요?</h1><p class="intro">지금 공항에 계신다면 <strong>항공사 직원에게 상황을 알리는 것부터 시작해주세요.</strong> 비행기가 늦어졌는지, 아예 결항됐는지, 짐에 문제가 있는지에 따라 접수처와 준비할 자료가 달라요. 아래에서 겪고 있는 상황을 고르고 필요한 순서대로 따라가보세요.</p></header>
<section aria-labelledby="incident-heading"><h2 id="incident-heading">지금 어떤 상황인가요?</h2><div class="incident-grid">{incidents.map((item,i)=><article><span class="step-number">0{i+1}</span><h3>{item.title}</h3><p><strong>{item.first}</strong></p><p>{item.text}</p><a href={`/ko/airport-assistance/guides/${item.id}/`}>{item.link} →</a></article>)}</div></section>
<section class="evidence"><h2>공항에서 받은 기록은 따로 모아두세요</h2><p>항공사에 신고한 뒤에도 확인서 발급이나 비용 청구가 남을 수 있어요. 다음 자료를 챙겨두면 어떤 항공편에서 무슨 일이 있었는지 설명할 때 함께 제출할 수 있어요.</p><ol><li><strong>항공권·탑승권·수하물표</strong><p>실제 운항사, 편명과 여행 날짜를 확인할 수 있게 보관해주세요. 수하물표는 짐을 신고할 때 필요해요.</p></li><li><strong>항공사 알림과 접수번호</strong><p>원래 일정과 변경 일정, 직원에게 요청한 내용과 답변을 남겨주세요. 수하물 사고보고서를 받았다면 사본도 챙겨주세요.</p></li><li><strong>파손 사진과 지출 영수증</strong><p>캐리어의 파손 상태를 사진으로 남기고, 지연 때문에 쓴 비용은 영수증을 보관해주세요. 필요한 증빙과 지급 여부는 항공사와 가입한 보험의 조건에 따라 달라요.</p></li></ol></section>
<section><h2>항공사 처리 후 보상·보험은 어떻게 준비하나요?</h2><div class="followup-grid"><article><h3>태국 출발편의 지원·보상</h3><p>태국에서 한국으로 출발하는 정기 국제선이라면 CAAT 승객 보호 규정의 적용 조건을 살펴보세요. 항공사가 제공하는 식사·숙박·환불·대체편과 금전 보상은 각각 조건과 예외가 있어요. 한국에서 태국으로 출발하는 편에는 같은 출발지 기준을 그대로 적용하지 않아요.</p><a href="/ko/airport-assistance/guides/caat-passenger-rights/">지원·보상 조건과 CAAT 신고 방법 →</a></article><article><h3>가입한 여행보험에 청구</h3><p>항공사 신고와 보험 청구는 별도예요. 가입한 특약이 해당 사고를 보장하는지 살펴보고, 항공사 확인서와 접수 기록·영수증을 준비해주세요. 출국편과 귀국편의 적용 범위도 구분해야 해요.</p><a href="/ko/airport-assistance/guides/insurance-claim/">보험사별 서류와 청구 순서 →</a></article></div></section>
<section class="help-tools" aria-labelledby="help-tools-heading"><h2 id="help-tools-heading">항공사·공항별 안내를 바로 찾으려면</h2><p>이용한 항공사의 신고·확인서가 필요한지, 공항에서 창구를 찾는지에 맞춰 선택해주세요.</p><div class="help-tools-grid">
<a class="help-tool search-tool" href="/ko/airport-assistance/airlines/"><span class="tool-label">한국어 항공사 안내</span><h3>항공사별 신고·확인서 찾기</h3><p>항공사 이름이나 OZ·KE 같은 코드, 편명으로 한국어 신고·확인서 안내를 찾아보세요.</p><span class="tool-action">항공사 검색 열기 <span aria-hidden="true">→</span></span></a>
<a class="help-tool english-tool" href="/en/airport-assistance/"><span class="tool-label">공통 영문 안내 · <span lang="en">English</span></span><h3>다른 항공사도 찾으시나요?</h3><p>영문 항공사 이름이나 코드로 검색하고, 해당 항공사의 영문 안내와 공식 문의 경로를 볼 수 있어요.</p><span class="tool-action">영문 항공사 검색 열기 <span aria-hidden="true">→</span></span></a>
<a class="help-tool" id="services" href="/ko/airport-assistance/departure-airports/"><span class="tool-label">한국에서 태국으로 출발</span><h3>한국 출발공항 카운터·문의처</h3><p>인천·김해·대구의 체크인·발권 창구, 공항 사무실과 수하물 문의처를 공항별·업무별로 살펴보세요.</p><span class="tool-action">한국 공항 문의처 보기 <span aria-hidden="true">→</span></span></a>
<a class="help-tool" href="/ko/airports/"><span class="tool-label">태국에서 공항 이용</span><h3>태국 공항 위치·시설 안내</h3><p>수완나폼·돈므앙·푸껫·치앙마이의 시설 지도·흡연실·체크인·시내 이동 안내를 찾아보세요.</p><span class="tool-action">태국 공항 안내 보기 <span aria-hidden="true">→</span></span></a>
</div></section>
<section class="hub-faq"><h2>문의하기 전에 자주 묻는 질문</h2>{faq.map((f,i)=><details><summary>{f.q}</summary><p>{f.a}</p>{i===2&&<a href="/ko/airport-assistance/airlines/">항공사 이름·코드로 찾기 →</a>}</details>)}</section>
<AirportSources sources={sources} checkedAt={data.checkedAt}/><p class="modified">최근 수정일: <RuntimeDate kind="modified" locale="ko"/></p>
</main><SiteFooter/></body></html>
<style>:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,"Apple SD Gothic Neo",sans-serif;line-height:1.85}:global(*){box-sizing:border-box}.assistance-hub{max-width:1100px;margin:auto;padding:48px 28px 80px}header{max-width:900px}.eyebrow{font-size:13px;letter-spacing:.3px;color:#267e89;font-weight:700}h1{font-size:36px;line-height:1.4;margin:14px 0 24px}h2{font-size:27px;line-height:1.5;margin:0 0 20px}h3{font-size:22px;line-height:1.5;margin:10px 0 18px}p{color:#61717e;margin:12px 0 20px}strong{color:#253545}a{color:#267e89;text-decoration:none;font-weight:700}a:hover{text-decoration:underline}a:focus-visible,summary:focus-visible{outline:3px solid #267e89;outline-offset:4px}section,aside{margin:64px 0}.incident-grid,.followup-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.incident-grid article,.followup-grid article{padding:28px;border:1px solid #dce5e8;border-radius:16px;background:white;display:flex;flex-direction:column;min-width:0}.incident-grid a,.followup-grid a{margin-top:auto;display:block;padding-top:8px}.step-number{font-size:13px;letter-spacing:1px;color:#267e89;font-weight:700}.evidence{border-top:1px solid #dce5e8;padding-top:44px}.evidence ol{padding-left:26px}.evidence li{padding-left:10px;margin:24px 0}.evidence li p{margin:8px 0}.hub-faq details{border-bottom:1px solid #dce5e8;padding:20px 0}.hub-faq summary{cursor:pointer;font-weight:700}.airport-link{padding:28px;background:#edf5f6;border-radius:16px}.airport-link h2{font-size:23px}.modified{font-size:13px}@media(max-width:650px){.assistance-hub{padding:30px 18px 56px}h1{font-size:29px}h2{font-size:24px}h3{font-size:21px}.incident-grid,.followup-grid{grid-template-columns:1fr;gap:18px}.incident-grid article,.followup-grid article{padding:24px}section,aside{margin:46px 0}}
</style>

<style>
.help-tools{padding-top:44px;border-top:1px solid #dce5e8}.help-tools-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-top:24px}.help-tool{display:flex;flex-direction:column;min-width:0;padding:26px;border:1px solid #bdcfd3;border-radius:14px;background:white;color:#253545;font-weight:400;text-decoration:none}.help-tool h3{font-size:22px;margin:10px 0 14px}.help-tool p{margin:0 0 24px;color:#536674}.help-tool:hover{border-color:#267e89;box-shadow:0 3px 12px #2037440b;text-decoration:none}.help-tool:focus-visible{outline:3px solid #267e89;outline-offset:4px}.tool-label{font-size:13px;font-weight:700;color:#48717a}.tool-action{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-top:auto;font-size:16px;font-weight:750;color:#246f79;padding-top:16px;border-top:1px solid #dce5e8}.search-tool{border:2px solid #267e89;background:#f2f8f8}.english-tool{border:2px solid #267e89}.english-tool .tool-label{color:#267e89}@media(max-width:650px){.help-tools{padding-top:30px}.help-tools-grid{grid-template-columns:1fr;gap:16px}.help-tool{padding:22px}.help-tool h3{font-size:21px}}
</style>
