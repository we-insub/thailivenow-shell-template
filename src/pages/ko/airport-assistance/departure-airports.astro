---
import AirportAssistanceDetail from '../../../components/AirportAssistanceDetail.astro';
import AirportSources from '../../../components/AirportSources.astro';
import AirportPhone from '../../../components/AirportPhone.astro';
import AirportEmail from '../../../components/AirportEmail.astro';
import RuntimeDate from '../../../components/RuntimeDate.astro';
import {airportMarketData} from '../../../lib/airport-markets';
import {airportServiceKoreanCopy} from '../../../lib/airport-service-copy-ko.mjs';
const data=airportMarketData('ko');
const path='/ko/airport-assistance/departure-airports/';
const names:Record<string,string>={ICN:'인천국제공항',PUS:'김해국제공항',TAE:'대구국제공항'};
const codes=[...new Set<string>(data.routes.map((r:any)=>r.originIata===r.thaiAirport?r.destinationIata:r.originIata))].filter(code=>names[code]);
const category=(s:any)=>/원격|예약센터|고객센터|서비스센터/.test(s.type)?'remote':/수하물|파손|분실|유실|Lost|PIR/i.test(s.type)?'baggage':/체크인|수속|백드랍/i.test(s.type)?'checkin':'office';
const categories=[{id:'checkin',title:'체크인·짐 부치기',text:'출발 수속을 할 터미널과 층, 항공사 카운터를 살펴보세요. 카운터가 열리는 시각과 수속 마감은 항공편마다 다를 수 있으니 본인의 편명을 함께 확인해주세요.'},{id:'office',title:'발권·공항 사무실',text:'항공권을 발권하거나 공항 지점에 문의할 때 이용하는 곳이에요. 사무실 위치가 체크인 장소와 같다고 생각하지 말고, 방문할 곳과 처리할 업무를 구분해주세요.'},{id:'baggage',title:'수하물 사고·유실물 문의',text:'짐이 파손되거나 도착하지 않은 경우와 기내에 물건을 두고 내린 경우는 접수 업무가 다를 수 있어요. 아래 설명에서 위탁 수하물 신고, 유실물 문의, 공항 지점 연락처를 구분해서 이용해주세요.'},{id:'remote',title:'예약·고객센터 전화 상담',text:'항공권 예약·변경과 일반 문의를 받는 원격 상담 번호예요. 공항 체크인 카운터나 수하물 사고 접수처의 직통번호와는 구분해주세요.'}];
const airports=codes.map(code=>({code,name:names[code],services:data.services.filter((s:any)=>s.airportIata===code).map(airportServiceKoreanCopy)}));
const services=airports.flatMap(a=>a.services);
const sources=[...new Set<string>(services.flatMap((s:any)=>s.sources||[]))];
const faq=[{q:'여기에 나온 고객센터 번호가 공항 카운터 직통번호인가요?',a:'아니요. 예약·고객센터 전화 상담은 공항 현장 창구와 구분해야 해요. 공항 사무실, 수하물 접수처, 일반 예약센터 중 어떤 업무를 받는 번호인지 각 연락처의 설명을 읽고 이용해주세요.'},{q:'이전 안내에 나온 카운터로 바로 가면 되나요?',a:'공항에 도착하면 출발 전광판에서 자신의 편명과 당일 카운터 배정을 먼저 살펴보세요. 같은 항공사라도 시즌이나 당일 공항 사정에 따라 배정이 바뀔 수 있어요. 수속 마감시간도 본인 항공편의 안내를 따라주세요.'},{q:'태국에서 귀국할 때 이용할 카운터는 어디에서 보나요?',a:'이 페이지는 한국 출발공항의 창구와 문의처를 모은 안내예요. 태국에서 출발하신다면 태국 공항 안내에서 수완나폼·돈므앙·푸껫·치앙마이 중 이용할 공항을 선택해주세요.'}];
---
<AirportAssistanceDetail title="한국 출발공항 카운터·문의처" description="인천·김해·대구에서 태국행 항공편을 이용할 때 필요한 체크인·발권 창구, 공항 사무실과 수하물 문의처를 공항별로 살펴보세요. 현장 창구와 원격 고객센터를 구분해 안내해요.">
<section class="response-section"><h2>공항에서 어떤 업무를 보실 건가요?</h2><p>짐을 부치는 체크인 카운터와 항공권을 바꾸는 발권 창구, 도착 수하물을 신고하는 곳은 서로 달라요. <strong>이용할 공항과 실제 운항사를 먼저 확인한 뒤 필요한 업무를 찾아보세요.</strong> 전화로 문의하신다면 공항 현장 번호인지 일반 고객센터인지도 함께 살펴보시면 돼요.</p><p>카운터는 시즌이나 당일 운영에 따라 바뀔 수 있어요. <strong>출발 전광판에서 본인의 편명과 배정 카운터를 다시 확인해주세요.</strong> 아래 시간 안내는 한국 공항 기준이며, 자료 확인일은 각 창구 아래에 표시했어요.</p></section>
<section class="departure-filters" aria-label="출발공항과 업무 선택"><div><label for="departure-airport">이용할 출발공항</label><select id="departure-airport"><option value="all">한국 출발공항 전체</option>{airports.map(a=><option value={a.code}>{a.name} ({a.code})</option>)}</select></div><div><label for="departure-service">필요한 업무</label><select id="departure-service"><option value="all">모든 업무</option>{categories.map(c=><option value={c.id}>{c.title}</option>)}</select></div></section><p role="status" aria-live="polite" id="departure-status">공항과 업무를 고르면 해당 안내만 볼 수 있어요.</p>
{airports.map(airport=><section class="response-section departure-airport" data-airport-code={airport.code} id={airport.code.toLowerCase()}><h2>{airport.name} <span class="airport-code">{airport.code}</span></h2><p><a href={`/ko/airport-assistance/airports/${airport.code.toLowerCase()}/`}>{airport.name} 항공편·공항별 안내 →</a></p>{categories.map(group=>{const records=airport.services.filter((s:any)=>category(s)===group.id);return records.length>0&&<section class="service-group" data-service-kind={group.id}><h3>{group.title}</h3><p>{group.text}</p><div class="service-grid">{records.map((s:any)=><article id={s.id} data-departure-service={s.id}><h4>{s.airline} · {s.type}</h4>{s.location&&<p><strong>{s.location}</strong></p>}{s.hours&&<p class="hours">{s.hours}</p>}{s.text&&<p>{s.text}</p>}{s.phone&&<AirportPhone phone={s.phone}/>} {s.email&&<AirportEmail email={s.email}/>}<p><a href={`/ko/airport-assistance/airlines/${s.airlineId}/`}>{s.airline} 신고·확인서 안내 →</a></p><p class="checked">자료 확인일: <RuntimeDate kind="source" locale="ko" pagePath={`${path}#${s.id}`} fallback={s.checkedAt}/></p></article>)}</div></section>;})}</section>)}
<section class="response-section"><h2>공항 창구를 찾기 전에 자주 묻는 질문</h2>{faq.map(item=><details><summary>{item.q}</summary><p>{item.a}</p></details>)}</section>
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(item=>({'@type':'Question',name:item.q,acceptedAnswer:{'@type':'Answer',text:item.a}}))})}/>
<section class="response-section"><h2>태국 공항이나 항공편 문제 안내가 필요하다면</h2><p><a href="/ko/airports/">태국 공항 시설·체크인·시내 이동 안내 →</a></p><p><a href="/ko/airport-assistance/">지연·결항·수하물 대응 안내로 돌아가기 →</a></p></section>
<AirportSources sources={sources} checkedAt={data.checkedAt}/><p class="checked">최근 수정일: <RuntimeDate kind="modified" locale="ko"/></p>
</AirportAssistanceDetail>
<script>
const airport=document.querySelector<HTMLSelectElement>('#departure-airport')!,service=document.querySelector<HTMLSelectElement>('#departure-service')!,status=document.querySelector<HTMLElement>('#departure-status')!;
function filterDeparture(){let count=0;for(const section of document.querySelectorAll<HTMLElement>('.departure-airport')){const selected=airport.value==='all'||airport.value===section.dataset.airportCode;let found=false;for(const group of section.querySelectorAll<HTMLElement>('[data-service-kind]')){group.hidden=service.value!=='all'&&service.value!==group.dataset.serviceKind;if(!group.hidden){found=true;if(selected)count+=group.querySelectorAll('[data-departure-service]').length;}}section.hidden=!selected||!found;}status.textContent=count?`선택한 공항·업무의 안내 ${count}건을 볼 수 있어요.`:'선택한 공항·업무의 안내가 이 자료에 포함되어 있지 않아요. 다른 업무를 선택하거나 공항별 안내를 이용해주세요.';}
airport.addEventListener('change',filterDeparture);service.addEventListener('change',filterDeparture);
</script>
<style>[hidden]{display:none!important}.departure-filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.departure-filters label{display:block;font-weight:700;margin-bottom:8px}.departure-filters select{width:100%;padding:14px;font:inherit;border:1px solid #b6cbd0;border-radius:10px;background:white;color:inherit}.departure-filters select:focus-visible{outline:3px solid #267e89;outline-offset:3px}@media(max-width:650px){.departure-filters{grid-template-columns:1fr}}.airport-code{font-size:16px;color:#267e89}.service-group{margin:36px 0}.service-group>h3{font-size:22px;margin-bottom:12px}.service-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.service-grid article{margin:0;min-width:0;scroll-margin-top:140px}.service-grid h4{font-size:18px;line-height:1.6;margin:0 0 16px}.service-grid p{overflow-wrap:anywhere}.service-grid .checked,.checked{font-size:13px}.service-grid .hours{color:#253545}@media(max-width:650px){.service-grid{grid-template-columns:1fr}}</style>
