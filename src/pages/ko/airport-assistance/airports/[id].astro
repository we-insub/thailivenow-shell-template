---
import {airportServiceKoreanCopy} from '../../../../lib/airport-service-copy-ko.mjs';
import BkkGuidePage from '../../../../components/BkkGuidePage.astro';
import koreanGuides from '../../../../data/airport-detail-guides-ko.json';
import AirportFacilityIntro from '../../../../components/AirportFacilityIntro.astro';
import AirportSources from '../../../../components/AirportSources.astro';
import AirportImportantText from '../../../../components/AirportImportantText.astro';
import AirportSourceReferences from '../../../../components/AirportSourceReferences.astro';
import AirportRailSummary from '../../../../components/AirportRailSummary.astro';
import AirportEmail from '../../../../components/AirportEmail.astro';
import AirportPhone from '../../../../components/AirportPhone.astro';
import {airportPairs} from '../../../../lib/airport-markets';
import data from '../../../../../public/data/airport-assistance.json';
import AirportAssistanceDetail from '../../../../components/AirportAssistanceDetail.astro';
export function getStaticPaths(){return [...new Set(data.routes.flatMap(r=>[r.originIata,r.destinationIata]).concat(data.services.map(s=>s.airportIata).filter(Boolean)))].map(code=>({params:{id:code.toLowerCase()},props:{code,name:data.routes.find(r=>r.originIata===code)?.origin||data.routes.find(r=>r.destinationIata===code)?.destination||({HKT:'푸껫 국제공항',CNX:'치앙마이 국제공항'} as Record<string,string>)[code]||code}}));}
const {code,name}=Astro.props;
const guideNames:Record<string,string>={BKK:'수완나품공항',DMK:'돈므앙공항',HKT:'푸껫공항',CNX:'치앙마이공항'};
const guideName=guideNames[code];
const koreanDeparture=['ICN','PUS','TAE'].includes(code);
const services=data.services.filter(s=>s.airportIata===code||s.airport?.includes(code)).map(airportServiceKoreanCopy);
const routes=data.routes.filter(r=>r.originIata===code || r.destinationIata===code);
const statusLinks=[...new Map(routes.filter((r:any)=>r.flightStatusUrl).map((r:any)=>[r.airlineId,{airline:r.airline,url:r.flightStatusUrl}])).values()] as any[];
const pairs=airportPairs(data).filter(pair=>[pair.other,pair.thai].includes(code));
const carrierIds=new Set([...routes.map(r=>r.airlineId),...services.map(s=>s.airlineId)]);
const guides=data.guides.filter((g:any)=>(!g.airportIata||g.airportIata===code)&&(!g.airlineIds?.length||g.airlineIds.some((id:string)=>carrierIds.has(id))));
const faq=[
 ...(services.length?[{q:`${name}에서 항공사 카운터는 어떻게 찾나요?`,a:'항공권의 실제 운항사를 먼저 확인하고 항공사별 창구에서 체크인·발권·수하물 업무를 구분해 살펴보세요. 카운터 배정은 여행 당일 공항 전광판과 항공사 안내로 다시 확인하세요.'}]:[]),
 ...(routes.length?[{q:`${name}에서 태국 또는 한국으로 가는 편명은 어디서 보나요?`,a:'아래 한국↔태국 노선에서 출발·도착 공항과 편명을 선택하면 해당 편의 자료 확인일과 운항 기간을 볼 수 있어요. 공항쌍별 안내에서는 같은 두 공항을 연결하는 항공편과 항공사 정보를 함께 살펴볼 수 있어요.'}]:[]),
 ...(statusLinks.length?[{q:'시간표에 나온 시각만으로 오늘 지연 여부를 알 수 있나요?',a:'시간표의 예정 시각과 당일 운항 상황은 구분해서 확인해야 해요. 당일 운항 상황 확인의 항공사 공식 조회를 열고 여행 날짜와 편명을 확인하세요.'}]:[]),
];
const pageSources=[...new Set([...services.flatMap((item:any)=>item.sources||[]),...routes.flatMap((item:any)=>item.sources||[])])].filter((url:any)=>typeof url==='string'&&/^https?:\/\//.test(url));
---
{code==='BKK'?<BkkGuidePage/>:<AirportAssistanceDetail parentUrl={koreanDeparture?'/ko/airport-assistance/departure-airports/':undefined} parentLabel={koreanDeparture?'한국 출발공항 카운터·문의처':undefined} title={guideName?`${guideName} 이용 안내 · 시설과 항공편`:`${name} 항공사 카운터·연락처`} description={guideName?`${guideName}의 터미널·층별 지도에서 필요한 시설을 찾아보세요. 흡연구역과 출발·도착 안내, 한국↔태국 항공편의 카운터·연락처를 함께 정리했어요.`:`${name}에서 한국↔태국 항공편을 이용할 때 확인할 체크인·발권 창구와 문의처입니다.`}>
<AirportFacilityIntro code={code} locale={"ko"}/>
{code === 'BKK' && <AirportRailSummary showMap={true} />}
{services.length>0&&<section><h2>항공사별 창구 찾기</h2><p>항공권의 실제 운항사와 편명을 확인한 뒤 아래 창구 정보를 살펴보세요. 표를 새로 발권하거나 변경할 때와 이미 체크인한 뒤 짐을 부칠 때의 창구는 다를 수 있어요.</p>{services.map(s=><article><h3>{s.airline} · {s.type}</h3>{s.location&&<p><AirportImportantText text={s.location} phrases={s.location.length<=70?[s.location]:[]} locale={"ko"}/></p>}{s.hours&&<p><AirportImportantText text={s.hours} phrases={s.hours.length<=70?[s.hours]:[]} locale={"ko"}/></p>}{s.text&&<p>{s.text}</p>}{s.phone&&<AirportPhone phone={s.phone} />}{s.email&&<AirportEmail email={s.email} />}<a href={`/ko/airport-assistance/airlines/${s.airlineId}/`}>항공사 상세 보기 →</a><p>자료 확인일: {s.checkedAt}</p><AirportSourceReferences sources={s.sources||[]} pageSources={pageSources} locale={"ko"}/></article>)}</section>}
{routes.length>0&&<section><h2>한국↔태국 노선·편명</h2><div class="links">{routes.map(r=><a href={`/ko/airport-assistance/routes/${r.id}/`}>{r.originIata} → {r.destinationIata} {r.flightNumber || r.airline}</a>)}</div></section>}
{pairs.length>0&&<section><h2>공항쌍별 안내</h2><div class="links">{pairs.map(pair=><a href={`/ko/airport-assistance/pairs/${pair.id}/`}>{pair.other} ↔ {pair.thai} →</a>)}</div></section>}
{statusLinks.length>0&&<section><h2>당일 운항 상황 확인</h2><div class="links">{statusLinks.map((item:any)=><a href={item.url} target="_blank" rel="noopener noreferrer">{item.airline} 공식 조회 ↗</a>)}</div></section>}
{faq.length>0&&<section><h2>{name} 이용 전에 자주 묻는 질문</h2>{faq.map(item=><details><summary>{item.q}</summary><p>{item.a}</p></details>)}</section>}
{faq.length>0&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:[...((koreanGuides as any)[code]?.faq||[]),...faq].map(item=>({'@type':'Question',name:item.q,acceptedAnswer:{'@type':'Answer',text:item.a}}))}).replaceAll('<','\u003c')}/>}
{guides.length>0&&<section><h2>지연·결항·수하물 문제와 도착 후 이동</h2><div class="links">{guides.map(g=><a href={`/ko/airport-assistance/guides/${g.id}/`}>{g.title} →</a>)}</div></section>}
<AirportSources locale={"ko"} sources={pageSources} checkedAt={undefined}/>
</AirportAssistanceDetail>}
