---
import AirportSources from '../../../../components/AirportSources.astro';
import AirportImportantText from '../../../../components/AirportImportantText.astro';
import AirportEmail from '../../../../components/AirportEmail.astro';
import AirportPhone from '../../../../components/AirportPhone.astro';
import AirportScheduleDates from '../../../../components/AirportScheduleDates.astro';
import RuntimeDate from '../../../../components/RuntimeDate.astro';
import {counterSeasonalNotice,needsCounterNotice} from '../../../../i18n/airport-counter-review';
import data from '../../../../../public/data/airport-assistance.json';
import AirportAssistanceDetail from '../../../../components/AirportAssistanceDetail.astro';
import {airportServiceKoreanCopy} from '../../../../lib/airport-service-copy-ko.mjs';
import {carrierIntroductions,guidesForAirline,guideKind} from '../../../../lib/airport-assistance-editorial.mjs';
export function getStaticPaths(){return data.airlines.map(airline=>({params:{id:airline.id},props:{airline}}));}
const {airline:a}=Astro.props as {airline:any};
const routes=data.routes.filter(r=>r.airlineId===a.id);
const services=data.services.filter(s=>s.airlineId===a.id).map(airportServiceKoreanCopy).map((s:any)=>({...s,code:s.airportIata||s.airport?.match(/\b[A-Z]{3}\b/)?.[0]}));
const guides=guidesForAirline(data,a.id);
const airportTitles=/인천|김해|체크인|카운터|공항에서 수속|수완나폼 타이항공 국제선|푸껫에서 한국|한국↔태국 항공편/;
const primary=(a.sections||[]).filter(s=>!airportTitles.test(s.title));
const secondary=(a.sections||[]).filter(s=>airportTitles.test(s.title));
const groupedServices=[{title:'수하물 사고·유실물 문의',items:services.filter(s=>/수하물|파손|분실|유실|Lost|Baggage|PIR/i.test(s.type))},{title:'예약·발권·공항 사무실',items:services.filter(s=>!/수하물|파손|분실|유실|Lost|Baggage|PIR/i.test(s.type)&&!/체크인|수속|Check.?in/i.test(s.type))},{title:'일반 체크인 카운터',items:services.filter(s=>!/수하물|파손|분실|유실|Lost|Baggage|PIR/i.test(s.type)&&/체크인|수속|Check.?in/i.test(s.type))}];
const pageSources=[...new Set([...(a.sources||[]),...(a.sections||[]).flatMap((item:any)=>item.sources||[]),...services.flatMap((item:any)=>item.sources||[]),...routes.flatMap((item:any)=>item.sources||[])])].filter((url:any)=>typeof url==='string'&&/^https?:\/\//.test(url));
const title=`${a.name} 지연·결항·수하물 신고 안내`;
const intro=carrierIntroductions[a.id];
---
<AirportAssistanceDetail title={title} description={intro} parentUrl="/ko/airport-assistance/airlines/" parentLabel="항공사별 신고·확인서 찾기">
{guides.length>0&&<section class="response-section"><h2>지금 필요한 업무부터 선택하세요</h2><div class="task-links">{guides.map(g=><a href={`/ko/airport-assistance/guides/${g.id}/`}>{g.title} →</a>)}</div></section>}
{primary.map((section:any)=><section class="response-section"><h2>{section.title}</h2>{section.text?.split('\n').filter(Boolean).map((text:string)=><p><AirportImportantText text={text} phrases={section.highlights||[]} locale="ko"/></p>)}{section.location&&<p>{section.location}</p>}{section.hours&&<p>{section.hours}</p>}{section.phone&&<AirportPhone phone={section.phone}/>}{section.email&&<AirportEmail email={section.email}/>}{section.actions?.map((action:any)=><p><a href={action.url}>{action.label} →</a></p>)}</section>)}
{a.actions?.length>0&&<section class="response-section"><h2>항공사에 접수하거나 확인서 신청하기</h2>{a.actions.map((action:any)=><p><a href={action.url}>{action.label} →</a></p>)}</section>}
{services.length>0&&<section class="response-section"><h2>전화·이메일은 업무와 공항을 맞춰 이용해주세요</h2><p>예약센터와 체크인 카운터, 도착 수하물 접수처는 서로 다른 곳이에요. 아래에서 필요한 업무를 펼친 뒤 이용할 공항과 연락처를 함께 살펴보세요. 공항 대표번호를 항공사 수하물 데스크 직통번호로 사용하지 않도록 구분해주세요.</p>{groupedServices.filter(group=>group.items.length).map(group=><details class="secondary-records"><summary>{group.title} · {group.items.length}건</summary>{group.items.map((s:any)=><article><h3>{s.airport||s.code} · {s.type}</h3>{s.location&&<p><AirportImportantText text={s.location} phrases={s.location.length<=70?[s.location]:[]} locale="ko"/></p>}{s.hours&&<p>{s.hours}</p>}{s.phone&&<AirportPhone phone={s.phone}/>}{s.email&&<AirportEmail email={s.email}/>}{s.text&&<p>{s.text}</p>}{s.code&&<p><a href={`/ko/airport-assistance/airports/${s.code.toLowerCase()}/${s.code==='BKK'?'airlines/':''}`}>이 공항의 항공사별 창구 안내 →</a></p>}<p>자료 확인일: <RuntimeDate kind="source" fallback={s.checkedAt} locale="ko"/></p></article>)}</details>)}</section>}
{secondary.length>0&&<details class="secondary-records"><summary>체크인 장소·공항별 수속 안내</summary>{a.note&&<p>{a.note}</p>}{needsCounterNotice(a,data.services.filter(s=>s.airlineId===a.id))&&<p>{counterSeasonalNotice.ko}</p>}{secondary.map((s:any)=><section><h2>{s.title}</h2>{s.text?.split('\n').filter(Boolean).map((text:string)=><p>{text}</p>)}{s.actions?.map((action:any)=><p><a href={action.url}>{action.label} →</a></p>)}</section>)}</details>}
{routes.length>0&&<details class="secondary-records"><summary>한국↔태국 노선·편명 자료 펼치기</summary><p>기간 시간표와 당일 운항 상태는 달라요. 본인의 여행 날짜와 실제 운항사를 확인한 뒤 각 노선의 유효기간과 공식 조회를 함께 살펴보세요.</p><div class="airline-routes">{routes.map(r=><div><a href={`/ko/airport-assistance/routes/${r.id}/`}>{r.originIata} → {r.destinationIata} {r.flightNumber||r.airline} →</a><AirportScheduleDates route={r} compact/></div>)}</div></details>}
{a.faq?.length>0&&<section class="response-section"><h2>이용 전에 자주 묻는 질문</h2>{a.faq.map((item:any)=><details><summary>{item.q}</summary><p>{item.a}</p></details>)}</section>}
{a.faq?.length>0&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:a.faq.map((item:any)=>({'@type':'Question',name:item.q,acceptedAnswer:{'@type':'Answer',text:item.a}}))}).replaceAll('<','\\u003c')}/>}
<section class="response-section"><h2>접수 기록을 챙겼다면 다음 절차를 살펴보세요</h2><p>태국 출발편의 승객 보호 규정과 본인이 가입한 여행보험은 적용 조건과 접수처가 달라요. 항공권 환불, 사고 신고, 보험 청구가 한 번에 처리되는 것으로 생각하지 말고 각각 필요한 절차를 진행해주세요.</p><p><a href="/ko/airport-assistance/guides/caat-passenger-rights/">태국 출발편 지원·보상과 CAAT 신고 →</a></p><p><a href="/ko/airport-assistance/guides/insurance-claim/">항공사 확인서·영수증으로 보험 청구 준비 →</a></p><p><a href="/ko/airport-assistance/">다른 상황·항공사 안내 찾기 →</a></p></section>
<AirportSources locale="ko" sources={pageSources} checkedAt={a.checkedAt}/>
</AirportAssistanceDetail>
<style>.airline-routes{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:18px}.airline-routes>div{padding:12px;border-bottom:1px solid #e4eaee}</style>
