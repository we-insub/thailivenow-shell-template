---
import DetailHeader from './DetailHeader.astro';
import SiteFooter from './SiteFooter.astro';
import AirportSources from './AirportSources.astro';
import foodBase from '../data/food.json';
import koPack from '../data/food-localized/ko.json';
import {locales} from '../i18n/locales';
import '../styles/food.css';
const {title,description,breadcrumbs=[],sourceIds=[],faq=[],locale='ko',ui=koPack.ui,data=foodBase}=Astro.props;
const language=locale==='ko'?'ko':locales.find(item=>item.code===locale)?.tag||locale;
const sourceRows=[...new Set(sourceIds)].map((id)=>data.sources[id]).filter(Boolean);
const schema={'@context':'https://schema.org','@graph':[{'@type':'Article',headline:title,description,inLanguage:language},...(faq.length?[{'@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}]:[])]};
---
<!doctype html><html lang={language}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | ThaiLiveNow</title><meta name="description" content={description}/><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261013"/><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261013"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body><a class="food-skip" href="#food-main">{ui.skip}</a><DetailHeader locale={locale}/><main class="thai-detail food-page" id="food-main"><nav class="food-breadcrumb" aria-label={ui.breadcrumbLabel}><a href={`/${locale}/`}>{ui.home}</a><span aria-hidden="true">/</span>{breadcrumbs.map(([label,url])=><><a href={url}>{label}</a><span aria-hidden="true">/</span></>)}<span aria-current="page">{title}</span></nav><slot/><section class="food-sources"><h2>{ui.sourcesTitle}</h2><p>{ui.sourcesIntro}</p><AirportSources sources={sourceRows.map(row=>row[1])} locale={locale} idPrefix="food-source" labeler={(url)=>sourceRows.find(row=>row[1]===url)?.[0]||new URL(url).hostname}/></section></main><SiteFooter locale={locale}/></body></html>
