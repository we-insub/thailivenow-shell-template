---
import food from '../data/food.json';
const months=Array.from({length:12},(_,i)=>i+1);
---
<div class="fruit-month-control" data-fruit-month-control hidden><label for="fruit-month">여행하는 달</label><select id="fruit-month"><option value="all">1–12월 전체</option>{months.map(m=><option value={m}>{m}월</option>)}</select><button type="button" data-fruit-reset>전체 보기</button><span role="status" aria-live="polite" data-fruit-status></span></div>
<div class="fruit-calendar" aria-label="1월부터 12월까지 과일 출하시기">{months.map(month=><article class="fruit-month" data-calendar-month={month}><h3>{month}월</h3><ul>{food.fruits.filter(f=>f.months.length<12&&(f.months.includes(month)||f.regionalMonths?.includes(month))).map(f=><li><a href={`/ko/food/fruits/${f.id}/`}>{f.name}</a><small>{f.months.includes(month)?f.seasonLabel:f.regional}</small></li>)}</ul></article>)}</div>
<p class="fruit-calendar-note"><strong>수박·파파야·어린 코코넛·바나나</strong>처럼 연중 출하하는 과일은 아래 전체 목록에서 볼 수 있어요. 달력은 주출하기 또는 공식 자료의 출하시기를 표시하며, <strong>12월 타마린드는 12월 말</strong>부터 안내돼요. 품종·산지·날씨에 따라 실제 출하는 달라질 수 있어요.</p>
<script>
function initFruitCalendar(){const control=document.querySelector<HTMLElement>('[data-fruit-month-control]');if(!control||control.dataset.ready)return;control.dataset.ready='true';const select=control.querySelector<HTMLSelectElement>('select')!;const status=control.querySelector<HTMLElement>('[data-fruit-status]')!;const blocks=[...document.querySelectorAll<HTMLElement>('[data-calendar-month]')];const items=[...document.querySelectorAll<HTMLElement>('[data-fruit-item]')];const value=new URLSearchParams(location.search).get('month');if(value&&[...select.options].some(o=>o.value===value))select.value=value;const apply=(save=false)=>{blocks.forEach(b=>b.hidden=select.value!=='all'&&b.dataset.calendarMonth!==select.value);let count=0;items.forEach(item=>{item.hidden=select.value!=='all'&&!item.dataset.months?.split(',').includes(select.value);if(!item.hidden)count++});status.textContent=select.value==='all'?`과일 ${count}종`:`${select.value}월에 살펴볼 과일 ${count}종`;if(save){const url=new URL(location.href);if(select.value==='all')url.searchParams.delete('month');else url.searchParams.set('month',select.value);history.replaceState(null,'',url)}};select.addEventListener('change',()=>apply(true));control.querySelector('[data-fruit-reset]')!.addEventListener('click',()=>{select.value='all';apply(true)});window.addEventListener('popstate',()=>{const v=new URLSearchParams(location.search).get('month')||'all';select.value=[...select.options].some(o=>o.value===v)?v:'all';apply()});control.hidden=false;apply()}initFruitCalendar();document.addEventListener('astro:page-load',initFruitCalendar);
</script>
<style>.fruit-month-control{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin:20px 0}.fruit-month-control label{font-size:14px;font-weight:650}.fruit-month-control select,.fruit-month-control button{font:inherit;font-size:14px;background:white;color:#28533f;border:1px solid #cadacd;padding:9px 13px;border-radius:8px}.fruit-month-control button{cursor:pointer}.fruit-month-control [role=status]{font-size:13px;color:#607468}.fruit-calendar{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.fruit-month{border:1px solid #dce5de;border-radius:12px;padding:20px;background:white;min-width:0}.fruit-month h3{color:#396b4c;font-size:23px!important}.fruit-month ul{padding:0;list-style:none}.fruit-month li{margin:12px 0;font-size:14px}.fruit-month small{display:block;font-size:11px;color:#738174}.fruit-calendar-note{font-size:14px;color:#627068;line-height:1.85}@media(max-width:800px){.fruit-calendar{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:540px){.fruit-calendar{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.fruit-month{padding:16px}.fruit-month li{font-size:13px}}</style>
