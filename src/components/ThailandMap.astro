---
import {hasLocalizedStage,localizedCameraEditorial,localizedVenue} from '../lib/localized-content';
import CameraActions from './CameraActions.astro';
import {mapIcons} from '../design/map-icons';
import {headerIcons} from '../design/header-icons';
import {getDesignUI} from '../i18n/design-ui';
import originalVenues from '../data/rooftops.json';
import { travelAreas, provinces } from '../data/map';
import { cameras, categoryLabels } from '../data/cameras';
import { getUI, cameraTitle, cameraStatus, categoryName, placeName } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
const {locale='en'}=Astro.props as {locale?:Locale};
const editorialEnabled=locale==='ko'||hasLocalizedStage(locale,'cameras');
const cameraEditorial=localizedCameraEditorial(locale);
const venues=originalVenues.map(v=>localizedVenue(v,locale));
const design=getDesignUI(locale);
const ui=getUI(locale);
const names: Record<string, string> = { Bangkok: '방콕', 'Chiang Mai': '치앙마이', 'Chiang Rai': '치앙라이', Phuket: '푸껫', Krabi: '끄라비', 'Chon Buri': '촌부리', 'Surat Thani': '수랏타니', 'Prachuap Khiri Khan': '쁘라쭈압키리칸' };
---
{hasLocalizedStage(locale,'cameras')&&<script is:inline type="application/json" data-locale-camera-model set:html={JSON.stringify({editorial:cameraEditorial,venues:hasLocalizedStage(locale,'rooftops')?venues:[]}).replaceAll('<','\u003c')}/>}<div class="mobile-home-intro"><p>{editorialEnabled?`태국 어디로 가세요? 지도에서 공개 카메라 ${cameras.length}개를 찾아보세요. 카메라를 누르면 촬영 위치와 시청 상태를 살펴보고, 운영자의 원본 화면으로 이동할 수 있어요.`:ui.mapIntro}</p><a href={`/${locale}/directory/`}>{ui.allList} →</a><a href={`/${locale}/destinations/`}>{ui.destinations} →</a></div>
<section class="thailand-explorer map-explorer home-map-frame camera-discovery-layout" id="map" aria-labelledby="map-title">
  <aside class="explorer-panel">
    <div class="panel-heading"><span class="overline">EXPLORE THAILAND</span><h1 id="map-title">{editorialEnabled?'태국 여행지 카메라와 라이브캠':ui.mapTitle}</h1><p class="panel-intro">{editorialEnabled?'방콕의 강변이나 푸껫의 해변이 궁금하신가요? 도시나 장소를 검색한 뒤 지도에서 카메라를 눌러보세요. 촬영 위치와 시청 상태를 살펴보고 운영자의 원본 화면으로 이동할 수 있어요. 생방송 영상과 갱신 사진은 카메라마다 다르니 안내를 함께 읽어주세요.':ui.mapIntro}</p><p class="panel-camera-count">{editorialEnabled?'태국 공개 카메라':ui.cameras} <strong>{cameras.length}</strong></p></div>
    <div class="search-area"><label class="city-search search-box"><span aria-hidden="true">⌕</span><input id="city-search" type="search" placeholder={ui.search} aria-label={ui.search} role="combobox" aria-expanded="false" aria-controls="search-results" autocomplete="off" /><button id="clear-camera-search" type="button" aria-label={editorialEnabled?'검색어 지우기':'Clear search'} hidden>×</button></label><div id="search-results" class="search-results" role="listbox" hidden></div></div>
    <label class="region-control"><span aria-hidden="true">⌖</span><select id="province-select" aria-label={ui.region}><option value="">{ui.allThailand} · {ui.regions}</option>{provinces.map(p => <option value={p.id}>{locale === 'ko' && names[p.name] ? `${names[p.name]} · ` : ''}{p.name}</option>)}</select></label>

    <div class="panel-scroll"><div class="browse-panel"><div class="list-heading panel-section-title"><h2>{ui.cameraList}</h2><span id="camera-count">{cameras.length}</span></div>
    <div class="city-list browse-cameras" id="camera-list">{cameras.map(camera => <article class="camera-row" data-camera-row={camera.id}><button class="city-card browse-camera" type="button" data-camera={camera.id} aria-pressed="false"><span class="thumbnail"><img src={camera.preview?.url} alt="" loading="lazy" referrerpolicy="no-referrer"/></span><span class="city-copy"><small>{placeName(camera.area,locale)}</small><strong>{editorialEnabled?cameraEditorial[camera.id].displayTitle:cameraTitle(camera,locale)}</strong>{locale!=='en'&&<em>{cameraTitle(camera,'en')}</em>}<span>{cameraStatus(camera,locale)}</span></span><svg class="city-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" set:html={mapIcons.arrow}/></button><div class="camera-row-links"><a href={`/${locale}/cameras/${camera.id}/`}>{ui.details}</a><a href={camera.sourceUrl} target="_blank" rel="noopener noreferrer">{ui.source}</a></div></article>)}</div>
</div>
    <p class="no-results" id="no-results" hidden>{ui.noResults}</p>
    <div id="home-tourism-panel" class="tourism-panel" hidden><div class="tourism-panel-heading"><span class="overline">EXPLORE THAILAND</span><h2>{editorialEnabled?'태국 여행':ui.destinations}</h2><p>{editorialEnabled?'여행할 도시를 고르고 지도에서 루프탑과 전망대를 찾아보세요. 시설 이름을 누르면 방문 안내를 읽을 수 있어요.':ui.explore}</p></div><div class="tourism-regions">{travelAreas.map(city=><button type="button" data-map-city={city.id}>{placeName(city.name,locale)}</button>)}</div><div class="tourism-places">{venues.filter(v=>v.publicationStatus!=='held').map(v=><article data-tourism-city={v.city}><span>{v.city}</span><h3>{editorialEnabled?v.name:v.english}</h3><p>{v.building}</p><a href={`/ko/rooftops/${v.id}/`}>{ui.details} →</a><button type="button" data-tourism-venue={v.id}>{ui.viewMap}</button></article>)}</div></div><div class="selected-place selected-card" hidden id="selected-place"><div class="selected-topline"><span class="live-cam-label">THAILAND CAMERA</span><button id="close-selection" class="icon-button" type="button" aria-label={ui.cameraList}>×</button></div><img id="selected-preview" alt="" hidden referrerpolicy="no-referrer"/><div class="selected-copy"><a id="selected-credit" class="source-note" target="_blank" rel="noopener noreferrer" hidden></a><p id="selected-region" class="eyebrow"></p><strong id="selected-name">{ui.allThailand}</strong><span id="selected-description">{ui.cameraList} · {cameras.length}</span><div class="tags" id="selected-tags"></div><div id="selected-weather" class="camera-weather" hidden></div><p id="selected-location" class="location-notice"></p><div id="selected-access" class="camera-rail-access" hidden></div><div class="operator-box"><div><small>{ui.provider}</small><a id="selected-operator" target="_blank" rel="noopener noreferrer"></a></div></div><p id="selected-status" class="status-line"></p><CameraActions locale={locale} compact/><a id="selected-source" target="_blank" rel="noopener noreferrer" hidden>{ui.source}</a><a id="selected-detail" hidden>{ui.details}</a><button type="button" id="reset-map">{ui.reset}</button></div></div>
</div>
    <div class="panel-foot"><span class="status-dot"></span><span>{ui.locationNote}</span><a href={`/${locale}/directory/`} class="camera-note">{ui.allList}</a></div>
  </aside>
  <div class="map-stage"><button type="button" id="reset-map-view" class="reset-map">⌖ {ui.allThailand}</button><a class="saved-map-link" href={`/${locale}/saved/`}>♡ {design.saved}</a><div class="map-caption"><span class="connection-dot"></span><strong id="map-in-view">{cameras.length}</strong><span>{editorialEnabled?'현재 지도에 표시된 카메라':'cameras in view'}</span></div><button id="mobile-camera-list" class="mobile-list-toggle" type="button" aria-expanded="false">{ui.cameraList} · {cameras.length}</button>
    <div id="thailand-map" aria-label={ui.map}></div>
    <div class="camera-filters category-bar" aria-label={ui.all}>{Object.entries(categoryLabels).map(([id,label]) => <button type="button" data-category={id} class:list={[id === 'all' && 'active']} aria-pressed={id === 'all' ? 'true' : 'false'}><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" set:html={mapIcons[id==='all'?'camera':id==='nature'?'mountain':id==='airport'?'plane':id==='sea'?'water':'pin']||mapIcons.pin}/>{id==='all'?ui.cameras:categoryName(id,locale)}</button>)}<button type="button" data-category="tourism" aria-pressed="false"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" set:html={mapIcons.compass}/>{editorialEnabled?'관광지':ui.destinations}</button></div><div class="map-toolbar city-shortcuts" hidden aria-label={ui.region}>{[{id:'all',name:'태국 전체'}, ...travelAreas].map(c => <button type="button" data-map-city={c.id} class:list={[c.id === 'all' && 'active']} aria-pressed={c.id === 'all' ? 'true' : 'false'}>{c.id === 'all' ? ui.allThailand : placeName(c.name,locale)}</button>)}<button type="button" id="toggle-beaches" aria-pressed="false">≈ {locale === 'ko' ? '해변' : 'Beaches'}</button><button type="button" id="toggle-cameras" aria-pressed="false" aria-label={ui.cameraPins}>◉ {ui.cameras}</button></div>
    <div class="travel-legend"><i aria-hidden="true"></i>{locale === 'ko' ? '주요 여행지 · 주변 영역 (행정경계 아님)' : 'Travel destinations · approximate areas'}</div>
    <div class="beach-status" id="beach-status" role="status" hidden></div>
    <div class="map-status map-loading" id="map-status" role="status"><span aria-hidden="true"></span>{ui.loading}</div>

    <div class="map-error" id="map-error" hidden><strong>{ui.mapError}</strong><p>{ui.connection}</p><button id="retry-map" type="button">{ui.retry}</button><a href="https://www.openstreetmap.org/#map=6/13.04/101.49" target="_blank" rel="noopener noreferrer">{ui.viewMap}</a></div>
    <noscript><div class="map-error"><strong>{ui.connection}</strong><a href="https://www.openstreetmap.org/#map=6/13.04/101.49">{ui.viewMap}</a></div></noscript>
  </div>
</section>
<script>
  import '../scripts/thailand-map';
</script>
