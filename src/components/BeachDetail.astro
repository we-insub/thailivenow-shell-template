---
import SiteFooter from './SiteFooter.astro';
import DetailHeader from './DetailHeader.astro';
import TransportPlaceMap from './TransportPlaceMap.astro';
import {getOperationalDeployDate} from '../lib/operational-date';
const {beach:b}=Astro.props;
const groups=[['이용 조건',b.accessConditions],['해수욕·스노클링',b.swimming],['계절·현장 깃발',b.seasons],['방문 정보·편의시설',b.facilities]].map(([title,rows])=>({title,rows:(rows||[]).filter(r=>r.label&&r.value)})).filter(g=>g.rows.length);
const photos=(b.photos||[]).filter(p=>p.src&&p.rights&&p.sourceUrl).slice(0,3);
const faq=(b.faq||[]).filter(f=>f[0]&&f[1]);
const points=[{name:b.name,lat:b.lat,lng:b.lng,text:b.intro,url:'#beach-info'},...(b.transport||[]).filter(p=>Number.isFinite(p.lat)&&Number.isFinite(p.lng)).map(p=>({...p,text:p.instructions,url:p.detailUrl||p.directionsUrl}))];
---
<html lang="ko"><head><link rel="icon" href="/favicon.ico?v=20261013" sizes="16x16 32x32 48x48" /><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261013" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261013" /><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{b.name} ({b.english}) | ThaiLiveNow</title><meta name="description" content={b.intro}/><meta name="robots" content="noindex,nofollow"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))})}/></head><body><DetailHeader/><main id="beach-info" class="thai-detail"><a href="/ko/beaches/">도시별 해변 →</a><h1>{b.name} ({b.english})</h1>{b.thai&&<p>{b.thai}</p>}<p>{b.intro}</p>{photos.length>0&&<div class="photos">{photos.map(p=><figure><img src={p.src} alt={p.alt} loading="lazy"/><figcaption>{p.caption} · <a href={p.sourceUrl}>{p.credit||'사진 출처'}</a></figcaption></figure>)}</div>}<TransportPlaceMap points={points} title="해변과 접근 지점 지도" note="핀은 확인된 해변·시설·교통 위치예요. 수영 구역과 현장 출입 조건은 아래 안내를 확인하세요."/>{groups.map(g=><section><h2>{g.title}</h2><dl>{g.rows.map(r=><div><dt>{r.label}</dt><dd>{r.value}</dd></div>)}</dl></section>)}{b.features?.length>0&&<section><h2>해변 특징·이런 분께 추천해요</h2>{b.features.map(p=><p>{p}</p>)}</section>}{b.transport?.length>0&&<section><h2>대중교통·가는 방법·귀가</h2>{b.transport.map(p=><article><h3>{p.name}</h3><p>{p.instructions}</p>{p.walkMinutes&&<p>도보 약 {p.walkMinutes}분</p>}{p.directionsUrl&&<a href={p.directionsUrl}>경로 확인 →</a>}</article>)}</section>}{faq.length>0&&<section><h2>자주 묻는 질문</h2>{faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>}<section><h2>출처</h2>{b.sources.map(([label,url])=><p><a href={url}>{label}</a></p>)}<p>출처 확인일: {getOperationalDeployDate()} · 최근 배포일: {getOperationalDeployDate()}</p></section></main><SiteFooter/></body></html>
<style>:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,sans-serif;line-height:1.8}main{max-width:1000px;margin:auto;padding:30px 20px}a{color:#267e89}section{margin:30px 0}dl{background:white;border:1px solid #dce5e8;border-radius:12px;overflow:hidden}dl>div{display:grid;grid-template-columns:160px minmax(0,1fr);border-bottom:1px solid #dce5e8}dt,dd{margin:0;padding:14px}dt{background:#edf4f5;font-weight:700}.photos img{width:100%;border-radius:12px}figure{margin:12px 0}details,article{padding:16px;border:1px solid #dce5e8;border-radius:10px;margin:12px 0}figcaption{font-size:12px}@media(max-width:600px){dl>div{grid-template-columns:100px minmax(0,1fr)}dt,dd{padding:10px;font-size:14px}}</style>
