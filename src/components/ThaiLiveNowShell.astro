---
import DetailHeader from './DetailHeader.astro';
import SiteFooter from './SiteFooter.astro';
import CameraMapResults from './CameraMapResults.astro';
import ThailandMap from './ThailandMap.astro';
import {getUI} from '../i18n/ui';
import type {Locale} from '../i18n/locales';
const {brand='ThaiLiveNow',locale='en'}=Astro.props as {brand?:string;locale?:Locale};
const ui=getUI(locale);
---
<div class="thai-shell">
 <a class="skip-link" href="#thai-main">{ui.skip}</a>
 <DetailHeader locale={locale} brand={brand} home/>
 <main id="thai-main" class="home-main">
  <ThailandMap locale={locale}/><CameraMapResults locale={locale}/>
 </main>
 <SiteFooter locale={locale}/>
</div>
