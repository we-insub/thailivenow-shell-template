---
interface Props {
  brand?: string;
  localeLabel?: string;
}

const { brand = 'ThaiLiveNow', localeLabel = '한국어 · ไทย · English' } = Astro.props;
const sections = [
  { id: 'map', icon: '⌖', label: '지도', short: '지도' },
  { id: 'destinations', icon: '◈', label: '목적지', short: '목적지' },
  { id: 'food', icon: '♨', label: '맛집', short: '맛집' },
  { id: 'transport', icon: '⇄', label: '교통', short: '교통' },
  { id: 'cameras', icon: '◉', label: '카메라', short: '카메라' },
  { id: 'coupons', icon: '％', label: '할인쿠폰', short: '쿠폰' },
  { id: 'flights', icon: '✈', label: '항공편', short: '항공편' },
];
const cards = [
  { id: 'destinations', label: '태국의 목적지와 도시', desc: '도시, 섬, 해변, 여행 코스를 넣을 영역입니다.' },
  { id: 'food', label: '태국 맛집과 식사 지역', desc: '음식점, 야시장, 현지 메뉴를 넣을 영역입니다.' },
  { id: 'transport', label: '태국 교통과 이동', desc: '공항, 도시철도, 기차, 배 정보를 넣을 영역입니다.' },
  { id: 'cameras', label: '카메라와 날씨', desc: '실시간 카메라, 지도, 데이터 상태를 넣을 영역입니다.' },
  { id: 'coupons', label: '태국 여행 할인쿠폰', desc: '입장권, 투어, 검증된 여행 서비스를 넣을 영역입니다.' },
  { id: 'flights', label: '항공편과 공항', desc: '노선, 공항 절차, 항공편 상태를 넣을 영역입니다.' },
];
---

<div class="thai-shell">
  <a class="skip" href="#thai-main">본문으로 건너뛰기</a>
  <header class="thai-header">
    <a class="thai-brand" href="#map" aria-label={`${brand} home`}><span class="brand-mark">TL</span><span>{brand}</span><b>LIVE</b></a>
    <nav class="thai-nav" aria-label="주 메뉴">
      {sections.map((section) => <a href={`#${section.id}`}><span aria-hidden="true">{section.icon}</span><span class="nav-full">{section.label}</span><span class="nav-short">{section.short}</span></a>)}
    </nav>
    <button class="language" type="button" aria-label="Language selector">{localeLabel}⌄</button>
  </header>

  <main id="thai-main">
    <section class="thai-map" id="map" aria-labelledby="map-title">
      <aside class="map-panel">
        <div class="panel-head"><span class="eyebrow">THAILAND · LIVE TRAVEL SHELL</span><h1 id="map-title">태국을 한눈에 보는 여행 지도</h1><p>도시, 여행지, 카메라를 나중에 채울 수 있는 기본 화면입니다.</p></div>
        <label class="search"><span aria-hidden="true">⌕</span><input placeholder="도시나 장소 검색" aria-label="도시나 장소 검색" /></label>
        <label class="select-label" for="region">지역</label><select id="region"><option>태국 전체</option><option>방콕</option><option>태국 북부</option><option>태국 남부</option></select>
        <div class="empty-panel"><strong>아직 장소 데이터가 없습니다</strong><span>준비가 끝나면 도시와 여행지를 추가합니다.</span></div>
        <div class="panel-foot"><i></i> API 미연결 <span>Shell preview</span></div>
      </aside>
      <div class="map-stage" aria-label="태국 지도 자리표시자">
        <div class="map-toolbar">{['전체','방콕','해변','산악'].map((label, index) => <button class:list={[index === 0 && 'active']} type="button">{label}</button>)}</div>
        <div class="map-placeholder"><div class="map-shape">TH</div><strong>태국 지도 영역</strong><span>나중에 지도 라이브러리나 공식 지도를 연결합니다.</span></div>
        <div class="map-badge"><b>지도</b><span>이 템플릿에는 실시간 데이터가 없습니다.</span></div>
      </div>
    </section>

    <section class="shell-section" id="destinations" aria-labelledby="destinations-title">
      <div class="section-heading"><div><span class="eyebrow">EXPLORE THAILAND</span><h2 id="destinations-title">목적지에서 여행을 시작하세요</h2><p>카메라와 지역 데이터를 넣기 전, 카드와 내부 연결 구조를 확인하는 영역입니다.</p></div><a href="#destinations">전체 보기 →</a></div>
      <div class="shell-grid">{cards.slice(0, 3).map((card) => <article class="shell-card"><div class="card-placeholder" aria-hidden="true">{card.id === 'destinations' ? '01' : card.id === 'food' ? '02' : '03'}</div><div class="card-copy"><span class="card-type">{card.id}</span><h3>{card.label}</h3><p>{card.desc}</p><a href={`#${card.id}`}>템플릿 열기 →</a></div></article>)}</div>
    </section>

    <section class="shell-section tinted" id="food" aria-labelledby="food-title">
      <div class="section-heading"><div><span class="eyebrow">LOCAL GUIDES</span><h2 id="food-title">맛집, 도시, 이동 경로</h2><p>실제 출처를 확인한 뒤 각 콘텐츠 블록을 채울 수 있습니다.</p></div></div>
      <div class="shell-grid">{cards.slice(3).map((card) => <article class="shell-card compact"><div class="card-placeholder" aria-hidden="true">{card.id.toUpperCase().slice(0, 2)}</div><div class="card-copy"><span class="card-type">{card.id}</span><h3>{card.label}</h3><p>{card.desc}</p><a href={`#${card.id}`}>템플릿 열기 →</a></div></article>)}</div>
    </section>

    <section class="shell-section" id="transport" aria-labelledby="transport-title">
      <div class="split-panel"><div><span class="eyebrow">TRAVEL TOOLKIT</span><h2 id="transport-title">태국 여행에 필요한 이동 정보</h2><p>각 카드에는 나중에 공식 교통 안내, 운영시간, 요금, 지도 링크를 연결할 수 있습니다.</p></div><div class="tool-list"><div><b>01</b><span>공항에서 시내로 이동</span><small>공항 이동 안내 자리</small></div><div><b>02</b><span>도시철도·기차·배</span><small>교통 탐색 자리</small></div><div><b>03</b><span>여행 날짜별 확인</span><small>운영 상태 확인 자리</small></div></div></div>
    </section>

    <section class="shell-section" id="cameras" aria-labelledby="cameras-title">
      <div class="empty-feature"><div class="feature-icon">◉</div><div><span class="eyebrow">LIVE CAMERAS</span><h2 id="cameras-title">태국 실시간 카메라와 날씨</h2><p>카메라 목록·상세·상태·원본 링크를 넣을 수 있는 빈 상태입니다. 현재 외부 API나 카메라 데이터는 연결하지 않았습니다.</p><button type="button">카메라 전체 보기 (데이터 없음)</button></div></div>
    </section>

    <section class="shell-section" id="coupons" aria-labelledby="coupons-title">
      <div class="notice-card"><span class="eyebrow">TRAVEL DEALS</span><h2 id="coupons-title">태국 여행 할인쿠폰과 서비스</h2><p>자리만 준비된 섹션입니다. 공식 조건과 추적 링크를 확인한 뒤에만 카드와 버튼을 채웁니다.</p><div class="notice-grid"><span>입장권</span><span>투어와 액티비티</span><span>숙소와 여행 서비스</span></div></div>
    </section>

    <section class="shell-section" id="flights" aria-labelledby="flights-title">
      <div class="section-heading"><div><span class="eyebrow">AIRPORTS & FLIGHTS</span><h2 id="flights-title">항공편과 공항 안내</h2><p>항공사·노선·공항 운영 데이터가 들어갈 독립 슬롯입니다.</p></div></div>
      <div class="flight-placeholder"><div><b>방콕</b><span>BKK · DMK</span></div><div class="route-line">✈ <i></i><i></i><i></i></div><div><b>도착지</b><span>공항·노선 자리</span></div></div>
    </section>
  </main>

  <footer class="thai-footer"><div><a class="footer-brand" href="#map">{brand}</a><p>태국 여행 쉘 · 콘텐츠와 데이터는 추후 검증 후 추가</p></div><nav aria-label="푸터"><a href="#map">홈</a><a href="#transport">교통</a><a href="#coupons">쿠폰</a><a href="#flights">항공편</a><a href="#map">개인정보처리방침</a></nav><small>© 2026 {brand}</small></footer>
</div>

<style>
  :global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){margin:0;background:#fafbfc;color:#253545;font-family:"DM Sans","Noto Sans Thai",system-ui,sans-serif}:global(button),:global(input),:global(select){font:inherit}.thai-shell{--ink:#253545;--muted:#75828e;--line:#e4eaee;--red:#e84d47;--teal:#2e7c89;min-height:100vh}.skip{position:fixed;left:16px;top:-70px;z-index:20;padding:12px 16px;background:#fff;border:2px solid var(--red);color:var(--ink)}.skip:focus{top:10px}.thai-header{height:76px;display:flex;align-items:center;gap:30px;padding:0 34px;border-bottom:1px solid var(--line);background:#fff;position:sticky;top:0;z-index:10}.thai-brand{display:flex;align-items:center;gap:9px;white-space:nowrap;color:var(--ink);font-size:22px;font-weight:800;letter-spacing:-.7px}.brand-mark{display:grid;place-items:center;width:30px;height:30px;border-radius:8px;background:var(--red);color:#fff;font-size:11px;letter-spacing:0}.thai-brand b{padding:5px 6px 4px;border:1px solid #f1b8b2;border-radius:4px;background:#fff5f3;color:var(--red);font-size:9px;letter-spacing:1px}.thai-nav{display:flex;align-items:stretch;gap:24px;height:100%;margin-left:auto}.thai-nav a{display:flex;align-items:center;gap:7px;position:relative;color:#7b8993;font-size:13px;font-weight:700;white-space:nowrap}.thai-nav a:hover,.thai-nav a:focus-visible{color:var(--red)}.thai-nav a:first-child{color:var(--ink)}.thai-nav a:first-child:after{content:"";position:absolute;bottom:0;left:0;right:0;height:3px;border-radius:3px;background:var(--red)}.nav-short{display:none}.language{border:1px solid var(--line);border-radius:8px;padding:8px 10px;background:#fff;color:#5f707c;font-size:12px;white-space:nowrap}.thai-map{display:grid;grid-template-columns:355px minmax(0,1fr);height:650px;min-height:600px}.map-panel{display:flex;flex-direction:column;min-width:0;border-right:1px solid #dfe6ea;background:#fff;box-shadow:5px 0 24px #25354508}.panel-head{padding:29px 27px 21px}.eyebrow{display:block;color:var(--red);font-size:10px;font-weight:800;letter-spacing:1.8px}.panel-head h1{margin:9px 0 10px;font-size:28px;line-height:1.35;letter-spacing:-1px}.panel-head p,.section-heading p,.split-panel p,.empty-feature p,.notice-card p{color:var(--muted);font-size:13px;line-height:1.8}.search{display:flex;align-items:center;gap:9px;margin:0 23px;padding:0 12px;height:46px;border:1px solid #e5ebee;border-radius:10px;background:#f6f8f9;color:#82909a}.search:focus-within{border-color:#9bbbc4;background:#fff}.search input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:var(--ink);font-size:13px}.select-label{margin:17px 23px 5px;color:#6d7c86;font-size:11px;font-weight:700}.map-panel select{height:40px;margin:0 23px;border:1px solid var(--line);border-radius:8px;padding:0 9px;background:#fff;color:#536875;font-size:13px}.empty-panel{display:grid;gap:5px;place-items:center;align-content:center;flex:1;margin-top:20px;border-top:1px solid #eef1f3;color:#738590;text-align:center;font-size:13px}.empty-panel span{font-size:11px;color:#98a5ad}.panel-foot{display:flex;align-items:center;gap:7px;height:44px;padding:0 23px;border-top:1px solid var(--line);color:#87959e;font-size:10px}.panel-foot i{width:6px;height:6px;border-radius:50%;background:#9aaab3}.panel-foot span{margin-left:auto}.map-stage{position:relative;overflow:hidden;background:#dcecef}.map-stage:before{content:"";position:absolute;inset:0;background:linear-gradient(145deg,#d5e9eb,#eef6f5 60%,#d5e5eb)}.map-toolbar{position:absolute;top:22px;left:24px;right:24px;z-index:2;display:flex;gap:7px;overflow:auto;padding:2px 2px 9px}.map-toolbar button{padding:9px 14px;border:1px solid #d9e4e7;border-radius:24px;background:#fffffff2;color:#576e79;font-size:12px;white-space:nowrap;box-shadow:0 3px 9px #213b4910}.map-toolbar button.active{border-color:var(--ink);background:var(--ink);color:#fff}.map-placeholder{position:absolute;inset:0;display:grid;place-items:center;align-content:center;gap:9px;color:#607783;text-align:center}.map-shape{display:grid;place-items:center;width:150px;height:220px;border:2px dashed #8aadb4;border-radius:46% 54% 44% 56%/35% 38% 62% 65%;transform:rotate(18deg);color:#7fa0a7;font-size:24px;font-weight:800;letter-spacing:3px}.map-placeholder strong{font-size:16px}.map-placeholder span{font-size:12px;color:#7f969e}.map-badge{position:absolute;bottom:25px;left:24px;display:grid;gap:3px;padding:10px 13px;border-radius:9px;background:#fffffff0;box-shadow:0 4px 14px #25354514}.map-badge b{font-size:12px}.map-badge span{font-size:10px;color:#82929b}.shell-section{max-width:1240px;margin:0 auto;padding:66px 40px}.shell-section.tinted{max-width:none;background:#f2f7f8}.section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:25px;margin-bottom:25px}.section-heading h2,.split-panel h2,.empty-feature h2,.notice-card h2{margin:8px 0 0;color:var(--ink);font-size:28px;line-height:1.35;letter-spacing:-.8px}.section-heading p{margin-top:9px}.section-heading>a{color:#617984;font-size:12px;font-weight:800;white-space:nowrap}.shell-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.shell-card{overflow:hidden;border:1px solid var(--line);border-radius:14px;background:#fff}.shell-card:hover{box-shadow:0 9px 25px #213b4910;transform:translateY(-2px)}.card-placeholder{display:grid;place-items:center;height:150px;background:linear-gradient(135deg,#e6f0f1,#f7faf9);color:#7ba2aa;font-size:30px;font-weight:800;letter-spacing:2px}.card-copy{padding:20px}.card-type{color:#96a5ad;font-size:10px;letter-spacing:1.1px;text-transform:uppercase}.card-copy h3{margin:7px 0 0;font-size:18px;line-height:1.5}.card-copy p{margin:10px 0 17px;color:#758792;font-size:12px;line-height:1.75}.card-copy a{color:#2e7281;font-size:12px;font-weight:800}.split-panel{display:grid;grid-template-columns:minmax(0,1fr) minmax(380px,520px);gap:55px;align-items:start;padding:30px;border:1px solid #dce8ea;border-radius:15px;background:#f7fbfb}.tool-list{display:grid;gap:9px}.tool-list div{display:grid;grid-template-columns:32px 1fr;gap:2px 10px;padding:14px 15px;border:1px solid #d9e6e8;border-radius:9px;background:#fff}.tool-list b{grid-row:span 2;color:var(--red);font-size:12px}.tool-list span{font-size:13px;font-weight:800}.tool-list small{color:#94a2a9;font-size:10px}.empty-feature{display:flex;gap:23px;align-items:center;padding:30px;border:1px dashed #b9d1d6;border-radius:15px;background:#f7fbfb}.feature-icon{display:grid;place-items:center;flex:0 0 72px;height:72px;border-radius:18px;background:#e4f0f1;color:var(--teal);font-size:28px}.empty-feature button{margin-top:18px;padding:10px 13px;border:1px solid #b9d1d6;border-radius:8px;background:#fff;color:#2c6b7b;font-size:12px;font-weight:800}.notice-card{padding:30px;border:1px solid #e7ded7;border-radius:15px;background:#fffaf6}.notice-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:22px}.notice-grid span{padding:13px;border:1px solid #eadfd5;border-radius:8px;background:#fff;color:#7e6d61;font-size:12px}.flight-placeholder{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:26px 30px;border:1px solid #dbe7eb;border-radius:14px;background:#fff}.flight-placeholder>div{display:grid;gap:6px}.flight-placeholder b{font-size:18px}.flight-placeholder span{color:#8798a1;font-size:11px}.route-line{display:flex!important;align-items:center;gap:7px;color:var(--teal);font-size:20px!important}.route-line i{width:42px;height:1px;background:#bed2d7}.thai-footer{display:flex;align-items:center;gap:35px;padding:34px 40px;border-top:1px solid var(--line);background:#fff}.footer-brand{color:var(--ink);font-size:16px;font-weight:800}.thai-footer p{margin:7px 0 0;color:#94a1a8;font-size:11px}.thai-footer nav{display:flex;flex-wrap:wrap;gap:16px;margin-left:auto}.thai-footer nav a,.thai-footer small{color:#748691;font-size:11px}.thai-footer small{white-space:nowrap}
  @media(max-width:1050px){.thai-header{gap:14px;padding:0 18px}.thai-nav{gap:13px}.thai-nav a{font-size:11px}.nav-full{display:none}.nav-short{display:inline}.thai-map{grid-template-columns:320px minmax(0,1fr)}.shell-section{padding-inline:25px}}
  @media(max-width:760px){.thai-header{height:112px;align-content:flex-start;display:flex;flex-wrap:wrap;padding:0 12px;gap:0 10px}.thai-brand{height:60px;font-size:19px}.thai-nav{order:3;display:flex;width:calc(100% + 24px);height:51px;margin:0 -12px;padding:0 5px;gap:0;overflow:auto;border-top:1px solid var(--line)}.thai-nav a{display:flex;min-width:62px;flex:1;flex-direction:column;justify-content:center;gap:2px;text-align:center;font-size:10px}.thai-nav a:first-child:after{left:19%;right:19%}.language{margin-left:auto;font-size:10px}.thai-map{display:block;height:680px;min-height:0;position:relative}.map-stage{height:100%;width:100%}.map-panel{position:absolute;left:0;right:0;bottom:0;z-index:3;height:390px;border-top:1px solid #dce5e8;border-right:0;border-radius:20px 20px 0 0;box-shadow:0 -8px 30px #2535451c}.panel-head{padding:20px 22px 14px}.panel-head h1{font-size:23px}.search{margin-inline:18px}.select-label{margin-left:18px}.map-panel select{margin-inline:18px}.empty-panel{min-height:85px}.map-toolbar{top:13px;left:10px;right:10px}.map-badge{bottom:414px;left:12px}.shell-section{padding:43px 18px}.section-heading{align-items:flex-start;display:block;margin-bottom:20px}.section-heading>a{display:inline-block;margin-top:13px}.section-heading h2,.split-panel h2,.empty-feature h2,.notice-card h2{font-size:23px}.shell-grid{grid-template-columns:1fr;gap:14px}.card-placeholder{height:125px}.split-panel{grid-template-columns:1fr;gap:23px;padding:21px}.empty-feature{align-items:flex-start;display:block;padding:22px}.feature-icon{width:58px;height:58px;margin-bottom:18px}.notice-card{padding:22px}.notice-grid{grid-template-columns:1fr}.flight-placeholder{padding:22px 16px;gap:10px}.flight-placeholder b{font-size:14px}.route-line i{width:18px}.thai-footer{display:block;padding:28px 18px}.thai-footer nav{margin:22px 0 0;gap:11px 15px}.thai-footer small{display:block;margin-top:20px}}
</style>
