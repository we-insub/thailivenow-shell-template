---
import cnxData from '../data/airport-facilities-cnx-sentences-reviewed.json';
import dmkData from '../data/airport-facilities-dmk-reviewed.json';
import bkkData from '../data/airport-facilities-bkk-reviewed.json';
import hktData from '../data/airport-facilities-hkt-reviewed.json';
import AirportFacilityText from './AirportFacilityText.astro';
import {airportKoreanReviewEnabled} from '../lib/airport-review';
import AirportSources from './AirportSources.astro';
import ImportantText from './ImportantText.astro';
import AirportKoreanGuide from './AirportKoreanGuide.astro';
import AirportLocalizedGuide from './AirportLocalizedGuide.astro';
import {airportDepthUI} from '../lib/airport-depth';
const {code,locale='ko', reviewEnabled=airportKoreanReviewEnabled,legacyOnly=false}=Astro.props;
const data=code==='HKT'?hktData:code==='BKK'?bkkData:code==='DMK'?dmkData:cnxData;
const copyLocale=locale==='en'&&code!=='CNX'?'en-us':code==='CNX'&&locale==='ko'?'en':locale;
const copy=(data.locales as any)[copyLocale]?.content;
const review=locale==='ko'?null:(data.locales as any)[locale]?.koReview;
const enabled=['CNX','DMK','BKK','HKT'].includes(code)&&!!copy;
const showReview=reviewEnabled&&locale!=='ko';
const important=['Level 2','domestic and international arrivals','06:00–24:00','24 hours','24시간','Floor 1','1층','Door 12','12번 문','30 THB','30바트','40 THB','40바트','60 THB','60바트','1722','45 minutes','45분 전','국제선 승객','2층 7번 게이트','국제선 터미널 1층','1–5번 벨트','3층 동쪽','2층 국내선·국제선 도착장'];
const sources=code==='HKT'?hktData.sources:code==='BKK'?bkkData.sources:code==='DMK'?dmkData.sources:['https://chiangmai.airportthai.co.th/about-us','https://chiangmai.airportthai.co.th/service/transportation/detail/138','https://chiangmai.airportthai.co.th/service/transportation/detail/145','https://chiangmai.airportthai.co.th/service/transportation/detail/139','https://chiangmai.airportthai.co.th/service/airport-guide/detail/CUSS+CUBD_CNX',...((cnxData as any).sources || [])];
---
{enabled&&locale==='ko'&&<AirportKoreanGuide code={code}/>}
{enabled&&locale!=='ko'&&!legacyOnly&&<AirportLocalizedGuide code={code} locale={locale} emitSchema={locale==='en'}/> }
{enabled&&locale!=='ko'&&<details class="legacy-facilities"><summary>{airportDepthUI(locale).legacy}</summary><div class="facility-intro" data-airport-facilities data-korean-review>
 <section class="facility-heading"><h2><AirportFacilityText value={copy.title} locale={locale} showReview={showReview} phrases={important}/></h2></section>
 {copy.sections.filter((s:any)=>locale!=='ko'||s.id!=='BKK-OFFICIAL-INDOOR-MAP-LINK').map((s:any,i:number)=><section class="facility-section"><h2><AirportFacilityText value={s.title} locale={locale} showReview={showReview} phrases={important}/></h2>{s.body.map((text:string,j:number)=><p><AirportFacilityText value={text} locale={locale} showReview={showReview} phrases={important}/></p>)}{s.link?.url&&s.link?.label&&<p><a href={s.link.url} target="_blank" rel="noopener noreferrer"><AirportFacilityText value={s.link.label} locale={locale} showReview={showReview} phrases={important}/></a></p>}</section>)}
 <section class="facility-faq">{copy.faq.map((item:any,i:number)=><article><h3><AirportFacilityText value={item.q} locale={locale} showReview={showReview} phrases={important}/></h3><p><AirportFacilityText value={item.a} locale={locale} showReview={showReview} phrases={important}/></p></article>)}</section>
 <AirportSources sources={sources} locale={locale} checkedAt={data.checkedAt} idPrefix="airport-source-facility"/>
</div></details>}
<style>
.facility-intro{margin:30px 0;border-bottom:1px solid #dce5e8;padding-bottom:24px}.facility-intro section{padding:0!important;border:0!important;background:transparent!important;border-radius:0!important;margin:30px 0!important}.facility-intro h2{font-size:24px;line-height:1.5;margin:0 0 16px}.facility-intro p{line-height:1.85;margin:12px 0;color:#61717e;overflow-wrap:anywhere}.facility-intro article{background:white;border:1px solid #dce5e8;border-radius:12px;padding:20px;margin:12px 0}.facility-intro h3{font-size:19px;margin:0 0 10px}.facility-intro [lang=ko]{font-size:.92em;color:#61717e;font-weight:400}.facility-intro :global(strong){font-weight:750;color:#253545}@media(max-width:650px){.facility-intro h2{font-size:22px}.facility-intro article{padding:18px}.facility-intro h3{font-size:17px}}
</style>
