---
import {transportTagged,transportData,transportPageLocale} from '../lib/transport-localization.mjs';
const transportLocale=transportPageLocale(Astro.url.pathname);
const f=transportTagged(transportLocale);
const {route:routeSource,terminal:terminalSource}=Astro.props;
const route=transportData(routeSource,transportLocale);
const terminal=transportData(terminalSource,transportLocale);
const operatorSchedules=route.operatorSchedules||[];
const saleExamples=route.serviceExamples||[];
const operators=[...new Set(saleExamples.map(s=>s.operatorKo||s.operatorTh))];
const days=(s)=>s?.arrivalOffsetLabel?.match(/\d+/)?.[0];
---
{(operatorSchedules.length>0||saleExamples.length>0)&&<section id="route-services" class="route-services"><h2>어떤 편을 탈 수 있고 비용은 얼마인가요?</h2>{operatorSchedules.length>0&&<><h3>운영사가 게시한 출발시간</h3><div class="service-grid">{operatorSchedules.map(s=><article><h4>{s.operator}</h4><p>{s.class}</p><div class="departure-times">{s.departures.map(time=><span>{time}</span>)}</div>{s.originDepartures?.length>0&&<p><strong>{f`${f`${s.originTerminal} 원출발:`}`}</strong> {s.originDepartures.join(' · ')}<br/>이 터미널에서는 경유 탑승 시각을 예약표·창구에서 확인하세요.</p>}{s.counter&&<p><strong>발권:</strong>{' '}{s.counter}</p>}{s.fare&&<p><strong>게시 요금:</strong> {s.fare}바트{s.fareNote&&` · ${s.fareNote}`}{s.duration&&` · ${s.duration}`}</p>}{s.arrival&&<p><strong>도착:</strong> {s.arrival}</p>}<p>태국 현지 시각이에요. 여행 날짜의 운행과 좌석은 운영사에서 확인하세요.</p><a href={s.bookingUrl} target="_blank" rel="noopener noreferrer">이 운영사에서 예매하기 ↗</a> · <a href={s.sourceUrl} target="_blank" rel="noopener noreferrer">시간표 근거 ↗</a>{s.path?.length>0&&<details class="operator-path"><summary>{f`운영사 게시 정차 지점 ${s.path.length}곳`}</summary><ol>{s.path.map(stop=><li>{stop}</li>)}</ol></details>}{s.phone&&<p class="service-phones">{s.phone.map(phone=><a href={`tel:+66${phone.replace(/\D/g,'').slice(1)}`}>{phone} </a>)}</p>}</article>)}</div></>}{saleExamples.length>0&&<><h3>날짜·하차 지점별 판매편 예시</h3><p>아래는 조회된 날짜의 판매 화면을 정리한 예시이며, 시각은 태국 현지 기준이에요. 잔여 좌석이나 현재 판매를 보장하는 실시간 시간표는 아니에요. 같은 도시라도 하차 지점과 등급에 따라 요금이 달라요. 등록 노선의 경유 구간과 판매편의 실제 노선명을 대조해 표를 고르세요.</p><div class="sales-groups">{operators.map((operator,index)=><details class="sales-group" open={index===0}><summary>{f`${operator} · ${saleExamples.filter(s=>(s.operatorKo||s.operatorTh)===operator).length}개 판매편 예시`}</summary><div class="service-grid">{saleExamples.filter(s=>(s.operatorKo||s.operatorTh)===operator).map(s=><article><h4>{s.operatorKo||s.operatorTh}</h4><p>{f`${s.class} · 조회 여행일 ${s.travelDate}`}</p><p class="service-fare">{s.fareTHB}바트</p>{s.departure&&<p><strong>{f`${f`${terminal.name} 탑승:`}`}</strong> {s.departure}</p>}{!s.departure&&s.originDeparture&&<p><strong>원출발 시각:</strong> {s.originDeparture} · 이 터미널 승차 시각은 예약표에서 확인</p>}{s.arrival&&<p><strong>도착 시각:</strong> {s.arrival}{s.arrivalOffsetLabel&&` (${days(s) ? `출발 ${days(s)}일 뒤` : '다음 날짜 도착'})`}</p>}<p class="thai-stop">{s.routeNameTh&&<span><strong>판매편 노선명:</strong> {s.routeNameTh}<br/></span>}<strong>하차 지점:</strong><br/>{s.destinationKo&&<span>{s.destinationKo}<br/></span>}{s.destinationTh}</p><a href={s.sourceUrl} target="_blank" rel="noopener noreferrer">이 하차 지점·여행 날짜로 예매 조회 ↗</a></article>)}</div></details>)}</div></>}</section>}
{route.dropoffOptions?.length>0&&<section id="route-dropoffs" class="route-services"><h2>{f`${f`${route.destination} 방면, 어디에서 내릴지 고르세요`}`}</h2><p>도시 이름만 보고 예약하지 말고 아래 실제 판매 목록의 하차 지점을 숙소·선착장과 대조하세요. 목록의 순서는 경유 순서가 아니에요. 태국어 지점명을 복사해 예약표와 확인할 수 있어요.</p><div class="dropoff-list">{route.dropoffOptions.map(stop=><details><summary>{stop.labelKo&&<span>{stop.labelKo}<br/></span>}{stop.destinationTh}</summary><p>{f`${f`${terminal.name}에서 이 지점까지의 편을 조회할 수 있어요. 선택한 버스의 하차 시각과 연결 교통을 함께 확인하세요.`}`}</p><a href={stop.salesUrl} target="_blank" rel="noopener noreferrer">이 지점까지 요금·시간표 조회 ↗</a></details>)}</div></section>}
{route.routeSegments?.length>0&&<section id="route-segments" class="route-services"><h2>등록 노선의 주요 구간</h2><p class="segments">{terminal.name} → {route.routeSegments.join(' → ')}</p><p>노선명에 게시된 주요 구간이에요. 모든 중간 정류장 목록을 뜻하지 않으며, 구매한 승차권에 적힌 하차 지점을 확인하세요.</p></section>}
<style>.service-phones a{display:inline-block;margin-right:14px}.sales-group{border:1px solid #dce5e8;border-radius:10px;padding:16px;margin:12px 0;background:#f6fafb}.sales-group>summary{cursor:pointer;font-weight:700;margin-bottom:12px}.operator-path{margin-top:14px}.operator-path summary{cursor:pointer;color:#267e89;font-weight:700}.operator-path li{font-size:13px;overflow-wrap:anywhere;margin-bottom:8px}.route-services{margin:32px 0;scroll-margin-top:110px}.service-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.service-grid article{padding:20px;border:1px solid #dce5e8;border-radius:12px;background:white}.service-grid h4{margin:0;font-size:18px}.service-grid p{font-size:14px;line-height:1.8}.departure-times{display:flex;flex-wrap:wrap;gap:8px}.departure-times span{padding:5px 9px;border-radius:6px;background:#eef6f7;font-weight:700;color:#267e89}.service-fare{font-size:23px!important;font-weight:800;color:#213945}.service-grid a,.dropoff-list a{color:#267e89;font-size:13px}.thai-stop{overflow-wrap:anywhere}.segments{padding:18px;background:#eef6f7;border-radius:10px;font-weight:700;color:#267e89}.dropoff-list details{background:white;border:1px solid #dce5e8;border-radius:8px;padding:14px;margin-bottom:8px}.dropoff-list summary{cursor:pointer;font-weight:700;overflow-wrap:anywhere}@media(max-width:600px){.service-grid{grid-template-columns:1fr}}</style>
