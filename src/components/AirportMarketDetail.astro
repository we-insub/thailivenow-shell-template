---
import SiteFooter from './SiteFooter.astro';
import AirportPageMetadata from './AirportPageMetadata.astro';
import AirportKoreanReview from './AirportKoreanReview.astro';
import DetailHeader from './DetailHeader.astro';
import {airportUI} from '../i18n/airport-ui';
import {assistanceCopy,departureAirportCodes} from '../lib/airport-assistance-layout';
import {airportMarketData} from '../lib/airport-markets';
const {market,title,description}=Astro.props;
const t=airportUI[market.locale];
const copy=assistanceCopy(market.locale),base=`/${market.locale}/airport-assistance/`,path=Astro.url.pathname;
const airportCode=path.match(/\/airports\/([^/]+)\/$/)?.[1]?.toUpperCase();
const directory=path.match(/\/airlines\/[^/]+\/$/)?{url:base+'airlines/',label:copy.airlines}:airportCode?{url:base+(departureAirportCodes(airportMarketData(market.locale)).includes(airportCode)?'departure-airports/':'airports/'),label:departureAirportCodes(airportMarketData(market.locale)).includes(airportCode)?copy.departures:copy.thaiAirports}:path.match(/\/(routes|pairs)\/[^/]+\/$/)?{url:base+'flights/',label:copy.flights}:null;
---
<!doctype html><html lang={market.lang}><head><link rel="icon" href="/favicon.ico?v=20261013" sizes="16x16 32x32 48x48" /><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261013" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261013" /><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="index,follow"/><title>{title} | ThaiLiveNow</title><meta name="description" content={description}/><AirportPageMetadata title={title} description={description} locale={market.locale} lang={market.lang} parentUrl={directory?.url} parentLabel={directory?.label}/></head><body><DetailHeader locale={market.locale}/><main class="thai-detail" translate="no"><a href={directory?.url||base}>← {directory?.label||t[0]}</a><h1>{title}</h1><slot name="description">{description&&<p>{description}</p>}</slot><slot/></main><AirportKoreanReview locale={market.locale}/><SiteFooter locale={market.locale}/></body></html>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,sans-serif;line-height:1.8}header{display:flex;align-items:center;justify-content:space-between;padding:18px 28px;border-bottom:1px solid #e4eaee;background:white}main{max-width:1000px;margin:auto;padding:32px 24px 60px}h1{font-size:32px;line-height:1.4}:global(main section){margin:34px 0}:global(main a){color:#2e7c89;font-weight:700}:global(main p){color:#61717e}:global(main h2){font-size:24px}:global(main .links){display:flex;gap:18px;flex-wrap:wrap}@media(max-width:600px){main{padding:24px 16px}h1{font-size:27px}}
:global(main article){padding:20px;background:white;border:1px solid #dce5e8;border-radius:12px;margin:12px 0}:global(main details:not(.source-fold)){padding:18px 20px;background:white;border:1px solid #dce5e8;border-radius:12px;margin:12px 0}:global(main summary){cursor:pointer;font-weight:600}:global(main p){overflow-wrap:anywhere}
</style>
