---
const {points,title='주요 교통 위치 지도',note='핀은 시설 위치를 표시해요. 층별 승차장·게이트 위치는 아래 안내와 현장 표지판에서 확인하세요.'}=Astro.props;
---
<section class="place-map-section"><h2>{title}</h2><p>핀을 누르면 위치와 이어서 볼 안내를 확인할 수 있어요.</p><div class="transport-place-map" data-points={JSON.stringify(points)} aria-label={title}></div><p class="map-note">{note}</p><div class="places">{points.map(p=><article><h3>{p.name}</h3><p>{p.text}</p><a href={p.url}>이동 안내 보기 →</a></article>)}</div><small>시설 위치: <a href="https://www.openstreetmap.org/copyright">© OpenStreetMap 기여자 · ODbL</a></small></section>
<script>
import { Map } from '../scripts/resilient-map';
import {Marker,Popup,NavigationControl,LngLatBounds,setWorkerUrl} from 'maplibre-gl';
import workerUrl from 'maplibre-gl/dist/maplibre-gl-csp-worker.js?url';
import 'maplibre-gl/dist/maplibre-gl.css';
setWorkerUrl(workerUrl);
for(const el of document.querySelectorAll<HTMLElement>('.transport-place-map')){
 const points=JSON.parse(el.dataset.points!);
 const map=new Map({container:el,center:[points[0].lng,points[0].lat],zoom:11,scrollZoom:false});map.addControl(new NavigationControl());
 const bounds=new LngLatBounds();
 for(const p of points){bounds.extend([p.lng,p.lat]);const button=document.createElement('button');button.className='transport-place-pin';button.textContent=p.name;button.setAttribute('aria-label',p.name);const box=document.createElement('div');const name=document.createElement('strong');name.textContent=p.name;const text=document.createElement('p');text.textContent=p.text;const link=document.createElement('a');link.href=p.url;link.textContent='이동 안내 보기 →';box.append(name,text,link);new Marker({element:button}).setLngLat([p.lng,p.lat]).setPopup(new Popup({offset:18}).setDOMContent(box)).addTo(map);}
 map.fitBounds(bounds,{padding:70,maxZoom:13,duration:0});
}
</script>
<style>.transport-place-map{height:420px;border:1px solid #dfe7ea;border-radius:14px;overflow:hidden}.map-note,small{font-size:12px;color:#61717e}.places{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:18px 0}.places article{background:#fff;border:1px solid #dfe7ea;border-radius:12px;padding:18px}.places h3{margin:0;font-size:17px}.places p{font-size:14px}.places a{color:#267e89}:global(.transport-place-pin){border:2px solid white;border-radius:20px;background:#267e89;color:white;padding:8px 12px;box-shadow:0 2px 6px #0003;font-weight:700;cursor:pointer;max-width:160px;font-size:12px}@media(max-width:600px){.places{grid-template-columns:1fr}.transport-place-map{height:340px}}</style>
