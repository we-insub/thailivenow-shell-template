---
import LocaleAlternates from './LocaleAlternates.astro';
import {localizedVenue,localeTag} from '../lib/localized-content';
import LocaleConnections from './LocaleConnections.astro';
import RuntimeDate from './RuntimeDate.astro';
import dateObservations from '../../data/site-date-observations.json';
import SiteFooter from './SiteFooter.astro';
import DetailHeader from './DetailHeader.astro';
import RooftopMap from './RooftopMap.astro';
import {getOperationalDeployDate} from '../lib/operational-date';
const {venue:sourceVenue,locale='ko'}=Astro.props;
const v=localizedVenue(sourceVenue,locale);
const pageDates=(dateObservations.pages as any)[Astro.url.pathname]||(dateObservations.pages as any)[`/ko/rooftops/${v.id}/`];
const cityNames={'bangkok':'방콕','chiang-mai':'치앙마이','pattaya':'파타야','phuket':'푸켓','samui':'코사무이','phi-phi':'피피섬'};
const cityName=cityNames[v.city]||v.city;
const facilityName=v.facilityCategory==='viewpoint'?'전망대':'루프탑';
const has=(x)=>typeof x==='string'&&x.trim()&&!/^(미확인|미검증|정보 없음|준비 중|-)$/.test(x.trim());
const facts=Object.entries(v.facts||{}).filter(([_,value])=>has(value));
const reasons=(v.reasons||[]).filter(r=>has(r.title)&&has(r.text));
const photos=(v.photos||[]).filter(p=>has(p.src)&&has(p.alt)&&has(p.sourceUrl)&&has(p.rights)).slice(0,3);
const access=(v.access||[]).filter(a=>has(a.name)&&has(a.instructions));
const isViewpoint=v.facilityCategory==='viewpoint';const sections=[['recommended','이런 분께 추천해요',v.recommended],['best-time','방문하기 좋은 시간',v.bestTime],['seating','좌석과 분위기',v.seating],['budget','예상 지출',v.budget],['reservation',isViewpoint?'관람 예약·티켓 안내':'예약·취소 조건',v.reservation],['entrance',isViewpoint?'관람층·입장 동선':'호텔 입구와 입장 동선',v.entrance],['return','돌아가는 방법',v.returnTrip]].filter(([_,__,text])=>has(text));
const faq=(v.faq?.length?v.faq:[['이 루프탑에서는 어떤 풍경을 볼 수 있나요?',reasons[0]?.text],['영업시간은 어떻게 되나요?',v.facts.hours],['어린이와 함께 갈 수 있나요?',v.facts.children],['드레스코드가 있나요?',v.facts.dressCode],['예약은 어떻게 하나요?',v.facts.booking],['비가 와도 이용할 수 있나요?',v.facts.rain],['입장료와 최소 이용금액은 어떻게 되나요?',v.facts.minimumSpend],['호텔에 묵지 않아도 방문할 수 있나요?',v.facts.nonGuest],['예약 취소나 노쇼 시 비용이 있나요?',v.reservation]]).filter(([q,a])=>has(q)&&has(a));
const schema={'@context':'https://schema.org','@graph':[{'@type':'Article',headline:v.name+' ('+v.english+')',description:v.intro,inLanguage:localeTag(locale)},{'@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}]};
const labels={smoking:'흡연 가능 여부',smokingArea:'흡연실·흡연구역',rain:'우천 운영',address:'주소',phone:'전화',nonGuest:'비투숙객 이용',parking:'주차',children:'어린이 동반',hours:'영업시간',minimumSpend:'최소 이용금액·주문',entryFee:'입장료',dressCode:'드레스코드',dressCodeMen:'남성 옷차림',dressCodeWomen:'여성 옷차림',dressCodeAvoid:'피해야 할 복장',closed:'휴무일',booking:'입장·예약',lastOrder:'마지막 주문',lastEntry:'마지막 입장'};
---
<!doctype html><html lang={localeTag(locale)}><head><link rel="icon" href="/favicon.ico?v=20261013" sizes="16x16 32x32 48x48" /><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261013" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261013" /><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{`${v.name} (${v.english}) | ${cityName} ${facilityName} 방문 정보 | ThaiLiveNow`}</title><meta name="description" content={v.intro}/><script type="application/ld+json" set:html={JSON.stringify(schema)}/><LocaleAlternates/></head><body><DetailHeader locale={locale}/><main class="thai-detail"><nav><a href="/ko/rooftops/">루프탑·전망대</a> › <a href={`/ko/rooftops/cities/${v.city}/`}>{cityName}</a> › {v.name}</nav><h1>{v.name} ({v.english})</h1><p class="location">{facilityName} · {v.building}</p><p class="intro">{v.intro}</p>{photos.length>0&&<section class="gallery" aria-label={`${facilityName} 사진`}>{photos.map((p,i)=><figure><img src={p.src} alt={p.alt} loading={i===0?"eager":"lazy"}/><figcaption>{p.caption||p.alt} · <a href={p.sourceUrl} target="_blank" rel="noopener noreferrer">{p.credit||"사진 출처"}</a>{p.licenseUrl&&<> · <a href={p.licenseUrl} target="_blank" rel="noopener noreferrer">{p.rights}</a></>}{p.changes&&<> · {p.changes}</>}</figcaption></figure>)}</section>}<RooftopMap locale={locale} venues={[v]} access={access} initialCity={v.city} detail={true}/>{access.length>0&&<section id="access"><h2>가까운 대중교통·가는 방법</h2>{access.map(a=><article><h3>{a.name}{a.english&&a.english!==a.name&&` (${a.english})`}</h3>{a.line&&<p>{a.line}{a.exit&&` · ${a.exit}`}</p>}<p>{a.instructions}</p>{(a.walkMinutes||a.distance)&&<p>{a.walkMinutes&&`도보 약 ${a.walkMinutes}분`}{a.distance&&` · ${a.distance}`}</p>}{a.detailUrl&&<a href={a.detailUrl}>역·선착장 상세 →</a>}{a.directionsUrl&&<p><a href={a.directionsUrl} target="_blank" rel="noopener noreferrer">실제 경로 길찾기 ↗</a></p>}</article>)}</section>}{v.taxi&&<section class="taxi-card"><h2>택시·Grab·Bolt로 방문하기</h2><p>{v.taxi.instructions}</p><article><h3>기사님께 보여주세요</h3><p lang="en">{v.taxi.english}</p><p lang="th">{v.taxi.thai}</p><p>{v.taxi.destination}</p></article></section>}{facts.length>0&&<section id="facts"><h2>방문 전 기본 정보</h2><dl>{facts.map(([key,value])=><div><dt>{labels[key]}</dt><dd>{['hours','children','closed','minimumSpend','entryFee'].includes(key)?<strong>{value}</strong>:value}{key==='booking'&&has(v.bookingUrl)&&<p><a href={v.bookingUrl} target="_blank" rel="noopener noreferrer">공식 홈페이지 연결 예약 ↗</a></p>}</dd></div>)}</dl></section>}{reasons.length>0&&<section id="experience"><h2>{v.facilityCategory==='viewpoint'?'이곳에서 만날 풍경과 경험':'이곳에서 보낼 시간을 상상해보세요'}</h2>{reasons.map(r=><article><h3>{r.title}</h3><p>{r.text}</p></article>)}</section>}{has(v.menu)&&<section><h2>메뉴와 음료</h2><p>{v.menu}</p></section>}{has(v.signature)&&<section><h2>시그니처 메뉴</h2><p>{v.signature}</p></section>}{sections.map(([id,title,text])=><section id={id}><h2>{title}</h2><p>{text}</p></section>)}{faq.length>0&&<section id="faq"><h2>자주 묻는 질문</h2>{faq.map(([q,a])=><article><h3>{q}</h3><p>{a}</p></article>)}</section>}<section><h2>이어서 살펴보기</h2><a href="/ko/rooftops/">도시별 루프탑·전망대 지도·목록 →</a>{locale==='ko'&&v.city==='bangkok'&&<><br/><a href="/ko/transport/bangkok/">방콕 철도·역 지도 →</a></>}<LocaleConnections locale={locale} areaId={v.city} exclude="rooftops" heading={false}/></section><section class="sources" id="sources"><details><summary>공식 출처 보기 · {v.sources.length+1}개</summary>{v.sources.map(([label,url])=><p><a href={url} target="_blank" rel="noopener noreferrer">{label} ↗</a></p>)}<p><a href={v.locationSource}>시설 좌표 출처 ↗</a></p></details><p>출처 확인일: <RuntimeDate kind="source" locale={locale} fallback={pageDates?.sourceCheckedOn}/><br/>최근 수정일: <RuntimeDate kind="modified" locale={locale} fallback={pageDates?.contentModifiedOn}/><br/>최근 배포일: <RuntimeDate kind="deployment" locale={locale} fallback={getOperationalDeployDate()}/></p></section></main><SiteFooter locale={locale}/></body></html>
<style>.toc{display:flex;flex-wrap:wrap;gap:10px;padding:16px;background:#eef4f5;border-radius:12px}.toc a{font-size:14px}.gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.gallery figure{margin:0}.gallery figure:first-child{grid-column:1/-1}.gallery img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:12px}.gallery figcaption{font-size:12px;color:#61717e}section{scroll-margin-top:110px}@media(max-width:600px){.gallery{grid-template-columns:1fr}}:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,"Apple SD Gothic Neo",sans-serif;line-height:1.8}:global(*){box-sizing:border-box}main{max-width:1000px;margin:auto;padding:32px 24px 60px}nav,.location{font-size:14px;color:#61717e}h1{font-size:32px}.intro{font-size:18px}section{margin-top:34px}h2{font-size:24px}h3{font-size:19px;margin:0}dl{background:white;border:1px solid #dce5e8;border-radius:12px;overflow:hidden}dl>div{display:grid;grid-template-columns:160px minmax(0,1fr);border-bottom:1px solid #e7edef}dl>div:last-child{border:0}dt{background:#eff5f6;font-weight:700}dt,dd{padding:14px 18px;margin:0}article{padding:20px;background:white;border:1px solid #dce5e8;border-radius:12px;margin:12px 0}article p{margin-bottom:0}a{color:#267e89;text-decoration:none}.sources{font-size:13px}dd{overflow-wrap:anywhere}dd p{margin:8px 0 0}.taxi-card article{background:#eef4f5}.taxi-card [lang]{font-size:18px;overflow-wrap:anywhere}@media(max-width:600px){main{padding:24px 16px}h1{font-size:27px}.intro{font-size:16px}dl>div{grid-template-columns:110px minmax(0,1fr)}dt,dd{padding:12px;font-size:14px}}
</style>
