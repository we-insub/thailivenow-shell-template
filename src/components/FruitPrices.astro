---
import foodBase from '../data/food.json';
import koPack from '../data/food-localized/ko.json';
import FoodMarks from './FoodMarks.astro';
import {fmt} from '../lib/food-text.mjs';
const {fruitId,city,compact=false,locale='ko',ui=koPack.ui,data=foodBase}=Astro.props;
const rows=data.fruitPrices.filter(p=>(!fruitId||p.fruit===fruitId)&&(!city||p.city===city));
const amount=n=>Number.isInteger(n)?String(n):n.toFixed(2);
---
{rows.length>0&&<div class="fruit-price-block"><p class="fruit-price-context"><strong>{ui.prices.title}</strong><br/>{ui.prices.intro}</p><div class="fruit-price-scroll" tabindex="0" role="region" aria-label={ui.prices.ariaLabel}><table class="fruit-price-table"><caption>{ui.prices.caption}</caption><thead><tr><th scope="col">{ui.prices.colFruit}</th><th scope="col">{ui.prices.colPrice}</th><th scope="col">{ui.prices.colUnit}</th></tr></thead><tbody>{rows.map(p=><tr><th scope="row"><a href={`/${locale}/food/fruits/${p.fruit}/`}>{p.label}</a></th><td>{fmt(ui.prices.range,{min:amount(p.min),max:amount(p.max)})}</td><td>{ui.prices.unit[p.unit==='송이'?'bunch':p.unit]}</td></tr>)}</tbody></table></div><p class="fruit-price-context"><FoodMarks text={ui.prices.note}/></p></div>}
<style>.fruit-price-context{font-size:14px;line-height:1.85;color:#627068}.fruit-price-scroll{overflow-x:auto;border:1px solid #dce5de;border-radius:12px;background:#fff}.fruit-price-table{border-collapse:collapse;width:100%;min-width:0;font-size:14px}.fruit-price-table caption{text-align:left;padding:15px;font-weight:650;color:#405b49}.fruit-price-table th,.fruit-price-table td{text-align:left;padding:14px 16px;border-top:1px solid #e1e9e3;vertical-align:top}.fruit-price-table thead{background:#eef4ef}.fruit-price-table tbody th{font-weight:500}.fruit-price-table td:nth-child(2),.fruit-price-table td:nth-child(3){white-space:nowrap}</style>
