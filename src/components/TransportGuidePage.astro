---
import RuntimeDate from './RuntimeDate.astro';
import observations from '../../data/site-date-observations.json';
import SiteFooter from './SiteFooter.astro';
import DetailHeader from './DetailHeader.astro';
import TransportPlaceMap from './TransportPlaceMap.astro';
import {getOperationalDeployDate} from '../lib/operational-date';
const {guide,points=[],mapTitle="방콕의 두 공항 위치와 이동 안내",mapNote=undefined}=Astro.props;
const airDates=observations.pages['/ko/transport/guides/air/'];
const schema={'@context':'https://schema.org','@graph':[{'@type':'Article',headline:guide.title,inLanguage:'ko',description:guide.intro},{'@type':'FAQPage',mainEntity:guide.faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}]};
---
<!doctype html><html lang="ko"><head><link rel="icon" href="/favicon.ico?v=20261013" sizes="16x16 32x32 48x48" /><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261013" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261013" /><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{guide.title} | ThaiLiveNow</title><meta name="description" content={guide.intro}/><meta name="robots" content="noindex,nofollow"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body><DetailHeader/><main class:list={["thai-detail", {"domestic-air-guide":guide.id==='air',"food-delivery-guide":['food-delivery','grabfood','line-man','shopeefood','robinhood'].includes(guide.id)}]}><nav aria-label="경로"><a href="/ko/">홈</a> › <a href={guide.parentUrl || "/ko/transport/"}>{guide.parentName || "태국 교통"}</a> › {guide.name}</nav><header><span>{guide.eyebrow || "THAILAND TRANSPORT"}</span><h1>{guide.name} <small>({guide.english})</small></h1><p class="intro">{guide.intro}</p></header><slot name="before-map"/>{points.length>0&&<TransportPlaceMap points={points} title={mapTitle} note={mapNote}/>}<slot name="after-map"/><section><h2>{guide.summaryTitle || "이용 방법 한눈에 비교하기"}</h2><div class="summary">{guide.summary.map(([name,place,how,fare])=><article><h3>{name}</h3><dl><dt>{guide.summaryLabels?.[0] || "타는 곳"}</dt><dd>{place}</dd><dt>{guide.summaryLabels?.[1] || "탑승"}</dt><dd>{how}</dd><dt>{guide.summaryLabels?.[2] || "요금"}</dt><dd>{fare}</dd></dl></article>)}</div></section>{guide.sections.map(s=><section id={s.id}><h2>{s.title}</h2>{s.paragraphs?.map(text=><p>{text}</p>)}{s.links&&<div class="related">{s.links.map(([label,url])=><a href={url} target={url.startsWith('http') ? "_blank" : undefined} rel={url.startsWith('http') ? "noopener noreferrer" : undefined}>{label} {url.startsWith('http') ? '↗' : '→'}</a>)}</div>}{s.steps&&<ol class="steps">{s.steps.map(([title,text])=><li><h3>{title}</h3><p>{text}</p></li>)}</ol>}</section>)}<section id="faq"><h2>자주 묻는 질문</h2>{guide.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section><section><h2>다음 이동도 함께 준비해 보세요</h2><div class="related">{guide.links.map(([label,url])=><a href={url}>{label} →</a>)}</div></section><section class="sources"><h2>출처</h2><details class="source-fold"><summary>공식 출처 보기 · {guide.sources.length}개</summary><ul>{guide.sources.map(([label,url])=><li><a href={url} target={url.startsWith('http') ? "_blank" : undefined} rel={url.startsWith('http') ? "noopener noreferrer" : undefined}>{label} {url.startsWith('http') ? '↗' : '→'}</a></li>)}</ul></details>{guide.id==='air'?<p>출처 확인일: <RuntimeDate kind="source" fallback={airDates.sourceCheckedOn} locale="ko" unknown="미확인"/><br/>최근 수정일: <RuntimeDate kind="modified" fallback={airDates.contentModifiedOn} locale="ko"/><br/>최근 배포일: <RuntimeDate kind="deployment" fallback={getOperationalDeployDate()} locale="ko"/></p>:<p>출처 확인일: {getOperationalDeployDate()}<br/>최근 배포일: {getOperationalDeployDate()}</p>}</section></main><SiteFooter/></body></html>
<style>:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,"Apple SD Gothic Neo",sans-serif;line-height:1.8}:global(*){box-sizing:border-box}main{max-width:1040px;margin:auto;padding:32px 28px 70px}a{color:#267e89;text-decoration:none}nav[aria-label="경로"]{font-size:13px;color:#61717e}header{margin:26px 0}header>span{letter-spacing:2px;font-size:11px;font-weight:800;color:#e54c47}h1{font-size:34px;line-height:1.4;margin:12px 0}h1 small{font-size:18px;color:#61717e}.intro{font-size:18px;max-width:850px}.toc{display:flex;flex-wrap:wrap;gap:10px;padding:18px;background:#eef4f5;border-radius:12px}.toc a{font-size:13px}section{margin-top:38px;scroll-margin-top:110px}h2{font-size:24px;line-height:1.5}h3{font-size:18px;line-height:1.6;margin:0 0 8px}.summary{display:grid;grid-template-columns:1fr 1fr;gap:16px}.summary article{padding:22px;background:white;border:1px solid #dde6ea;border-radius:14px}dl{display:grid;grid-template-columns:60px minmax(0,1fr);gap:12px;margin:0;font-size:14px}dt{font-weight:700;color:#61717e}dd{margin:0}.steps{list-style:none;counter-reset:step;padding:0;display:grid;gap:12px}.steps li{counter-increment:step;padding:20px 22px 20px 64px;background:white;border:1px solid #dde6ea;border-radius:12px;position:relative}.steps li:before{content:counter(step);position:absolute;left:20px;top:24px;border-radius:50%;background:#267e89;color:white;display:grid;place-items:center;width:28px;height:28px}.steps p{margin:0}details{padding:16px 20px;border:1px solid #dde6ea;border-radius:10px;margin-bottom:10px;background:white}summary{font-weight:700;cursor:pointer}.related{display:flex;flex-wrap:wrap;gap:12px}.related a{background:white;border:1px solid #dde6ea;border-radius:10px;padding:12px 16px}.sources{font-size:13px;border-top:1px solid #dde6ea;padding-top:16px}@media(max-width:600px){main{padding:24px 16px 50px}h1{font-size:27px}h1 small{display:block;font-size:16px}.intro{font-size:16px}.summary{grid-template-columns:1fr}h2{font-size:22px}.toc{display:grid;gap:8px}}</style>

<style>
/* The shared detail list rule uses !important and reduces padding-left to 4px.
   Reserve badge space on the domestic-flight and food-delivery guides. */
.thai-detail:is(.domestic-air-guide,.food-delivery-guide) .steps > li {
  padding-left: 68px !important;
  margin-block: 0 !important;
}
@media (max-width: 799px) {
  .thai-detail:is(.domestic-air-guide,.food-delivery-guide) .steps > li { padding-left: 58px !important; }
  .thai-detail:is(.domestic-air-guide,.food-delivery-guide) .steps > li::before { left: 16px; }
}
</style>
