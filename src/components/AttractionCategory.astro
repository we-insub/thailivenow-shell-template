---
import LocaleAlternates from './LocaleAlternates.astro';
import {attractionUI,attractionTag,localizedAttractions,localizedAttractionCategories,attractionCategoryUrl} from '../lib/attractions-localized';
import DetailHeader from './DetailHeader.astro';
import SiteFooter from './SiteFooter.astro';
import AttractionPhoto from './AttractionPhoto.astro';


const {category:c,locale='ko'}=Astro.props;
const u=attractionUI(locale),places=localizedAttractions(locale),attractionCategories=localizedAttractionCategories(locale);
const categoryUrl=id=>attractionCategoryUrl(id,locale);
const marketTitles={en:`${c.name} in Thailand | Sights and visitor information`, 'en-us':`Thailand ${c.name.toLowerCase()} | Highlights and visitor information`, 'en-gb':`${c.name} to visit in Thailand | Practical information`, 'en-in':`Visiting ${c.name.toLowerCase()} in Thailand | Planning your visit`};
const title=(marketTitles[locale]||`${c.name} | ${u.attractions}`)+' | ThaiLiveNow';
const countryHeading=locale.startsWith('en')?`${c.name} in Thailand`:({ko:`태국 ${c.name}`,ja:`タイの${c.name}`,'zh-cn':`泰国${c.name}`,'zh-tw':`泰國${c.name}`,ms:`${c.name} di Thailand`,es:`${c.name} en Tailandia`,ru:`${c.name} в Таиланде`})[locale];
const listed=places.filter(p=>p.category===c.id&&p.indexing!=='noindex'&&p.catalogListing!=='reference');
const references=places.filter(p=>p.category===c.id&&p.indexing!=='noindex'&&p.catalogListing==='reference');
const cities=[...new Set(listed.map(p=>p.cityName))].sort((a,b)=>a.localeCompare(b,locale));
const url='https://thailivenow.com'+categoryUrl(c.id);
const description=locale==='ko'?`태국 ${c.name} ${listed.length+references.length}곳을 지역별로 찾아보세요. ${c.text}`:c.text;
const schema={'@context':'https://schema.org','@type':'CollectionPage',name:countryHeading,description,url,inLanguage:attractionTag(locale),hasPart:{'@type':'ItemList',itemListElement:[...listed,...references].map((p,i)=>({'@type':'ListItem',position:i+1,name:p.name,url:`https://thailivenow.com/${locale}/attractions/${p.id}/`}))}};
---
<!doctype html><html lang={attractionTag(locale)}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="icon" href="/favicon.svg"/><title>{locale==='ko'?`태국 ${c.name} | 지역별 볼거리·방문 정보 | ThaiLiveNow`:title}</title><meta name="description" content={description}/><LocaleAlternates/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body><DetailHeader locale={locale}/><main class="attraction-category">
<nav class="breadcrumbs" aria-label={u.location}><a href={`/${locale}/attractions/`}>{u.attractions}</a> › <span>{c.name}</span></nav>
<header><p class="eyebrow">{u.attractions}</p><h1>{countryHeading}</h1><p class="intro">{c.text}</p></header>
<nav class="category-nav" aria-label={u.categoryNav}>{attractionCategories.map(other=><a href={categoryUrl(other.id)} aria-current={other.id===c.id?'page':undefined}>{other.name}</a>)}</nav>
<section aria-labelledby="catalog-heading"><h2 id="catalog-heading">{u.choose}</h2><div class="catalog-filters"><label>{u.search}<input type="search" data-place-search placeholder={u.searchPlaceholder}/></label><label>{u.region}<select data-place-city><option value="">{u.allRegions}</option>{cities.map(city=><option value={city}>{city}</option>)}</select></label></div><p class="catalog-count" role="status" data-place-count data-count-label={u.places}>{listed.length} · {c.name}</p>
<div class="place-grid">{listed.map((p,i)=><article class="place-card" data-place-card data-city={p.cityName} data-search={`${p.name} ${p.english} ${p.thai||''} ${p.cityName} ${p.type}`}>
{p.photos?.[0]&&<AttractionPhoto locale={locale} photo={p.photos[0]} href={`/${locale}/attractions/${p.id}/`} eager={i<2}/>}
<div class="place-body"><p class="place-city">{p.cityName} · {p.type}</p><h3><a href={`/${locale}/attractions/${p.id}/`}>{p.name}</a></h3><p class="place-names"><span lang="en">{p.english}</span><span lang="th">{p.thai}</span></p><p class="place-summary">{p.intro[0]}</p><a class="place-detail-link" href={`/${locale}/attractions/${p.id}/`}>{u.viewDetail} →</a></div></article>)}</div><p data-no-places hidden>{u.noResults}</p></section>
{references.length>0&&<section aria-labelledby="reference-heading"><h2 id="reference-heading">{u.reference}</h2><div class="reference-links">{references.map(p=><a href={`/${locale}/attractions/${p.id}/`}>{p.name} · {p.english} →</a>)}</div></section>}
<p class="back-link"><a href={`/${locale}/attractions/`}>← {u.back}</a></p>
</main><SiteFooter locale={locale}/></body></html>
<script>
const search=document.querySelector<HTMLInputElement>('[data-place-search]');const city=document.querySelector<HTMLSelectElement>('[data-place-city]');
function filterPlaces(){const query=(search?.value||'').trim().toLocaleLowerCase();let count=0;for(const card of document.querySelectorAll<HTMLElement>('[data-place-card]')){const match=(!city?.value||card.dataset.city===city.value)&&(!query||(card.dataset.search||'').toLocaleLowerCase().includes(query));card.hidden=!match;if(match)count++;}const status=document.querySelector('[data-place-count]');if(status)status.textContent=`${count} ${((status as HTMLElement).dataset.countLabel||'')}`;const empty=document.querySelector<HTMLElement>('[data-no-places]');if(empty)empty.hidden=count>0;}
search?.addEventListener('input',filterPlaces);city?.addEventListener('change',filterPlaces);
</script>
<style>
.attraction-category{max-width:1120px;padding:40px 28px 72px;margin:auto;color:#203743;line-height:1.8;word-break:keep-all;overflow-wrap:anywhere}.breadcrumbs{font-size:14px;color:#61717e;margin-bottom:30px}.eyebrow{font-size:14px;color:#267e89;font-weight:700}.attraction-category h1{font-size:clamp(32px,4vw,46px);line-height:1.4;letter-spacing:-.03em;margin:12px 0 24px}.intro{font-size:20px;color:#526572;max-width:820px}.category-nav{display:flex;flex-wrap:wrap;gap:10px;margin:30px 0 48px}.category-nav a{padding:9px 16px;min-height:44px;border:1px solid #c9d9e0;border-radius:30px;background:white;text-decoration:none;display:flex;align-items:center;color:#267e89}.category-nav a[aria-current]{background:#267e89;color:white}.catalog-filters{display:grid;grid-template-columns:2fr 1fr;gap:20px;padding:24px;border:1px solid #c9d9e0;border-radius:16px;background:#edf5f4}.catalog-filters label{display:flex;flex-direction:column;gap:8px;font-size:15px;font-weight:600;min-width:0}.catalog-filters input,.catalog-filters select{min-width:0;width:100%;padding:12px;border:1px solid #c9d9e0;border-radius:8px;background:white;font:400 16px/1.5 system-ui;color:#203743;min-height:46px}.catalog-count{color:#61717e;font-size:15px;margin:16px 0 30px}.place-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.place-card{min-width:0;display:flex;flex-direction:column;border:1px solid #dce5e8;border-radius:16px;background:white;overflow:hidden}.place-card :global(.attraction-photo){margin:0}.place-card :global(img){border-radius:0}.place-card :global(figcaption){padding:0 20px}.place-body{padding:24px;display:flex;flex-direction:column;flex:1}.place-city{font-size:14px;color:#267e89;margin:0 0 12px}.place-body h3{font-size:24px;line-height:1.5;margin:0 0 8px}.place-body h3 a{color:inherit;text-decoration:none}.place-names{font-size:14px;color:#61717e;line-height:1.7;margin:0 0 20px;overflow-wrap:anywhere}.place-names span{display:block}.place-summary{font-size:17px;line-height:1.85;margin:0 0 24px;flex:1}.place-detail-link{display:flex;align-items:center;border-top:1px solid #e3ebee;padding-top:16px;min-height:44px;font-weight:600}.attraction-category a{color:#267e89;text-underline-offset:4px}.place-card[hidden]{display:none!important}.reference-links{display:grid;gap:14px}.reference-links a{display:flex;align-items:center;min-height:44px}.back-link{margin-top:40px}.attraction-category :is(a,input,select):focus-visible{outline:3px solid #66a7cd;outline-offset:4px}@media(max-width:680px){.attraction-category{padding:28px 18px 48px}.intro{font-size:18px}.catalog-filters{grid-template-columns:1fr;padding:20px}.place-grid{grid-template-columns:1fr;gap:20px}.place-body{padding:22px}.category-nav{gap:8px;margin-bottom:36px}.category-nav a{font-size:14px;padding:8px 12px}}
</style>
