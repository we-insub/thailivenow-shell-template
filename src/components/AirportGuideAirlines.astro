---
import {airportMarketData} from '../lib/airport-markets';
import {airportUI} from '../i18n/airport-ui';
const {locale='ko',guide}=Astro.props;
const data=airportMarketData(locale);
const incidentIds=['damaged-baggage','delayed-baggage','flight-delayed','flight-cancelled','insurance-claim','find-airline-counter','caat-passenger-rights'];
const show=incidentIds.includes(guide.id);
const carrierIds=new Set(data.routes.map((route:any)=>route.airlineId));
const airlines=data.airlines.filter((airline:any)=>carrierIds.has(airline.id));
const related=(airlineId:string)=>data.guides.filter((item:any)=>item.id!==guide.id&&item.airlineIds?.includes(airlineId)&&(
  /baggage/.test(guide.id)?/baggage/.test(item.id):
  /flight-delayed|flight-cancelled|insurance-claim|caat-passenger-rights/.test(guide.id)?/certificate|confirmation|disruption|flight-evidence|redress/.test(item.id):false
));
---
{show&&airlines.length>0&&<section aria-label={airportUI[locale][6]}>
  <h2>{airportUI[locale][6]}</h2>
  <ul>{airlines.map((airline:any)=><li>
    <a href={`/${locale}/airport-assistance/airlines/${airline.id}/`}>{airline.name} →</a>
    {related(airline.id).length>0&&<ul>{related(airline.id).map((item:any)=><li><a href={`/${locale}/airport-assistance/guides/${item.id}/`}>{item.title} →</a></li>)}</ul>}
  </li>)}</ul>
</section>}
<style>ul{padding-left:1.3rem}li{margin:.65rem 0}li ul{margin-top:.3rem}</style>
