---
import DetailHeader from './DetailHeader.astro';
import SiteFooter from './SiteFooter.astro';
import ImportantText from './ImportantText.astro';
import data from '../data/travel-seasons-ko.json';
import {getOperationalDeployDate} from '../lib/operational-date';
const {region,seasonGuide=false}=Astro.props;
const hub=!region&&!seasonGuide;
const title=hub?'태국 여행하기 좋은 시기 · 지역별 월별 날씨':seasonGuide?'태국 우기·건기 여행 안내':`${region.name} 여행하기 좋은 시기`;
const description=hub?'태국 여행은 몇 월에 가면 좋을까요? 방콕부터 코사무이까지 6개 지역의 월별 기온과 강수량을 비교하고, 더위와 비를 피해 관광하는 방법과 해변 여행 준비를 알아보세요.':seasonGuide?'태국 북부·중부, 안다만해, 코사무이의 계절 차이를 살펴보고 비 오는 날 일정과 해변·보트 여행 준비를 알아보세요.':`${region.name}의 1월부터 12월까지 평균기온·최고·최저기온·강수량·비 오는 날을 살펴보고 월별 장점과 주의할 점으로 여행 일정을 준비하세요.`;
const intro=hub?'태국 여행을 준비하고 계신가요? 방콕에서 사원과 시장을 둘러볼 계획이라면 비가 적고 더위가 덜한 시기를, 해변에서 쉬고 싶다면 가려는 해안의 우기와 건기를 먼저 알아보세요. 푸껫과 코사무이는 비가 많이 오는 시기가 달라서 같은 달이라도 어느 곳으로 떠나는지에 따라 준비가 달라져요. 아래에서 여행할 지역과 달을 골라 날씨와 추천 일정을 살펴보실 수 있어요.':seasonGuide?'우기라고 여행 내내 비가 오는 것은 아니지만, 비가 언제 얼마나 내릴지는 날짜마다 달라요. 야외 일정 사이에 식사와 실내 휴식을 넣고, 바다 여행은 비뿐 아니라 바람과 파도까지 살펴보세요. 같은 태국이라도 푸껫과 코사무이는 비가 많은 시기가 다르답니다.':region.intro;
const plain=(s:string)=>s.replaceAll('**','');const phrases=(s:string)=>[...s.matchAll(/\*\*(.+?)\*\*/g)].map(m=>m[1]);
const faq=region?[[`${region.name} 여행은 언제 가면 좋을까요?`,region.bestAnswer],['평균기온만 보면 옷차림을 정할 수 있나요?','평균 최고·최저기온도 함께 보세요. 평균기온은 하루 중 어느 시각의 기온을 뜻하지 않아요. 한낮에 걸을 시간과 아침·밤에 나갈 시간을 나눠 준비하면 좋아요.'],['비 오는 날 수만큼 하루 종일 비가 오나요?','그렇지는 않아요. 비 오는 날 수는 월별 평균이고, 비가 내리는 시간이나 지속 시간을 뜻하지 않아요. 실제 여행일의 시간대별 예보를 보고 야외 일정을 바꿔주세요.']]:[['태국은 어느 곳이나 같은 달에 우기인가요?','아니요. 북부·중부와 안다만해, 남부 동쪽 해안은 비가 많은 시기가 달라요. 푸껫·끄라비와 코사무이 중 어디로 갈지 고민 중이라면, 여행할 달에 어느 쪽에 비가 더 적게 오는지 비교해보세요.'],['우기 여행은 피해야 하나요?','꼭 피할 필요는 없어요. 비가 많이 오는 시간에는 식사하거나 실내에서 쉬고, 비가 잦아들면 가까운 곳을 둘러보세요. 야외 관광은 날씨에 따라 시간을 바꿀 수 있도록 준비하시면 좋아요. 다만 물놀이와 보트·섬 투어는 당일 날씨와 현장 안내에 따라 취소하거나 변경해야 할 수 있으니, 예약할 때 취소·변경 조건을 함께 살펴보세요.'],['표에 나온 날씨가 올해의 예보인가요?','아니요. 표에 나오는 수치는 1991–2020년 동안 관측한 날씨를 평균 낸 값이에요. 여행하기 좋은 달을 고를 때 참고할 수 있지만, 여행 당일의 날씨를 알려주지는 않아요. 출발 전에는 태국 기상청에서 여행 날짜의 실제 예보를 확인해주세요.']];
const sources=[['태국 기상청 · 1991–2020 기후평년값 (관측소별 월별 표)',data.source],['태국 기상청 · 태국의 기후와 계절','https://www5.tmd.go.th/info/ภูมิอากาศของประเทศไทย'],['태국 관광청 · 9월 안다만해와 태국만 여행','https://www.tourismthailand.org/Articles/thailand-september'],['태국 기상청 · 현재 예보','https://www.tmd.go.th/en/']];
const schema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<!doctype html><html lang="ko"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="icon" href="/favicon.svg"/><title>{title} | ThaiLiveNow</title><meta name="description" content={description}/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body><DetailHeader/><main>
<nav aria-label="현재 위치"><a href="/ko/destinations/">태국 여행</a> › {hub?'태국 여행 시기':<><a href="/ko/travel-seasons/">태국 여행 시기</a> › {title}</>}</nav>
<header><span class="kicker">WHEN TO VISIT THAILAND</span><h1>{title}</h1><p class="intro"><ImportantText text={plain(intro)} phrases={phrases(intro)}/></p></header>
{hub&&<><section class="picker"><h2>어느 달, 어디로 떠나시나요?</h2><div class="controls"><label>여행할 지역<select id="season-region">{data.regions.map(r=><option value={r.id}>{r.name}</option>)}</select></label><label>여행하는 달<select id="season-month">{Array.from({length:12},(_,i)=><option value={i+1}>{i+1}월</option>)}</select></label></div><div aria-live="polite" id="season-result">{data.regions.flatMap(r=>r.months.map(m=><article data-climate-region={r.id} data-climate-month={m.month} hidden={r.id!=='bangkok'||m.month!==1}><h3>{r.name} · {m.month}월 <span class="badge">{m.season}</span></h3><div class="metrics"><div><small>평균기온</small><strong>{m.mean.toFixed(1)}°C</strong></div><div><small>평균 최고 / 최저</small><strong>{m.high.toFixed(1)} / {m.low.toFixed(1)}°C</strong></div><div><small>월 강수량</small><strong>{m.rain.toFixed(1)}mm</strong></div><div><small>비 오는 날</small><strong>{m.rainDays.toFixed(1)}일</strong></div></div><p><strong>이달의 장점</strong><br/>{m.advantage}</p><p><strong>주의할 점</strong><br/>{m.caution}</p><a href={`/ko/travel-seasons/${r.id}/`}>{r.name} 12개월 날씨와 여행 안내 →</a></article>))}</div><p class="note">날씨 수치는 1991–2020년 관측자료를 평균 낸 값이에요. 어느 달에 더 덥고 비가 많은지 비교할 때 참고하시고, 출발 전에는 실제 여행 날짜의 예보를 따로 확인해주세요.</p></section>
<section><h2>여행하기 좋은 시기를 지역별로 살펴보세요</h2><div class="region-grid">{data.regions.map(r=><a class="region-card" href={`/ko/travel-seasons/${r.id}/`}><h3>{r.name}</h3><strong>{r.best}</strong><p>{r.cardSummary}</p><span>월별 기온·장점·주의점 →</span></a>)}</div></section>
<section><h2>우기와 건기, 일정은 어떻게 달라질까요?</h2><p>건기에는 우기보다 비 걱정을 덜고 사원이나 시장을 걸어 다니기 좋아요. 다만 <strong>건기에도 한낮에는 더울 수 있으니, 야외 관광은 아침이나 해 질 무렵에</strong> 즐기시길 추천해요. 낮에는 쇼핑몰을 둘러보거나 카페와 숙소에서 쉬어가시면 더위를 피해 여행하실 수 있겠죠.</p><p>우기에 떠나신다면 야외에서만 보내는 하루보다는 관광 중간에 식사와 실내 휴식을 함께 넣어보세요. 비가 많이 내릴 때는 가까운 실내에서 기다렸다가 비가 잦아들면 다시 나가시면 돼요. <strong>해변에서 물놀이를 하거나 배를 탈 계획이라면 비 예보뿐 아니라 바람과 파도 예보도 함께 확인해주세요.</strong> 바다에서는 현장의 수영 금지 안내와 운항사의 안내를 따라야 해요.</p><a class="action" href="/ko/travel-seasons/rainy-dry/">지역별 우기·건기와 준비물 알아보기 →</a></section></>}
{region&&<><section><h2>{region.name} 월별 평균기온과 비</h2><p>아래 수치는 <strong>{data.period}년 기후평년값</strong>이에요. 관측소는 {region.station}이며, 해변·산·숙소의 실제 날씨와 차이가 날 수 있어요. 표는 옆으로 밀어서 볼 수 있어요.</p><div class="table-scroll" tabindex="0" role="region" aria-label={`${region.name} 월별 기후표, 가로 스크롤`}><table><caption>월별 평균기온·평균 최고·최저기온·강수량·비 오는 날</caption><thead><tr>{['월','평균기온','평균 최고','평균 최저','강수량','비 오는 날'].map(t=><th scope="col">{t}</th>)}</tr></thead><tbody>{region.months.map(m=><tr><th scope="row">{m.month}월</th><td>{m.mean.toFixed(1)}°C</td><td>{m.high.toFixed(1)}°C</td><td>{m.low.toFixed(1)}°C</td><td>{m.rain.toFixed(1)}mm</td><td>{m.rainDays.toFixed(1)}일</td></tr>)}</tbody></table></div><p class="note">PDF {region.pdfPage}쪽의 관측소 표를 사용했어요. 비 오는 날 수는 평균값이며 하루 종일 비가 내린다는 뜻은 아니에요.</p></section>
<section><h2>월별로 어떤 여행을 즐기면 좋을까요?</h2><p>장점과 주의점은 기후자료를 바탕으로 제안하는 일정 안내예요. 당일 날씨와 해상 활동 운영 여부는 출발 전에 따로 살펴보세요.</p><div class="month-grid">{region.months.map(m=><article><h3>{m.month}월 <span class="badge">{m.season}</span></h3><p><strong>이달의 장점</strong><br/>{m.advantage}</p><p><strong>주의할 점</strong><br/>{m.caution}</p></article>)}</div></section>
<section><h2>하루 일정을 이렇게 나눠보세요</h2><p>{region.outdoor}은 아침이나 해 질 무렵에 넣어보세요. 한낮에는 식사와 휴식을 잡아두면 더운 시간에 오래 걷지 않아도 돼요. 비가 오는 날에는 {region.indoor}으로 바꿔보실 수 있어요.</p><p>{region.pattern==='north'?'겨울철 아침·밤 외출에는 얇은 겉옷을 챙겨주세요. 산으로 올라가는 일정은 시내 기온과 다를 수 있으니 목적지 예보도 함께 보세요.':region.pattern==='andaman'||region.pattern==='gulf'?'바다에 들어가기 전에는 해변 깃발과 현장 수영 금지 안내를 따르세요. 섬 투어와 보트 이동은 운항사의 당일 안내를 보고, 취소·변경 조건을 예약 전에 읽어두면 좋아요.':'가벼운 옷과 모자, 우산을 챙기고 야외 이동 사이에 그늘이나 실내에서 쉬어가세요. 갑자기 비가 오면 먼 곳으로 옮기기보다 가까운 실내 장소에서 기다리는 일정도 준비해두세요.'}</p></section></>}
{seasonGuide&&<><section><h2>북부·중부: 선선한 건기, 더운 시기, 우기</h2><p>태국 대부분 지역은 대체로 <strong>5월 중순–10월 중순 우기</strong>, <strong>10월 중순–2월 중순 겨울철</strong>, <strong>2월 중순–5월 중순 여름철</strong>로 나눠요. 실제 계절 시작일은 해마다 달라요. 방콕은 겨울철에도 낮에 덥고, 치앙마이는 아침·밤 기온이 더 내려가므로 같은 옷차림으로 생각하지 않는 게 좋아요.</p></section><section><h2>푸껫·끄라비와 코사무이는 따로 비교하세요</h2><p>안다만해 쪽 푸껫·끄라비는 남서 몬순 시기에 비가 늘어요. 반면 남부 동쪽 해안의 코사무이는 북동 몬순의 영향을 받아 <strong>연말 쪽 강수량이 많아요.</strong> 같은 달에 바다 여행을 가더라도 목적지를 바꾸면 날씨 조건이 달라질 수 있답니다.</p><p>기후평년값에서 푸껫은 9월 강수량이 350.4mm, 코사무이는 11월 444.6mm예요. 각 지역의 12개월 표를 비교한 뒤 실제 여행일 예보와 보트 운항을 함께 살펴보세요.</p></section><section><h2>비가 오는 날에도 여행을 즐기려면</h2><ol><li>여행할 도시의 예보를 보고 야외 일정과 실내 일정을 하루 안에 함께 넣어요.</li><li>젖은 우산과 옷을 넣을 봉투, 휴대전화와 서류를 보호할 방수 주머니를 챙겨요.</li><li>보트·섬 투어는 예약할 때 취소와 날짜 변경 조건을 읽어둬요.</li><li>현장 수영 금지와 운항 중단 안내가 나오면 실내 일정으로 바꿔요.</li></ol></section></>}
<section><h2>자주 묻는 질문</h2>{faq.map(([q,a])=><article class="faq"><h3>{q}</h3><p>{a}</p></article>)}</section>
<section><h2>이어서 여행을 준비해보세요</h2><div class="related">{data.regions.filter(r=>r.id!==region?.id).map(r=><a href={`/ko/travel-seasons/${r.id}/`}>{r.name} 여행 시기 →</a>)}{!seasonGuide&&<a href="/ko/travel-seasons/rainy-dry/">우기·건기 준비 →</a>}<a href="/ko/entry/">태국 입국 준비 →</a><a href="/ko/destinations/">여행 목적지 고르기 →</a><a href="https://www.tmd.go.th/en/" target="_blank" rel="noopener noreferrer">태국 기상청 현재 예보 ↗</a></div></section>
<section class="sources"><p>출처 확인일: {getOperationalDeployDate()}<br/>최근 배포일: {getOperationalDeployDate()}</p><details><summary>공식 출처 보기 · {sources.length}개</summary><ul>{sources.map(([label,url])=><li><a href={url} target="_blank" rel="noopener noreferrer">{label} ↗</a></li>)}</ul></details></section>
</main><SiteFooter/></body></html>
<script>
const regionSelect=document.querySelector<HTMLSelectElement>('#season-region');const monthSelect=document.querySelector<HTMLSelectElement>('#season-month');
function update(){document.querySelectorAll<HTMLElement>('[data-climate-region]').forEach(el=>{el.hidden=el.dataset.climateRegion!==regionSelect?.value||el.dataset.climateMonth!==monthSelect?.value;});}
regionSelect?.addEventListener('change',update);monthSelect?.addEventListener('change',update);
</script>
<style>
