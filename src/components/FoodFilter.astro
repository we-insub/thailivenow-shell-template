---
import koPack from '../data/food-localized/ko.json';
import {fmt} from '../lib/food-text.mjs';
const {type='city',options=[],count=0,ui=koPack.ui}=Astro.props;
const countTemplate=type==='city'?ui.filter.cityCount:ui.filter.dishCount;
---
<form class="food-filter" data-food-filter={type} data-count-template={countTemplate} hidden><label for={`food-filter-${type}`}>{type==='city'?ui.filter.city:ui.filter.dish}</label><select id={`food-filter-${type}`} name={type==='city'?'region':'category'}><option value="all">{ui.filter.all}</option>{options.map(([value,label])=><option value={value}>{label}</option>)}</select><button type="reset">{ui.filter.reset}</button><span class="food-filter-status" role="status" aria-live="polite">{fmt(countTemplate,{n:count})}</span></form>
<script>
function initFoodFilters(){document.querySelectorAll<HTMLFormElement>('[data-food-filter]').forEach(form=>{if(form.dataset.ready)return;form.dataset.ready='true';const select=form.querySelector<HTMLSelectElement>('select');if(!select)return;const type=form.dataset.foodFilter;const items=[...document.querySelectorAll<HTMLElement>(`[data-food-item="${type}"]`)];const status=form.querySelector<HTMLElement>('[role="status"]');const params=new URLSearchParams(location.search);const requested=params.get(select.name);if(requested&&[...select.options].some(o=>o.value===requested))select.value=requested;const apply=(write=false)=>{let visible=0;items.forEach(item=>{item.hidden=select.value!=='all'&&item.dataset.filterValue!==select.value;if(!item.hidden)visible++});if(status)status.textContent=(form.dataset.countTemplate||'{n}').replace('{n}',String(visible));if(write){const url=new URL(location.href);if(select.value==='all')url.searchParams.delete(select.name);else url.searchParams.set(select.name,select.value);history.replaceState(null,'',url)}};select.addEventListener('change',()=>apply(true));form.addEventListener('reset',event=>{event.preventDefault();select.value='all';apply(true)});form.addEventListener('submit',event=>event.preventDefault());window.addEventListener('popstate',()=>{const value=new URLSearchParams(location.search).get(select.name)||'all';select.value=[...select.options].some(o=>o.value===value)?value:'all';apply()});form.hidden=false;apply()})}initFoodFilters();document.addEventListener('astro:page-load',initFoodFilters);
</script>
