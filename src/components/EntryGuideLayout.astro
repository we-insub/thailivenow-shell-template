---
import RuntimeDate from './RuntimeDate.astro';
import dateObservations from '../../data/site-date-observations.json';
import LocaleAlternates from './LocaleAlternates.astro';
import {getLocalizedPack,localeTag} from '../lib/localized-content';
import DetailHeader from './DetailHeader.astro';
import SiteFooter from './SiteFooter.astro';
import ImportantText from './ImportantText.astro';
import {getOperationalDeployDate} from '../lib/operational-date';
import koreanGuides from '../data/entry-guides-ko.json';
const {guide:g,locale='ko'}=Astro.props;
const guides=locale==='ko'?koreanGuides:getLocalizedPack(locale).travel.entry;
const pageDates=(dateObservations.pages as any)[Astro.url.pathname];
const plain=(text:string)=>text.replaceAll('**','');
const phrases=(text:string)=>[...text.matchAll(/\*\*(.+?)\*\*/g)].map(m=>m[1]);
const url=`https://thailivenow.com/${locale}/entry/${g.id==='entry'?'':g.id+'/'}`;
const schema={'@context':'https://schema.org','@graph':[{'@type':'Article','@id':url+'#article',headline:g.title,description:g.description,inLanguage:localeTag(locale),mainEntityOfPage:url,publisher:{'@type':'Organization',name:'ThaiLiveNow',url:'https://thailivenow.com'},about:{'@type':'Thing',name:g.title},citation:g.sources.map((s:any)=>s[1])},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'태국 여행',item:`https://thailivenow.com/${locale}/destinations/`},{'@type':'ListItem',position:2,name:'태국 입국',item:`https://thailivenow.com/${locale}/entry/`},...(g.id==='entry'?[]:[{'@type':'ListItem',position:3,name:g.title,item:url}])]},{'@type':'FAQPage',mainEntity:g.faq.map((f:any)=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:plain(f.a)}}))}]};
---
<!doctype html><html lang={localeTag(locale)}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="icon" href="/favicon.svg"/><title>{g.title} | ThaiLiveNow</title><meta name="description" content={g.description}/><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')}/><LocaleAlternates/></head><body><DetailHeader locale={locale} activeHref={`/${locale}/destinations/`}/><main class="thai-detail entry-detail"><nav aria-label="현재 위치"><a href="/ko/destinations/">태국 여행</a> › {g.id==='entry'?'태국 입국':<><a href="/ko/entry/">태국 입국</a> › {g.title}</>}</nav><header class="entry-heading"><span class="entry-kicker">THAILAND ENTRY GUIDE</span><h1>{g.title}</h1><p class="intro">{g.intro}</p></header>
{g.id==='entry'&&<section class="entry-guide-links" aria-label="태국 입국 상세 가이드">{guides.filter(v=>v.id!=='entry').map(v=><a href={`/ko/entry/${v.id}/`}><strong>{v.id==='tdac'?'TDAC 작성 방법':v.id==='visa'?'태국 비자 종류':'태국 관광비자'}</strong><span>{v.id==='tdac'?'모바일 화면으로 작성·저장·수정하기':v.id==='visa'?'방문 목적에 맞는 비자 구분하기':'단수·복수 조건과 신청 서류'} →</span></a>)}</section>}
{g.facts.length>0&&<section><h2>먼저 알아두면 좋은 기본 정보</h2><dl>{g.facts.map(([key,value]:string[])=><div><dt>{key}</dt><dd>{value}</dd></div>)}</dl>{g.id==='tdac'&&<a class="entry-action" href="https://tdac.immigration.go.th/" target="_blank" rel="noopener noreferrer">TDAC 공식 사이트에서 작성하기 ↗</a>}</section>}
{g.sections.map((s:any)=><section id={s.id}><h2>{s.title}</h2>{s.paragraphs.filter((p:string,i:number)=>!s.paragraphAudiences||s.paragraphAudiences[i]===g.market).map((p:string)=><p><ImportantText text={plain(p)} phrases={phrases(p)}/></p>)}{s.image&&<figure class="mobile-capture"><a href={`/images/entry/${s.image}`} target="_blank" rel="noopener noreferrer" aria-label={`${s.caption} 이미지 크게 보기`}><img src={`/images/entry/${s.image}`} alt={s.caption} width="390" loading="lazy"/></a><figcaption>{s.caption}<br/>모바일 화면 · 2026-10-14 캡처 · <a href={s.imageSourceUrl || "https://tdac.immigration.go.th/"} target="_blank" rel="noopener noreferrer">{s.imageCredit || "태국 이민국 공식 TDAC 화면"}</a> · 화면 저작권: Immigration Bureau. {s.imageNote || "안내용 캡처이며 실제 개인정보는 입력하지 않았어요."}</figcaption></figure>}{s.image2&&<figure class="mobile-capture"><a href={`/images/entry/${s.image2}`} target="_blank" rel="noopener noreferrer" aria-label={`${s.caption2} 이미지 크게 보기`}><img src={`/images/entry/${s.image2}`} alt={s.caption2} width="390" loading="lazy"/></a><figcaption>{s.caption2}<br/>모바일 화면 · 2026-10-14 캡처 · <a href="https://tdac.immigration.go.th/" target="_blank" rel="noopener noreferrer">태국 이민국 공식 TDAC 화면</a> · 화면 저작권: Immigration Bureau.</figcaption></figure>}{s.fields&&<dl>{s.fields.map(([key,value]:string[])=><div><dt>{key}</dt><dd>{value}</dd></div>)}</dl>}</section>)}
<section class="entry-faq"><h2>자주 묻는 질문</h2>{g.faq.map((f:any)=><article><h3>{f.q}</h3><p><ImportantText text={plain(f.a)} phrases={phrases(f.a)}/></p></article>)}</section>
<section><h2>이어서 여행을 준비해보세요</h2><div class="entry-related">{guides.filter(v=>v.id!==g.id).map(v=><a href={`/ko/entry/${v.id==='entry'?'':v.id+'/'}`}>{v.id==='entry'?'태국 입국 준비':v.id==='tdac'?'TDAC 모바일 작성 방법':v.id==='visa'?'태국 비자 종류':'태국 관광비자 조건'} →</a>)}<a href="/ko/airport-assistance/">태국 도착 공항·항공편 안내 →</a><a href="/ko/transport/airports/suvarnabhumi-to-bangkok/">수완나폼공항에서 방콕 시내로 →</a><a href="/ko/destinations/">태국 여행 목적지 고르기 →</a></div></section>
<section class="entry-sources"><p>출처 확인일: <RuntimeDate kind="source" locale={locale} fallback={pageDates?.sourceCheckedOn}/><br/>최근 수정일: <RuntimeDate kind="modified" locale={locale} fallback={pageDates?.contentModifiedOn}/><br/>최근 배포일: <RuntimeDate kind="deployment" locale={locale} fallback={getOperationalDeployDate()}/></p><details class="source-fold"><summary>공식 출처 보기 · {g.sources.length}개</summary><ul>{g.sources.map(([label,href]:string[])=><li><a href={href} target="_blank" rel="noopener noreferrer">{label} ↗</a></li>)}</ul></details></section></main><SiteFooter locale={locale}/></body></html>
<style>
:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,"Apple SD Gothic Neo",sans-serif;line-height:1.8}:global(*){box-sizing:border-box}main{max-width:1000px;margin:auto;padding:36px 24px 72px}nav{font-size:14px;color:#61717e;margin-bottom:24px}a{color:#267e89;text-decoration:none}a:hover{text-decoration:underline}a:focus-visible,summary:focus-visible{outline:3px solid #66a7cd;outline-offset:4px}.entry-kicker{font-size:12px;letter-spacing:2px;color:#ed504d;font-weight:700}h1{font-size:34px;line-height:1.45;margin:12px 0 22px}.intro{font-size:19px;line-height:1.95}section{margin-top:42px;scroll-margin-top:140px}h2{font-size:25px;line-height:1.5;margin:0 0 18px}h3{font-size:19px;line-height:1.6;margin:0}p{font-size:18px;line-height:1.95;color:#526572;margin:14px 0}strong{color:#253545}dl{background:white;border:1px solid #dce5e8;border-radius:12px;overflow:hidden;margin:20px 0}dl>div{display:grid;grid-template-columns:220px minmax(0,1fr);border-bottom:1px solid #e7edef}dl>div:last-child{border-bottom:0}dt{background:#eff5f6;font-weight:700}dt,dd{margin:0;padding:15px 18px;font-size:16px;overflow-wrap:anywhere}.mobile-capture{margin:26px 0}.mobile-capture img{display:block;width:100%;max-width:390px;height:auto;border:1px solid #dce5e8;border-radius:12px}.mobile-capture figcaption{font-size:12px;line-height:1.8;color:#61717e;margin-top:12px;max-width:580px}.entry-faq article{padding:22px;background:white;border:1px solid #dce5e8;border-radius:12px;margin:14px 0}.entry-faq article p{margin-bottom:0}.entry-guide-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.entry-guide-links a{border:1px solid #dce5e8;background:white;padding:20px;border-radius:12px}.entry-guide-links span{display:block;font-size:14px;margin-top:10px;color:#61717e}.entry-related{display:flex;flex-wrap:wrap;gap:18px}.entry-action{display:inline-block;padding:12px 18px;border:1px solid #267e89;border-radius:10px;font-weight:700}.entry-sources p,.entry-sources a{font-size:13px}.source-fold{border:1px solid #dce5e8;border-radius:12px;background:white;padding:16px 20px}.source-fold summary{cursor:pointer;font-weight:700}.source-fold li{margin:10px 0;overflow-wrap:anywhere}@media(max-width:600px){main{padding:26px 18px 48px}h1{font-size:28px}h2{font-size:23px}.intro,p{font-size:17px}section{margin-top:34px}dl>div{grid-template-columns:1fr}dt,dd{padding:12px 15px;font-size:15px}.entry-guide-links{grid-template-columns:1fr}.entry-related{display:grid;gap:14px}}
</style>
