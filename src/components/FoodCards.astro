---
import food from '../data/food.json';
import FoodPhoto from './FoodPhoto.astro';
const {ids,filterable=false}=Astro.props;
const dishes=ids.map(id=>food.dishes.find(d=>d.id===id)).filter(Boolean);
const categoryNames={noodles:'밥·면',soup:'국·커리',side:'반찬·구이',dessert:'디저트',drinks:'음료'};
---
<div class="food-grid">{dishes.map(d=><article class="food-card" data-food-item={filterable?'dish':undefined} data-filter-value={d.category}><FoodPhoto dish={d} variant="card"/><span class="food-card-meta">{d.scope} · {categoryNames[d.category]}</span><h3><a href={`/ko/food/dishes/${d.id}/`}>{d.name}</a></h3><span class="food-card-name" lang="en">{d.english}</span><p>{d.flavor}</p><a class="food-card-link" href={`/ko/food/dishes/${d.id}/`}>{d.name} 맛·먹는 방법 →</a></article>)}</div>
