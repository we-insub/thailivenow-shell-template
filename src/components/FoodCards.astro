---
import foodBase from '../data/food.json';
import koPack from '../data/food-localized/ko.json';
import {fmt} from '../lib/food-text.mjs';
import FoodPhoto from './FoodPhoto.astro';
const {ids,filterable=false,locale='ko',ui=koPack.ui,data=foodBase}=Astro.props;
const dishes=ids.map(id=>data.dishes.find(d=>d.id===id)).filter(Boolean);
---
<div class="food-grid">{dishes.map(d=><article class="food-card" data-food-item={filterable?'dish':undefined} data-filter-value={d.category}><FoodPhoto dish={d} variant="card" ui={ui}/><span class="food-card-meta">{d.scope} · {ui.categories[d.category]}</span><h3><a href={`/${locale}/food/dishes/${d.id}/`}>{d.name}</a></h3><span class="food-card-name" lang="en">{d.english}</span><p>{d.flavor}</p><a class="food-card-link" href={`/${locale}/food/dishes/${d.id}/`}>{fmt(ui.cards.dishLink,{name:d.name})}</a></article>)}</div>
