---
import {transportData,transportText,transportFormat,transportPageLocale} from '../lib/transport-localization.mjs';
import SiteFooter from './SiteFooter.astro';
import DetailHeader from './DetailHeader.astro';
import {getOperationalDeployDate} from '../lib/operational-date';
const transportLocale=transportPageLocale(Astro.url.pathname);
const {guide:guideSource}=Astro.props;
const guide=transportData(guideSource,transportLocale);
const faq=guide.tabs.flatMap(tab=>tab.faq);
const schema={'@context':'https://schema.org','@graph':[{'@type':'Article',headline:guide.title,inLanguage:'ko',description:guide.intro},{'@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}]};
---
<!doctype html>
<html lang="ko"><head><link rel="icon" href="/favicon.ico?v=20261013" sizes="16x16 32x32 48x48" /><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261013" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261013" /><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{guide.title} | ThaiLiveNow</title><meta name="description" content={guide.intro}/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head>
<body><DetailHeader/><main class="thai-detail">
  <nav class="crumb" aria-label="경로"><a href="/ko/">홈</a><span>›</span><a href="/ko/transport/">태국 교통</a><span>›</span><span>{guide.name}</span></nav>
  <header class="page-heading"><span class="eyebrow">THAILAND TAXI GUIDE</span><h1>{guide.name}<small>{guide.english}</small></h1><p class="intro">{guide.intro}</p></header>
  <div class="taxi-guide" data-taxi-guide>
    <div class="tab-bar" role="tablist" aria-label="택시 이용 상황">
      {guide.tabs.map((tab,i)=><button type="button" role="tab" id={`tab-${tab.id}`} aria-controls={tab.id} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-taxi-tab={tab.id}><span>{tab.id==='airport'?'01':'02'}</span>{tab.label}<small>{tab.id==='airport'?'승차층 · 예약 · 톨비':'미터 · 바가지 · 카드 · 팁'}</small></button>)}
    </div>
    <noscript><p class="no-js">공항 택시와 도심 택시 안내가 아래에 차례대로 표시돼요.</p></noscript>
    {guide.tabs.map(tab=><div id={tab.id} role="tabpanel" aria-labelledby={`tab-${tab.id}`} tabindex="0" data-taxi-panel>
      <header class="panel-heading"><span class="eyebrow">{tab.english}</span><h2>{tab.title}</h2><p>{tab.intro}</p></header>
      <div class="highlights">{tab.highlights.map(([label,text])=><article><h3>{label}</h3><p>{text}</p></article>)}</div>
      
      <div class="detail-sections">{tab.sections.map(section=><section id={section.id}>
        <h2>{section.title}</h2>
        {section.swatches&&<div class="taxi-colors" aria-label="일반 택시 색상 예시">{section.swatches.map(([label,top,bottom])=><div><span class="car" style={`--car-top:${top};--car-bottom:${bottom}`} aria-hidden="true"><svg viewBox="0 0 110 60"><rect x="47" y="2" width="23" height="8" rx="2" fill="#fff"/><text x="58.5" y="8" text-anchor="middle" font-size="5" font-weight="700" fill="#253545">TAXI</text><path d="M23 31L34 13H72L87 31Z" fill="var(--car-top)"/><path d="M38 16H52V29H30ZM57 16H70L80 29H57Z" fill="#e8f4f7"/><rect x="8" y="30" width="95" height="21" rx="7" fill="var(--car-bottom)"/><circle cx="29" cy="49" r="9" fill="#253545"/><circle cx="82" cy="49" r="9" fill="#253545"/><circle cx="29" cy="49" r="4" fill="#e0e5e8"/><circle cx="82" cy="49" r="4" fill="#e0e5e8"/></svg></span><strong>{label}</strong></div>)}</div>}
        {section.paragraphs?.map(text=><p>{text}</p>)}
        {section.steps&&<ol class="steps">{section.steps.map(([title,text])=><li><h3>{title}</h3><p>{text}</p></li>)}</ol>}
        {section.table&&<div class="table-wrap"><table><thead><tr>{section.table.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{section.table.rows.map(row=><tr>{row.map((cell,i)=><td data-label={section.table.headers[i]}>{cell}</td>)}</tr>)}</tbody></table></div>}
        {section.callout&&<aside class="callout"><p>{section.callout}</p></aside>}
        {section.phrases&&<dl class="phrases">{section.phrases.map(([ko,en])=><div><dt>{ko}</dt><dd lang="en">{en}</dd></div>)}</dl>}
        {section.links&&<div class="links">{section.links.map(([label,url])=><a href={url} target={url.startsWith('http')?'_blank':undefined} rel={url.startsWith('http')?'noopener noreferrer':undefined}>{label}<span aria-hidden="true">{url.startsWith('http')?'↗':'→'}</span></a>)}</div>}
      </section>)}</div>
      <section id={`${tab.id}-faq`} class="faq"><h2>자주 묻는 질문</h2>{tab.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
      <section class="sources"><h2>출처·공식 안내</h2><details class="source-fold"><summary>공식 출처 보기 · {tab.sources.length}개</summary><ul>{tab.sources.map(([label,url])=><li><a href={url} target="_blank" rel="noopener noreferrer">{label} ↗</a></li>)}</ul></details><p>승차 위치·차종·결제수단은 실제 예약 화면과 현장 안내를 함께 확인하세요.</p></section>
    </div>)}
  </div>
  <section class="related"><h2>관련 이동 안내</h2><div class="links">{guide.links.map(([label,url])=><a href={url}>{label}<span aria-hidden="true">→</span></a>)}</div></section>
  <footer class="dates"><p>출처 확인일: {getOperationalDeployDate()}<br/>최근 배포일: {getOperationalDeployDate()}</p></footer>
</main><SiteFooter/></body></html>
<script>
const guide=document.querySelector<HTMLElement>('[data-taxi-guide]');
if(guide){
 const tabs=Array.from(guide.querySelectorAll<HTMLButtonElement>('[data-taxi-tab]'));
 const panels=Array.from(guide.querySelectorAll<HTMLElement>('[data-taxi-panel]'));
 const select=(id:string)=>{
  tabs.forEach(tab=>{const active=tab.dataset.taxiTab===id;tab.setAttribute('aria-selected',String(active));tab.tabIndex=active?0:-1;});
  panels.forEach(panel=>panel.hidden=panel.id!==id);
 };
 const syncHash=()=>{
  let id:string;try{id=decodeURIComponent(location.hash.slice(1));}catch{return;}
  const target=id?document.getElementById(id):null;
  const panel=target?.closest<HTMLElement>('[data-taxi-panel]');
  if(panel){select(panel.id);if(target!==panel)requestAnimationFrame(()=>target?.scrollIntoView({block:'start'}));}
  else if(!id)select('airport');
 };
 tabs.forEach((tab,index)=>{
  tab.addEventListener('click',()=>{select(tab.dataset.taxiTab!);history.replaceState(null,'',`#${tab.dataset.taxiTab}`);guide.scrollIntoView({block:'start'});});
  tab.addEventListener('keydown',event=>{
   let next:number;
   if(event.key==='ArrowRight')next=(index+1)%tabs.length;
   else if(event.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;
   else if(event.key==='Home')next=0;
   else if(event.key==='End')next=tabs.length-1;
   else return;
   event.preventDefault();tabs[next].focus();tabs[next].click();
  });
 });
 select('airport');syncHash();window.addEventListener('hashchange',syncHash);
}
</script>
<style>
:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,"Apple SD Gothic Neo",sans-serif;line-height:1.8}:global(*){box-sizing:border-box}main{max-width:1040px;padding:32px 28px 70px;margin:auto}a{color:#267e89;text-decoration:none}a:hover{text-decoration:underline}.crumb{display:flex;gap:9px;flex-wrap:wrap;font-size:13px;color:#61717e}.page-heading{margin:28px 0}.eyebrow{font-size:11px;letter-spacing:2px;font-weight:800;color:#267e89}h1{font-size:36px;line-height:1.4;margin:10px 0}h1 small{font-size:16px;color:#61717e;font-weight:500;display:block;margin-top:8px}.intro{font-size:18px;max-width:800px}.taxi-guide{scroll-margin-top:110px}.tab-bar{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:8px;background:#eaf0f2;border-radius:18px;margin:28px 0}.tab-bar button{cursor:pointer;font:inherit;font-size:19px;font-weight:800;line-height:1.4;text-align:left;border:1px solid transparent;border-radius:12px;padding:20px 24px;background:transparent;color:#61717e}.tab-bar button>span{display:inline-flex;margin-right:10px;font-size:12px;vertical-align:middle}.tab-bar small{display:block;font-size:12px;font-weight:500;margin-top:8px}.tab-bar [aria-selected=true]{background:#253545;color:white;box-shadow:0 4px 12px #25354515}.tab-bar button:focus-visible{outline:3px solid #267e89;outline-offset:3px}[data-taxi-panel][hidden]{display:none}[data-taxi-panel]{scroll-margin-top:115px}[data-taxi-panel]:focus{outline:none}.panel-heading{padding:26px 30px;background:#edf5f5;border-radius:16px}.panel-heading h2{font-size:28px;margin:7px 0}.panel-heading p{margin:10px 0 0;max-width:800px}.highlights{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:18px 0}.highlights article{border:1px solid #dde6ea;border-radius:12px;background:white;padding:18px 20px}.highlights h3{font-size:17px;margin:0}.highlights p{font-size:13px;color:#61717e;margin:5px 0 0}.toc{display:flex;gap:8px 18px;flex-wrap:wrap;border-bottom:1px solid #dde6ea;padding:20px 0;font-size:13px}.detail-sections section,.faq,.sources,.related{margin-top:42px;scroll-margin-top:115px}h2{font-size:24px;line-height:1.5}h3{font-size:17px;line-height:1.6}.detail-sections section>p{max-width:880px}.steps{list-style:none;counter-reset:step;padding:0;display:grid;gap:12px}.steps li{counter-increment:step;position:relative;padding:20px 22px 20px 64px;background:#fff;border:1px solid #dde6ea;border-radius:12px}.steps li:before{content:counter(step);position:absolute;left:20px;top:24px;border-radius:50%;background:#267e89;color:#fff;width:28px;height:28px;display:grid;place-items:center}.steps h3{margin:0 0 7px}.steps p{margin:0;font-size:15px}.table-wrap{overflow:auto;border:1px solid #dde6ea;border-radius:12px;margin:20px 0}table{border-collapse:collapse;width:100%;font-size:14px;background:white}th,td{padding:15px 18px;text-align:left;vertical-align:top;border-bottom:1px solid #e5ebee}th{background:#edf3f5;font-weight:700}tbody tr:last-child td{border-bottom:0}td:first-child{font-weight:650;width:24%}.callout{padding:16px 20px;border-left:3px solid #267e89;background:#edf5f5;border-radius:0 10px 10px 0;font-size:14px;margin:22px 0}.callout p{margin:0}.links{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}.links a{display:flex;gap:12px;align-items:center;border:1px solid #d9e4e8;border-radius:10px;padding:12px 16px;background:#fff;font-size:14px}.links a span{margin-left:auto}.taxi-colors{display:flex;gap:12px;margin:20px 0}.taxi-colors>div{flex:1;max-width:200px;padding:18px 20px;background:#fff;border:1px solid #dde6ea;border-radius:12px;text-align:center}.car{display:block;max-width:110px;margin:auto}.car svg{display:block;width:100%}.taxi-colors strong{font-size:13px}.phrases{display:grid;grid-template-columns:1fr 1fr;gap:12px}.phrases>div{padding:18px 20px;background:white;border:1px solid #dde6ea;border-radius:12px}.phrases dt{font-size:14px;font-weight:700}.phrases dd{margin:7px 0 0;font-size:17px;color:#267e89}details{padding:16px 20px;border:1px solid #dde6ea;border-radius:10px;background:#fff;margin-bottom:10px}summary{cursor:pointer;font-weight:700}details p{margin-bottom:0}.sources{border-top:1px solid #dde6ea;padding-top:15px;font-size:13px}.sources h2{font-size:18px}.sources li{margin:6px 0}.dates{border-top:1px solid #dde6ea;margin-top:32px;font-size:13px;color:#61717e}.no-js{font-size:14px}
@media(max-width:600px){main{padding:24px 16px 50px}h1{font-size:28px}.intro{font-size:16px}.tab-bar{gap:6px;padding:6px;position:sticky;top:calc(var(--site-header-height,114px) + 12px);z-index:2}.tab-bar button{padding:14px 12px;font-size:16px}.tab-bar button>span{display:none}.tab-bar small{font-size:10px;margin-top:5px}.panel-heading{padding:22px 20px}.panel-heading h2{font-size:23px}.highlights{grid-template-columns:1fr;gap:8px}.highlights article{padding:14px 18px;display:grid;grid-template-columns:100px 1fr;gap:8px;align-items:center}.highlights h3{font-size:15px}.highlights p{margin:0}.toc{display:grid;gap:8px}h2{font-size:22px}.steps li{padding:18px 16px 18px 56px}.steps li:before{left:16px;top:21px;width:25px;height:25px}.table-wrap{overflow:visible}thead{display:none}tbody,tr,td{display:block}td{padding:10px 14px;border-bottom:0;font-size:14px}td:before{content:attr(data-label);display:block;font-size:11px;color:#61717e;font-weight:700;margin-bottom:4px}td:first-child{width:auto;background:#edf3f5;font-weight:700}tbody tr{border-bottom:1px solid #dde6ea}tbody tr:last-child{border-bottom:0}.taxi-colors{gap:8px}.taxi-colors>div{padding:12px 8px}.taxi-colors strong{font-size:12px}.phrases{grid-template-columns:1fr}.links{display:grid}.detail-sections section,.faq{scroll-margin-top:185px}[data-taxi-panel]{scroll-margin-top:185px}}
</style>
