---
import {transportData,transportTagged,transportPageLocale} from '../lib/transport-localization.mjs';
import BusRouteCards from './BusRouteCards.astro';
const transportLocale=transportPageLocale(Astro.url.pathname);
const f=transportTagged(transportLocale);
const {routes:routesSource,terminals:terminalsSource,showTerminal=true}=Astro.props;
const routes=transportData(routesSource,transportLocale);
const terminals=transportData(terminalsSource,transportLocale);
const regions=[...new Set(routes.map(r=>r.region).filter(Boolean))];
---
<div class="bus-explorer"><div class="explorer-controls"><label>목적지·하차 지점 검색<input class="bus-search" type="search" placeholder="치앙마이, 반페, 푸껫, 태국어 정류장명…"/></label>{showTerminal&&<label>출발 터미널<select class="bus-terminal"><option value="all">터미널 전체</option>{terminals.map(t=><option value={t.id}>{t.name}</option>)}</select></label>}<label>방면<select class="bus-region"><option value="all">모든 방면</option>{regions.map(region=><option value={region}>{region}</option>)}</select></label></div><p class="explorer-status" role="status">{f`출발 터미널별 등록 안내 ${routes.length}개`}</p><BusRouteCards routes={routes} terminals={terminals} showTerminal/><div class="explorer-pages"><button class="bus-prev" type="button">이전</button><span class="bus-page"></span><button class="bus-next" type="button">다음</button></div></div>
<script>
import {transportText,transportLink,transportHTML,transportData,transportReady} from '../scripts/transport-locale';
void transportReady.then(()=>{


for(const explorer of document.querySelectorAll<HTMLElement>('.bus-explorer')){
 const cards=Array.from(explorer.querySelectorAll<HTMLElement>('[data-bus-route]'));const search=explorer.querySelector<HTMLInputElement>('.bus-search')!;const terminal=explorer.querySelector<HTMLSelectElement>('.bus-terminal');const region=explorer.querySelector<HTMLSelectElement>('.bus-region')!;const prev=explorer.querySelector<HTMLButtonElement>('.bus-prev')!;const next=explorer.querySelector<HTMLButtonElement>('.bus-next')!;let page=0;const size=12;
 function render(){const words=search.value.trim().toLowerCase().split(/\s+/);const matches=cards.filter(card=>words.every(word=>card.dataset.search!.includes(word))&&(!terminal||terminal.value==='all'||terminal.value===card.dataset.terminal)&&(region.value==='all'||region.value===card.dataset.region));const pages=Math.max(1,Math.ceil(matches.length/size));page=Math.min(page,pages-1);const visible=new Set(matches.slice(page*size,(page+1)*size));for(const card of cards)card.hidden=!visible.has(card);explorer.querySelector('.explorer-status')!.textContent=transportText(matches.length?`검색 결과 ${matches.length}개 · ${page*size+1}–${Math.min((page+1)*size,matches.length)}번째 안내`:'일치하는 등록 안내가 없어요. 도시의 영어명·태국어명 또는 하차 지점으로 다시 찾아보세요.');prev.disabled=page===0;next.disabled=page===pages-1;explorer.querySelector('.bus-page')!.textContent=transportText(`${page+1} / ${pages}`);}
 for(const control of [search,terminal,region].filter(Boolean))control!.addEventListener(control===search?'input':'change',()=>{page=0;render();});prev.addEventListener('click',()=>{page--;render();search.scrollIntoView({block:'center'});});next.addEventListener('click',()=>{page++;render();search.scrollIntoView({block:'center'});});render();
}

});
</script>
<style>.explorer-controls{display:flex;gap:12px;margin:20px 0;align-items:end}.explorer-controls label{font-weight:700;font-size:13px;flex:1;min-width:0}.explorer-controls label:first-child{flex:2}.explorer-controls input,.explorer-controls select{font:inherit;display:block;width:100%;min-height:48px;margin-top:6px;padding:10px 12px;border:1px solid #bdcdd3;border-radius:8px;background:white;color:#253545}.explorer-status{font-size:13px;color:#61717e}.explorer-pages{display:flex;align-items:center;justify-content:center;gap:20px;margin:20px 0}.explorer-pages button{font:inherit;padding:8px 18px;border:1px solid #267e89;border-radius:8px;background:white;color:#267e89;cursor:pointer}.explorer-pages button:disabled{opacity:.35;cursor:default}@media(max-width:600px){.explorer-controls{flex-wrap:wrap}.explorer-controls label:first-child{flex-basis:100%}}</style>
