---
import BkkGuidePagination from './BkkGuidePagination.astro';
import AirportTransferChooser from './AirportTransferChooser.astro';
import RuntimeDate from './RuntimeDate.astro';
import dateObservations from '../../data/site-date-observations.json';
import SiteFooter from './SiteFooter.astro';
import DetailHeader from './DetailHeader.astro';
import ImportantText from './ImportantText.astro';
import AirportRailAccessMap from './AirportRailAccessMap.astro';
import TransportPlaceMap from './TransportPlaceMap.astro';
import {getOperationalDeployDate} from '../lib/operational-date';
const {guide:g}=Astro.props;
const chooserPage=g.id==='suvarnabhumi-to-bangkok';
const pageDates=dateObservations.pages['/ko/transport/airports/suvarnabhumi-to-bangkok/'];
const emphasis=g.id==='suvarnabhumi-to-bangkok'?['지하 1층','1층 4번 게이트','공항 추가요금 50바트','톨비는 75바트','총 125바트','05:30~24:00','약 26~30분','승차권과 요금이 각각 따로','포함하지 않았어요','항상 4층에서 타는 것은 아니니','수하물 추가요금']:[];
const schema={'@context':'https://schema.org','@graph':[{'@type':'Article',headline:g.title,description:g.intro,inLanguage:'ko'},{'@type':'FAQPage',mainEntity:g.faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}]};
const airportPoints=[{name:'수완나품 공항 (BKK)',lng:100.7513395,lat:13.6942971,text:'무료 셔틀 승차: 메인 터미널 2층 3번 게이트 안쪽 도로',url:'#boarding'},{name:'돈므앙 공항 (DMK)',lng:100.60406,lat:13.91264,text:'무료 셔틀 승차: 터미널1 국제선 건물 1층 6번 게이트',url:'#boarding'}];
---
<!doctype html><html lang="ko"><head><link rel="icon" href="/favicon.ico?v=20261013" sizes="16x16 32x32 48x48" /><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261013" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261013" /><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{g.title} | ThaiLiveNow</title><meta name="description" content={g.intro}/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body><DetailHeader/><main class:list={["thai-detail",{"airport-editorial":g.id==='suvarnabhumi-to-bangkok'}]}><nav class="crumb">{chooserPage?<><a href="/ko/airports/">태국 공항</a> › <a href="/ko/airport-assistance/airports/bkk/">수완나폼 공항안내</a></>:<><a href="/ko/transport/">태국 교통</a> › <a href="/ko/transport/guides/air/">태국 국내선·항공사별 노선</a></>}</nav><span class="eyebrow">THAILAND AIRPORT TRANSFERS</span><h1>{g.name}<small>({g.english})</small></h1><p class="intro">{g.intro}</p>{chooserPage&&<BkkGuidePagination current="transport"/>}{chooserPage&&<AirportTransferChooser/>}{g.sections.filter(s=>s.map==='rail').map(s=><section id={s.id}><h2>{s.title}</h2>{s.paragraphs?.map(p=><p><ImportantText text={p} phrases={emphasis}/></p>)}<AirportRailAccessMap/></section>)}{g.id!=='suvarnabhumi-to-bangkok'&&<nav class="toc" aria-label="목차">{g.sections.map(s=><a href={`#${s.id}`}>{s.title}</a>)}<a href="#faq">자주 묻는 질문</a></nav>}{g.sections.filter(s=>s.map!=='rail').map(s=><section id={s.id}><h2>{s.title}</h2>{s.paragraphs?.map(p=><p><ImportantText text={p} phrases={emphasis}/></p>)}{s.map==='rail'&&<AirportRailAccessMap/>}{s.map==='airports'&&<TransportPlaceMap points={airportPoints} title="수완나품·돈므앙 공항 위치" note="핀은 공항 시설 위치예요. 층·게이트는 위 양방향 승차 표를 확인하세요. 도로 경로와 예상시간은 아래 길찾기로 확인할 수 있어요."/>}{s.table&&<div class="table-wrap"><table><thead><tr>{s.table.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{s.table.rows.map(row=><tr>{row.map((cell,i)=><td data-label={s.table.headers[i]}>{cell}</td>)}</tr>)}</tbody></table></div>}{s.steps&&<ol class="steps">{s.steps.map(([title,text])=><li><h3>{title}</h3><p>{text}</p></li>)}</ol>}{s.links&&<div class="links">{s.links.map(([label,url])=><a href={url} target={url.startsWith('http')?'_blank':undefined} rel={url.startsWith('http')?'noopener noreferrer':undefined}>{label} {url.startsWith('http')?'↗':'→'}</a>)}</div>}</section>)}<section id="faq"><h2>자주 묻는 질문</h2>{g.faq.map(([q,a])=>g.id==='suvarnabhumi-to-bangkok'?<article class="faq-card"><h3>{q}</h3><p>{a}</p></article>:<details><summary>{q}</summary><p>{a}</p></details>)}</section><section><h2>공항 이동 이어서 보기</h2><div class="links"><a href="/ko/transport/airports/suvarnabhumi-to-bangkok/">수완나품 → 방콕 시내</a><a href="/ko/transport/airports/airport-rail-link/">공항철도·MRT·BTS 환승</a><a href="/ko/transport/airports/suvarnabhumi-don-mueang/">수완나품↔돈므앙 환승</a></div></section><section class="sources"><details class="source-disclosure"><summary>공식 출처 보기 · {g.sources.length}개</summary>{g.sources.map(([label,url])=><p><a href={url} target="_blank" rel="noopener noreferrer">{label} ↗</a></p>)}<p>요금·운행시간은 각 공식 공개 안내를 기준으로 정리했어요. 실제 승차권 구매 화면과 당일 공항 안내에서 적용되는 조건을 함께 확인하세요.</p></details>{chooserPage?<p>출처 확인일: <RuntimeDate kind="source" fallback={pageDates.sourceCheckedOn} locale="ko" unknown="미확인"/><br/>최근 수정일: <RuntimeDate kind="modified" fallback={pageDates.contentModifiedOn} locale="ko" unknown="미확인"/><br/>최근 배포일: <RuntimeDate kind="deployment" fallback={getOperationalDeployDate()} locale="ko"/></p>:<p>출처 확인일: {getOperationalDeployDate()}<br/>최근 배포일: {getOperationalDeployDate()}</p>}</section>{chooserPage&&<BkkGuidePagination current="transport" position="bottom"/>}</main><SiteFooter/></body></html>
<style>:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,"Apple SD Gothic Neo",sans-serif;line-height:1.8}:global(*){box-sizing:border-box}main{max-width:1100px;margin:auto;padding:34px 26px 70px}a{color:#267e89;text-decoration:none}.crumb{font-size:13px;color:#61717e}.eyebrow{display:block;color:#e84d47;letter-spacing:2px;font-size:11px;margin-top:24px}h1{font-size:34px;line-height:1.4}h1 small{display:block;font-size:17px;font-weight:400;color:#61717e;margin-top:8px}.intro{font-size:18px;max-width:930px}.toc,.links{display:flex;gap:10px;flex-wrap:wrap}.toc{padding:18px;background:#eff5f6;border-radius:12px;margin-top:24px}.toc a{font-size:13px}.links a{padding:10px 14px;background:white;border:1px solid #dce5e8;border-radius:9px;font-size:14px}.links{margin-top:16px}section{margin-top:36px;scroll-margin-top:120px}h2{font-size:24px;line-height:1.5}.table-wrap{overflow:auto;border:1px solid #dce5e8;border-radius:12px;background:white}table{width:100%;border-collapse:collapse;table-layout:auto;font-size:14px}th,td{text-align:left;padding:14px 16px;border-bottom:1px solid #e4ebee;vertical-align:top;min-width:120px;word-break:keep-all;overflow-wrap:anywhere}th{background:#eff5f6}tbody tr:last-child td{border:0}.steps{list-style:none;padding:0;counter-reset:step;display:grid;gap:12px}.steps li{counter-increment:step;background:white;border:1px solid #dce5e8;border-radius:12px;padding:18px 20px 18px 60px;position:relative}.steps li:before{content:counter(step);position:absolute;top:22px;left:18px;width:26px;height:26px;background:#267e89;color:white;border-radius:50%;display:grid;place-items:center}.steps h3{font-size:18px;margin:0 0 6px}.steps p{margin:0}details{padding:15px 18px;border:1px solid #dce5e8;border-radius:10px;background:white;margin:10px 0}summary{cursor:pointer;font-weight:700}.sources{font-size:13px;border-top:1px solid #dce5e8;padding-top:16px}@media(max-width:650px){main{padding:24px 16px 50px}h1{font-size:27px}.intro{font-size:16px}h2{font-size:22px}.toc{display:grid}.table-wrap{border:0;background:transparent}table,tbody,tr,td{display:block;width:100%}thead{display:none}tbody tr{border:1px solid #dce5e8;border-radius:12px;background:white;margin-bottom:12px;padding:6px 12px}td{display:grid;grid-template-columns:95px minmax(0,1fr);gap:12px;padding:10px 0;min-width:0;font-size:14px;border:0;border-bottom:1px solid #edf1f3!important}td:last-child{border-bottom:0!important}td:before{content:attr(data-label);font-weight:700;color:#61717e;font-size:12px;word-break:keep-all}.steps li{padding-left:56px}}</style>

<style>
main.airport-editorial{max-width:1000px;padding:32px 24px 60px}.airport-editorial h1{margin:12px 0 16px;font-size:32px}.airport-editorial .eyebrow{margin-top:18px}.airport-editorial h2{margin:0 0 16px}.airport-editorial section{margin-top:34px}.airport-editorial p{color:#61717e;margin:12px 0;line-height:1.85}.airport-editorial :global(p strong){color:#253545;font-weight:750}.airport-editorial .intro{margin-bottom:28px}.airport-editorial .faq-card{background:#fff;border:1px solid #dce5e8;border-radius:12px;padding:20px;margin:12px 0}.airport-editorial .faq-card h3{font-size:19px;margin:0 0 10px}.airport-editorial .faq-card p{margin-bottom:0}.airport-editorial th{color:#253545}.airport-editorial td{color:#52616e}.airport-editorial .sources{font-size:13px}@media(max-width:650px){main.airport-editorial{padding:24px 16px 48px}.airport-editorial h1{font-size:27px}.airport-editorial .intro{font-size:16px}.airport-editorial .faq-card{padding:18px}.airport-editorial td{grid-template-columns:90px minmax(0,1fr)}}
</style>
<style>.sources .source-disclosure{padding:0;border:0;background:transparent;margin:0 0 16px}.sources .source-disclosure summary{padding:14px 16px;background:#eff5f6;border:1px solid #dce5e8;border-radius:10px;font-size:14px}.sources .source-disclosure p{font-size:13px;margin:10px 0;line-height:1.65}.sources .source-disclosure[open] summary{margin-bottom:16px}.sources>p{font-size:12px;color:#61717e;line-height:1.8}</style>