---
import {transportData,transportText,transportFormat,transportPageLocale,transportTagged} from '../lib/transport-localization.mjs';
import AttractionTransportConnections from './AttractionTransportConnections.astro';
import TransportSourceDates from './TransportSourceDates.astro';
import SiteFooter from './SiteFooter.astro';
import DetailHeader from './DetailHeader.astro';
import RailDestinations from './RailDestinations.astro';
import TransportPlaceMap from './TransportPlaceMap.astro';
import officialMetadata from '../data/transport/station-official-metadata.json';
import dataSource from '../data/transport/bangkok.json';
import namesKoSource from '../data/transport/station-names-ko.json';
const transportLocale=transportPageLocale(Astro.url.pathname);
const f=transportTagged(transportLocale);
const data=transportData(dataSource,transportLocale);
const namesKo=transportData(namesKoSource,transportLocale);
const { station } = Astro.props;
const p=station.properties;
// Korean searchers look stations up by their Korean name; the English name stays alongside it.
const nameKo=namesKo[p.station_id]||p.name;
const nameEn=nameKo===p.name?'':`(${p.name})`;
const official=officialMetadata[p.station_id]||[];
const lines=data.bangkok_lines.filter(line=>p.lines.includes(line.id));
const nearby=/Itsaraphap/i.test(p.name);
const faq=transportData([
 ['이 역의 노선과 목적지 방향은 어디서 확인하나요?','위 이용 노선에서 노선 이름을 누르면 정차역 목록을 볼 수 있어요. 내릴 역이 어느 방향에 있는지 살펴본 뒤, 역에서는 승강장의 행선지 표지와 맞춰 탑승해주세요.'],
 ...(nearby?[['왓아룬까지 배를 타야 하나요?','이싸라팝역은 왓아룬과 같은 강 서쪽에 있어 도보로 접근할 수 있어요.']]:[])
],transportLocale);
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};

---
<!doctype html><html lang="ko"><head><link rel="icon" href="/favicon.ico?v=20261013" sizes="16x16 32x32 48x48" /><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261013" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261013" /><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{f`${nameKo}역${nameEn} · ${lines.map(line=>line.name_ko).join("·")} | 방콕 역 위치·연결 노선·탑승 안내 | ThaiLiveNow`}</title><meta name="description" content={f`${nameKo}역에서 이용하는 ${lines.map(line=>line.name_ko).join("·")}의 연결 노선과 탑승 안내를 살펴보세요. 역 위치와 길찾기, 운영사 안내를 함께 볼 수 있어요.`}/><script type="application/ld+json" set:html={JSON.stringify(faqSchema).replaceAll('<','\\u003c')}/></head><body><DetailHeader/><main class="thai-detail"><nav aria-label="현재 위치"><a href="/ko/transport/">태국 교통</a> · <a href="/ko/transport/bangkok/">방콕 교통</a></nav><span class="eyebrow">BANGKOK STATION</span><h1>{f`${nameKo}역`} <small>{nameEn} · {lines.map(line=>line.name_ko).join(" · ")}</small></h1>{p.name_th&&<p class="names">{p.name_th}</p>}<p>{f`${nameKo}역에서는 ${lines.map(line=>line.name_ko).join(" · ")}을 이용할 수 있어요. 아래 지도에서 역 위치를 살펴보고, 이용 노선의 정차역 목록에서 내릴 역을 찾아보세요. 역에 도착하면 목적지 방향의 승강장으로 가시면 돼요. 현재 출발지에서 오는 길은 아래 길찾기로 볼 수 있어요.`}</p>{official.length>0&&<section><h2>역 코드</h2><div class="cards">{official.map(info=><p><strong>{info.code}</strong> · {data.bangkok_lines.find(line=>line.id===info.lineId)?.name_ko}{info.nameTH&&<span> · {info.nameTH}</span>}</p>)}</div></section>}<TransportPlaceMap title="역 주변 실제 지도" note="핀은 역 시설의 위치예요. 이용할 출구와 승강장은 현장 표지판에서 확인하세요." points={[{name:f`${nameKo}역`,lng:station.geometry.coordinates[0],lat:station.geometry.coordinates[1],text:'역 위치를 확인하고 방콕 전체 노선 지도에서 이어지는 노선을 살펴보세요.',url:'/ko/transport/bangkok/'}]}/><section><h2>이용 노선</h2><div class="cards">{lines.map(line=><a href={`/ko/transport/bangkok/lines/${line.id}/`} style={`border-left:4px solid ${line.color}`}><strong>{line.name_ko}</strong><span>{line.termini}</span><small>노선과 정차역 보기 →</small></a>)}</div></section><RailDestinations stationId={p.station_id}/><AttractionTransportConnections stationId={p.station_id}/><section><h2>위치와 길찾기</h2><p><a href={`https://www.google.com/maps/search/?api=1&query=${station.geometry.coordinates[1]},${station.geometry.coordinates[0]}`} target="_blank" rel="noopener noreferrer">지도에서 역 위치 보기 ↗</a></p><p><a href={`https://www.google.com/maps/dir/?api=1&destination=${station.geometry.coordinates[1]},${station.geometry.coordinates[0]}&travelmode=transit`} target="_blank" rel="noopener noreferrer">현재 출발지에서 이 역까지 길찾기 ↗</a></p><a href="/ko/transport/bangkok/">방콕 전체 노선 지도 →</a></section><section><h2>표 구매와 탑승</h2><p>먼저 어느 노선으로 몇 번 갈아타야 하는지 정해보세요. 역의 발매기나 매표소에서 이용할 노선의 승차권을 구매한 뒤, 행선지 표지를 보고 목적지 방향 승강장으로 가시면 돼요. 다른 운영사의 노선으로 갈아탈 때는 승차권과 카드 사용 방법이 달라질 수 있으니 해당 노선의 안내도 함께 읽어주세요.</p><a href="/ko/transport/guides/rail/">운영사별 표 구매·탑승 안내 →</a></section>{nearby&&<section><h2>주변 명소</h2><a class="place" href="/ko/attractions/wat-arun/"><strong>왓아룬 (Wat Arun)</strong><p>역에서 사원 위치까지 Google 지도 기준 도보 약 15분·1.1km예요. 출구와 입장 지점에 따라 달라질 수 있어요.</p><span>명소와 도보 경로 보기 →</span></a></section>}<section id="faq"><h2>자주 묻는 질문</h2>{faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section><section class="source"><TransportSourceDates/><details class="source-fold"><summary>공식 출처 보기 · {1+lines.filter(line=>line.official_url).length}개</summary><p>역 위치·이름: <a href={`https://www.openstreetmap.org/${p.osm_id}`} target="_blank" rel="noopener noreferrer">OpenStreetMap 원본</a> · ODbL</p>{lines.map(line=>line.official_url&&<p><a href={line.official_url.startsWith('http')?line.official_url:`https://${line.official_url}`} target="_blank" rel="noopener noreferrer">{line.name_ko} 운영사 안내 ↗</a></p>)}</details></section></main><SiteFooter/></body></html>
<style>
:global(body){margin:0;color:#253545;background:#fafbfc;font-family:system-ui,sans-serif;line-height:1.8}:global(*){box-sizing:border-box}main{max-width:980px;margin:auto;padding:35px 24px 65px}.eyebrow{display:block;color:#e84d47;font-size:10px;letter-spacing:2px;margin-top:25px;font-weight:800}h1{font-size:32px;line-height:1.4;margin:10px 0}.thai-detail h1 small{display:block;font-size:18px;color:#61717e;margin-top:8px}.names{color:#71818e}h2{font-size:23px}section{margin-top:32px}a{color:#2e7c89;text-decoration:none}.cards{display:grid;gap:12px}.cards a,.place{display:block;padding:20px;border:1px solid #e4eaee;border-radius:10px;background:white}.cards strong,.cards span,.cards small{display:block}.cards span{font-size:14px;color:#61717e}.cards small{margin-top:5px}.source{font-size:12px;color:#71818e}details{border-bottom:1px solid #e4eaee;padding:12px 0}summary{cursor:pointer;font-weight:700}nav{font-size:12px}@media(max-width:560px){main{padding:24px 16px 45px}h1{font-size:26px}}
</style>
