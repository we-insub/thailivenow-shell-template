---
import editorial from '../data/camera-editorial-ko.json';
import {cameraViewingCopy} from '../lib/camera-viewing-copy.mjs';
import CameraActions from './CameraActions.astro';
import {getDesignUI} from '../i18n/design-ui';
import { cameras } from '../data/cameras';
import { getUI, sourceText, cameraTitle as originalCameraTitle, cameraStatus, categoryName, placeName, previewLabel } from '../i18n/ui';
import type { Locale } from '../i18n/locales';
const {locale='en',savedOnly=false}=Astro.props as {locale?:Locale;savedOnly?:boolean};
const design=getDesignUI(locale);
const ui=getUI(locale);
const cameraTitle=(camera,market)=>market==='ko'&&editorial[camera.id]?.displayTitle||originalCameraTitle(camera,market);
---
<section id="cameras" class="camera-gallery directory-section" data-camera-locale={locale} data-saved-directory={savedOnly?true:undefined} aria-labelledby="camera-gallery-title">
  <div class="gallery-heading"><span>THAILAND THROUGH THE LENS</span><h2 id="camera-gallery-title">{ui.galleryTitle}</h2><p>{locale==='ko'?'파통 해변부터 코사무이의 만, 북부의 산과 강까지. 어떤 곳인지 읽어보고 카메라로 현지 풍경을 만나보세요.':ui.galleryIntro}</p><small>{locale==='ko'?`태국의 풍경 ${cameras.length}곳 · 장소 소개와 영상·갱신 사진`:<>{ui.cameraList} · {cameras.length} / {ui.verified} · {cameras.filter(camera => camera.playback === 'verified' && camera.kind === 'live-page').length}. {ui.previewNote}</>}</small></div>
  <div class="camera-grid">{cameras.map(camera => {const pilot=locale==='ko';return <article class="camera-tile" data-camera-gallery={camera.id}><a class:list={['camera-cover',camera.category,{'camera-pilot-cover':pilot}]} href={`/${locale}/cameras/${camera.id}/`} aria-label={`${cameraTitle(camera,locale)} · ${ui.details}`}><span class="cover-area">{placeName(camera.area,locale)}</span>{pilot?<span class="camera-cover-place">{editorial[camera.id].place}</span>:<img class="camera-photo" src={camera.preview?.url} alt={locale==='ko'?`${camera.area} 지역 참고사진 · 현재 카메라 화면 아님`:`${cameraTitle(camera,locale)} · ${previewLabel(camera.preview?.label,locale)}`} loading="lazy" decoding="async" referrerpolicy="no-referrer" />}{locale==='ko'&&<span class="camera-reference-label">{pilot?cameraViewingCopy(camera).label:'지역 참고사진 · 실시간 화면 아님'}</span>}<span class="cover-caption">{locale==='ko'?(pilot?'어떤 곳인지 보기 →':'장소·시청 안내 →'):camera.kind === 'time-travel' ? ui.timeTravel+' ↗' : ui.source+' ↗'}</span></a><div class="tile-copy"><span class="tile-category">{categoryName(camera.category,locale)}</span><h3><a href={`/${locale}/cameras/${camera.id}/`}>{cameraTitle(camera,locale)}</a></h3><p>{locale === 'ko' ? editorial[camera.id].preview : ui.cameraIntro}</p><small>{locale==='ko'?`제공·안내: ${camera.sourceName}`:`${sourceText(camera.sourceName,locale)} · ${cameraStatus(camera,locale)}`}</small>{locale==='ko'&&!pilot&&<p class="camera-card-viewing"><strong>{cameraViewingCopy(camera).label}</strong> · {camera.kind==='live-photo'?'주기적으로 바뀌는 사진이에요.':'현재 재생 여부는 제공 사이트에서 살펴보세요.'}</p>}{!pilot&&<div class="photo-credit"><a href={camera.preview?.sourceUrl} target="_blank" rel="noopener noreferrer">{ui.photoCredit}: {sourceText(camera.preview?.credit ?? '',locale)}</a>{camera.preview?.license && <a href={camera.preview.licenseUrl} target="_blank" rel="noopener noreferrer"> · {camera.preview.license}</a>}<span>{locale==='ko'?' · 표시 크기 조정·일부 잘림; 사진 라이선스 조건 적용':' · resized/cropped; image license applies'}</span></div>}<CameraActions id={camera.id} locale={locale} compact/><div class="tile-actions">{locale==='ko'?<><a href={`/ko/cameras/${camera.id}/`}>{pilot?'장소와 풍경 보기 →':'장소·시청 안내 →'}</a>{camera.center&&<button type="button" data-select-camera={camera.id}>지도에서 위치 보기</button>}<a href={pilot?cameraViewingCopy(camera).url:camera.sourceUrl} target="_blank" rel="noopener noreferrer">{pilot?cameraViewingCopy(camera).button:camera.kind==='live-photo'?'갱신 사진 보기':'카메라 제공 사이트'} ↗</a></>:<><button type="button" data-select-camera={camera.id}>{camera.center ? ui.viewMap : ui.details}</button><a href={camera.sourceUrl} target="_blank" rel="noopener noreferrer">{ui.source}</a></>}</div></div></article>})}</div>
  {savedOnly&&<p id="saved-empty" hidden>{design.empty}</p>}
</section>
<style>
  .camera-gallery{max-width:1240px;margin:auto;padding:60px 40px;scroll-margin-top:85px}.gallery-heading>span{font-size:10px;letter-spacing:1.8px;color:#e84d47;font-weight:800}.gallery-heading h2{font-size:28px;letter-spacing:-.8px;margin:9px 0}.gallery-heading p{color:#75828e;font-size:13px;line-height:1.8}.gallery-heading small{display:block;color:#83949d;font-size:11px;line-height:1.7;margin:12px 0 25px}.camera-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.camera-tile{background:#fff;border:1px solid #e4eaee;border-radius:14px;overflow:hidden}.camera-tile[hidden]{display:none}.camera-cover{height:155px;display:flex;flex-direction:column;position:relative;text-decoration:none;padding:16px 18px;color:#fff;background:linear-gradient(155deg,#84c0c8,#347a91)}.camera-cover.skyline{background:linear-gradient(155deg,#727d9e,#2a3c59)}.camera-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.cover-area,.cover-caption,.preview-kind{position:relative;z-index:1;text-shadow:0 1px 3px #000}.camera-cover:after{content:"";position:absolute;inset:0;background:linear-gradient(#0005,transparent 40%,#0009)}.preview-kind{font-size:10px;margin-top:auto;margin-bottom:5px}.photo-credit{font-size:9px;line-height:1.5;color:#75828e;margin-top:8px}.photo-credit a{color:inherit}.cover-area{font-size:11px;font-weight:800}.cover-symbol{align-self:center;font-size:64px;line-height:1.1;opacity:.65}.cover-caption{margin-top:auto;font-size:11px}.tile-copy{padding:19px}.tile-category{font-size:10px;color:#2e7c89}.tile-copy h3{margin:8px 0 0;font-size:17px;line-height:1.5}.tile-copy h3 a{color:#253545;text-decoration:none}.tile-copy p{color:#75828e;font-size:12px;line-height:1.8;min-height:65px}.tile-copy>small{display:block;font-size:10px;color:#84949e;min-height:26px}.tile-actions{display:flex;justify-content:space-between;gap:8px;border-top:1px solid #e4eaee;margin-top:12px;padding-top:14px}.tile-actions button{background:none;border:0;padding:0;color:#596d7a;font-size:11px;cursor:pointer}.tile-actions a{font-size:11px;color:#2e7c89;font-weight:800}.coverage-note{border:1px solid #e4eaee;border-radius:10px;padding:18px 22px;margin-top:25px;background:#f4f8f9}.coverage-note strong{font-size:12px}.coverage-note p{font-size:12px;color:#75828e;line-height:1.8;margin-bottom:0}@media(max-width:760px){.camera-gallery{padding:35px 18px;scroll-margin-top:120px}.camera-grid{grid-template-columns:1fr}.gallery-heading h2{font-size:23px}.tile-copy p{min-height:0}}
</style>

<style>.camera-reference-label{position:absolute;z-index:1;top:44px;left:16px;max-width:calc(100% - 32px);padding:5px 8px;background:#203743e6;color:#fff;border-radius:5px;font-size:12px;line-height:1.5}.camera-card-viewing{min-height:0!important;font-size:14px!important;line-height:1.8!important;padding:12px;background:#f0f6f6;border-radius:8px;margin-top:14px}.camera-gallery[data-camera-locale="ko"] .tile-actions{flex-wrap:wrap;align-items:center;gap:12px}.camera-gallery[data-camera-locale="ko"] .tile-actions a,.camera-gallery[data-camera-locale="ko"] .tile-actions button{line-height:1.6;min-height:40px;display:inline-flex;align-items:center}.camera-gallery[data-camera-locale="ko"] .tile-copy>small{line-height:1.8}</style>

<style>.camera-pilot-cover{background:linear-gradient(135deg,#203b4c,#267e89)}.camera-pilot-play{position:absolute;inset:0;display:grid;place-items:center;font-size:38px;color:white;opacity:.9}</style>

<style>.camera-cover-place{position:relative;z-index:1;font-size:23px;font-weight:750;line-height:1.5;margin-top:48px;overflow-wrap:anywhere;max-width:100%;text-shadow:0 1px 3px #20374350}.camera-gallery[data-camera-locale="ko"] .camera-cover{height:210px}.camera-gallery[data-camera-locale="ko"] .camera-reference-label{font-size:11px;padding:3px 7px}</style>
