---
import CameraKoreanDetail from './CameraKoreanDetail.astro';
import {hasLocalizedStage} from '../lib/localized-content';
import CameraInternationalDetail from './CameraInternationalDetail.astro';
const {camera,locale='en',autoDetect=false}=Astro.props;
---
{!autoDetect&&(locale==='ko'||hasLocalizedStage(locale,'cameras'))?<CameraKoreanDetail camera={camera} locale={locale}/>:<CameraInternationalDetail {...Astro.props}/>}
