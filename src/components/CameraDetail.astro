---
import CameraActions from './CameraActions.astro';
import SiteFooter from './SiteFooter.astro';
import {locales,type Locale} from '../i18n/locales';
import {getUI,sourceText,cameraTitle,cameraStatus,categoryName,placeName,previewLabel} from '../i18n/ui';
import type {Camera} from '../data/cameras';
import DetailHeader from './DetailHeader.astro';
import LocaleRedirect from './LocaleRedirect.astro';
const {camera,locale='en',autoDetect=false}=Astro.props as {camera:Camera;locale?:Locale;autoDetect?:boolean};
const active=locales.find(item=>item.code===locale)!;
const ui=getUI(locale);
const metadataPatterns:Record<string,string>={ko:'{name}의 공개 카메라 원본과 촬영 지역, 시청 방식을 살펴보세요.',en:'Find the original public camera source, location and viewing status for {name}.',ja:'{name}の公開カメラの配信元、撮影場所、視聴状況を確認できます。',ms:'Lihat sumber kamera awam, lokasi dan status tontonan untuk {name}.',ru:'Источник открытой камеры, место съёмки и состояние просмотра: {name}.',es:'Consulta la fuente de la cámara pública, su ubicación y el estado de visualización de {name}.','zh-cn':'查看{name}的公开摄像头来源、拍摄位置和观看状态。','zh-tw':'查看{name}的公開攝影機來源、拍攝位置及觀看狀態。'};
const description=(metadataPatterns[locale]||metadataPatterns.en).replace('{name}',cameraTitle(camera,locale));
---
<!doctype html><html lang={active.tag} data-locale={locale}><head><link rel="icon" href="/favicon.ico?v=20261013" sizes="16x16 32x32 48x48"/><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261013" sizes="any"/><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261013"/><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{cameraTitle(camera,locale)} · {ui.cameraInfo} | ThaiLiveNow</title><meta name="description" content={description}/>{autoDetect&&<LocaleRedirect/>}</head><body><DetailHeader locale={locale} home/><main class="camera-detail-page content-container" data-camera-detail={camera.id}>
 <nav class="breadcrumbs"><a href={`/${locale}/`}>ThaiLiveNow</a><span>/</span><a href={`/${locale}/directory/`}>{placeName(camera.area,locale)}</a><span>/</span><b>{cameraTitle(camera,locale)}</b></nav>
 <header class="page-heading"><span class="count-label">{categoryName(camera.category,locale)} · {camera.kind==='time-travel'?ui.timeTravel:camera.kind==='live-photo'?previewLabel(camera.preview?.label,locale):ui.source}</span><h1>{cameraTitle(camera,locale)}</h1><p>{placeName(camera.area,locale)}</p></header>
 <div class="detail-layout"><div class="detail-image"><a class="thumbnail" href={camera.sourceUrl} target="_blank" rel="noopener noreferrer">{camera.preview?.url&&<img src={camera.preview.url} alt={`${cameraTitle(camera,locale)} · ${previewLabel(camera.preview?.label,locale)}`} width="960" height="540" referrerpolicy="no-referrer"/>}</a>{camera.preview&&<p>{previewLabel(camera.preview.label,locale)}<br/><a href={camera.preview.sourceUrl} target="_blank" rel="noopener noreferrer">{ui.photoCredit}: {sourceText(camera.preview.credit,locale)}{camera.preview.license&&` · ${camera.preview.license}`}</a>{camera.preview.licenseUrl&&<><br/><a href={camera.preview.licenseUrl} target="_blank" rel="noopener noreferrer">{camera.preview.license} · {locale==='ko'?'표시 크기 조정·일부 잘림; 해당 라이선스 조건 적용':'resized/cropped; supplied under this license'}</a></>}</p>}<p class="detail-description">{locale==='ko'?camera.description:ui.cameraIntro}</p>
 {camera.center&&<section class="camera-weather" data-camera-weather data-lng={camera.center[0]} data-lat={camera.center[1]}></section>}
 {camera.youtubeId&&<iframe class="official-player" src={`https://www.youtube-nocookie.com/embed/${camera.youtubeId}?autoplay=0&rel=0`} title={`${cameraTitle(camera,locale)} 공식 YouTube 플레이어`} loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen/>}
 </div><section class="detail-info"><CameraActions id={camera.id} locale={locale}/><dl><dt>{ui.provider}</dt><dd><a href={camera.sourceUrl} target="_blank" rel="noopener noreferrer">{sourceText(camera.sourceName,locale)} ↗</a></dd><dt>{ui.region}</dt><dd>{placeName(camera.area,locale)}</dd><dt>{ui.checked}</dt><dd>{camera.checked}</dd><dt>{ui.viewing}</dt><dd>{cameraStatus(camera,locale)}</dd><dt>{ui.verification}</dt><dd>{locale==='ko'?camera.verification:`${cameraStatus(camera,locale)} · ${ui.viewingNote}`}</dd></dl><h2>{camera.kind==='time-travel'?'시간대별 영상 원본':'공개 카메라 원본'}</h2><p>{camera.kind==='time-travel'?'상시 생방송으로 확인된 소스는 아니에요. 원본에서 제공하는 시간대별 영상을 살펴보세요.':'원본 보기를 누르면 운영자의 화면으로 이동해요. 현재 방송 중인지와 촬영 시각은 그 화면에서 살펴보세요.'}</p><a class="primary-link" href={camera.sourceUrl} target="_blank" rel="noopener noreferrer">{ui.source} ↗</a><a class="secondary-link" href={`/${locale}/?camera=${camera.id}#map`}>{ui.viewMap} →</a></section></div>
 <section class="camera-location-section"><h2>{ui.cameraInfo}</h2><p>{locale==='ko'?camera.locationNote:ui.locationNote}</p><a class="detail-map-link" href={camera.locationEvidence} target="_blank" rel="noopener noreferrer">{ui.details} ↗</a><p>{ui.viewingNote}</p><p class="footnote">{ui.previewNote}</p></section>
 </main><SiteFooter locale={locale}/></body></html>
<script>import '../scripts/camera-weather';</script>
