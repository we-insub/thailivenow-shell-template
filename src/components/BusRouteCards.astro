---
import {transportData,transportTagged,transportPageLocale} from '../lib/transport-localization.mjs';
const transportLocale=transportPageLocale(Astro.url.pathname);
const f=transportTagged(transportLocale);
const {routes:routesSource,terminals:terminalsSource,showTerminal=false}=Astro.props;
const routes=transportData(routesSource,transportLocale);
const terminals=transportData(terminalsSource,transportLocale);
---
<div class="bus-route-cards">{routes.map(r=>{const terminal=terminals.find(t=>t.id===r.terminalId);return <article id={r.id} data-bus-route data-terminal={r.terminalId} data-region={r.region} data-search={`${r.destination} ${r.english} ${r.thai} ${terminal.name} ${terminal.english} ${r.dropoffOptions?.map(x=>x.destinationTh).join(' ')||''}`.toLowerCase()}><span class="route-region">{showTerminal ? f`${terminal.name} 출발` : r.english}</span><h3><a href={r.url}>{r.dropoffOptions?.length>1 ? f`${r.destination} 방면` : f`${r.destination}행`} →</a></h3><p class="journey">{terminal.name} → {r.destination}</p>{r.fare&&<p class="fare"><strong>{r.fareKind!=='operator'?f`${r.fare}바트부터`:f`${r.fare}바트`}</strong><span>{r.fareKind==='operator'?'운영사 게시 편도 · 1인 요금':'판매 요금 예시 · 날짜·차량 등급별 차이'}</span>{r.minimumFareDropoffTh&&r.fareKind!=='operator'&&<span>{f`이 요금의 하차 지점: ${r.minimumFareDropoffTh}`}</span>}</p>}{r.duration&&<p>{r.duration}</p>}{r.departures&&<p>{f`출발 ${r.departures[0]}–${r.departures.at(-1)}`} · <a href={r.url+'#timetable'}>전체 시간표</a></p>}<p>{r.note}</p>{r.operatorSchedules?.length>0&&<p>{f`운영사별 출발시간·창구 안내 ${r.operatorSchedules.length}개`}</p>}{r.dropoffOptions?.length>0&&<p>{f`하차 지점 ${r.dropoffOptions.length}곳 비교`}</p>}<a class="route-link" href={r.url}>요금·탑승·하차 자세히 보기 →</a></article>})}</div>
<style>.bus-route-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.bus-route-cards article{padding:20px;border:1px solid #dce5e8;border-radius:14px;background:white;scroll-margin-top:100px}.bus-route-cards article[hidden]{display:none}.route-region{font-size:12px;color:#61717e}.bus-route-cards h3{font-size:20px;margin:6px 0}.bus-route-cards a{color:#267e89;text-decoration:none}.journey{font-size:13px;color:#61717e}.fare strong{font-size:21px;color:#213945}.fare span{display:block;font-size:12px;color:#61717e}.bus-route-cards p{font-size:14px;line-height:1.7}.route-link{font-weight:700;font-size:14px}@media(max-width:600px){.bus-route-cards{grid-template-columns:1fr}}
</style>
