---
import {airlineCatalogue} from '../lib/airport-airline-catalogue';
import data from '../../public/data/airport-assistance.json';
import englishCopy from '../data/airport-common-airline-en.json';
import RuntimeDate from './RuntimeDate.astro';
import {guidesForAirline,guideKind} from '../lib/airport-assistance-editorial.mjs';
const {english=false,incident='all',showEnglishLink=true}=Astro.props;
const primaryLinks=(airline:any)=>airline.links.filter((link:any,i:number,list:any[])=>list.findIndex(other=>other.label===link.label)===i);
const rows=airlineCatalogue.map(a=>({...a,guides:a.korean?guidesForAirline(data,a.id):[]}));
---
<section class="airline-finder" data-airline-finder data-english={String(english)}>
 <h2>{english?'Find your operating airline':'이용한 항공사의 접수 방법을 찾아보세요'}</h2>
 <p>{english?'Search by an English airline name or the two-character code on your flight number. The airline operating the aircraft may differ from the airline that sold the ticket.':'항공사 이름이나 편명 앞의 코드를 입력해주세요. 예를 들어 아시아나는 OZ, 대한항공은 KE로 찾을 수 있어요. 공동운항편이라면 항공권을 판매한 곳과 실제 운항사가 같은지도 살펴보세요.'}</p>
 <label for="airline-query">{english?'Airline name or code':'항공사 이름·영문명·코드'}</label>
 <input id="airline-query" type="search" placeholder={english?'e.g. OZ, Asiana Airlines, KE657':'예: 아시아나, OZ, Asiana Airlines, KE657'} autocomplete="off" aria-controls="airline-results"/>
 {!english&&<><label for="airline-incident">어떤 안내가 필요한가요?</label><select id="airline-incident"><option value="all" selected={incident==='all'}>전체 접수·확인서 안내</option><option value="flight" selected={incident==='flight'}>지연·결항·확인서</option><option value="baggage" selected={incident==='baggage'}>수하물 파손·미도착</option></select></>}
 <p class="search-status" role="status" aria-live="polite" data-airline-status>{english?`${rows.length} airlines in the existing Thailand travel records.`:'입력하면 해당 항공사의 안내가 아래에 나타나요. 한국어 안내가 없는 항공사는 공통 영문 안내로 연결해드려요.'}</p>
 <details id="airline-results" data-airline-results><summary>{english?'Browse all airlines':'항공사별 안내 펼쳐보기'}</summary>
 <div class="airline-results-grid">{rows.map(a=><article data-airline-result data-korean={String(!!a.korean)} hidden={!english&&!a.korean} data-airline-search={a.search} data-airline-codes={a.codes.join(',').toLowerCase()} id={english?'airline-'+a.id:undefined}>
 <h3>{english?a.name:a.korean?.name||a.name} {a.codes.length>0&&<small>{a.codes.join(' / ')}</small>}</h3>
 {english?<><p>{englishCopy[a.id] || 'Use the official airline channels below for your flight or baggage problem. Have your booking reference, travel date and operating flight number ready. Ask the airline which reporting route applies to your arrival airport, and keep the reference number and its reply. Insurance requirements depend on your own policy.'}</p><div class="airline-actions">{primaryLinks(a).map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div><details class="source-fold"><summary>Official sources · {a.sources.length}</summary><ul>{a.sources.map(url=><li><a href={url} target="_blank" rel="noopener noreferrer">{new URL(url).hostname} · {decodeURIComponent(new URL(url).pathname.split('/').filter(Boolean).at(-1)||'Official information')} ↗</a></li>)}</ul></details><p class="source-check">Source check date: <RuntimeDate kind="source" locale="en" pagePath={`/en/airport-assistance/#airline-${a.id}`} fallback={a.records.map(r=>r.airline.checkedAt).filter(Boolean).sort().at(-1)||null}/>. Contact and claim conditions can depend on the airport, country and ticket.</p></>:a.korean?<>
 <p>{a.guides.some(g=>guideKind(g)==='certificate')?'지연·결항 증빙과 수하물 신고 절차를 업무별로 나누어 살펴보세요.':'확인서 문의와 수하물 사고 신고에 필요한 접수처를 살펴보세요.'}</p>
 <div class="airline-actions">{a.guides.map(g=><a data-incident={guideKind(g)==='baggage'?'baggage':'flight'} href={`/ko/airport-assistance/guides/${g.id}/`}>{g.title} →</a>)}<a href={`/ko/airport-assistance/airlines/${a.id}/`}>접수처·문의 방법 전체 보기 →</a></div>
 </>:<><p>이 항공사는 공통 영문 안내에서 공식 문의·신고 경로를 찾을 수 있어요.</p><a href={`/en/airport-assistance/#airline-${a.id}`} lang="en">{a.name} · English guide →</a></>}
 </article>)}</div></details>
 <p class="search-empty" data-airline-empty hidden>{english?'No matching airline in these records. Check the operating airline on your ticket and use its official support channel.':'현재 자료에서 해당 항공사를 찾지 못했어요. 항공권에 적힌 실제 운항사 이름과 코드를 다시 살펴보고, 해당 항공사의 공식 문의처를 이용해주세요.'}</p>
 {!english&&showEnglishLink&&<p class="english-search"><a href="/en/airport-assistance/" lang="en">다른 항공사도 영문 이름·코드로 찾기 · English →</a></p>}
</section>
<script>
import {normalizeAirlineQuery,matchesAirline} from '../lib/airport-airline-search.mjs';
for(const root of document.querySelectorAll<HTMLElement>('[data-airline-finder]')){
 const query=root.querySelector<HTMLInputElement>('#airline-query')!,select=root.querySelector<HTMLSelectElement>('#airline-incident'),fold=root.querySelector<HTMLDetailsElement>('[data-airline-results]')!,cards=[...root.querySelectorAll<HTMLElement>('[data-airline-result]')],english=root.dataset.english==='true',status=root.querySelector<HTMLElement>('[data-airline-status]')!;
 const knownCodes=cards.flatMap(card=>(card.dataset.airlineCodes||'').split(','));
 function filter(){const value=normalizeAirlineQuery(query.value),kind=select?.value||'all';let count=0;for(const card of cards){card.hidden=(!english&&!value&&card.dataset.korean!=='true')||!matchesAirline(value,card.dataset.airlineSearch!,(card.dataset.airlineCodes||'').split(','),knownCodes);if(!card.hidden)count++;for(const link of card.querySelectorAll<HTMLElement>('[data-incident]'))link.hidden=kind!=='all'&&link.dataset.incident!==kind;}root.querySelector<HTMLElement>('[data-airline-empty]')!.hidden=count>0;if(value){fold.open=count>0;status.textContent=english?`${count} matching airline${count===1?'':'s'}.`:`항공사 ${count}곳의 안내를 찾았어요.`;}else{status.textContent=english?`${count} airlines in the existing records.`:'항공사 이름을 입력하거나 아래 목록을 펼쳐보세요.';}}
 query.addEventListener('input',filter);select?.addEventListener('change',filter);
 const params=new URLSearchParams(location.search);if(params.get('airline'))query.value=params.get('airline')!;filter();
 if(english&&location.hash.startsWith('#airline-')){const target=document.getElementById(location.hash.slice(1));if(target){fold.open=true;requestAnimationFrame(()=>target.scrollIntoView({block:'start'}));}}
}
</script>
<style>.airline-finder{margin:56px 0}.airline-finder h2{margin-bottom:12px}.airline-finder label{display:block;font-weight:700;margin:20px 0 8px}.airline-finder input,.airline-finder select{width:100%;min-height:52px;padding:12px 16px;border:1px solid #b6cbd0;border-radius:10px;font:inherit;color:inherit;background:white}.airline-finder input:focus-visible,.airline-finder select:focus-visible{outline:3px solid #267e89;outline-offset:3px}.airline-finder summary{cursor:pointer;font-weight:700;color:#267e89;padding:14px 0}.airline-results-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.airline-results-grid article{padding:22px;border:1px solid #dce5e8;border-radius:14px;background:white;min-width:0;scroll-margin-top:150px}.airline-results-grid h3{margin:0;font-size:20px;overflow-wrap:anywhere}.airline-results-grid small{font-size:13px;color:#61717e}.airline-actions{display:grid;gap:12px}.airline-actions a{display:block}.search-status,.english-search{font-size:14px}.airline-finder [hidden]{display:none!important}.search-empty{padding:20px;background:#edf5f6;border-radius:12px}@media(max-width:650px){.airline-results-grid{grid-template-columns:1fr}}</style>
