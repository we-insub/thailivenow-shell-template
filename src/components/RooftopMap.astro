---
import rooftops from '../data/rooftops.json';
import {cities as references} from '../data/map';
const {venues=rooftops,initialCity='bangkok',detail=false,access=[]}=Astro.props;
const cityNames={'all':'전체','bangkok':'방콕','chiang-mai':'치앙마이','pattaya':'파타야','phi-phi':'피피섬','phuket':'푸켓','samui':'코사무이'};
const centers=Object.fromEntries(references.map(c=>[c.id,c.center]));centers['phi-phi']=[98.78112,7.74433];
---
<section class="rooftop-map-section"><h2 id="rooftop-map-title">{detail?'시설 위치':`${cityNames[initialCity]||'태국'} 루프탑·전망대 지도`}</h2><div id="rooftop-map" data-venues={JSON.stringify(venues)} data-access={JSON.stringify(access)} data-centers={JSON.stringify(centers)} data-city={initialCity} data-detail={String(detail)} data-city-name={cityNames[initialCity]||'태국'} aria-label="도시별 루프탑·전망대 위치 지도"></div><p class="map-note">{detail?'핀은 시설이 있는 건물 위치예요. 아래 이동 안내와 목적지 이름을 함께 확인하세요.':'핀은 건물·관람 시설 위치예요. 입구와 이용층, 방문 조건은 상세페이지에서 확인하세요.'}</p></section>
<script>
import { Map } from '../scripts/resilient-map';
import {Marker,Popup,NavigationControl,LngLatBounds,setWorkerUrl} from 'maplibre-gl';
import workerUrl from 'maplibre-gl/dist/maplibre-gl-csp-worker.js?url';
import 'maplibre-gl/dist/maplibre-gl.css';setWorkerUrl(workerUrl);
const el=document.getElementById('rooftop-map')!;
const venues=JSON.parse(el.dataset.venues!),centers=JSON.parse(el.dataset.centers!);
const map=new Map({container:el,center:centers[el.dataset.city!],zoom:12,scrollZoom:false});map.addControl(new NavigationControl());
const accessPoints=JSON.parse(el.dataset.access||'[]').filter(p=>Number.isFinite(p.lng)&&Number.isFinite(p.lat));
for(const p of accessPoints){const button=document.createElement('button');button.className='rooftop-pin access-pin';button.textContent=p.name+(p.english?' ('+p.english+')':'');button.setAttribute('aria-label',button.textContent);const box=document.createElement('div');const heading=document.createElement('strong');heading.textContent=button.textContent;const text=document.createElement('p');text.textContent=p.instructions;box.append(heading,text);if(p.detailUrl){const link=document.createElement('a');link.href=p.detailUrl;link.textContent='역·선착장 상세 →';box.append(link);}if(p.directionsUrl){const link=document.createElement('a');link.href=p.directionsUrl;link.textContent='길찾기 ↗';link.target='_blank';link.rel='noopener noreferrer';box.append(document.createElement('br'),link);}new Marker({element:button}).setLngLat([p.lng,p.lat]).setPopup(new Popup({offset:18}).setDOMContent(box)).addTo(map);}
// Multiple venues can occupy the same building. Keep the real coordinate and
// expose every venue in one popup, rather than offsetting or obscuring pins.
const groups=new globalThis.Map<string,typeof venues>();
for(const venue of venues.filter(v=>Number.isFinite(v.lng)&&Number.isFinite(v.lat))){
  const key=venue.lat+','+venue.lng;
  groups.set(key,[...(groups.get(key)||[]),venue]);
}
const markers=[...groups.values()].map(group=>{
  const v=group[0],button=document.createElement('button');
  button.className='rooftop-pin';
  const popup=new Popup({offset:18});
  const marker=new Marker({element:button}).setLngLat([v.lng,v.lat]).setPopup(popup).addTo(map);
  button.addEventListener('click',()=>{for(const card of document.querySelectorAll<HTMLElement>('[data-rooftop-id]'))card.classList.toggle('selected',group.some(venue=>venue.id===card.dataset.rooftopId));});
  return {group,v,marker,popup,button};
});
let facilityKind=['rooftop','viewpoint'].includes(new URLSearchParams(location.search).get('type')||'')?new URLSearchParams(location.search).get('type')!:'all';
function selectCity(city:string){
  const visible=[];
  for(const pin of markers){
    const shown=pin.group.filter(v=>(city==='all'||v.city===city)&&(facilityKind==='all'||(v.facilityCategory||'rooftop')===facilityKind));
    pin.button.hidden=shown.length===0;pin.popup.remove();
    if(!shown.length)continue;
    visible.push(pin);
    pin.button.textContent=shown.length===1?shown[0].name:shown[0].name+' 외 '+(shown.length-1)+'곳';
    pin.button.setAttribute('aria-label',shown.map(v=>v.name).join(', '));
    pin.button.classList.toggle('viewpoint-pin',shown.every(v=>v.facilityCategory==='viewpoint'));
    const content=document.createElement('div');
    for(const venue of shown){const row=document.createElement('p'),link=document.createElement('a');link.href='/ko/rooftops/'+venue.id+'/';link.textContent=venue.name+' ('+venue.english+') →';row.append(link);content.append(row);}
    pin.popup.setDOMContent(content);
  }
  if(visible.length){const bounds=new LngLatBounds();visible.forEach(p=>bounds.extend([p.v.lng,p.v.lat]));accessPoints.forEach(p=>bounds.extend([p.lng,p.lat]));map.fitBounds(bounds,{padding:60,maxZoom:el.dataset.detail==='true'?15:13.8,duration:0});}
  else if(centers[city])map.jumpTo({center:centers[city],zoom:city==='phi-phi'?12:11});
  document.getElementById('rooftop-map-title')!.textContent=el.dataset.detail==='true'?'시설 위치':el.dataset.cityName+' '+(facilityKind==='viewpoint'?'전망대':facilityKind==='rooftop'?'루프탑':'루프탑·전망대')+' 지도';
}
selectCity(el.dataset.city!);
document.addEventListener('rooftop:filter',(event:CustomEvent)=>{facilityKind=event.detail.kind;selectCity(el.dataset.city!);});
for(const button of document.querySelectorAll<HTMLButtonElement>('[data-city-filter]'))button.addEventListener('click',()=>selectCity(button.dataset.cityFilter!));
</script>
<style>:global(.rooftop-pin.viewpoint-pin){background:#7253a0}:global(.access-pin){background:#385f9e}#rooftop-map{height:440px;border-radius:14px;border:1px solid #dce5e8;overflow:hidden}.map-note{font-size:12px;color:#61717e}:global(.rooftop-pin){padding:8px 12px;border:2px solid white;border-radius:22px;color:white;background:#267e89;box-shadow:0 2px 7px #0003;font-weight:700;cursor:pointer}:global(.rooftop-pin[hidden]){display:none}:global(.maplibregl-popup-content a){color:#267e89}@media(max-width:600px){#rooftop-map{height:340px}}</style>
