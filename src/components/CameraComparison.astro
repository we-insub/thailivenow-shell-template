---
import {cameraViewingCopy} from '../lib/camera-viewing-copy.mjs';
import editorial from '../data/camera-editorial-ko.json';
import DetailHeader from './DetailHeader.astro';
import SiteFooter from './SiteFooter.astro';
import CameraActions from './CameraActions.astro';
import {locales} from '../i18n/locales';
import {cameras} from '../data/cameras';
import {getUI,cameraTitle as originalCameraTitle,cameraStatus,previewLabel,sourceText} from '../i18n/ui';
const {locale='ko'}=Astro.props;
const ui=getUI(locale),active=locales.find(v=>v.code===locale)!,ko=locale==='ko';
const cameraTitle=(camera,market)=>market==='ko'?editorial[camera.id].displayTitle:originalCameraTitle(camera,market);
---
<!doctype html><html lang={active.tag} data-locale={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><link rel="icon" href="/favicon.svg"/><title>{ko?'카메라 비교':'Camera comparison'} | ThaiLiveNow</title></head><body><DetailHeader locale={locale} home/><main class="content-container"><header class="page-heading"><nav class="breadcrumbs"><a href={`/${locale}/saved/`}>{ko?'저장한 카메라':'Saved cameras'}</a> › {ko?'카메라 비교':'Camera comparison'}</nav><h1>{ko?'카메라 비교':'Camera comparison'}</h1><p>{ko?'최대 4개 카메라의 풍경·원본·촬영 위치 안내를 함께 비교하세요.':'Compare the views, sources and location notes of up to four cameras.'}</p></header><p id="comparison-empty">{ko?'목록이나 상세페이지에서 비교에 추가를 눌러주세요.':'Select Add to compare in the directory or camera details.'}</p><div class="comparison-grid">{cameras.map(camera=><article class="comparison-card" data-comparison-card={camera.id} hidden><div class="thumbnail">{ko?<span class="map-place-preview">{editorial[camera.id].place}</span>:<img src={camera.preview?.url} alt={ko?`${camera.area} 지역 참고사진 · 현재 카메라 화면 아님`:cameraTitle(camera,locale)} loading="lazy" referrerpolicy="no-referrer"/>}</div><div class="tile-copy">{!ko&&camera.preview&&<p class="comparison-credit"><a href={camera.preview.sourceUrl} target="_blank" rel="noopener noreferrer">사진: {camera.preview.credit}</a>{camera.preview.licenseUrl&&<> · <a href={camera.preview.licenseUrl} target="_blank" rel="noopener noreferrer">{camera.preview.license}</a></>} · 크기 조정·일부 잘림</p>}<h2>{cameraTitle(camera,locale)}</h2><p>{locale==='ko'?editorial[camera.id].preview:ui.cameraIntro}</p><p>{ko?cameraViewingCopy(camera).label+' · '+cameraViewingCopy(camera).short:cameraStatus(camera,locale)}</p><p>{locale==='ko'?editorial[camera.id].location:ui.locationNote}</p><a href={camera.sourceUrl} target="_blank" rel="noopener noreferrer">{sourceText(camera.sourceName,locale)} ↗</a><CameraActions id={camera.id} locale={locale}/><a class="secondary-link" href={`/${locale}/cameras/${camera.id}/`}>{ko?'장소와 풍경 보기':ui.details} →</a></div></article>)}</div></main><SiteFooter locale={locale}/></body></html>

<style>.thumbnail{position:relative}.comparison-photo-label{position:absolute;z-index:1;bottom:8px;left:8px;right:8px;width:fit-content;max-width:calc(100% - 16px);font-size:12px;line-height:1.6;padding:5px 8px;border-radius:5px;color:white;background:#203743e6}</style>

<style>.comparison-card .comparison-credit{font-size:11px;line-height:1.6;color:#61717e}</style>

<style>.map-place-preview{display:flex;align-items:center;justify-content:center;min-height:120px;padding:20px;background:linear-gradient(135deg,#203b4c,#267e89);color:white;font-size:20px;line-height:1.6;font-weight:700;text-align:center;overflow-wrap:anywhere}</style>
