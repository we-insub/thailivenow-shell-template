---
const {points,title,note,ui,compact=false}=Astro.props;
---
<section class="beach-map-section"><h2>{title}</h2><p>{ui.mapInstructions}</p><div class="beach-place-map" data-beach-points={JSON.stringify(points)} data-map-locale={JSON.stringify({'NavigationControl.ZoomIn':ui.zoomIn,'NavigationControl.ZoomOut':ui.zoomOut,'NavigationControl.ResetBearing':ui.resetBearing})} data-link-label={ui.detail} data-compact={compact?'true':undefined} aria-label={title}></div><p class="map-note">{note||ui.mapNote}</p><small><a href="https://www.openstreetmap.org/copyright">© {ui.contributors} · ODbL</a></small></section>
<script>
import {Map} from '../scripts/resilient-map';
import {Marker,Popup,NavigationControl,LngLatBounds,setWorkerUrl} from 'maplibre-gl';
import workerUrl from 'maplibre-gl/dist/maplibre-gl-csp-worker.js?url';
import 'maplibre-gl/dist/maplibre-gl.css';
setWorkerUrl(workerUrl);
for(const el of document.querySelectorAll<HTMLElement>('.beach-place-map')){
 const points=JSON.parse(el.dataset.beachPoints!);if(!points.length)continue;
 const map=new Map({container:el,center:[points[0].lng,points[0].lat],zoom:11,scrollZoom:false,locale:JSON.parse(el.dataset.mapLocale!)});
 map.addControl(new NavigationControl());const bounds=new LngLatBounds();
 for(const p of points){bounds.extend([p.lng,p.lat]);const button=document.createElement('button');button.className='beach-place-pin';button.textContent=p.name;button.setAttribute('aria-label',p.name);const box=document.createElement('div');const name=document.createElement('strong');name.textContent=p.name;const text=document.createElement('p');text.textContent=p.text;const link=document.createElement('a');link.href=p.url;link.textContent=p.linkLabel||el.dataset.linkLabel!;box.append(name,text,link);new Marker({element:button}).setLngLat([p.lng,p.lat]).setPopup(new Popup({offset:18}).setDOMContent(box)).addTo(map);}
 map.fitBounds(bounds,{padding:70,maxZoom:13,duration:0});
 if(el.dataset.compact==='true'){const update=()=>el.querySelectorAll<HTMLElement>('.beach-place-pin').forEach(b=>b.classList.toggle('compact',map.getZoom()<9));map.on('zoom',update);update();}
}
</script>
<style>.beach-place-map{height:420px;border:1px solid #dfe7ea;border-radius:14px;overflow:hidden}.map-note,small{font-size:12px;color:#61717e}:global(.beach-place-pin){border:2px solid white;border-radius:20px;background:#267e89;color:white;padding:8px 12px;box-shadow:0 2px 6px #0003;font-weight:700;cursor:pointer;max-width:180px;font-size:12px}:global(.beach-place-pin.compact){font-size:0;width:17px;height:17px;padding:0;min-width:0;min-height:0;border-radius:50%}@media(max-width:600px){.beach-place-map{height:340px}}</style>
