---
import SiteFooter from './SiteFooter.astro';
import AirportPageMetadata from './AirportPageMetadata.astro';
import DetailHeader from './DetailHeader.astro';
import {isKoreanAirportGuide} from '../lib/airport-guide-navigation.mjs';
const { title, description, editorial = false, intro=description, parentUrl:customParentUrl, parentLabel:customParentLabel } = Astro.props;
const airportGuide=isKoreanAirportGuide(Astro.url.pathname);
const parentUrl=customParentUrl||(airportGuide?'/ko/airports/':'/ko/airport-assistance/');
const parentLabel=customParentLabel||(airportGuide?'태국 공항 목록':'지연·결항·수하물 대응 안내');
---
<!doctype html><html lang="ko"><head><link rel="icon" href="/favicon.ico?v=20261013" sizes="16x16 32x32 48x48" /><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261013" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261013" /><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="index,follow"/><title>{title} | ThaiLiveNow</title><meta name="description" content={description}/><AirportPageMetadata title={title} description={description} parentUrl={customParentUrl} parentLabel={customParentLabel}/></head><body><DetailHeader/><main class:list={["thai-detail", {"caat-editorial": editorial}]}><a href={parentUrl}>← {parentLabel}</a><h1>{title}</h1><p class="detail-intro">{intro}</p><slot/></main><SiteFooter/></body></html>
<style>
:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,sans-serif;line-height:1.8}:global(*){box-sizing:border-box}main{max-width:1000px;margin:auto;padding:32px 24px 60px}h1{font-size:32px;line-height:1.4}:global(main section){margin:34px 0}:global(main a){color:#2e7c89;font-weight:700}:global(main p),:global(main li){color:#61717e}:global(main h2){font-size:24px}:global(main .links){display:flex;gap:18px;flex-wrap:wrap}@media(max-width:600px){main{padding:24px 16px}h1{font-size:27px}}
:global(main article){padding:20px;background:white;border:1px solid #dce5e8;border-radius:12px;margin:12px 0}:global(main details:not(.source-fold)){padding:18px 20px;background:white;border:1px solid #dce5e8;border-radius:12px;margin:12px 0}:global(main summary){cursor:pointer;font-weight:600}:global(main p){overflow-wrap:anywhere}
</style>

<style>
:global(.thai-detail .response-section){margin:52px 0}:global(.thai-detail .response-section h2){margin-bottom:18px}:global(.thai-detail .response-section p){margin:16px 0 24px}:global(.thai-detail .secondary-records){margin:36px 0;border-top:1px solid #dce5e8;padding-top:20px}:global(.thai-detail .secondary-records>summary){font-size:20px;line-height:1.5}:global(.thai-detail .task-links){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}:global(.thai-detail .task-links a){display:block;padding:20px;border:1px solid #dce5e8;border-radius:12px;background:white;text-decoration:none}:global(.thai-detail .detail-intro){font-size:18px;line-height:1.9}:global(.thai-detail details.secondary-records){background:transparent;border-width:1px 0 0;border-radius:0;padding:24px 0}@media(max-width:600px){:global(.thai-detail .task-links){grid-template-columns:1fr}}
</style>
