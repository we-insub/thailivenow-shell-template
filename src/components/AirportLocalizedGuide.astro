---
import {airportDepthGuide,airportDepthDirectory,airportDepthUI,airportFacilityName} from '../lib/airport-depth';
import AirportLocalizedMap from './AirportLocalizedMap.astro';
import ImportantText from './ImportantText.astro';
import RuntimeDate from './RuntimeDate.astro';
import AirportRepresentativePhoto from './AirportRepresentativePhoto.astro';
const {code,locale='en',part='all',faqItems,emitSchema=true}=Astro.props;
const ui=airportDepthUI(locale),guide=airportDepthGuide(code,locale),directory=airportDepthDirectory(code,locale);
const overview=part==='all'||part==='overview',showMap=['all','map','smoking'].includes(part),showSmoking=part==='all'||part==='smoking',facilities=part==='all'||part==='map';
const highlights=['B1','SAT-1','F67','L16','G9','1722','06:00–24:00','08:00–17:00','45','40','60','30'];
const rows=directory.maps.flatMap((m:any)=>m.facilities.map((f:any)=>({...f,mapId:m.id,mapLabel:m.label,displayName:airportFacilityName(f.store_name,locale),categoryLabel:f.categoryLabel,lockLabel:['AIRPORT_INFORMATION','MONEY_EXCHANGE'].includes(f.lock_no)?f.lock_no.replaceAll('_',' '):f.lock_no})));
const smokingSources=guide.smoking.flatMap((s:any)=>s.sources) as string[];
const isOfficial=(s:string)=>['.airportthai.co.th/','prioritypass.com/','airindia.com/'].some(host=>s.includes(host));
const officialSources=[...new Set([...guide.officialSources,directory.source,...smokingSources.filter(isOfficial)])].filter(Boolean) as string[];
const reports=[...new Set(smokingSources)].filter(s=>!isOfficial(s)) as string[];
const sections=guide.sections.filter((_:any,index:number)=>(code!=='BKK'||index!==0)&&(part==='all'||part==='map'));
const faq=faqItems||guide.faq;
const mapDatePath=part==='overview'?undefined:'/ko/airport-assistance/airports/'+code.toLowerCase()+'/#facility-map';
---
{guide&&<div class="airport-korean-guide" data-airport-korean-guide data-localized-airport-guide={locale} data-airport-facilities data-facility-copy={JSON.stringify({count:ui.count,empty:ui.empty})}>
 {overview&&<section class="airport-introduction"><h2>{ui.firstVisit.replace('{name}',guide.name)}</h2>{guide.intro.map((p:string)=><p>{p}</p>)}<AirportRepresentativePhoto code={code} locale={locale}/><dl class="airport-basics">{guide.facts.map(([label,value]:string[])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>}
 {showMap&&<AirportLocalizedMap locale={locale} code={code} directory={directory} pins={guide.pins} defaultMap={part==='smoking'?'11':guide.defaultMap}/>}
 {showSmoking&&<section aria-labelledby={`smoking-${code}`}><h2 id={`smoking-${code}`}>{ui.smokingTitle}</h2>
  <p>{ui.smokingIntro}</p>
  <div class="smoking-list">{guide.smoking.map((s:any)=><article class="smoking-place"><span class="access-label">{s.access}</span><h3>{s.title}</h3><p class="evidence-status">{s.status}</p>{s.body.map((p:string)=><p><ImportantText text={p} phrases={highlights}/></p>)}{s.mapId&&<button type="button" data-map-target={s.mapId} data-target-pin={s.pin}>{ui.pinButton}</button>}</article>)}</div>
 </section>}
 {overview&&guide.steps.map((s:any)=><section><h2>{s.title}</h2><ol class="airport-steps">{s.items.map((p:string)=><li><ImportantText text={p} phrases={highlights}/></li>)}</ol></section>)}
 {facilities&&<section aria-labelledby={`facility-title-${code}`}><h2 id={`facility-title-${code}`}>{ui.facilitiesTitle}</h2><p>{ui.facilitiesIntro}</p>
  <div class="facility-filters"><label>{ui.search}<input type="search" data-facility-search placeholder={ui.searchPlaceholder}/></label><label>{ui.floor}<select data-facility-floor><option value="">{ui.allFloors}</option>{directory.maps.map((m:any)=><option value={m.id} selected={m.id===guide.defaultMap}>{m.label}</option>)}</select></label><label>{ui.category}<select data-facility-category><option value="">{ui.allCategories}</option>{[...new Set(rows.map((r:any)=>r.categoryLabel))].map((name:any)=><option value={name}>{name}</option>)}</select></label></div>
  <p data-facility-count role="status"></p><div class="facility-rows">{rows.map((r:any)=><article data-facility-row data-map-id={r.mapId} data-category={r.categoryLabel} data-search={[r.displayName,r.store_name,r.lock_no,r.mapLabel,r.categoryLabel].join(' ').toLowerCase().replace(/\s/g,'')} hidden={r.mapId!==guide.defaultMap}><h3>{r.displayName}</h3>{r.displayName!==r.store_name&&<p class="original-name" lang="en">{r.store_name}</p>}<p>{r.mapLabel} · {r.categoryLabel}</p>{r.lockLabel&&<p>{ui.mapCode}: <strong>{r.lockLabel}</strong></p>}<button type="button" data-map-target={r.mapId}>{ui.floorButton}</button></article>)}</div>
 </section>}
 {sections.map((s:any)=><section><h2>{s.title}</h2>{s.body.map((p:string)=><p><ImportantText text={p} phrases={highlights}/></p>)}{s.link&&<p><a href={s.link.url} target="_blank" rel="noopener noreferrer">{s.link.label}</a></p>}</section>)}
 <section><h2>{ui.faq.replace('{name}',guide.name)}</h2>{faq.map((f:any)=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
 <section class="guide-sources"><p>{ui.sourceDate}: <RuntimeDate kind="source" fallback={part==='overview'?guide.legacyCheckedAt:directory.checkedOn} pagePath={mapDatePath} locale={locale}/></p><details class="source-fold"><summary>{ui.sources} · {officialSources.length}</summary><ul>{officialSources.map(url=><li><a href={url} target="_blank" rel="noopener noreferrer">{new URL(url).hostname} · {decodeURIComponent(new URL(url).pathname.split('/').at(-1)||ui.mapSource)}</a></li>)}</ul></details>{showSmoking&&reports.length>0&&<details class="source-fold"><summary>{ui.reports} · {reports.length}</summary><p>{ui.reportsIntro}</p><ul>{reports.map(url=><li><a href={url} target="_blank" rel="noopener noreferrer">{new URL(url).hostname} · {ui.reportLabel}</a></li>)}</ul></details>}</section>
</div>}
{emitSchema&&faq.length>0&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map((f:any)=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}).replaceAll('<','\\u003c')}/>}
<style>
.airport-korean-guide{margin:32px 0 44px;border-bottom:1px solid #dce5e8;padding-bottom:30px}.airport-korean-guide section{margin:42px 0}.airport-korean-guide h2{font-size:25px;line-height:1.5;margin:0 0 18px}.airport-korean-guide h3{font-size:19px;line-height:1.5;margin:6px 0 12px}.airport-korean-guide p{line-height:1.95;margin:12px 0;color:#61717e;overflow-wrap:anywhere}.airport-photo{margin:28px 0}.airport-photo img{width:100%;height:auto;display:block;border-radius:12px}.airport-photo figcaption{font-size:12px;color:#61717e;margin-top:9px}.airport-photo a{font-weight:400!important}.airport-basics{margin:28px 0 0}.airport-basics>div{display:grid;grid-template-columns:180px minmax(0,1fr);border-bottom:1px solid #e0e7eb;padding:14px 0;gap:16px}.airport-basics dt{font-weight:700}.airport-basics dd{margin:0;color:#61717e}.airport-steps{padding-left:25px}.airport-steps li{line-height:1.95;padding:8px 0 14px 6px}.smoking-list{display:grid;gap:22px}.smoking-place{padding:24px!important}.access-label{color:#287a86;font-size:13px;font-weight:700}.evidence-status{font-size:13px}.airport-korean-guide button{font:inherit;padding:10px 14px;border:1px solid #b9ced4;border-radius:8px;background:#edf6f7;color:#276c77;cursor:pointer;font-weight:650}.facility-filters{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:14px;margin:22px 0}.facility-filters label{font-size:13px;font-weight:700;display:flex;flex-direction:column;gap:7px;min-width:0}.facility-filters input,.facility-filters select{font:inherit;padding:12px;border:1px solid #c8d9df;border-radius:8px;min-width:0;background:white;color:#253545}.facility-rows{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.facility-rows article{margin:0!important;min-width:0}.facility-rows [hidden]{display:none!important}.facility-rows p{font-size:14px}.facility-rows .original-name{font-size:12px}.guide-sources{font-size:13px}.source-fold{padding:16px!important}.source-fold li{margin:10px 0;overflow-wrap:anywhere}.source-fold a{font-size:12px;font-weight:400!important}.airport-korean-guide :global([data-guide-map]){scroll-margin-top:125px}@media(max-width:650px){.airport-basics>div{grid-template-columns:1fr;gap:4px}.facility-filters,.facility-rows{grid-template-columns:1fr}.airport-korean-guide h2{font-size:22px}.smoking-place{padding:20px!important}}
</style>
