---
import stations from '../data/transport/bangkok-stations.json';
const names=['Suvarnabhumi','Makkasan','Phetchaburi','Phaya Thai','Siam','Sukhumvit','Asok','Sala Daeng','Si Lom','Sanam Chai'];
const ko={'Suvarnabhumi':'수완나품 공항','Makkasan':'ARL 마카산','Phetchaburi':'MRT 펫차부리','Phaya Thai':'파야타이','Siam':'시암','Sukhumvit':'MRT 수쿰윗','Asok':'BTS 아속','Sala Daeng':'BTS 살라댕','Si Lom':'MRT 실롬','Sanam Chai':'MRT 사남차이'};
const points=stations.filter(s=>names.includes(s.properties.name)).map(s=>({name:ko[s.properties.name],english:s.properties.name,coords:s.geometry.coordinates,url:`/ko/transport/bangkok/stations/${s.properties.station_id}/`}));
---
<div class="airport-rail-explorer" data-points={JSON.stringify(points)}>
<p>빨간선은 공항철도, 파란선은 MRT 블루라인, 초록선은 BTS 수쿰윗선이에요. 환승 위치를 선택하면 해당 역 주변으로 확대돼요.</p>
<div class="transfer-controls" aria-label="공항철도 환승 위치"><button data-transfer="all" aria-pressed="true">공항부터 시내까지</button><button data-transfer="makkasan">마카산 → MRT 펫차부리</button><button data-transfer="phayathai">파야타이 → BTS</button></div>
<div id="airport-access-map" aria-label="공항철도 실제 노선과 환승역 지도"></div>
<p class="legend"><span style="--color:#d52328">ARL 공항철도</span><span style="--color:#2454b3">MRT 블루라인</span><span style="--color:#43a047">BTS 수쿰윗선</span></p><details class="station-directory"><summary>환승역·주요 역 상세 보기 ({points.length})</summary><div class="station-links">{points.map(p=><a href={p.url}>{points.indexOf(p)+1}. {p.name} ({p.english}) →</a>)}</div></details>
<small>실제 철도 형상·역 위치: <a href="https://www.openstreetmap.org/copyright">© OpenStreetMap 기여자 · ODbL</a>. 역 핀은 출구 위치와 구분하세요.</small>
</div>
<script>
import { Map } from '../scripts/resilient-map';
import {Marker,Popup,NavigationControl,LngLatBounds,setWorkerUrl} from 'maplibre-gl';import worker from 'maplibre-gl/dist/maplibre-gl-csp-worker.js?url';import 'maplibre-gl/dist/maplibre-gl.css';setWorkerUrl(worker);
const section=document.querySelector<HTMLElement>('.airport-rail-explorer');
if(section){const points=JSON.parse(section.dataset.points!);const map=new Map({container:'airport-access-map',center:[100.63,13.73],zoom:10.8,scrollZoom:false});map.addControl(new NavigationControl());
for(const p of points){const button=document.createElement('button');button.className='airport-station-dot';button.textContent=String(points.indexOf(p)+1);const label=document.createElement('span');label.className='airport-pin-label';label.textContent=p.name;button.append(label);if(['Suvarnabhumi','Makkasan','Phaya Thai'].includes(p.english))button.classList.add('major-stop');if(p.english==='Suvarnabhumi')button.classList.add('label-left');const content=document.createElement('div');const title=document.createElement('strong');title.textContent=p.name+' ('+p.english+')';const link=document.createElement('a');link.href=p.url;link.textContent='역 상세·연결 노선 →';content.append(title,document.createElement('br'),link);new Marker({element:button}).setLngLat(p.coords).setPopup(new Popup({offset:12}).setDOMContent(content)).addTo(map);button.setAttribute('aria-label',p.name+' ('+p.english+')');}
map.on('zoom',()=>section!.classList.toggle('show-local-labels',map.getZoom()>=14));
function focus(id:string){section!.dataset.focus=id;if(id==='makkasan')map.jumpTo({center:[100.5629,13.7499],zoom:15});else if(id==='phayathai')map.jumpTo({center:[100.534,13.7568],zoom:15});else{const bounds=new LngLatBounds();points.filter(p=>['Suvarnabhumi','Phaya Thai','Makkasan'].includes(p.english)).forEach(p=>bounds.extend(p.coords));map.fitBounds(bounds,{padding:45,maxZoom:12,duration:0});}section!.querySelectorAll<HTMLButtonElement>('[data-transfer]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.transfer===id)));}
section.querySelectorAll<HTMLButtonElement>('[data-transfer]').forEach(b=>b.addEventListener('click',()=>focus(b.dataset.transfer!)));focus('all');
map.on('load',async()=>{try{const r=await fetch('/data/bangkok-rail.geojson');if(!r.ok)throw Error('network');const data=await r.json();const ids=['arl','mrt-blue','bts-sukhumvit'];map.addSource('airport-rail',{type:'geojson',data:{type:'FeatureCollection',features:data.routes.features.filter(f=>ids.includes(f.properties.line_id))}});map.addLayer({id:'airport-rail-lines',type:'line',source:'airport-rail',paint:{'line-color':['get','color'],'line-width':4}});}catch{const p=document.createElement('p');p.textContent='노선 지도를 불러오지 못했어요. 아래 역 상세와 환승 표를 이용해 주세요.';section!.append(p);}});
}
</script>
<style>
.airport-rail-explorer{min-width:0}.station-directory{margin:16px 0;border:1px solid #dce5e8;border-radius:12px;background:#fff;padding:14px 16px}.station-directory summary{cursor:pointer;font-weight:700;color:#267e89;font-size:14px}.station-links{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))}.station-links a{display:block;overflow-wrap:anywhere}.airport-rail-explorer>p:first-child{font-size:14px;line-height:1.7}.legend span{white-space:nowrap}.airport-rail-explorer small{display:block;font-size:11px;line-height:1.7}
#airport-access-map{height:440px;border-radius:14px;border:1px solid #dce5e8}.transfer-controls,.legend,.station-links{display:flex;flex-wrap:wrap;gap:10px;margin:16px 0}.transfer-controls button{border:1px solid #dce5e8;border-radius:24px;padding:10px 14px;background:white;color:#267e89;cursor:pointer}.transfer-controls button[aria-pressed=true]{background:#267e89;color:white}.legend{font-size:13px}.legend span:before{content:'';display:inline-block;width:18px;height:4px;background:var(--color);margin-right:6px;vertical-align:middle}.station-links a{border:1px solid #dce5e8;padding:8px 12px;border-radius:8px;font-size:13px}small{color:#61717e}:global(.airport-station-dot){width:26px;height:26px;border:2px solid white;border-radius:50%;background:#253545;color:white;cursor:pointer;box-shadow:0 2px 5px #0003;font-size:12px;padding:0}:global(.maplibregl-popup-content){font-family:system-ui,sans-serif}:global(.maplibregl-popup-content a){color:#267e89}:global(.airport-pin-label){display:none;position:absolute;left:24px;top:-1px;white-space:nowrap;background:#fffffff2;color:#253545;border-radius:5px;padding:2px 5px;font-size:11px;box-shadow:0 1px 3px #0002}:global(.label-left .airport-pin-label){left:auto;right:24px}:global(.major-stop .airport-pin-label),:global(.show-local-labels .airport-pin-label){display:block}@media(max-width:600px){#airport-access-map{height:360px}.transfer-controls button{font-size:12px}}
</style>

<style>
@media(max-width:600px){.transfer-controls{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0}.transfer-controls button{border-radius:10px;min-height:44px;padding:10px 8px;line-height:1.5}.transfer-controls button:first-child{grid-column:1/-1}.legend{display:grid;grid-template-columns:1fr;gap:6px;background:#fff;border:1px solid #dce5e8;border-radius:10px;padding:12px}.station-links{grid-template-columns:1fr!important;gap:8px}.station-links a{min-height:44px;padding:10px 12px}#airport-access-map{height:400px}:global(.airport-rail-explorer[data-focus=all] .airport-pin-label){display:none}:global(.airport-station-dot){width:28px;height:28px;font-size:11px;font-weight:700}:global(.airport-rail-explorer .maplibregl-ctrl-attrib){font-size:9px;max-width:230px}}
</style>