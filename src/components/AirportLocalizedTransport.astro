---
import {airportTransportGuide,airportDepthUI} from '../lib/airport-depth';
import AirportLocalizedRailMap from './AirportLocalizedRailMap.astro';
import AirportLocalizedTransferChooser from './AirportLocalizedTransferChooser.astro';
const {locale}=Astro.props,g=airportTransportGuide(locale),ui=airportDepthUI(locale);
---
<div class="transport-guide"><AirportLocalizedTransferChooser locale={locale}/>{g.sections.filter((s:any)=>s.map==='rail').map((s:any)=><section id={s.id}><h2>{s.title}</h2><AirportLocalizedRailMap locale={locale}/></section>)}{g.sections.filter((s:any)=>s.map!=='rail').map((s:any)=><section id={s.id}><h2>{s.title}</h2>{s.paragraphs.map((p:string)=><p>{p}</p>)}{s.table&&<div class="table-wrap"><table><thead><tr>{s.table.headers.map((h:string)=><th scope="col">{h}</th>)}</tr></thead><tbody>{s.table.rows.map((row:string[])=><tr>{row.map((cell,i)=><td data-label={s.table.headers[i]}>{cell}</td>)}</tr>)}</tbody></table></div>}{s.links&&<div class="links">{s.links.map(([label,url]:string[])=><a href={url} target={url.startsWith('http')?'_blank':undefined} rel={url.startsWith('http')?'noopener noreferrer':undefined}>{label} →</a>)}</div>}</section>)}<section><h2>{ui.faq.replace('{name}',g.name)}</h2>{g.faq.map(([q,a]:string[])=><details><summary>{q}</summary><p>{a}</p></details>)}</section><details class="source-fold"><summary>{ui.sources} · {g.sources.length}</summary><ul>{g.sources.map(([label,url]:string[])=><li><a href={url} target="_blank" rel="noopener noreferrer">{label}</a></li>)}</ul></details></div>
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:g.faq.map(([q,a]:string[])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}).replaceAll('<','\\u003c')}/>
<style>.transport-guide section{margin:36px 0;scroll-margin-top:150px}.transport-guide p{line-height:1.9}.table-wrap{overflow:auto;border:1px solid #dce5e8;border-radius:12px;background:white}table{width:100%;border-collapse:collapse;font-size:14px}th,td{text-align:left;padding:14px 16px;vertical-align:top;border-bottom:1px solid #e4ebee;min-width:120px}th{background:#eff5f6}.source-fold{font-size:13px}.source-fold li{margin:12px 0;overflow-wrap:anywhere}@media(max-width:650px){.table-wrap{border:0;background:transparent}table,tbody,tr,td{display:block;width:100%}thead{display:none}tbody tr{border:1px solid #dce5e8;border-radius:12px;background:white;margin-bottom:12px;padding:6px 12px}td{box-sizing:border-box;display:grid;grid-template-columns:100px minmax(0,1fr);gap:12px;padding:10px 0;min-width:0;border:0;border-bottom:1px solid #edf1f3}td:before{content:attr(data-label);font-weight:700;color:#61717e;font-size:12px}}</style>
