---
import RelatedTravelServices from './RelatedTravelServices.astro';
import {hasLocalizedStage,isLocalizedPage} from '../lib/localized-content';
import {siteBrand} from '../lib/site-brand.mjs';
import attractionCopy from '../data/attractions-hub-copy.json';
import {getUI} from '../i18n/ui';
const routeLocale=Astro.url.pathname.split('/')[1];
const {locale=['ko','ms','zh-cn','en','en-in','ru','ja','en-gb','en-us','es','zh-tw'].includes(routeLocale)?routeLocale:'ko'}=Astro.props;
const ui=getUI(locale);
const base=locale.startsWith('en')?'en':locale;
const footerLabels={ko:['루프탑','방문 통계 설정'],en:['Rooftops','Analytics settings'],ms:['Rooftop','Tetapan analitik'],'zh-cn':['屋顶酒吧与观景台','访问统计设置'],'zh-tw':['高空酒吧與觀景台','瀏覽統計設定'],ja:['ルーフトップ・展望台','アクセス解析の設定'],ru:['Крыши и смотровые площадки','Настройки статистики'],es:['Azoteas y miradores','Ajustes de estadísticas']}[base];
---
<footer class="site-footer tln-footer" data-site-footer>
 <div><a class="footer-brand" href={`/${locale}/`}>{siteBrand(locale)}</a><p>{ui.footer}</p><RelatedTravelServices locale={locale}/></div>
 <nav aria-label={ui.explore}><a href={`/${locale}/`}>{ui.map}</a><a href={`/${locale}/directory/`}>{ui.cameras}</a><a href={`/${locale}/transport/`}>{ui.transport}</a>{locale!=='ko'&&hasLocalizedStage(locale,'rooftops')&&<a href={`/${locale}/attractions/`}>{attractionCopy[locale][0]}</a>}{locale==='ko'&&<><a href="/ko/food/">음식</a><a href="/ko/food-delivery/">음식배달</a><a href="/ko/attractions/">관광지</a><a href="/ko/beaches/">해변</a></>}</nav>
 <small>© 2026 ThaiLiveNow</small>
 {locale==='ko'&&<nav aria-label="서비스 운영 안내"><a href="/ko/about/">서비스 소개</a><a href="/ko/contact/">문의·오류 신고</a><a href="/ko/credits/">출처 및 이용 안내</a><a href="/ko/terms/">이용약관·제휴 안내</a><a href="/ko/privacy/">개인정보 처리방침</a></nav>}
 <button type="button" data-analytics-settings>{footerLabels[1]}</button>
</footer>
<style>.tln-footer button{font:inherit;color:#267e89;background:white;border:1px solid #cddde2;border-radius:8px;padding:8px 12px;cursor:pointer}.tln-footer button:focus-visible{outline:3px solid #66a7cd;outline-offset:3px}</style>
