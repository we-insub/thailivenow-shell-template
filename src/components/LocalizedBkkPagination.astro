---
import {bkkDepthPages,airportDepthUI} from '../lib/airport-depth';
const {locale,current}=Astro.props,ui=airportDepthUI(locale),pages=bkkDepthPages(locale),index=pages.findIndex(p=>p.id===current),previous=pages[index-1],next=pages[index+1];
---
<nav class="bkk-pages" aria-label={ui.pagination} data-bkk-pagination><ol>{pages.map((p,i)=><li><a href={p.url} aria-current={p.id===current?'page':undefined}><span>{i+1}</span>{p.label}</a></li>)}</ol><div>{previous?<a href={previous.url} rel="prev">← {ui.previous} · {previous.label}</a>:<span/>}{next&&<a href={next.url} rel="next">{ui.next} · {next.label} →</a>}</div></nav>
<style>.bkk-pages{margin:28px 0 36px;padding:20px 0;border-block:1px solid #dce5e8}.bkk-pages ol{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.bkk-pages li{min-width:0}.bkk-pages a{color:#287782;text-decoration:none;font-size:14px;line-height:1.6}.bkk-pages li a{display:flex;align-items:flex-start;gap:8px;padding:12px 10px;height:100%;border:1px solid #dce5e8;background:#fff;border-radius:9px;overflow-wrap:anywhere}.bkk-pages li a[aria-current]{background:#e6f2f3;border-color:#287782;color:#183d44}.bkk-pages li span{flex:none;display:grid;place-items:center;width:23px;height:23px;border-radius:50%;background:#edf3f4;font-size:12px}.bkk-pages [aria-current] span{background:#287782;color:white}.bkk-pages>div{display:flex;justify-content:space-between;gap:20px;margin-top:16px}.bkk-pages>div>a{max-width:48%}.bkk-pages>div>a:last-child{text-align:right}@media(max-width:650px){.bkk-pages ol{grid-template-columns:1fr}.bkk-pages li a{padding:10px 12px;align-items:center}}</style>
