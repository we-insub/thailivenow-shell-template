---
import {airportKoreanReviewEnabled,airportReviewDictionary} from '../lib/airport-review';
const {locale}=Astro.props;
const enabled=airportKoreanReviewEnabled&&locale!=='ko';
---
{enabled&&<script type="application/json" id="airport-korean-review" data-locale={locale} set:html={JSON.stringify(airportReviewDictionary(locale)).replaceAll('<','\\u003c')}/>}
<script>
function addAirportReview(){
 const config=document.querySelector<HTMLScriptElement>('#airport-korean-review');
 if(!config)return;
 const translations:Record<string,string>=JSON.parse(config.textContent||'{}');
 const locale=config.dataset.locale||'en';
 const segmenter=new Intl.Segmenter(locale,{granularity:'sentence'});
 const roots=document.querySelectorAll('main');
 for(const root of roots){
 const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
 const nodes:Text[]=[];let node:Node|null;
 while((node=walker.nextNode())){const parent=node.parentElement;if(parent&&!parent.closest('script,style,[data-korean-review],[data-airport-sentence],code,textarea')&&node.textContent?.trim())nodes.push(node as Text);}
 for(const text of nodes){
 const value=text.data;
 const pieces=Array.from(segmenter.segment(value),s=>s.segment);
 const fragment=document.createDocumentFragment();let translated=false;
 const annotation=(ko:string)=>{translated=true;const span=document.createElement('span');span.lang='ko';span.dataset.koreanReview='true';span.className='airport-korean-review';span.textContent=` (${ko}) `;fragment.append(span);};
 for(const piece of pieces){
 const key=piece.trim(),ko=translations[key];
 if(ko&&ko!==key){fragment.append(document.createTextNode(piece));annotation(ko);continue;}
 // Decorated labels, airport names and date/time rows may share a text node.
 let rest=piece;
 while(rest){
 const matches=Object.keys(translations).filter(k=>k&&translations[k]&&translations[k]!==k&&rest.includes(k)).map(k=>({key:k,index:rest.indexOf(k)})).sort((a,b)=>a.index-b.index||b.key.length-a.key.length);
 const match=matches[0];
 if(!match){fragment.append(document.createTextNode(rest));break;}
 fragment.append(document.createTextNode(rest.slice(0,match.index)+match.key));annotation(translations[match.key]);rest=rest.slice(match.index+match.key.length);
 }
 }
 if(translated){if(text.parentElement?.tagName==='OPTION'){text.parentElement.dataset.koreanReview='option';text.data=fragment.textContent||value;}else text.replaceWith(fragment);}
 }
 }
}
addAirportReview();
</script>
<style is:global>.airport-korean-review{color:#5d536b;font-size:.9em;font-weight:400;overflow-wrap:anywhere}</style>
