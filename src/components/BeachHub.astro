---
import SiteFooter from './SiteFooter.astro';
import DetailHeader from './DetailHeader.astro';
import TransportPlaceMap from './TransportPlaceMap.astro';
import beaches from '../data/beaches.json';
import cities from '../data/beach-cities.json';
const {city=null}=Astro.props;
const records=beaches.filter(b=>b.pilot&&(!city||b.cityId===city.id));
const title=city?`${city.name} 해변·해수욕장 | 해변 비교와 가는 방법`:'태국 해변·해수욕장 | 도시·섬별 해변 지도와 방문 안내';
const intro=city?city.intro:'푸켓에서 코사멧까지, 여행할 도시와 섬을 골라 해변을 비교해보세요. 모래사장의 풍경뿐 아니라 육로로 갈 수 있는지, 배를 타야 하는지, 물놀이 전에 어떤 조건을 살펴야 하는지 함께 정리했어요.';
const points=records.map(b=>({name:b.name,lat:b.lat,lng:b.lng,text:b.city+' · '+b.coordinateKind,url:`/ko/beaches/${b.id}/`}));
---
<!doctype html><html lang="ko"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="icon" href="/favicon.svg"/><title>{title} | ThaiLiveNow</title><meta name="description" content={intro}/></head><body><DetailHeader/><main>
{city&&<a href="/ko/beaches/">← 태국 해변 전체</a>}<span class="overline">THAILAND BEACHES</span><h1>{city?`${city.name} 해변·해수욕장`:'도시별 해변·해수욕장 찾기'}</h1><p class="intro">{intro}</p><nav aria-label="도시·섬별 해변"><a href="/ko/beaches/" aria-current={!city?'page':undefined}>전체</a>{cities.map(c=><a href={`/ko/beaches/cities/${c.id}/`} aria-current={city?.id===c.id?'page':undefined}>{c.name}</a>)}</nav>
<TransportPlaceMap points={points} showPlaces={false} compactPins={true} linkLabel="해변 방문 안내 →" title={city?`${city.name} 해변 지도`:'태국 해변 지도'} note="핀은 해변·만·마을의 대표 위치예요. 지도 아래 목록에서 해변별 접근 방법과 물놀이 조건을 읽어보세요."/>
{(city?[city]:cities).map(c=><section aria-labelledby={`city-${c.id}`}><header><div><h2 id={`city-${c.id}`}>{c.name} 해변</h2>{!city&&<p>{c.intro}</p>}</div>{!city&&<a href={`/ko/beaches/cities/${c.id}/`}>{c.name} 해변 비교 →</a>}</header><div class="cards">{records.filter(b=>b.cityId===c.id).map(b=><article>{b.photos[0]&&<a tabindex="-1" aria-hidden="true" href={`/ko/beaches/${b.id}/`}><img src={b.photos[0].src} alt="" width="600" height="360" loading="lazy"/></a>}<div class="card-copy"><span>{b.facilityType} · {b.english}</span><h3><a href={`/ko/beaches/${b.id}/`}>{b.name}</a></h3><p>{b.intro}</p><p class="access">{b.accessConditions[0].value}</p><a class="detail-link" href={`/ko/beaches/${b.id}/`}>{b.name} 방문 안내 →</a>{b.photos[0]&&<small>사진: <a href={b.photos[0].sourceUrl}>{b.photos[0].credit}{b.photos[0].title&&` · ${b.photos[0].title}`}</a> · <a href={b.photos[0].licenseUrl||b.photos[0].sourceUrl}>{b.photos[0].rights}</a></small>}</div></article>)}</div></section>)}
<section class="planning"><h2>해변을 고른 뒤에는 이동 순서를 확인해보세요</h2><p>본토 해변은 실제로 내릴 곳과 해안으로 들어가는 길을 정하고, 섬이나 배로 가는 해변은 도착 선착장과 돌아올 편까지 함께 살펴보세요. 해변 이름이 같아도 다른 지역일 수 있어 도시·섬 이름을 함께 검색하면 편해요.</p><p><strong>빨간 깃발이 올라가면 수영하지 마세요.</strong> 해변 사진이나 계절만으로 당일 입수 여부를 정하지 말고 현장 통제와 해상 예보를 따라주세요.</p><p><a href="/ko/destinations/">도시·섬별 여행 안내 →</a> · <a href="/ko/?category=sea#map">메인 지도에서 바다·해변 찾기 →</a></p></section>
</main><SiteFooter/></body></html>
<style>:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,sans-serif;line-height:1.85}main{max-width:1160px;margin:auto;padding:40px 24px 72px}.overline{display:block;color:#e84d47;font-size:12px;letter-spacing:2px;margin:18px 0}h1{font-size:clamp(28px,4vw,42px);line-height:1.4}.intro{font-size:19px;max-width:900px}a{color:#207b85;text-underline-offset:4px}nav{display:flex;flex-wrap:wrap;gap:10px;margin:28px 0}nav a{background:white;border:1px solid #dce5e8;border-radius:24px;padding:10px 18px;text-decoration:none}nav a[aria-current]{background:#267e89;color:#fff}section{margin:56px 0}section header{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:24px}header p{max-width:800px}h2{font-size:28px;margin:0}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}article{border:1px solid #dce5e8;background:white;border-radius:16px;overflow:hidden}article img{display:block;width:100%;height:240px;object-fit:cover}.card-copy{padding:24px}.card-copy>span,.card-copy small{font-size:12px;color:#627787}.card-copy small{overflow-wrap:anywhere;display:block;margin-top:20px}h3{font-size:25px;line-height:1.4;margin:10px 0 16px}h3 a{text-decoration:none}.access{background:#eef5f5;padding:16px;border-radius:10px}.detail-link{font-weight:700}.planning{padding:28px;background:#edf4f5;border-radius:16px}@media(max-width:650px){main{padding:24px 18px}.intro{font-size:17px}.cards{grid-template-columns:1fr}section header{display:block}section header>a{display:inline-block;margin:10px 0}.card-copy{padding:20px}h2{font-size:24px}nav{gap:8px}nav a{font-size:14px;padding:8px 12px}}</style>
