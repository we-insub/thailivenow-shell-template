---
import {groupCounterServices,departureRoutesForService} from '../lib/bkk-airline-counters.mjs';
import counterDetails from '../data/bkk-airline-counter-details-ko.json';
import AirportPhone from './AirportPhone.astro';
import AirportEmail from './AirportEmail.astro';
import AirportScheduleDates from './AirportScheduleDates.astro';
import RuntimeDate from './RuntimeDate.astro';
const {services,routes,statusLinks,pairs,guides,sources}=Astro.props;
const groups=groupCounterServices(services);
const airlineIds=[...new Set(services.map((s:any)=>s.airlineId))] as string[];
const routeGroups=airlineIds.map(id=>({id,name:services.find((s:any)=>s.airlineId===id).airline,routes:routes.filter((r:any)=>r.airlineId===id)})).sort((a,b)=>a.name.localeCompare(b.name,'ko'));
const faq=[
 {q:'수완나폼공항에서 Q5–10은 무슨 뜻인가요?',a:'Q구역의 5번부터 10번까지 체크인 카운터라는 뜻이에요. Q는 구역을 나타내는 알파벳이고, 5~10은 그 안의 카운터 번호예요. 비행기를 타는 탑승구 번호와는 달라요.'},
 {q:'에어프레미아 체크인 카운터는 요일마다 달라지나요?',a:'기존 안내는 화·수·목·토요일 Q구역 5~10번, 금요일 W구역 1~6번, 일요일 U구역 1~6번이에요. 월요일 배정은 항공사에 먼저 물어보세요. 다른 요일도 바뀔 수 있어 당일 출발 전광판에서 자신의 편명과 카운터를 함께 살펴보셔야 해요.'},
 {q:'대한항공 체크인 운영시간은 모든 편이 같나요?',a:'편명별로 달라요. KE660은 06:50~08:50, KE658은 18:40~20:40, KE652는 18:40~22:30, KE656은 23:35~다음 날 01:35로 안내돼 있어요. 태국 현지 시각이며 출발 날짜와 당일 배정을 함께 확인하세요.'},
 {q:'체크인 마감 시각까지 공항에 도착하면 되나요?',a:'체크인 마감은 공항 도착 권장 시각과 달라요. 항공사별 마감 전에 탑승 수속을 마칠 수 있도록 카운터를 찾고 대기하는 시간도 잡아두세요. 아시아나항공은 출발 40분 전 마감이며 A380 항공편은 50분 전 마감이라는 예외가 있어요.'},
 {q:'공항 사무실과 수하물 문의처에서 체크인할 수 있나요?',a:'체크인 카운터, 공항 사무실, 수하물 문의처는 업무가 달라요. 비행기를 타기 위한 수속은 체크인 안내에서 찾고, 짐이 나오지 않거나 파손됐다면 공항을 떠나기 전에 항공사 수하물 직원에게 신고하세요.'}
];
const guideGroups=[
 {label:'수하물 파손·지연·분실 신고',items:guides.filter((g:any)=>/수하물|캐리어/.test(g.title))},
 {label:'지연·결항·항공사 증빙',items:guides.filter((g:any)=>!/수하물|캐리어/.test(g.title)&&!/보험|도착|늦게/.test(g.title))},
 {label:'보험과 늦은 도착 후 이동',items:guides.filter((g:any)=>!/수하물|캐리어/.test(g.title)&&/보험|도착|늦게/.test(g.title))}
].filter(g=>g.items.length);
---
<div class="counter-guide" data-bkk-counter-guide>
 <section class="counter-reading">
  <h2>출발 전광판에서 항공사와 편명부터 찾으세요</h2>
  <p>수완나폼공항의 <strong>4층 출발장</strong>에서 자신의 실제 운항사와 편명을 찾고, 안내된 체크인 카운터로 가세요. 카운터는 구역을 나타내는 알파벳과 번호로 표시돼요. 예를 들어 <strong>Q5–10은 Q구역 5~10번 카운터</strong>이며 탑승구 번호가 아니에요.</p>
  <p>아래 안내는 <strong>체크인 → 발권 → 공항 사무실 → 수하물·분실물 → 예약센터</strong> 순서예요. 각 항목 안에서는 항공사 이름순으로 찾을 수 있어요. 요일·시즌에 따라 배정이 달라질 수 있으므로 당일 전광판을 함께 보셔야 해요.</p>
 </section>
 {groups.map(group=><section class="counter-group" id={`counter-${group.id}`} data-counter-group={group.id}>
  <h2>{group.title}</h2><p>{group.intro}</p>
  {group.id==='checkin'&&<p class="reading-note">연결된 출발편은 아래에 표시된 확인 날짜·기간의 자료예요. 여행 당일 운항 여부와 카운터 배정을 확정하는 실시간 정보와는 구분해 주세요.</p>}
  {group.services.map((s:any)=>{
   const detail=(counterDetails as any)[s.id]||{};
   const departures=group.id==='checkin'?departureRoutesForService(s,routes):[];
   const locations=detail.locations||(s.location?[[group.id==='office'?'사무실 위치':'위치',s.location]]:[]);
   const hours=detail.hours||(s.hours?[['운영시간',s.hours]]:[]);
   const status=statusLinks.find((item:any)=>item.airline===s.airline);
   return <article class="counter-card" data-counter-service={s.id}>
    <h3>{s.airline}</h3>
    {group.id!=='checkin'&&<p class="service-kind">{s.type}</p>}
    {locations.length>0&&<dl class="counter-facts">{locations.map(([label,value]:string[])=><div><dt>{label}</dt><dd><strong>{value}</strong></dd></div>)}</dl>}
    {hours.length>0&&<><h4>{detail.hoursLabel|| (group.id==='checkin'?'체크인 시간':'운영시간')}</h4><dl class="counter-facts">{hours.map(([label,value]:string[])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></>}
    {detail.facts?.length>0&&<dl class="counter-facts">{detail.facts.map(([label,value]:string[])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}
    {(detail.text||s.text)&&<p>{detail.text||s.text}</p>}
    {departures.length>0&&<div class="departure-records"><h4>연결된 한국행 출발편 안내</h4><ul>{departures.map((r:any)=><li><a href={`/ko/airport-assistance/routes/${r.id}/`}><strong>{r.flightNumber}</strong> · {r.destination}</a><AirportScheduleDates route={r} compact={true}/>{!r.validFrom&&!r.operatingDates?.length&&<p class="record-date">자료 확인일: <RuntimeDate kind="source" fallback={r.checkedAt} pagePath={`/ko/airport-assistance/routes/${r.id}/`} locale="ko"/></p>}</li>)}</ul></div>}
    {s.phone&&<div class="counter-contact"><h4>{detail.contactLabel||'전화 문의'}</h4><AirportPhone phone={s.phone}/></div>}
    {s.email&&<div class="counter-contact"><h4>이메일 문의</h4><AirportEmail email={s.email}/></div>}
    <div class="counter-actions"><a href={`/ko/airport-assistance/airlines/${s.airlineId}/`}>{s.airline} 상세 안내 →</a>{status&&group.id==='checkin'&&<a href={status.url} target="_blank" rel="noopener noreferrer">공식 운항 조회 ↗</a>}</div>
    <p class="record-date">자료 확인일: <RuntimeDate kind="source" fallback={s.checkedAt} pagePath={`/ko/airport-assistance/airports/bkk/airlines/#${s.id}`} locale="ko"/></p>
   </article>;
  })}
 </section>)}
 <section class="counter-faq"><h2>체크인 카운터를 찾을 때 자주 묻는 질문</h2>{faq.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
 <section class="counter-related"><h2>노선과 공항 이용 안내 더 보기</h2>
  <details><summary>한국↔태국 노선·편명 자료 · {routes.length}개</summary><p>같은 항공사라도 방콕 도착편과 한국행 출발편의 카운터 안내는 구분해야 해요. 각 편의 확인 날짜·기간과 당일 운항 조회는 노선 상세에서 볼 수 있어요.</p>{routeGroups.map(g=><div><h3>{g.name}</h3><ul>{g.routes.map((r:any)=><li><a href={`/ko/airport-assistance/routes/${r.id}/`}>{r.originIata} → {r.destinationIata} · {r.flightNumber}</a></li>)}</ul></div>)}</details>
  <details><summary>출발·도착 공항쌍별 안내 · {pairs.length}개</summary><ul>{pairs.map((p:any)=><li><a href={`/ko/airport-assistance/pairs/${p.id}/`}>{p.other} ↔ {p.thai} 항공편 안내</a></li>)}</ul></details>
  {guideGroups.map(g=><details><summary>{g.label} · {g.items.length}개</summary><ul>{g.items.map((item:any)=><li><a href={`/ko/airport-assistance/guides/${item.id}/`}>{item.title}</a></li>)}</ul></details>)}
  <p>공항 출입문과 탑승구 번호가 헷갈린다면 <a href="/ko/airport-assistance/airports/bkk/">도착·출발·환승 기본 안내</a>를 읽어보세요. 식당·편의점은 <a href="/ko/airport-assistance/airports/bkk/map/">층별 시설 지도</a>에서, 담배를 피울 수 있는 곳은 <a href="/ko/airport-assistance/airports/bkk/smoking/">일반구역·면세구역 흡연실 안내</a>에서 찾을 수 있어요.</p>
 </section>
 <section class="counter-sources"><details class="source-fold"><summary>공식 출처 보기 · {sources.length}개</summary><ul>{sources.map((url:string)=><li><a href={url} target="_blank" rel="noopener noreferrer">{new URL(url).hostname} · 공식 안내</a></li>)}</ul></details><p>카운터와 연락처의 자료 확인일은 각 항공사 안내에 표시했어요. 체크인 시간과 편명별 운영시간은 태국 현지 시각을 기준으로 읽고, 예약센터처럼 한국 시간이 따로 적힌 경우에는 해당 시간대를 따라주세요.</p></section>
</div>
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}).replaceAll('<','\u003c')}/>
<style>
.counter-guide section{margin:40px 0}.counter-guide p{line-height:1.9;overflow-wrap:anywhere}.counter-guide h2{margin:0 0 16px;line-height:1.5}.counter-guide h3{font-size:22px;line-height:1.5;margin:0 0 18px}.counter-guide h4{font-size:15px;margin:24px 0 10px}.counter-card{padding:26px!important;margin:20px 0!important}.counter-facts{margin:12px 0}.counter-facts>div{display:grid;grid-template-columns:150px minmax(0,1fr);gap:18px;padding:12px 0;border-bottom:1px solid #e5ecef}.counter-facts dt{font-weight:650;font-size:14px}.counter-facts dd{margin:0;color:#526470;line-height:1.9;overflow-wrap:anywhere}.counter-facts strong{color:#253545;font-weight:700}.counter-guide .service-kind{font-size:14px;margin-top:-10px;color:#537682}.counter-actions{display:flex;flex-wrap:wrap;gap:12px 22px;margin-top:22px;font-size:14px}.counter-guide .record-date{font-size:12px;line-height:1.6;color:#6d7e87;margin:12px 0 0}.reading-note{font-size:13px;background:#edf4f5;padding:14px 18px;border-radius:8px}.departure-records{margin:22px 0}.departure-records ul{list-style:none;padding:0;display:grid;gap:12px}.departure-records li{border-left:3px solid #c7dee2;padding:0 0 0 14px}.departure-records :global(.schedule-dates){font-size:12px;margin:3px 0 0;line-height:1.6}.counter-contact :global(p){margin:4px 0}.counter-related details{margin:14px 0}.counter-related li{margin:9px 0;font-size:14px}.counter-related details h3{font-size:17px;margin:22px 0 10px}.counter-sources{font-size:12px}.source-fold{padding:16px;border:1px solid #dce5e8;border-radius:10px}.source-fold summary{cursor:pointer;font-weight:650;font-size:14px}.source-fold li{margin:10px 0;overflow-wrap:anywhere}.source-fold a{font-weight:400!important;font-size:12px}@media(max-width:650px){.counter-card{padding:20px!important}.counter-guide h3{font-size:20px}.counter-facts>div{grid-template-columns:1fr;gap:4px}.counter-guide section{margin:32px 0}}
</style>
