---
import network from '../data/transport/domestic-air-routes.json';
import outline from '../data/transport/thailand-air-outline.json';
const airports=network.airports;
const xy=(code:string)=>{const a=airports[code];return [(a.lng-97)*57+30,(21-a.lat)*43+20]};
const codes=[...new Set(network.airlines.flatMap(a=>a.routes.flat()))];
---
<section id="domestic-network" class="network">
  <div class="heading"><div><span>DOMESTIC FLIGHT NETWORK</span><h2>항공사별 태국 국내선 노선도</h2></div><p>항공사를 고르면 지도와 목록에서 출발·도착 공항을 볼 수 있어요.</p></div>
  <div class="filters" aria-label="항공사 선택"><button type="button" data-air-filter="all" aria-pressed="true">전체 항공사</button>{network.airlines.map(a=><button type="button" data-air-filter={a.code} aria-pressed="false" style={`--air-color:${a.color}`}><i></i>{a.name} · {a.code}</button>)}</div>
  <div class="map-layout"><div class="map-panel"><svg viewBox="0 0 550 690" role="img" aria-labelledby="air-map-title air-map-desc"><title id="air-map-title">태국 국내 공항 간 대표 항공 노선도</title><desc id="air-map-desc">선은 공항 사이 항공 노선을 나타냅니다. 항공사별 출발·도착 공항은 아래 노선 목록에서도 확인할 수 있습니다.</desc><rect width="550" height="690" fill="#edf6f8"/>{outline.map(d=><path d={d} fill="#fdfaf1" stroke="#d4dfd5" stroke-width="0.5"/>)}{network.airlines.map(a=><g data-air-lines={a.code} fill="none" stroke={a.color} stroke-width="1.5" opacity="0.45">{a.routes.map(([from,to])=>{const [x,y]=xy(from);const [tx,ty]=xy(to);return <path d={`M${x},${y} Q${(x+tx)/2+35},${(y+ty)/2-20} ${tx},${ty}`}><title>{a.name}: {airports[from].name} ({from}) ↔ {airports[to].name} ({to})</title></path>})}</g>)}{codes.map(code=>{const [x,y]=xy(code);const left=['CNX','HKT','URT','TST','THS','HHQ','DMK'].includes(code);return <g data-air-port={code}><circle cx={x} cy={y} r="4" fill="#253545" stroke="white" stroke-width="1.5"/><text x={x+(left?-8:8)} y={y+(code==='BKK'?14:code==='DMK'?-7:code==='KBV'?12:-5)} text-anchor={left?'end':'start'} font-size="12" font-weight="700" fill="#253545" stroke="#fff" stroke-width="3" paint-order="stroke">{code}</text><title>{airports[code].name} ({code})</title></g>})}<text x="24" y="661" fill="#61717e" font-size="12">공항 위치 기준 · 선은 실제 비행 경로가 아닌 노선 연결 표시</text></svg></div>
  <div class="directory"><p class="map-note">지도와 목록에는 대표 노선을 표시했어요. 전체 취항지는 항공사 공식 노선도에서 살펴보고, 실제 운항 여부는 예약 사이트에 여행 날짜를 넣어 확인해주세요.</p>{network.airlines.map(a=><article data-air-card={a.code} style={`--air-color:${a.color}`}><header><h3>{a.name} <b>{a.code}</b></h3><small>{a.english}</small></header><p>{a.note}</p><details><summary>대표 노선 {a.routes.length}개 보기</summary><ul>{a.routes.map(([from,to])=><li>{airports[from].name} <strong>{from}</strong> ↔ {airports[to].name} <strong>{to}</strong></li>)}</ul></details><div class="air-links"><a href={a.source} target="_blank" rel="noopener noreferrer">공식 노선·취항지 안내 ↗</a><a href={a.url} target="_blank" rel="noopener noreferrer">항공권 검색 ↗</a></div></article>)}</div></div>
</section>
<script>
const root=document.querySelector('.network');
if(root){const filters=root.querySelectorAll<HTMLButtonElement>('[data-air-filter]');filters.forEach(button=>button.addEventListener('click',()=>{const code=button.dataset.airFilter;filters.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));root.querySelectorAll<SVGElement>('[data-air-lines]').forEach(g=>{g.style.display=code==='all'||g.dataset.airLines===code?'':'none';g.setAttribute('opacity',code==='all'?'0.45':'0.85');});root.querySelectorAll<HTMLElement>('[data-air-card]').forEach(card=>{card.hidden=code!=='all'&&card.dataset.airCard!==code;const details=card.querySelector('details');if(details)details.open=code!=='all'&&!card.hidden;});const visible=new Set<string>();root.querySelectorAll<SVGElement>('[data-air-lines]').forEach(g=>{if(g.style.display==='none')return;g.querySelectorAll('title').forEach(t=>{for(const match of t.textContent?.matchAll(/\(([A-Z]{3})\)/g)||[])visible.add(match[1]);});});root.querySelectorAll<SVGElement>('[data-air-port]').forEach(g=>g.style.display=visible.has(g.dataset.airPort||'')?'':'none');}));}
</script>
<style>
.network{margin:32px 0;scroll-margin-top:100px}.heading span{font-size:11px;letter-spacing:2px;color:#267e89;font-weight:800}.heading h2{margin:5px 0;font-size:26px}.heading p{color:#61717e}.filters{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0}.filters button{font:inherit;font-size:13px;background:#fff;border:1px solid #d5e1e5;border-radius:24px;padding:9px 14px;cursor:pointer;display:flex;align-items:center;gap:6px}.filters button[aria-pressed=true]{background:#253545;color:#fff;border-color:#253545}.filters button:focus-visible{outline:3px solid #267e89;outline-offset:3px}i{width:8px;height:8px;background:var(--air-color);border-radius:50%}.map-layout{display:grid;grid-template-columns:1.05fr 1fr;gap:22px;align-items:start}.map-panel{position:sticky;top:100px;border:1px solid #d5e1e5;border-radius:18px;overflow:hidden}.map-panel svg{display:block;width:100%;height:auto}.map-note{font-size:13px;color:#61717e;margin-top:0}.directory article{background:#fff;border:1px solid #dde6ea;border-top:3px solid var(--air-color);border-radius:12px;padding:20px;margin-bottom:14px}.directory article[hidden]{display:none}h3{font-size:19px;margin:0}h3 b{color:var(--air-color);font-size:14px}small{color:#61717e}article p,li{font-size:14px}details summary{font-size:14px;font-weight:700;cursor:pointer;color:var(--air-color)}ul{padding-left:18px}.air-links{display:flex;flex-wrap:wrap;gap:12px;margin-top:14px}.air-links a{font-size:13px;color:#267e89;text-decoration:none}@media(max-width:700px){.map-layout{grid-template-columns:1fr}.map-panel{position:static}.heading h2{font-size:23px}.filters button{font-size:12px;padding:8px 11px}}
</style>
