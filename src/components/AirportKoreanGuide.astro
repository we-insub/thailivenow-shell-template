---
import guides from '../data/airport-detail-guides-ko.json';
import commonFacilityNames from '../data/airport-facility-names-ko.json';
import directories from '../data/airport-map-directory-ko.json';
import AirportGuideMap from './AirportGuideMap.astro';
import ImportantText from './ImportantText.astro';
import RuntimeDate from './RuntimeDate.astro';
import AirportRepresentativePhoto from './AirportRepresentativePhoto.astro';
const {code,part='all',faqItems}=Astro.props;
const overview=part==='all'||part==='overview';
const showMap=['all','map','smoking'].includes(part);
const showSmoking=part==='all'||part==='smoking';
const facilities=part==='all'||part==='map';
const guide=(guides as any)[code],directory=(directories as any)[code];
const highlights=['일반구역','출국심사 후','국제선 터미널 1층','국내선 터미널 1층','1층','2층','3층','4층','12번 문','7번 출입구','24시간','06:00–24:00','45분 전','30바트','40바트','60바트'];
const facilityNames:Record<string,string>={...commonFacilityNames,'Smoking Area':'흡연구역','First Aid':'응급처치실','Medical Room':'의료실','Medical Clinic':'의료실','Left Luggage':'수하물 보관','Airport Information':'공항 안내','Mini Market Shop':'미니마켓','Mini Market':'미니마켓','Fresh Corner Minimart':'프레시 코너 미니마트','Muslim Prayer Room':'이슬람 기도실','Baby Care Room':'수유·육아실','7-Eleven':'세븐일레븐','Lawson Shop':'로손','Burger King':'버거킹','McDonalds':'맥도날드','Miracle Lounge':'미라클 라운지'};
const mapSymbols:Record<string,string>={AIRPORT_INFORMATION:'공항 안내 아이콘',ATM:'ATM 아이콘',MONEY_EXCHANGE:'환전 아이콘',SPA:'스파'};
const rows=directory.maps.flatMap((m:any)=>m.facilities.map((f:any)=>({...f,mapId:m.id,mapLabel:m.label,displayName:facilityNames[f.store_name]||(/^(Baggage Claim) (\d+)( Domestic Arrival| International Arrival)?$/.test(f.store_name)?f.store_name.replace(/^Baggage Claim (\d+)( Domestic Arrival| International Arrival)?$/,(_:string,n:string,area:string)=>(area===' Domestic Arrival'?'국내선 도착 ':area===' International Arrival'?'국제선 도착 ':'')+'수하물 수취대 '+n):f.store_name),lockLabel:mapSymbols[f.lock_no]||f.lock_no})));
const smokingSources=guide.smoking.flatMap((s:any)=>s.sources) as string[];
const isOfficial=(s:string)=>['.airportthai.co.th/','prioritypass.com/','airindia.com/'].some(host=>s.includes(host));
const officialSources=[...new Set([...guide.officialSources,directory.source,...smokingSources.filter(isOfficial)])].filter(Boolean) as string[];
const reports=[...new Set(smokingSources)].filter(s=>!isOfficial(s)) as string[];
const sections=guide.sections.filter((s:any)=>(code!=='BKK'||s.title!=='흡연 구역')&&(part==='all'||(part==='overview'?['2층 도착장 서비스','국제선 환승 보안검색'].includes(s.title):part==='map'&&!['2층 도착장 서비스','국제선 환승 보안검색'].includes(s.title))));
const faq=faqItems||guide.faq.filter((f:any)=>code!=='BKK'||f.q!=='흡연 구역은 어디에 있나요?');
const mapDatePath=part==='all'?'/ko/airport-assistance/airports/'+code.toLowerCase()+'/#facility-map':Astro.url.pathname;
---
{guide&&<div class="airport-korean-guide" data-airport-korean-guide data-airport-facilities>
 {overview&&<section class="airport-introduction"><h2>{guide.name} 처음 이용하신다면</h2>{guide.intro.map((p:string)=><p>{p}</p>)}<AirportRepresentativePhoto code={code} locale={'ko'}/><dl class="airport-basics">{guide.facts.map(([label,value]:string[])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>}
 {showMap&&<AirportGuideMap code={code} directory={directory} pins={guide.pins} defaultMap={part==='smoking'?'11':guide.defaultMap}/>}
 {showSmoking&&<section aria-labelledby={`smoking-${code}`}><h2 id={`smoking-${code}`}>흡연구역 · 출국심사 전후로 나눠 찾기</h2>
  <p>공항에서 담배를 피우려면 지정된 흡연구역을 이용해야 해요. <strong>일반구역, 출국심사 후 구역, 라운지 안의 별도 공간</strong>을 구분해 보세요.</p>
  <div class="smoking-list">{guide.smoking.map((s:any)=><article class="smoking-place"><span class="access-label">{s.access}</span><h3>{s.title}</h3><p class="evidence-status">{s.status}</p>{s.body.map((p:string)=><p><ImportantText text={p} phrases={highlights}/></p>)}{s.mapId&&<button type="button" data-map-target={s.mapId} data-target-pin={s.pin}>지도에서 {s.pin==='hkt-smoking'?'흡연구역':'찾아가는 기준점'} 보기 ↑</button>}</article>)}</div>
 </section>}
 {overview&&guide.steps.map((s:any)=><section><h2>{s.title}</h2><ol class="airport-steps">{s.items.map((p:string)=><li><ImportantText text={p} phrases={highlights}/></li>)}</ol></section>)}
 {facilities&&<section aria-labelledby={`facility-title-${code}`}><h2 id={`facility-title-${code}`}>편의시설 찾기</h2><p>터미널·층과 시설 종류를 고르거나 매장 이름으로 검색해 보세요. <strong>시설번호는 지도에서 찾는 표기</strong>예요. 그 번호만으로 탑승구나 출입 가능 구역을 판단하지 마세요.</p>
  <div class="facility-filters"><label>시설·매장 검색<input type="search" data-facility-search placeholder="흡연, 의료실, 세븐일레븐, Burger King…"/></label><label>터미널·층<select data-facility-floor><option value="">전체 터미널·층</option>{directory.maps.map((m:any)=><option value={m.id} selected={m.id===guide.defaultMap}>{m.label}</option>)}</select></label><label>시설 종류<select data-facility-category><option value="">모든 시설</option>{[...new Set(rows.map((r:any)=>r.categoryKo))].map((name:any)=><option value={name}>{name}</option>)}</select></label></div>
  <p data-facility-count role="status"></p><div class="facility-rows">{rows.map((r:any)=><article data-facility-row data-map-id={r.mapId} data-category={r.categoryKo} data-search={[r.displayName,r.store_name,r.lock_no,r.mapLabel,r.categoryKo].join(' ').toLowerCase().replace(/\s/g,'')} hidden={r.mapId!==guide.defaultMap}><h3>{r.displayName}</h3>{r.displayName!==r.store_name&&<p class="original-name" lang="en">{r.store_name}</p>}<p>{r.mapLabel} · {r.categoryKo}</p>{r.lockLabel&&<p>지도 표기: <strong>{r.lockLabel}</strong></p>}<button type="button" data-map-target={r.mapId}>해당 층 지도 보기 ↑</button></article>)}</div>
 </section>}
 {sections.map((s:any)=><section><h2>{s.title}</h2>{s.body.map((p:string)=><p><ImportantText text={p} phrases={highlights}/></p>)}{s.link&&<p><a href={s.link.url} target="_blank" rel="noopener noreferrer">{s.link.label.replace(/^AOT /,'공항 ')}</a></p>}</section>)}
 <section><h2>{guide.name} 이용 전에 자주 묻는 질문</h2>{faq.map((f:any)=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
 <section class="guide-sources"><p>자료 확인일: <RuntimeDate kind="source" fallback={part==='overview'?guide.legacyCheckedAt:directory.checkedOn} pagePath={mapDatePath} locale="ko"/></p><details class="source-fold"><summary>공식 출처 보기 · {officialSources.length}개</summary><ul>{officialSources.map(url=><li><a href={url} target="_blank" rel="noopener noreferrer">{new URL(url).hostname} · {decodeURIComponent(new URL(url).pathname.split('/').at(-1)||'공식 안내')}</a></li>)}</ul></details>{showSmoking&&reports.length>0&&<details class="source-fold"><summary>흡연구역 현장 기록·보도 보기 · {reports.length}개</summary><p>현재 운영이 달라질 수 있는 이용 기록은 공식 시설 목록과 구분해 안내했어요.</p><ul>{reports.map(url=><li><a href={url} target="_blank" rel="noopener noreferrer">{new URL(url).hostname} · 이용 기록·보도</a></li>)}</ul></details>}</section>
</div>}
{faqItems?.length>0&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqItems.map((f:any)=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}).replaceAll('<','\\u003c')}/>}
<style>
.airport-korean-guide{margin:32px 0 44px;border-bottom:1px solid #dce5e8;padding-bottom:30px}.airport-korean-guide section{margin:42px 0}.airport-korean-guide h2{font-size:25px;line-height:1.5;margin:0 0 18px}.airport-korean-guide h3{font-size:19px;line-height:1.5;margin:6px 0 12px}.airport-korean-guide p{line-height:1.95;margin:12px 0;color:#61717e;overflow-wrap:anywhere}.airport-photo{margin:28px 0}.airport-photo img{width:100%;height:auto;display:block;border-radius:12px}.airport-photo figcaption{font-size:12px;color:#61717e;margin-top:9px}.airport-photo a{font-weight:400!important}.airport-basics{margin:28px 0 0}.airport-basics>div{display:grid;grid-template-columns:180px minmax(0,1fr);border-bottom:1px solid #e0e7eb;padding:14px 0;gap:16px}.airport-basics dt{font-weight:700}.airport-basics dd{margin:0;color:#61717e}.airport-steps{padding-left:25px}.airport-steps li{line-height:1.95;padding:8px 0 14px 6px}.smoking-list{display:grid;gap:22px}.smoking-place{padding:24px!important}.access-label{color:#287a86;font-size:13px;font-weight:700}.evidence-status{font-size:13px}.airport-korean-guide button{font:inherit;padding:10px 14px;border:1px solid #b9ced4;border-radius:8px;background:#edf6f7;color:#276c77;cursor:pointer;font-weight:650}.facility-filters{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:14px;margin:22px 0}.facility-filters label{font-size:13px;font-weight:700;display:flex;flex-direction:column;gap:7px;min-width:0}.facility-filters input,.facility-filters select{font:inherit;padding:12px;border:1px solid #c8d9df;border-radius:8px;min-width:0;background:white;color:#253545}.facility-rows{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.facility-rows article{margin:0!important;min-width:0}.facility-rows [hidden]{display:none!important}.facility-rows p{font-size:14px}.facility-rows .original-name{font-size:12px}.guide-sources{font-size:13px}.source-fold{padding:16px!important}.source-fold li{margin:10px 0;overflow-wrap:anywhere}.source-fold a{font-size:12px;font-weight:400!important}.airport-korean-guide :global([data-guide-map]){scroll-margin-top:125px}@media(max-width:650px){.airport-basics>div{grid-template-columns:1fr;gap:4px}.facility-filters,.facility-rows{grid-template-columns:1fr}.airport-korean-guide h2{font-size:22px}.smoking-place{padding:20px!important}}
</style>
