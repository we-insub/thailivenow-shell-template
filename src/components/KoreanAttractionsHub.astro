---
import {attractionUI,attractionTag,localizedAttractions,localizedAttractionCategories,attractionCategoryUrl} from '../lib/attractions-localized';
import DetailHeader from './DetailHeader.astro';
import SiteFooter from './SiteFooter.astro';
import LocaleAlternates from './LocaleAlternates.astro';
const {locale='ko'}=Astro.props;
const u=attractionUI(locale),places=localizedAttractions(locale);
const hubTitle=({'en-us':'Things to do in Thailand | Temples, markets and museums | ThaiLiveNow','en-gb':'Places to visit in Thailand | Temples, markets and museums | ThaiLiveNow','en-in':'Thailand sightseeing | Temples, markets and museums | ThaiLiveNow'})[locale]||u.hubTitle;
const p=places.find(p=>p.id==='jim-thompson-house');
const listed=places.filter(p=>p.indexing!=='noindex'&&p.catalogListing!=='reference');
import AttractionPhoto from './AttractionPhoto.astro';
import rooftops from '../data/rooftops.json';
const categories=localizedAttractionCategories(locale);
const categoryUrl=id=>attractionCategoryUrl(id,locale);
const cover=c=>{const photo=c.id==='rooftops'?rooftops.find(p=>p.id==='sky-bar')?.photos?.[0]:listed.find(p=>p.category===c.id&&p.photos?.length)?.photos[0];return c.id==='rooftops'&&photo&&locale!=='ko'?{...photo,alt:'Sky Bar · '+c.name,caption:'Sky Bar',modifications:u.modified}:photo;};
const schema={'@context':'https://schema.org','@type':'CollectionPage',name:u.attractions,description:u.hubDescription,url:`https://thailivenow.com/${locale}/attractions/`,inLanguage:attractionTag(locale),hasPart:{'@type':'ItemList',itemListElement:categories.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,url:'https://thailivenow.com'+categoryUrl(c.id)}))}};
---
<!doctype html><html lang={attractionTag(locale)}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="icon" href="/favicon.svg"/><title>{hubTitle}</title><meta name="description" content={u.hubDescription}/><LocaleAlternates/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body><DetailHeader locale={locale}/><main class="korean-attractions-hub">
<header class="hub-intro"><p class="eyebrow">{u.attractions}</p><h1>{u.hubHeading}</h1><p class="intro">{u.hubIntro}</p></header>
<nav class="category-shortcuts" aria-label={u.types}>{categories.map(c=><a href={categoryUrl(c.id)}>{c.name}</a>)}</nav>
<section class="featured-place" aria-labelledby="featured-title">{p.photos?.[0]&&<div class="featured-photo"><AttractionPhoto locale={locale} photo={p.photos[0]} href={`/${locale}/attractions/jim-thompson-house/`}/></div>}<div><p class="eyebrow">{locale==='ko'?'방콕 · 옛집과 미술품':`${p.cityName} · ${p.type}`}</p><h2 id="featured-title"><a href={`/${locale}/attractions/jim-thompson-house/`}>{p.name}</a></h2><p class="foreign-names"><span lang="en">{p.english}</span><span lang="th">{p.thai}</span></p><p>{locale==='ko'?'운하 옆 정원에 모인 티크 목조 주택 여섯 채. 태국 실크 사업가가 살던 집에서 아시아 미술품을 함께 볼 수 있어요. 본관은 가이드와 함께 둘러봐요.':p.intro[0]}</p><a class="primary-link" href={`/${locale}/attractions/jim-thompson-house/`}>{u.viewDetail} <span aria-hidden="true">→</span></a></div>{locale==='ko'?<><dl><div><dt>일반 성인</dt><dd>250바트</dd></div><div><dt>관람 방식</dt><dd>본관 가이드 동행</dd></div><div><dt>가까운 전철</dt><dd>BTS 내셔널스타디움<br/>1번 출구</dd></div></dl></>:<dl>{(p.prices||p.facts||[]).slice(0,3).map(([label,value])=><div><dt>{label}</dt><dd>{value.replaceAll('**','')}</dd></div>)}</dl>}</section>
<section aria-labelledby="category-heading"><div class="section-intro"><h2 id="category-heading">{u.categoryHeading}</h2><p>{u.categoryIntro}</p></div><div class="category-grid">{categories.map(c=><article id={c.id} class="category-card">{cover(c)&&<AttractionPhoto locale={locale} photo={cover(c)} href={categoryUrl(c.id)}/>}<span class="category-number" aria-hidden="true">{c.number}</span><h3><a href={categoryUrl(c.id)}>{c.name}</a></h3><p>{c.text}</p><a class="category-action" href={categoryUrl(c.id)}>{c.name}{locale==='ko'?' ': ' · '}{u.seeCategory} →</a></article>)}</div></section>
<section class="choose-note"><h2>{u.planningHeading}</h2><p>{u.planningBody}</p>{locale==='ko'&&<a href="/ko/transport/">{u.transport} →</a>}</section>
</main><SiteFooter locale={locale}/></body></html>
<style>
.korean-attractions-hub{max-width:1120px;margin:auto;padding:48px 28px 72px;color:#203743;line-height:1.8;word-break:keep-all;overflow-wrap:anywhere}.hub-intro{max-width:820px;margin-bottom:28px}.eyebrow{color:#267e89;font-size:14px;font-weight:700;letter-spacing:.06em;margin:0 0 14px}.hub-intro h1{font-size:clamp(34px,4.5vw,52px);line-height:1.35;letter-spacing:-.035em;margin:0 0 24px}.intro{font-size:20px;color:#526572;line-height:1.85;margin:0}.category-shortcuts{display:flex;flex-wrap:wrap;gap:10px;margin:30px 0 38px}.category-shortcuts a{color:#267e89;background:white;border:1px solid #c9d9e0;border-radius:30px;padding:10px 17px;text-decoration:none;font-size:15px;min-height:44px;display:flex;align-items:center}.featured-place{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:40px;background:#edf5f4;border:1px solid #c9d9e0;border-radius:20px;padding:36px;margin-bottom:56px}.featured-place h2{font-size:30px;line-height:1.5;margin:0 0 8px;letter-spacing:-.02em}.featured-place h2 a{color:#203743;text-decoration:none}.featured-place p{font-size:18px;line-height:1.85;margin:0 0 20px}.featured-place .eyebrow{font-size:14px}.featured-place .foreign-names{color:#526572;font-size:14px}.foreign-names span{display:block}.featured-place dl{margin:0;display:flex;flex-direction:column;justify-content:center;border-left:1px solid #c9d9e0;padding-left:28px;gap:20px}.featured-place dt{color:#526572;font-size:14px}.featured-place dd{font-weight:700;font-size:18px;margin:2px 0 0}.primary-link{display:inline-flex;align-items:center;gap:24px;background:#267e89;color:white;padding:12px 18px;border-radius:10px;text-decoration:none;font-weight:600;min-height:48px}.section-intro{margin-bottom:26px}.section-intro h2,.choose-note h2{font-size:27px;line-height:1.5;margin:0 0 12px}.section-intro p{font-size:18px;color:#526572;margin:0}.category-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.category-card{min-width:0;display:flex;flex-direction:column;background:white;border:1px solid #dce5e8;border-radius:16px;padding:28px;scroll-margin-top:160px}.category-number{color:#267e89;font-weight:700;font-size:14px;margin-bottom:14px}.category-card h3{font-size:23px;line-height:1.5;margin:0 0 12px}.category-card p{font-size:17px;color:#526572;line-height:1.85;margin:0 0 24px;flex:1}.category-card a,.choose-note a{color:#267e89;font-size:16px;font-weight:600;line-height:1.7;min-height:44px;display:flex;align-items:center;text-underline-offset:4px}.choose-note{margin-top:48px;max-width:820px}.choose-note p{font-size:18px;line-height:1.85;color:#526572}.korean-attractions-hub a:focus-visible{outline:3px solid #66a7cd;outline-offset:5px}@media(max-width:680px){.korean-attractions-hub{padding:32px 18px 48px}.intro{font-size:18px}.featured-place{grid-template-columns:1fr;gap:24px;padding:24px;margin-bottom:40px}.featured-place h2{font-size:26px}.featured-place dl{border-left:0;border-top:1px solid #c9d9e0;padding:20px 0 0;gap:14px}.featured-place dl>div{display:grid;grid-template-columns:110px minmax(0,1fr);gap:12px;align-items:baseline}.featured-place dd{font-size:16px}.category-grid{grid-template-columns:1fr;gap:18px}.category-card{padding:24px}.category-shortcuts{margin:26px 0;gap:8px}.category-shortcuts a{font-size:14px;padding:9px 13px}}
</style>

<style>
.category-card h3 a{font-size:inherit;color:inherit;text-decoration:none;min-height:0}.category-card .category-action{border-top:1px solid #e3ebee;padding-top:16px}.category-card :global(.attraction-photo){margin:-28px -28px 24px}.featured-photo{grid-column:1/-1}.featured-photo :global(img){max-height:400px}.featured-place .featured-photo{margin:0}.category-card :global(figcaption){padding:0 16px}.category-card .category-number{margin-top:0}@media(max-width:680px){.category-card :global(.attraction-photo){margin:-24px -24px 20px}}
</style>
