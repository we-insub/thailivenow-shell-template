---
import beachCities from '../data/beach-cities.json';
import {beachHomeUI} from '../lib/beach-home-ui.mjs';
import {navigationLabels} from '../lib/site-navigation.mjs';
import {getLocalizedPack,hasLocalizedStage} from '../lib/localized-content';
import DetailHeader from './DetailHeader.astro';
import SiteFooter from './SiteFooter.astro';
import CameraMapResults from './CameraMapResults.astro';
import ThailandMap from './ThailandMap.astro';
import CameraGallery from './CameraGallery.astro';
import {getUI,placeName,sourceText} from '../i18n/ui';
import type {Locale} from '../i18n/locales';
import {travelAreas} from '../data/map';
import {cameras} from '../data/cameras';
import regionPhotos from '../../public/data/region-preview-photos.json';
import venues from '../data/rooftops.json';
import food from '../data/food.json';
import FoodPhoto from './FoodPhoto.astro';
import delivery from '../data/transport/guides/food-delivery.json';
const {brand='ThaiLiveNow',locale='en',section='destinations',page=1}=Astro.props as {brand?:string;locale?:Locale;section?:string;page?:number};
const ui=getUI(locale),ko=locale==='ko';
const travelCopy=hasLocalizedStage(locale,'travel')?getLocalizedPack(locale).travel.destinations:undefined;
const showKoreanTravel=ko||!!travelCopy;
const pageAreas=travelAreas;
const cityPhotos=regionPhotos as Record<string,{url:string;sourceUrl:string;credit:string;license?:string}>;
const destinationIntrosKo:Record<string,string>={
  "bangkok": "낮에는 수영장 있는 호텔에서 푹 쉬고, 저녁에는 강변에서 식사하거나 루프탑 야경을 즐겨보세요. 5성급 호텔에서 보내는 호캉스와 도시 여행을 함께 즐기고 싶은 분께 추천해요.",
  "chiang-mai": "올드시티의 사원과 골목을 걷다가 마음에 드는 카페에 들러보세요. 커피 한 잔과 산책으로 하루를 느긋하게 보내고 싶을 때 떠나기 좋은 도시예요.",
  "chiang-rai": "하얀 사원과 푸른 사원처럼 색과 모양이 특별한 건축물을 만나보세요. 사진으로 보던 풍경을 직접 보고, 북부의 산과 사원을 둘러보는 여행을 즐기실 수 있어요.",
  "pattaya": "낮에는 해변을 산책하거나 호텔에서 쉬고, 저녁에는 바다를 바라보며 식사해보세요. 바닷가 휴가를 즐기면서 도심에서 식사하고 구경하는 재미도 함께 누릴 수 있어요.",
  "hua-hin": "가족과 바닷가 숙소에 머물며 아침에는 해변을 걷고, 저녁에는 시장을 둘러보세요. 관광 일정을 가득 채우지 않고 함께 먹고 쉬는 시간을 보내고 싶을 때 골라보세요.",
  "phuket": "리조트에서 바다를 보며 쉬는 날과 올드타운을 둘러보는 날을 나누어 계획해보세요. 해변 휴가도 즐기고, 색색의 건물이 늘어선 거리를 걸으며 식사하는 재미도 느낄 수 있어요.",
  "krabi": "바다 옆으로 우뚝 솟은 석회암 절벽을 바라보며 해변을 걸어보세요. 바닷가에서 쉬는 날과 배를 타고 섬을 둘러보는 날을 함께 계획하면, 바다에서 보내는 휴가가 한층 다채로워져요.",
  "samui": "바닷가 리조트에 머물며 늦은 아침을 먹고, 해변을 산책하다 숙소로 돌아와 쉬어보세요. 연인이나 가족과 함께 식사하고 쉬는 시간을 여유롭게 즐겨보세요.",
  "phi-phi": "바다 위로 솟은 절벽과 섬 사이로 펼쳐지는 풍경을 만나보세요. 배를 타고 바다를 둘러보거나 전망대에서 섬을 바라보며, 사진으로만 보던 태국의 바다를 직접 즐기실 수 있어요.",
  "phangan": "해변에서 쉬는 휴가와 음악을 즐기는 밤을 모두 생각하고 있다면 코팡안을 살펴보세요. 머무는 해변과 여행 날짜를 골라 북적이는 분위기를 즐기거나 조용히 쉬는 여행을 계획하실 수 있어요.",
  "tao": "해변 풍경뿐 아니라 물속 풍경도 궁금하시다면 코타오로 떠나보세요. 스노클링이나 다이빙을 배우며 바다를 만나고, 저녁에는 해변에서 쉬며 하루를 마무리해보세요.",
  "lanta": "바닷가 숙소에서 책을 읽고, 해 질 무렵에는 해변을 따라 걸어보세요. 매일 새로운 관광지를 찾아다니기보다 마음에 드는 해변에 오래 머물며 쉬고 싶은 분께 추천해요.",
  "samet": "방콕 여행에 짧은 바다 휴가를 더하고 싶다면 코사멧을 살펴보세요. 하얀 모래사장을 걷고 바닷가에서 식사하며, 도시를 둘러본 뒤 쉬어가는 시간을 보내실 수 있어요."
};
const guides=[['rail','방콕 전철·역 찾기','Bangkok rail & stations'],['bus','버스 터미널·목적지·요금','Bus terminals & routes'],['boat','보트·선착장·노선','Boats & piers'],['train','기차·역·승차권','Trains & tickets'],['air','태국 국내선','Domestic flights'],['taxi','택시·차량 호출','Taxis & ride hailing'],['motorcycle','오토바이 택시','Motorcycle taxis'],['local','툭툭·쏭태우','Tuk-tuks & songthaews']];
---
<div class="thai-shell">
 <a class="skip-link" href="#thai-main">{ui.skip}</a>
 <DetailHeader locale={locale} brand={brand}/>
 <main id="thai-main" class="home-main">

  {section==='destinations'&&(<section class="content-container home-destinations" id="destinations">{showKoreanTravel&&<><header class="travel-heading"><h1>태국 여행{page>1&&` · ${page}페이지`}</h1></header>{page===1&&<div class="home-entry-intro"><div class="section-heading"><div><span class="overline">BEFORE YOUR THAILAND TRIP</span><h2>태국 입국</h2><p><strong>한국 일반여권으로 태국에 관광하러 가시나요?</strong> 출발 전에 여권과 무비자 입국 조건을 살펴보고, 항공권과 숙소 예약증을 보며 TDAC를 작성해주세요. 비자가 필요한 일정이라면 방문 목적에 맞는 비자와 신청 방법도 함께 알아보실 수 있어요.</p></div><a href="/ko/entry/">태국 입국 안내 →</a></div><div class="home-guide-grid">{[['tdac','TDAC 작성 방법','여권과 예약증을 보며 휴대전화로 작성해보세요. 제출한 문서를 저장하고 잘못 적은 내용을 고치는 방법도 안내해요.'],['','태국 입국 방법','한국 여권의 무비자 입국 조건과 준비할 서류, 공항에 도착해 입국심사를 받는 순서를 알아보세요.'],['visa','태국 비자 종류','관광하러 가는지, 일하거나 공부할 계획인지에 따라 어떤 비자를 준비해야 하는지 살펴보세요.'],['tourist-visa','태국 관광비자','관광비자가 필요한 일정이라면 단수·복수 조건을 비교하고, 신청할 서류와 전자비자 제출 순서를 알아보세요.']].map(([id,title,text])=><a href={`/ko/entry/${id?id+'/':''}`}><span aria-hidden="true">↗</span><h3>{title}</h3><p>{text}</p></a>)}</div></div>} {page===1&&<div class="home-entry-intro home-seasons"><div class="section-heading"><div><span class="overline">WHEN TO VISIT THAILAND</span><h2>태국 여행 시기</h2><p>여행할 달을 정하셨나요? 방콕에서 사원과 시장을 걷고 싶은지, 푸껫이나 코사무이에서 쉬고 싶은지에 따라 날씨를 비교해보세요. 월별 기온과 비의 양을 살펴보고 여행하기 좋은 시기와 준비물을 알아보실 수 있어요.</p></div><a href="/ko/travel-seasons/">태국 여행 시기 전체 →</a></div><div class="home-guide-grid">{[['','여행하기 좋은 시기','지역과 달을 골라 기온·강수량을 비교하고, 그달의 장점과 주의할 점을 살펴보세요.'],['bangkok','방콕·도시 여행 시기','방콕의 12개월 날씨를 보고 사원 산책과 실내 휴식을 하루 일정에 나눠보세요.'],['rainy-dry','우기·건기 여행 준비','지역마다 다른 우기와 건기를 알아보고, 비 오는 날 일정과 바다 여행 준비를 읽어보세요.'],['koh-samui','해변 여행 시기','코사무이와 푸껫·끄라비의 월별 비를 비교해 어느 해안으로 떠날지 골라보세요.']].map(([id,title,text])=><a href={`/ko/travel-seasons/${id?id+'/':''}`}><span aria-hidden="true">↗</span><h3>{title}</h3><p>{text}</p></a>)}</div></div>}</>}<div class="section-heading"><div><span class="overline">EXPLORE THAILAND</span>{showKoreanTravel?<h2>목적지</h2>:<h1>{ui.destinations}</h1>}<p>{showKoreanTravel?'좋은 호텔에서 푹 쉬고 싶은지, 사원과 카페를 천천히 둘러보고 싶은지, 바닷가에서 휴가를 보내고 싶은지 떠올려보세요. 각 도시와 섬에서 보낼 하루를 생각하며 마음이 가는 곳을 골라보세요.':ui.mapIntro}</p></div></div><div class:list={["camera-grid", {"destination-card-grid": showKoreanTravel}]}>{pageAreas.map(city=>{const camera=cameras.find(c=>c.area===city.name);const preview=camera?.preview??cityPhotos[city.name];return <article class="camera-tile" id={`city-${city.id}`}><a class="home-place-image" href={`/${locale}/?city=${city.id}#map`}>{preview?.url&&<img src={preview.url} alt={travelCopy?.areas?.[city.id]?.name||placeName(city.name,locale)} loading="lazy" referrerpolicy="no-referrer"/>}<span>{travelCopy?.areas?.[city.id]?.name||placeName(city.name,locale)}</span></a><div class="tile-copy"><h3><a href={`/${locale}/?city=${city.id}#map`}>{travelCopy?.areas?.[city.id]?.name||placeName(city.name,locale)}</a></h3><p data-destination-intro={showKoreanTravel?city.id:undefined}>{showKoreanTravel ? travelCopy?.areas?.[city.id]?.intro || destinationIntrosKo[city.id] || `${ui.map} · ${ui.cameras}` : `${ui.map} · ${ui.cameras}`}</p>{preview&&<a class="photo-credit" href={preview.sourceUrl} target="_blank" rel="noopener noreferrer">{ui.photoCredit}: {sourceText(preview.credit,locale)}{preview.license&&` · ${preview.license}`}</a>}<div class="destination-actions"><a class="tile-official" href={`/${locale}/?city=${city.id}#map`}>{ui.viewMap} →</a>{beachCities.some(b=>b.id===({samet:'ko-samet'})[city.id]||b.id===city.id)&&<p><a href={`/${locale}/beaches/cities/${({samet:'ko-samet'})[city.id]||city.id}/`}>{placeName(city.name,locale)} · {locale==='ko'?'해변·해수욕장':beachHomeUI(locale).title} →</a></p>}{(locale==='ko'||hasLocalizedStage(locale,'rooftops'))&&['bangkok','chiang-mai','pattaya','phi-phi','phuket','samui'].includes(city.id)&&<p><a href={`/${locale}/rooftops/cities/${city.id}/`}>{travelCopy?.areas?.[city.id]?.name||placeName(city.name,locale)} · 루프탑·전망대 →</a></p>}</div></div></article>})}</div></section>)}

  {section==='food'&&(ko?<section class="content-container home-food" id="food"><div class="section-heading"><div><span class="overline">THAI FOOD & CULTURE</span><h1>음식</h1><p>태국 전통음식부터 도시마다 다른 대표 음식과 먹는 방법까지 살펴보세요.</p></div><a href="/ko/food/">태국 음식 전체 →</a></div><div class="camera-grid">{food.cities.map(city=><article class="camera-tile"><div class="tile-copy"><FoodPhoto dish={food.dishes.find(d=>d.id===city.photoDish)} variant="card"/><span class="overline">{city.english.toUpperCase()}</span><h3><a href={`/ko/food/cities/${city.id}/`}>{city.name} 음식</a></h3><p>{city.tag}</p><a class="tile-official" href={`/ko/food/cities/${city.id}/`}>대표 음식·지역의 맛 →</a></div></article>)}</div><div class="home-link-row"><a href="/ko/food/traditions/">태국 전통음식 소개 →</a><a href="/ko/rooftops/">루프탑·전망대 방문 안내 →</a><a href="/ko/food-delivery/">음식배달 앱·주문 안내 →</a></div></section>:<section class="content-container home-food" id="food"><div class="section-heading"><div><span class="overline">FOOD & CITY VIEWS</span><h1>{ui.food}</h1><p>{ko?'전망을 즐기는 식사·바 방문 정보와 음식배달 이용 방법을 살펴보세요.':ui.explore}</p></div><a href="/ko/rooftops/">{ko?'루프탑·전망대 전체':'Rooftops & viewpoints'} →</a></div><div class="camera-grid">{venues.filter(v=>v.publicationStatus!=='held').slice(0,6).map(v=><article class="camera-tile"><div class="tile-copy"><span class="overline">{v.city.toUpperCase()}</span><h3><a href={`/ko/rooftops/${v.id}/`}>{ko?v.name:v.english}</a></h3><p>{v.building}</p><a class="tile-official" href={`/ko/rooftops/${v.id}/`}>{ko?'예약·입장·식사 정보':'Visit information (Korean)'} →</a></div></article>)}</div><div class="home-link-row"><a href={`/${locale}/food-delivery/`}>{ko?'음식배달 앱·주문·비용 안내':navigationLabels[locale][7]} →</a><a href={`/${locale}/beaches/`}>{ko?'태국 해변 안내':beachHomeUI(locale).title} →</a></div></section>)}
  {section==='transport'&&(<section class="content-container" id="transport"><div class="section-heading"><div><span class="overline">THAILAND TRANSPORT</span><h1>{ui.transport}</h1><p>{ko?'기존 노선도·정차역·요금·터미널·이용 방법을 교통수단별로 확인하세요.':ui.explore}</p></div><a href="/ko/transport/">{ui.explore} →</a></div><div class="home-guide-grid">{guides.map(([id,title,en])=><a href={id==='rail'?'/ko/transport/bangkok/':`/ko/transport/guides/${id}/`}><span>↗</span><h3>{ko?title:en}</h3><p>{ko?'노선·지도·이용 안내':'Route maps & travel guide (Korean)'}</p></a>)}</div></section>)}
  {section==='coupons'&&(<section class="content-container" id="coupons"><div class="section-heading"><div><span class="overline">OFFICIAL OFFERS</span><h1>{ui.coupons}</h1><p>{ko?'음식배달 할인은 앱의 주문 화면에서 적용 조건과 최종 결제금액을 확인하세요.':ui.explore}</p></div></div><div class="home-link-row">{delivery.sources.filter(([label,url])=>url.includes('grab.com')||url.includes('lineman')).map(([label,url])=><a href={url} target="_blank" rel="noopener noreferrer">{ko?label:new URL(url).hostname} ↗</a>)}</div></section>)}

 </main>
 <SiteFooter locale={locale}/>
</div>
<style>.home-main{max-width:1240px;margin:auto;min-height:65vh}.section-heading h1{font-size:32px;line-height:1.35;margin:12px 0;color:#253545}@media(max-width:760px){.section-heading h1{font-size:26px}}
.travel-heading{margin-bottom:32px}.home-entry-intro{margin-bottom:64px}.home-entry-intro h2{margin-top:8px}@media(max-width:799px){.home-entry-intro{margin-bottom:40px}.home-entry-intro .section-heading{flex-wrap:wrap}}@media(max-width:420px){.home-entry-intro .home-guide-grid{grid-template-columns:1fr}}</style>

<style>.home-entry-intro .section-heading p,.home-entry-intro .home-guide-grid p{word-break:keep-all;overflow-wrap:anywhere}.home-entry-intro .section-heading p{max-width:880px}.home-entry-intro strong{color:#253545;font-weight:650}</style>

<style>
/* Keep each destination's photo, heading, copy, credit and map action in shared rows. */
.destination-card-grid > .camera-tile {display:flex;flex-direction:column;min-width:0}
.destination-card-grid > .camera-tile:hover {transform:none}
.destination-card-grid .tile-copy {display:flex;flex-direction:column;flex:1;min-width:0}
.destination-card-grid .tile-copy > p {flex:1;margin:0;line-height:1.85;overflow-wrap:anywhere}
.destination-card-grid .tile-copy > h3 {margin:0 0 8px}
.destination-card-grid .photo-credit {margin-top:16px;overflow-wrap:anywhere}
.destination-card-grid .destination-actions {display:flex;flex-direction:column;min-width:0}
.destination-card-grid .destination-actions > p {margin:8px 0 0;line-height:1.7}
.destination-card-grid .destination-actions a {overflow-wrap:anywhere}
.destination-card-grid .tile-official {min-height:44px;flex-shrink:0;box-sizing:border-box}
@supports (grid-template-rows:subgrid) {
  .destination-card-grid {row-gap:24px}
  .destination-card-grid > .camera-tile {display:grid;grid-row:span 5;grid-template-rows:subgrid;grid-template-columns:minmax(0,1fr);row-gap:0}
  .destination-card-grid .tile-copy {display:grid;grid-row:span 4;grid-template-rows:subgrid;grid-template-columns:minmax(0,1fr);row-gap:0}
  .destination-card-grid .tile-copy > * {grid-column:1}
  .destination-card-grid .tile-copy > h3 {grid-row:1}
  .destination-card-grid .tile-copy > p {grid-row:2}
  .destination-card-grid .photo-credit {grid-row:3}
  .destination-card-grid .destination-actions {grid-row:4;align-self:stretch}
}
</style>
