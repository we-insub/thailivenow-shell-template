---
import {transportData,transportPageLocale} from '../lib/transport-localization.mjs';
const transportLocale=transportPageLocale(Astro.url.pathname);
const {terminal:terminalSource}=Astro.props;
const terminal=transportData(terminalSource,transportLocale);
---
<section id="terminal-facilities" class="terminal-facilities"><h2>식사·대기·짐 보관은 어디에서 하나요?</h2><p>먼저 발권과 승차홈 확인을 마친 뒤 남은 시간에 맞춰 시설을 이용하세요. 터미널 안의 편의시설과 밖의 식당은 아래에서 구분했어요.</p><div class="facility-grid">{terminal.facilities?.map(f=><article><h3>{f.name}</h3><strong class="location">{f.location}</strong><p>{f.description}</p>{f.costNote&&<p class="cost">{f.costNote}</p>}<a href={f.sourceUrl} target="_blank" rel="noopener noreferrer">시설 안내 출처 ↗</a></article>)}</div>{terminal.dining?.length>0&&<><h3 class="dining-heading">터미널 주변에서 식사하기</h3><div class="facility-grid">{terminal.dining.map(f=><article><h4>{f.name}</h4><p>{f.location}<br/>태국 현지 시간 {f.hours}</p><p>{f.description}</p><a href={f.sourceUrl} target="_blank" rel="noopener noreferrer">공식 매장·영업 안내 ↗</a></article>)}</div></>}{terminal.internationalNotes?.map(note=><article class="international-note"><h3>{note.title}</h3><p>{note.text}</p><a href={note.sourceUrl} target="_blank" rel="noopener noreferrer">국경 통과 현황 근거 ↗</a></article>)}<h3 class="dining-heading">버스표 외에 준비할 비용</h3><p>터미널까지의 교통비, 식사·음료, 짐 보관, 추가 수하물, 도착 후 호텔까지의 이동비를 따로 준비하세요. 유료 시설은 접수 전에 현장 요금표를 확인하세요.</p></section>
<section id="terminal-counters" class="terminal-facilities"><h2>어느 창구로 가야 하나요?</h2><div class="facility-grid">{terminal.ticketCounters?.map(c=><article><h3>{c.operator}</h3><strong class="location">{c.location}</strong><p>{c.instruction}</p><a href={c.sourceUrl} target="_blank" rel="noopener noreferrer">발권 위치·운영사 안내 ↗</a></article>)}</div><p>같은 터미널에서도 운영사에 따라 창구가 달라요. 층과 창구 번호를 모든 버스에 공통으로 적용하지 말고, 예약표와 현장 표시를 대조하세요.</p></section>
<style>.international-note{margin:20px 0;padding:18px;background:#eef6f7;border-radius:10px}.international-note a{color:#267e89;font-size:13px}.terminal-facilities{margin:32px 0;scroll-margin-top:110px}.facility-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.facility-grid article{background:#fff;border:1px solid #dce5e8;border-radius:12px;padding:20px}.facility-grid h3,.facility-grid h4{font-size:18px;margin:0 0 10px}.location{font-size:14px;color:#267e89}.facility-grid p{font-size:14px;line-height:1.8}.facility-grid a{font-size:12px;color:#267e89}.cost{padding:8px 10px;background:#eef6f7;border-radius:6px}.dining-heading{margin-top:28px}@media(max-width:600px){.facility-grid{grid-template-columns:1fr}}</style>
