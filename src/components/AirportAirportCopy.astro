---
import {airportAirportCopy} from '../lib/airport-airport-copy';
import {airportReviewDictionary} from '../lib/airport-review';
const {locale,name,services=false,routes=false,status=false,part='faq'}=Astro.props;
const copy=airportAirportCopy[locale];
const native=(text:string)=>text.replaceAll('{name}',name);
const koName=airportReviewDictionary(locale)[name]||name;
const segments=(text:string)=>[...new Intl.Segmenter(locale,{granularity:'sentence'}).segment(text)].map(item=>item.segment.trim()).filter(Boolean).map(text=>({text:native(text),ko:(copy.koreanReview[text]||'').replaceAll('{name}',koName)}));
const faq=copy?[
 ...(services?[{q:copy.counterQ,a:copy.counterA}]:[]),
 ...(routes?[{q:copy.routeQ,a:copy.routeA}]:[]),
 ...(status?[{q:copy.statusQ,a:copy.statusA}]:[]),
]:[];
---
{copy&&part==='intro'&&<p data-korean-review>{segments(copy.intro).map(item=><>{`${item.text}${item.ko?` (${item.ko})`:""} `}</>)}</p>}
{copy&&part==='faq'&&faq.length>0&&<section data-korean-review><h2>{copy.faqTitle} ({copy.koreanReview[copy.faqTitle]})</h2>{faq.map(item=><details><summary>{item.q} ({copy.koreanReview[item.q]})</summary><p>{segments(item.a).map(sentence=><>{`${sentence.text}${sentence.ko?` (${sentence.ko})`:""} `}</>)}</p></details>)}</section>}
{part==='faq'&&faq.length>0&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(item=>({'@type':'Question',name:native(item.q),acceptedAnswer:{'@type':'Answer',text:native(item.a)}}))}).replaceAll('<','\u003c')}/>}
