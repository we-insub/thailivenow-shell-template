---
import AirportPhone from './AirportPhone.astro';
import AirportEmail from './AirportEmail.astro';
import {airportMarkets,airportMarketData} from '../lib/airport-markets';
import {airlineCatalogue} from '../lib/airport-airline-catalogue';
import {buildGlobalAirportRecords,marketLabels,recordsForAirport,englishContactPhone} from '../lib/airport-global-search.mjs';
const {airport}=Astro.props;
const allRecords=buildGlobalAirportRecords(airportMarkets.map(m=>({locale:m.locale,data:airportMarketData(m.locale)})),airlineCatalogue);
const records=recordsForAirport(allRecords,airport);
---
<section data-global-airport-search class="global-airport-search" aria-labelledby="global-search-title">
<h2 id="global-search-title">{airport?`${airport}: airline counters, contacts and flights by country`:'Search all country records'}</h2><p>Search airline names or codes, flight numbers, airport codes and recorded contacts across all ten country datasets. Results explain where to go in English; each country’s full record opens in its original language. Country-specific conditions remain separate.</p>
<div class="search-controls"><label>Airline, flight, airport or contact<input type="search" data-global-query placeholder="e.g. Asiana, OZ, UA878, SFO, BKK" autocomplete="off" aria-controls="global-airport-results"/></label><label>Record type<select data-global-kind><option value="all">All records</option><option value="airline">Airline help</option><option value="route">Flights and routes</option><option value="contact">Airport counters and contacts</option><option value="guide">Disruption and baggage guides</option></select></label><label>Country dataset<select data-global-market><option value="all">All countries</option>{Object.entries(marketLabels).map(([code,label])=><option value={code}>{label[0]}</option>)}</select></label></div>
<p role="status" aria-live="polite" data-global-status>Search {records.length} records, or browse by type and country.</p><div id="global-airport-results" class="global-results">{records.map((r,i)=><article data-global-record data-kind={r.kind} data-market={r.locale} data-markets={r.locales?.join(",")} data-search={r.search} data-tokens={r.tokens} hidden={i>=12}><p class="result-label">{r.country} · {({airline:'Airline help',route:'Flight record',contact:'Airport contact',guide:'Travel help guide'})[r.kind]}</p><h3>{r.title}</h3><p>{r.description}</p>{r.phone&&<AirportPhone phone={englishContactPhone(r.phone)}/>}{r.email&&<AirportEmail email={r.email}/>}<a href={r.href} lang={r.locale}>Read the full record →</a></article>)}</div><p data-global-empty hidden>No matching record. Try an airline code or an airport code, or select another record type.</p><button type="button" data-global-more>Show more results</button>
</section>
<script>
import {matchesGlobalRecord} from '../lib/airport-global-search.mjs';
for(const root of document.querySelectorAll<HTMLElement>('[data-global-airport-search]')){const query=root.querySelector<HTMLInputElement>('[data-global-query]')!,kind=root.querySelector<HTMLSelectElement>('[data-global-kind]')!,market=root.querySelector<HTMLSelectElement>('[data-global-market]')!,cards=[...root.querySelectorAll<HTMLElement>('[data-global-record]')],status=root.querySelector<HTMLElement>('[data-global-status]')!,more=root.querySelector<HTMLButtonElement>('[data-global-more]')!;let limit=12;
const update=()=>{const matches=cards.filter(card=>matchesGlobalRecord({search:card.dataset.search,tokens:card.dataset.tokens,kind:card.dataset.kind,locale:card.dataset.market,locales:card.dataset.markets?.split(",")},query.value,kind.value,market.value));const shown=new Set(matches.slice(0,limit));for(const c of cards)c.hidden=!shown.has(c);status.textContent=`${matches.length} matching record${matches.length===1?'':'s'} · showing ${shown.size}.`;more.hidden=matches.length<=limit;root.querySelector<HTMLElement>('[data-global-empty]')!.hidden=matches.length>0;};
for(const control of [query,kind,market])control.addEventListener(control===query?'input':'change',()=>{limit=12;update();});more.addEventListener('click',()=>{limit+=12;update();});const params=new URLSearchParams(location.search);query.value=params.get('q')||'';if(['airline','route','contact','guide'].includes(params.get('kind')||''))kind.value=params.get('kind')!;if(params.get('market')&&[...market.options].some(o=>o.value===params.get('market')))market.value=params.get('market')!;update();}
</script>
<style>.global-airport-search{margin:44px 0}.search-controls{display:grid;grid-template-columns:2fr 1fr 1fr;gap:16px}.search-controls label{display:grid;gap:8px;font-weight:650}.search-controls input,.search-controls select{min-width:0;width:100%;min-height:50px;border:1px solid #b6cbd0;border-radius:10px;padding:10px 12px;font:inherit;background:white;color:inherit;box-sizing:border-box}.global-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.global-results article{padding:22px;background:white;border:1px solid #dce5e8;border-radius:14px;min-width:0;overflow-wrap:anywhere}.global-results h3{font-size:20px;line-height:1.45;margin:8px 0}.result-label{font-size:13px}.global-airport-search [hidden]{display:none!important}.global-airport-search button{padding:14px 22px;border:1px solid #267e89;border-radius:10px;background:white;color:#267e89;font:inherit;cursor:pointer}.global-airport-search :focus-visible{outline:3px solid #267e89;outline-offset:3px}@media(max-width:700px){.search-controls,.global-results{grid-template-columns:1fr}}</style>
