---
import {transportData,transportText,transportFormat,transportPageLocale} from '../lib/transport-localization.mjs';
import dataSource from '../data/transport/bangkok.json';
const transportLocale=transportPageLocale(Astro.url.pathname);
const data=transportData(dataSource,transportLocale);
const lines=data.bangkok_lines;
---
<section class="transport-explorer" aria-labelledby="rail-map-heading">
  <div class="map-heading"><div><span class="kicker">BANGKOK TRANSPORT</span><h2 id="rail-map-heading">방콕 철도 노선 지도</h2><p>어디에서 타고 내릴지 지도로 살펴보세요. 역을 누르면 노선과 이동 안내를 볼 수 있어요.</p></div><button id="show-all-rail">전체 노선 보기</button></div>
  <div class="explorer-layout"><aside class="rail-panel"><label for="rail-search">역 이름 검색</label><input id="rail-search" type="search" placeholder="Siam, Asok, Itsaraphap…"/><div class="rail-filters">{lines.map(line=><button data-rail-line={line.id} aria-pressed="false" style={`--line-color:${line.color}`}><i></i>{line.name_ko}</button>)}</div><div id="rail-selection" aria-live="polite"><strong>역을 선택해 보세요</strong><p>지도의 역과 아래 검색 결과를 누르면 이용할 노선과 역 정보를 확인할 수 있어요.</p></div><div id="rail-search-results"></div></aside><div class="rail-stage"><div id="bangkok-rail-map" data-lines={JSON.stringify(lines.map(l=>({id:l.id,name:l.name_ko,color:l.color})))}></div><p id="rail-map-status" role="status">실제 노선과 역 위치를 불러오고 있어요.</p></div></div>
  <p class="rail-guide-selection" id="rail-guide-selection" role="status">노선을 선택하면 해당 노선의 표 구매·탑승 안내가 표시돼요.</p>
  <p class="map-credit">노선 형상·역 위치: <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">© OpenStreetMap 기여자 · ODbL</a>. 운행·승차권 안내는 각 운영사 자료를 참고하세요.</p>
</section>
<script>import '../scripts/bangkok-transport';</script>
<style>
.transport-explorer{margin:32px 0}.map-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:18px}.kicker{font-size:10px;letter-spacing:1.5px;color:#e84d47;font-weight:800}.map-heading h2{margin:8px 0;font-size:26px}.map-heading p{margin:0;color:#61717e;font-size:14px}.map-heading>button{white-space:nowrap;padding:10px 14px;border:1px solid #dce5e8;border-radius:8px;background:#fff;color:#2e7c89;cursor:pointer}.explorer-layout{display:grid;grid-template-columns:290px minmax(0,1fr);border:1px solid #dce5e8;border-radius:16px;overflow:hidden;background:white}.rail-panel{padding:20px;max-height:650px;overflow:auto}.rail-panel label{display:block;font-size:12px;font-weight:700;margin-bottom:7px}.rail-panel input{width:100%;padding:10px;border:1px solid #dce5e8;border-radius:8px;font:inherit;font-size:13px}.rail-filters{display:grid;gap:7px;margin:16px 0}.rail-filters button{display:flex;gap:9px;align-items:center;padding:9px;border:1px solid #e4eaee;border-radius:8px;background:white;text-align:left;font-size:12px;color:#253545;cursor:pointer}.rail-filters button i{width:18px;height:4px;background:var(--line-color);flex-shrink:0}.rail-filters button.active{border-color:var(--line-color);background:#f3f7fa}#rail-selection{padding:15px 0;border-top:1px solid #e4eaee;font-size:14px}#rail-selection p{font-size:12px;color:#61717e}#rail-selection :global(a){display:block;color:#2e7c89;font-size:12px;margin:6px 0}#rail-search-results :global(button){display:block;width:100%;background:white;border:0;border-bottom:1px solid #e4eaee;padding:10px;text-align:left;cursor:pointer}.rail-stage{position:relative;min-height:650px}#bangkok-rail-map{position:absolute;inset:0}#rail-map-status{position:absolute;left:12px;bottom:24px;background:#ffffffed;border-radius:6px;padding:7px 10px;font-size:11px;max-width:calc(100% - 24px)}.rail-guide-selection{padding:12px 16px;background:#eef4f5;border-radius:8px;color:#2e7c89;font-size:14px}:global([data-rail-guide-lines][hidden]){display:none!important}.map-credit{font-size:11px;color:#71818e}.rail-stage :global(.maplibregl-popup-content){font-family:system-ui,sans-serif;padding:14px}.rail-stage :global(.maplibregl-popup-content a){color:#2e7c89;font-size:12px;display:block;margin-top:7px}@media(max-width:760px){.map-heading{display:block}.map-heading>button{margin-top:12px}.explorer-layout{display:flex;flex-direction:column}.rail-stage{order:0;min-height:470px}.rail-panel{order:1;max-height:none}.rail-filters{grid-template-columns:repeat(2,minmax(0,1fr))}.rail-filters button{font-size:11px}#rail-selection{padding-bottom:0}}
</style>
