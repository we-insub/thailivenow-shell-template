---
const {center,label,place}=Astro.props as {center:[number,number];label:string;place:string};
---
<div class="camera-area-map" data-camera-area-map data-lng={center[0]} data-lat={center[1]} data-label={label} aria-label={`${place} 참고 위치 지도`}></div>
<script>
import {Map} from '../scripts/resilient-map';
import {Marker,NavigationControl,setWorkerUrl} from 'maplibre-gl';
import workerUrl from 'maplibre-gl/dist/maplibre-gl-csp-worker.js?url';
import 'maplibre-gl/dist/maplibre-gl.css';
const element=document.querySelector<HTMLElement>('[data-camera-area-map]');
if(element){
  setWorkerUrl(workerUrl);
  const center:[number,number]=[Number(element.dataset.lng),Number(element.dataset.lat)];
  const map=new Map({container:element,center,zoom:10,scrollZoom:false});
  map.addControl(new NavigationControl());
  const label=document.createElement('div');
  label.className='camera-area-marker';label.textContent=element.dataset.label??'';
  new Marker({element:label}).setLngLat(center).addTo(map);
}
</script>
<style>
.camera-area-map{width:100%;height:400px;border:1px solid #d5e1e5;border-radius:12px;overflow:hidden;margin:24px 0 16px}
:global(.camera-area-marker){padding:7px 12px;background:#267e89;color:#fff;border:2px solid white;border-radius:20px;font:700 13px/1.5 system-ui,sans-serif;box-shadow:0 2px 6px #20374330;white-space:nowrap}
@media(max-width:650px){.camera-area-map{height:300px}}
</style>
