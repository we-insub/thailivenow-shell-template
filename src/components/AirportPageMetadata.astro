---
const {title,description,locale='ko',lang='ko-KR'}=Astro.props;
const base=Astro.site||Astro.url;
const canonical=new URL(Astro.url.pathname,base).href;
const hub=new URL(`/${locale}/airport-assistance/`,base).href;
const schema={
  '@context':'https://schema.org',
  '@type':'WebPage',
  '@id':`${canonical}#webpage`,
  url:canonical,
  name:title,
  ...(description?{description}:{}),
  inLanguage:lang,
  isPartOf:{'@type':'WebSite',name:'ThaiLiveNow',url:new URL('/',base).href},
  ...(canonical!==hub?{breadcrumb:{'@type':'BreadcrumbList',itemListElement:[
    {'@type':'ListItem',position:1,name:'ThaiLiveNow',item:hub},
    {'@type':'ListItem',position:2,name:title,item:canonical}
  ]}}:{})
};
---
<link rel="canonical" href={canonical}/>
<meta name="robots" content="index,follow"/>
<meta property="og:type" content="website"/>
<meta property="og:title" content={title}/>
{description&&<meta property="og:description" content={description}/>}
<meta property="og:url" content={canonical}/>
<script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\u003c')}/>
