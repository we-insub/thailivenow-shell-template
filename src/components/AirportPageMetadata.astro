---
import {isKoreanAirportGuide} from '../lib/airport-guide-navigation.mjs';
import {airportUI} from '../i18n/airport-ui';
const {title,description,locale='ko',lang='ko-KR',parentUrl,parentLabel}=Astro.props;
const base=Astro.site||Astro.url;
const canonical=new URL(Astro.url.pathname,base).href;
const airportGuide=locale==='ko'&&isKoreanAirportGuide(Astro.url.pathname);
const hub=new URL(airportGuide?'/ko/airports/':`/${locale}/airport-assistance/`,base).href;
const parent=parentUrl?new URL(parentUrl,base).href:null;
const crumbs=[{name:airportGuide?'태국 공항':parent?(locale==='ko'?'지연·결항·수하물 대응 안내':airportUI[locale]?.[0]||'ThaiLiveNow'):'ThaiLiveNow',item:hub},...(parent&&parent!==hub?[{name:parentLabel,item:parent}]:[]),{name:title,item:canonical}];
const schema={
  '@context':'https://schema.org',
  '@type':'WebPage',
  '@id':`${canonical}#webpage`,
  url:canonical,
  name:title,
  ...(description?{description}:{}),
  inLanguage:lang,
  isPartOf:{'@type':'WebSite',name:'ThaiLiveNow',url:new URL('/',base).href},
  ...(canonical!==hub?{breadcrumb:{'@type':'BreadcrumbList',itemListElement:crumbs.map((crumb,i)=>({'@type':'ListItem',position:i+1,...crumb}))}}:{})
};
---
<link rel="canonical" href={canonical}/>
<meta name="robots" content="index,follow"/>
<meta property="og:type" content="website"/>
<meta property="og:title" content={title}/>
{description&&<meta property="og:description" content={description}/>}
<meta property="og:url" content={canonical}/>
<script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\u003c')}/>
