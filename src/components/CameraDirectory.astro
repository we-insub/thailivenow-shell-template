---
import {getDesignUI} from '../i18n/design-ui';
import DetailHeader from './DetailHeader.astro';
import SiteFooter from './SiteFooter.astro';
import CameraGallery from './CameraGallery.astro';
import {cameras} from '../data/cameras';
import {locales} from '../i18n/locales';
import {getUI} from '../i18n/ui';
const {locale='ko',saved=false,page=1}=Astro.props;
const design=getDesignUI(locale);
const ui=getUI(locale),active=locales.find(v=>v.code===locale)!;
const title=saved?design.saved:ui.cameraList;
---
<!doctype html><html lang={active.tag} data-locale={locale}><head><meta charset="utf-8"/><meta name="robots" content="noindex,nofollow"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><title>{title}{!saved&&page>1?(locale==='ko'?` ${page}페이지`:` · Page ${page}`):''} | ThaiLiveNow</title><meta name="description" content={`${title} · ${(page-1)*24+1}–${Math.min(page*24,cameras.length)} / ${cameras.length}. ${ui.galleryIntro}`}/></head><body><DetailHeader locale={locale} home/><main class="camera-directory content-container"><div class="page-heading"><nav class="breadcrumbs"><a href={`/${locale}/`}>{ui.map}</a> › {title}</nav><span class="count-label">{saved?'PRIVATE TO THIS BROWSER':`${(page-1)*24+1}–${Math.min(page*24,cameras.length)} / ${cameras.length}`}</span><h1>{saved&&locale==='ko'?'저장한 카메라와 최근 본 카메라':title}</h1><p>{saved?(locale==='ko'?'이 브라우저에 저장한 태국 카메라를 다시 찾아보세요.':'Revisit Thailand cameras saved in this browser.'):ui.galleryIntro}</p></div>{!saved&&<label class="directory-search search-box">⌕ <input type="search" id="directory-search" aria-label={ui.search} placeholder={ui.search}/></label>}{saved&&<div class="saved-tabs" role="tablist" aria-label={title}><button type="button" role="tab" data-personal-tab="saved" aria-selected="true">{design.saved}</button><button type="button" role="tab" data-personal-tab="recent" aria-selected="false">{locale==='ko'?'최근 본 카메라':'Recently viewed'}</button></div>}{saved&&<button class="saved-clear" type="button" data-clear-recent hidden>{locale==='ko'?'전체 기록 삭제':'Clear history'}</button>}<div data-directory-page={saved?undefined:page}><CameraGallery locale={locale} savedOnly={saved}/></div>{!saved&&<nav class="directory-pagination" aria-label={locale==='ko'?'페이지 선택':'Pagination'}>{Array.from({length:Math.ceil(cameras.length/24)},(_,i)=><a href={i===0?`/${locale}/directory/`:`/${locale}/directory/${i+1}/`} aria-current={page===i+1?'page':undefined}>{i+1}</a>)}</nav>}</main><SiteFooter locale={locale}/></body></html>
<script>
const input=document.querySelector<HTMLInputElement>('#directory-search'),root=document.querySelector<HTMLElement>('[data-directory-page]');
function filter(){if(!root)return;const page=Number(root.dataset.directoryPage||1),query=input?.value.trim().toLocaleLowerCase()||'';root.querySelectorAll<HTMLElement>('[data-camera-gallery]').forEach((card,i)=>card.hidden=query?!card.textContent?.toLocaleLowerCase().includes(query):i<(page-1)*24||i>=page*24);}
input?.addEventListener('input',filter);filter();
</script>
