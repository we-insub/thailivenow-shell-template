---
import ThaiLiveNowShell from './ThaiLiveNowShell.astro';
import TopicHub from './TopicHub.astro';
import LocaleRedirect from './LocaleRedirect.astro';
import { locales, type Locale } from '../i18n/locales';
import { getUI } from '../i18n/ui';
const {locale='en',autoDetect=false,section}=Astro.props as {locale?:Locale;autoDetect?:boolean;section?:string};
const active=locales.find(item=>item.code===locale)!;
const ui=getUI(locale);
const regionTitle=locale==='en-in' ? 'Thailand travel for Indian travellers' : locale==='en-gb' ? 'Thailand travel for UK travellers' : locale==='en-us' ? 'Thailand travel for US travelers' : ui.explore;
const koreanTopics:Record<string,[string,string]>={
 destinations:['태국 여행 · 입국 준비와 도시별 여행지','한국 일반여권으로 관광하러 가는 분을 위한 태국 입국 준비와 TDAC 작성, 비자 안내를 살펴보세요. 방콕·치앙마이·푸켓 등 도시별 여행지와 공개 카메라도 지도에서 찾아볼 수 있어요.'],
 coupons:['태국 배달 할인쿠폰 · 공식 혜택 확인','Grab과 LINE MAN의 공식 혜택 페이지에서 태국 음식배달 할인 정보를 찾아보세요. 주문 전 앱에서 적용 조건과 최종 결제금액을 확인하는 방법을 안내해요.'],
};
const topicMetadata=locale==='ko'&&section?koreanTopics[section]:undefined;
---
<!doctype html>
<html lang={active.tag} data-locale={locale}>
  <head><link rel="icon" href="/favicon.ico?v=20261013" sizes="16x16 32x32 48x48" /><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261013" sizes="any" /><link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261013" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Indexing is generated by the shared page-seo policy. -->
    <title>{topicMetadata?.[0] || (section ? `${ui[section]} · ${regionTitle} | ThaiLiveNow` : `ThaiLiveNow | ${regionTitle}`)}</title>
    <meta name="description" content={topicMetadata?.[1] || (section ? '' : ui.footer)} />
    {locales.map(item=><link rel="alternate" hreflang={item.tag} href={new URL(`/${item.code}/${section ? `${section}/` : ''}`,(Astro.site || Astro.url)).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(`/en/${section ? `${section}/` : ''}`,(Astro.site || Astro.url)).href} />
    {autoDetect && <LocaleRedirect />}
  </head>
  <body>{section ? <TopicHub locale={locale} section={section}/> : <ThaiLiveNowShell locale={locale} />}</body>
</html>
