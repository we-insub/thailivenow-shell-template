---
import {airportTransportGuide,airportTransferUI} from '../lib/airport-depth';
const {locale}=Astro.props,g=airportTransportGuide(locale),ui=airportTransferUI(locale),rows=g.sections.find((s:any)=>s.id==='destinations').table.rows;
const ids=['asok','silom','old-town','siam','khao-san'];
const destinations=rows.map((r:any,i:number)=>({id:ids[i],name:r[0],route:r[1],fareParts:r[2],fare:r[3],duration:r[4]}));
const payload={ui,destinations};
---
<section class="transfer-chooser" data-localized-transfer data-transfer-copy={JSON.stringify(payload)}>
<span class="chooser-eyebrow">BKK → BANGKOK</span><h2>{ui.title}</h2><p>{ui.intro}<br/><strong>{ui.emphasis}</strong></p>
<form hidden><div class="chooser-fields"><label>{ui.area}<select name="destination" required><option value="">{ui.choose}</option>{destinations.map((d:any)=><option value={d.id}>{d.name}</option>)}</select></label><label>{ui.time}<input name="time" type="time" required aria-describedby="transfer-time-help"/><small id="transfer-time-help">{ui.timeHelp}</small></label><label>{ui.luggage}<select name="luggage"><option value="light">{ui.light}</option><option value="many">{ui.many}</option></select></label><label>{ui.preference}<select name="preference"><option value="compare">{ui.compare}</option><option value="door">{ui.door}</option></select></label></div><div class="chooser-buttons"><button type="submit">{ui.submit} →</button><button type="reset">{ui.reset}</button></div></form>
<noscript><p>{ui.noscript}</p></noscript><p role="status" data-choice-status></p>
<div data-choice-results hidden><h3 tabindex="-1" data-choice-heading></h3><p data-choice-reason></p><p>{ui.notice}</p><div data-choice-cards>
<article data-mode="rail"><h4>ARL + MRT · BTS</h4><p data-rail-status></p><div data-rail-details><dl>{['route','fare','duration'].map(key=><div><dt>{ui[key]}</dt><dd data-choice-value={key}></dd></div>)}</dl><p>{ui.railAdvice}</p><p><strong>B1 · Airport Rail Link</strong></p></div><a href="#rail">{ui.railLink} →</a></article>
<article data-mode="taxi"><h4>{ui.taxi}</h4><p>{g.sections.find((s:any)=>s.id==='taxi').paragraphs[0]}</p>{g.sections.find((s:any)=>s.id==='taxi-cost').paragraphs.map((text:string)=><p>{text}</p>)}<a href="#taxi-cost">{ui.taxiLink} →</a></article>
<article data-mode="grab"><h4>{ui.grab}</h4>{g.sections.find((s:any)=>s.id==='apps').paragraphs.filter((_:any,i:number)=>i!==1).map((text:string)=><p>{text}</p>)}<a href="#apps">{ui.grabLink} →</a></article>
</div><p>{ui.footnote}</p></div>
</section>
<script>
import base from '../data/transport/airport-guides/suvarnabhumi-to-bangkok.json';
import {compareAirportTransfer} from '../lib/airport-transfer-choice.mjs';
for(const root of document.querySelectorAll<HTMLElement>('[data-localized-transfer]')){
 const {ui,destinations}=JSON.parse(root.dataset.transferCopy!),form=root.querySelector('form')!,result=root.querySelector<HTMLElement>('[data-choice-results]')!,status=root.querySelector('[data-choice-status]')!,heading=root.querySelector<HTMLElement>('[data-choice-heading]')!;form.hidden=false;
 form.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;try{const values=Object.fromEntries(new FormData(form)),c=compareAirportTransfer(base,values),place=destinations.find((d:any)=>d.id===values.destination),format=(s:string)=>s.replace('{name}',place.name).replace('{time}',String(values.time));heading.textContent=format(ui.heading);root.querySelector('[data-choice-reason]')!.textContent=ui[!c.hasRailRoute?'noRailReason':!c.withinHours?'outsideReason':values.preference==='door'?'doorReason':values.luggage==='many'?'manyReason':'compareReason'];root.querySelector('[data-rail-status]')!.textContent=format(ui[!c.hasRailRoute?'noRail':c.withinHours?'inside':'outside']);root.querySelector<HTMLElement>('[data-rail-details]')!.hidden=!c.hasRailRoute;for(const key of ['route','fare','duration'])root.querySelector(`[data-choice-value=${key}]`)!.textContent=key==='fare'?place.fare+' · '+place.fareParts:place[key];for(const mode of c.roadFirst?['taxi','grab','rail']:['rail','taxi','grab'])root.querySelector('[data-choice-cards]')!.append(root.querySelector(`[data-mode=${mode}]`)!);result.hidden=false;status.textContent=ui.success;heading.focus();}catch{result.hidden=true;status.textContent=ui.failure;}});
 form.addEventListener('input',()=>{if(!result.hidden){result.hidden=true;status.textContent=ui.changed;}});form.addEventListener('reset',()=>{result.hidden=true;status.textContent='';});
}
</script>
<style>.transfer-chooser{margin:28px 0 40px;padding:28px;border:1px solid #c9dedf;border-radius:18px;background:#f0f7f6}.chooser-eyebrow{letter-spacing:1.6px;color:#267e89;font-size:12px;font-weight:750}.chooser-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 24px}.chooser-fields label{display:flex;flex-direction:column;gap:9px;font-weight:700;min-width:0}.chooser-fields input,.chooser-fields select{font:inherit;box-sizing:border-box;min-height:50px;width:100%;min-width:0;padding:12px;border:1px solid #b7ccce;border-radius:9px;background:white}.chooser-fields small{font-size:13px;font-weight:400;line-height:1.7}.chooser-buttons{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:26px}.chooser-buttons button{min-width:0;overflow-wrap:anywhere;font:inherit;font-weight:700;padding:14px;border:1px solid #267e89;border-radius:9px;background:#267e89;color:white;cursor:pointer}.chooser-buttons button+button{background:transparent;color:#267e89}.transfer-chooser :is(button,input,select):focus-visible{outline:3px solid #d37426;outline-offset:3px}.transfer-chooser h3{scroll-margin-top:150px}.transfer-chooser dl>div{display:grid;grid-template-columns:150px minmax(0,1fr);gap:14px;padding:12px 0}.transfer-chooser dd{margin:0}.transfer-chooser [hidden]{display:none!important}.transfer-chooser [data-choice-status]:empty{display:none}@media(max-width:650px){.transfer-chooser{padding:22px 16px}.chooser-fields{grid-template-columns:1fr}.chooser-fields select,.chooser-fields input{font-size:16px}.transfer-chooser dl>div{grid-template-columns:1fr;gap:4px}}</style>
