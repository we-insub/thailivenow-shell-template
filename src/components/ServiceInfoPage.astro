---
import DetailHeader from './DetailHeader.astro';
import SiteFooter from './SiteFooter.astro';
import RuntimeDate from './RuntimeDate.astro';
import ImportantText from './ImportantText.astro';
import pages from '../data/service-info-ko.json';
import records from '../../data/site-date-observations.json';
const {page}=Astro.props;
const pagePath=`/ko/${page.id}/`,url=`https://thailivenow.com${pagePath}`;
const record=records.pages[pagePath];
const keyPhrases=['hello@thailivenow.com','회원가입이나 사이트 내 결제 없이','직접 방문하지 않은 곳을 다녀온 것처럼 소개하지 않아요.','동의 전과 거부 상태에서는 GA4 태그를 불러오지 않아요.','처리에 필요한 동안 보관하고','실제 거래한 업체','180일','향후 도입할 계획','개인정보를 가려주세요.'];
const schema={'@context':'https://schema.org','@type':page.id==='about'?'AboutPage':page.id==='contact'?'ContactPage':'WebPage',name:page.title,description:page.description,url,inLanguage:'ko',dateModified:record?.contentModifiedOn,publisher:{'@type':'Organization',name:'ThaiLiveNow',email:'hello@thailivenow.com',url:'https://thailivenow.com'}};
---
<!doctype html><html lang="ko"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="icon" href="/favicon.svg"/><title>{page.title} | ThaiLiveNow</title><meta name="description" content={page.description}/><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\u003c')}/></head><body><DetailHeader locale="ko"/><main class="service-info"><header><span class="eyebrow">THAILIVENOW</span><h1>{page.title}</h1><p class="intro">{page.intro}</p><p class="operator">운영: ThaiLiveNow 운영팀 · <a href="mailto:hello@thailivenow.com">hello@thailivenow.com</a></p></header>
{page.sections.map(section=><section><h2>{section.title}</h2>{section.paragraphs.map(text=><p><ImportantText text={text} phrases={keyPhrases.filter(phrase=>text.includes(phrase))}/></p>)}{section.links?.length>0&&<details open={section.links.length<3||!section.links.every(([,href])=>href.startsWith('https:'))} class:list={['section-links',section.links.length<3&&'short-links']}><summary>{section.links.every(([,href])=>href.startsWith('https:'))?`공식 출처 보기 · ${section.links.length}개`:'관련 안내 보기'}</summary><div class="related">{section.links.map(([label,href])=><a href={href} data-analytics-settings={href==='#analytics-settings'?true:undefined} target={href.startsWith('https:')?'_blank':undefined} rel={href.startsWith('https:')?'noopener noreferrer':undefined}>{label}{href.startsWith('https:')?' ↗':''}</a>)}</div></details>}</section>)}
<section aria-label="관련 운영 안내"><h2>함께 확인할 안내</h2><div class="related">{pages.filter(item=>item.id!==page.id).map(item=><a href={`/ko/${item.id}/`}>{item.title}</a>)}</div></section>
<div class="info-dates"><p>정보 확인일: <RuntimeDate kind="source" pagePath={pagePath} fallback={record?.sourceCheckedOn??null} locale="ko" unknown="미확인"/><br/>최근 수정일: <RuntimeDate kind="modified" pagePath={pagePath} fallback={record?.contentModifiedOn??null} locale="ko" unknown="미확인"/></p></div>
</main><SiteFooter locale="ko"/></body></html>
<style>
:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,"Apple SD Gothic Neo",sans-serif;line-height:1.8}.service-info{max-width:1000px;padding:40px 24px 72px;margin:auto;box-sizing:border-box}.service-info .eyebrow{font-size:12px;color:#ed504d;letter-spacing:2px;font-weight:700}.service-info h1{font-size:34px;line-height:1.45;margin:12px 0 24px}.service-info h2{font-size:25px;line-height:1.5;margin:0 0 18px}.service-info p{font-size:18px;color:#526572;line-height:1.95;word-break:keep-all;overflow-wrap:anywhere;margin:14px 0}.service-info .intro{font-size:19px}.service-info section{margin-top:44px}.service-info .operator,.service-info .info-dates p{font-size:14px}.service-info a{color:#267e89;overflow-wrap:anywhere}.service-info a:focus-visible{outline:3px solid #66a7cd;outline-offset:4px}.service-info .related{display:flex;flex-wrap:wrap;gap:12px 22px;margin-top:20px}.service-info .section-links{margin-top:20px}.service-info .section-links summary{cursor:pointer;color:#267e89}.service-info .short-links summary{display:none}.service-info .section-links:not(.short-links) a{font-size:14px}.service-info .info-dates{margin-top:44px;border-top:1px solid #dce5e8;padding-top:18px}@media(max-width:600px){.service-info{padding:28px 18px 48px}.service-info h1{font-size:28px}.service-info h2{font-size:23px}.service-info p,.service-info .intro{font-size:17px}.service-info section{margin-top:34px}.service-info .related{display:grid;gap:14px}}
</style>
