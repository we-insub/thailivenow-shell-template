---
import SiteFooter from './SiteFooter.astro';
import DetailHeader from './DetailHeader.astro';
import LocalizedBeachMap from './LocalizedBeachMap.astro';
import {localeTag} from '../lib/localized-content';
import {getBeachLocale} from '../lib/beach-localization.mjs';
const {city=null,locale}=Astro.props;
const {beaches,cities,ui}=getBeachLocale(locale);
const records=beaches.filter(b=>!city||b.cityId===city.id);
const title=city?`${city.name} | ${ui.hubTitle} · ${ui.compare}`:`${ui.hubTitle} | ${ui.hubSubtitle}`;
const intro=city?city.intro:ui.hubIntro;
const points=records.map(b=>({name:b.name,lat:b.lat,lng:b.lng,text:b.city+' · '+b.coordinateKind,url:`/${locale}/beaches/${b.id}/`}));
---
<!doctype html><html lang={localeTag(locale)} data-locale={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="icon" href="/favicon.svg"/><title>{title} | ThaiLiveNow</title><meta name="description" content={intro}/></head><body><DetailHeader locale={locale}/><main>
{city&&<a href={`/${locale}/beaches/`}>← {ui.all}</a>}<span class="overline">{ui.hubTitle}</span><h1>{city?`${city.name} · ${ui.beach}`:ui.hubTitle}</h1><p class="intro">{intro}</p><nav aria-label={ui.hubTitle}><a href={`/${locale}/beaches/`} aria-current={!city?'page':undefined}>{ui.all}</a>{cities.map(c=><a href={`/${locale}/beaches/cities/${c.id}/`} aria-current={city?.id===c.id?'page':undefined}>{c.name}</a>)}</nav>
<LocalizedBeachMap points={points} compact={true} title={city?`${city.name} · ${ui.map}`:ui.map} ui={ui}/>
{(city?[city]:cities).map(c=><section aria-labelledby={`city-${c.id}`}><header><div><h2 id={`city-${c.id}`}>{c.name} · {ui.beach}</h2>{!city&&<p>{c.intro}</p>}</div>{!city&&<a href={`/${locale}/beaches/cities/${c.id}/`}>{c.name} · {ui.compare} →</a>}</header><div class="cards">{records.filter(b=>b.cityId===c.id).map(b=><article>{b.photos[0]&&<a tabindex="-1" aria-hidden="true" href={`/${locale}/beaches/${b.id}/`}><img src={b.photos[0].src} alt="" width="600" height="360" loading="lazy"/></a>}<div class="card-copy"><span>{b.facilityType} · {b.english}</span><h3><a href={`/${locale}/beaches/${b.id}/`}>{b.name}</a></h3><p>{b.intro}</p><p class="access">{b.accessConditions[0].value}</p><a class="detail-link" href={`/${locale}/beaches/${b.id}/`}>{b.name} · {ui.detail} →</a>{b.photos[0]&&<small>{ui.photo}: <a href={b.photos[0].sourceUrl}>{b.photos[0].credit}{b.photos[0].title&&` · ${b.photos[0].title}`}</a> · <a href={b.photos[0].licenseUrl||b.photos[0].sourceUrl}>{b.photos[0].rights}</a></small>}</div></article>)}</div></section>)}
<section class="planning"><h2>{ui.planning}</h2><p>{ui.planningBody}</p><p><strong>{ui.redWarning}</strong></p><p>{ui.season}</p><p><a href={`/${locale}/destinations/`}>{ui.destinations} →</a> · <a href={`/${locale}/?category=sea#map`}>{ui.mainMap} →</a></p></section>
</main><SiteFooter locale={locale}/></body></html>
<style>:global(body){margin:0;background:#fafbfc;color:#253545;font-family:system-ui,sans-serif;line-height:1.85}main{max-width:1160px;margin:auto;padding:40px 24px 72px}.overline{display:block;color:#e84d47;font-size:12px;letter-spacing:2px;margin:18px 0}h1{font-size:clamp(28px,4vw,42px);line-height:1.4}.intro{font-size:19px;max-width:900px}a{color:#207b85;text-underline-offset:4px}nav{display:flex;flex-wrap:wrap;gap:10px;margin:28px 0}nav a{background:white;border:1px solid #dce5e8;border-radius:24px;padding:10px 18px;text-decoration:none}nav a[aria-current]{background:#267e89;color:#fff}section{margin:56px 0}section header{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:24px}header p{max-width:800px}h2{font-size:28px;margin:0}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}article{border:1px solid #dce5e8;background:white;border-radius:16px;overflow:hidden}article img{display:block;width:100%;height:240px;object-fit:cover}.card-copy{padding:24px}.card-copy>span,.card-copy small{font-size:12px;color:#627787}.card-copy small{overflow-wrap:anywhere;display:block;margin-top:20px}h3{font-size:25px;line-height:1.4;margin:10px 0 16px}h3 a{text-decoration:none}.access{background:#eef5f5;padding:16px;border-radius:10px}.detail-link{font-weight:700}.planning{padding:28px;background:#edf4f5;border-radius:16px}@media(max-width:650px){main{padding:24px 18px}.intro{font-size:17px}.cards{grid-template-columns:1fr}section header{display:block}section header>a{display:inline-block;margin:10px 0}.card-copy{padding:20px}h2{font-size:24px}nav{gap:8px}nav a{font-size:14px;padding:8px 12px}}</style>
