---
import {attractionUI,attractionTag,attractionCategoryUrl} from '../lib/attractions-localized';
import LocaleAlternates from './LocaleAlternates.astro';
import DetailHeader from './DetailHeader.astro';
import SiteFooter from './SiteFooter.astro';
import RuntimeDate from './RuntimeDate.astro';
import koreanEditorial from '../data/attraction-detail-enrichment-ko.json';
import {applyAttractionEditorial} from '../lib/attraction-editorial.mjs';
import AttractionPhoto from './AttractionPhoto.astro';
import AttractionTripOffer from './AttractionTripOffer.astro';
import AttractionVisitPrograms from './AttractionVisitPrograms.astro';

import AttractionLocationMap from './AttractionLocationMap.astro';
const {place:basePlace,locale='ko'}=Astro.props;
const p=applyAttractionEditorial(basePlace,locale,koreanEditorial);
const u=attractionUI(locale);
const categoryUrl=(id)=>attractionCategoryUrl(id,locale);
const isJim=locale==='ko'&&p.id==='jim-thompson-house';
const inline=(text='')=>text.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>');
const url=`https://thailivenow.com/${locale}/attractions/${p.id}/`;
const schema={'@context':'https://schema.org','@graph':[
 {'@type':'Article','@id':url+'#article',headline:p.name===p.english?p.name:`${p.name} (${p.english})`,description:p.description,inLanguage:attractionTag(locale),mainEntityOfPage:url,about:{'@id':url+'#place'},citation:p.sources.map(s=>s[1])},
 {'@type':p.schemaType||'Museum','@id':url+'#place',name:p.name,alternateName:[p.english,p.thai].filter(Boolean),url,...(p.address?{address:{'@type':'PostalAddress',streetAddress:p.address,addressCountry:'TH'}}:{}),...(Number.isFinite(p.lat)&&Number.isFinite(p.lng)?{geo:{'@type':'GeoCoordinates',latitude:p.lat,longitude:p.lng}}:{}),...(p.phone?{telephone:p.phone}:{})},
 {'@type':'BreadcrumbList',itemListElement:[[u.home,`https://thailivenow.com/${locale}/`],[u.attractions,`https://thailivenow.com/${locale}/attractions/`],[p.categoryName,'https://thailivenow.com'+categoryUrl(p.category)],[p.name,url]].map(([name,item],i)=>({'@type':'ListItem',position:i+1,name,item}))},
 ...(p.faq?.length?[{'@type':'FAQPage',mainEntity:p.faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}]:[])
]};
---
<!doctype html><html lang={attractionTag(locale)}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="icon" href="/favicon.svg"/><title>{p.title||(isJim?'짐 톰슨 하우스 | 입장료·가이드 관람·가는 방법 | ThaiLiveNow':`${p.name} | 볼거리·방문 정보 | ThaiLiveNow`)}</title>{p.indexing==='noindex'&&<meta name="tln:indexing" content="noindex"/>}<meta name="description" content={p.description}/><LocaleAlternates/><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')}/></head><body><DetailHeader locale={locale}/><main class="thai-detail attraction-detail">
<nav class="breadcrumbs" aria-label={u.location}><a href={`/${locale}/attractions/`}>{u.attractions}</a><span aria-hidden="true"> › </span><a href={categoryUrl(p.category)}>{p.categoryName}</a><span aria-hidden="true"> › </span><span>{p.name}</span></nav>
<header><h1>{p.name}{p.name!==p.english&&<span lang="en" class="foreign-name">{p.english}</span>}{p.thai&&<span lang="th" class="foreign-name">{p.thai}</span>}</h1><p class="place-kind">{p.cityName} · {p.type}</p>{p.intro.map((text,i)=><p class:list={[i===0&&'lead']}>{text}</p>)}{isJim&&<p><a href="https://artsandculture.google.com/story/pwWxmFjSajOYKg" target="_blank" rel="noopener noreferrer">박물관 사진·소장품 미리 보기 ↗</a></p>}{locale!=='ko'&&p.id==='jim-thompson-house'&&<p><a href="https://artsandculture.google.com/story/pwWxmFjSajOYKg" target="_blank" rel="noopener noreferrer">{u.preview} ↗</a></p>}</header>
{p.photos?.length>0&&<section class="attraction-gallery" aria-label={u.photo}>{p.photos.map((photo,i)=><AttractionPhoto photo={photo} locale={locale} detail eager={i===0}/>)}</section>}
<section aria-labelledby="location-heading"><h2 id="location-heading">{u.location}</h2>{Number.isFinite(p.lat)&&Number.isFinite(p.lng)&&<AttractionLocationMap place={p} locale={locale}/>}<div class="address-block">{p.address&&<><h3>{p.addressPrecision==='area'?u.area:u.address}</h3><p>{p.addressKo&&<>{p.addressKo}<br/></>}<span lang="en" id="museum-address">{p.address}</span></p></>}<div class="map-actions"><a href={p.mapUrl} target="_blank" rel="noopener noreferrer">{u.map} ↗</a><a href={p.directionsUrl} target="_blank" rel="noopener noreferrer">{u.directions} ↗</a>{p.address&&<button type="button" data-copy-attraction-address data-copied={u.copied} data-copy-fallback={u.copyFallback}>{p.addressPrecision==='area'?u.copyArea:u.copy}</button>}</div><span role="status" data-address-status></span></div>
{isJim&&<><h3>BTS 내셔널스타디움역에서 걸어가기</h3><p>{p.access}</p><p><a href="/ko/transport/bangkok/">방콕 BTS 노선·역 지도 →</a></p><h3>택시·Grab·Bolt로 가기</h3><p>목적지에 <strong lang="en">Jim Thompson House Museum</strong>을 입력하세요. 박물관은 까셈산 2 골목에 있어요. 택시 기사님께는 위의 주소나 아래 태국어 이름을 보여주시면 돼요.</p><p class="taxi-name" lang="th">{p.thai}</p></>}{!isJim&&p.accessSections?.map(item=><div class="access-block"><h3>{item.title}</h3>{item.paragraphs.map(text=><p set:html={inline(text)}/>)}</div>)}</section>
{isJim&&<><section aria-labelledby="facts-heading"><h2 id="facts-heading">관람 시간과 입장료</h2><dl class="visit-facts"><div><dt>관람 시간</dt><dd><strong>매일 10:00–17:00</strong><br/>마지막 가이드 관람은 17:00에 시작해요.</dd></div><div><dt>관람 방식</dt><dd>본관은 <strong>가이드 동행 필수</strong></dd></div>{p.prices.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}<div><dt>가이드 언어</dt><dd>{p.guideLanguages}</dd></div><div><dt>운영</dt><dd>{p.operator}</dd></div><div><dt>문의</dt><dd><a href="tel:+6622167368">{p.phone}</a></dd></div></dl><p>성인과 함께 오는 <strong>0–9세 어린이는 무료</strong>예요. 10–21세 요금을 적용받으려면 나이를 확인할 수 있는 신분증이나 여권을 가져오세요.</p></section>
</>}{!isJim&&p.facts?.length>0&&<section aria-labelledby="facts-heading"><h2 id="facts-heading">{p.factsHeading||u.facts}</h2><dl class="visit-facts">{p.facts.map(([label,value])=><div><dt>{label}</dt><dd set:html={inline(value)}/></div>)}{locale!=='ko'&&p.phone&&<div><dt>{u.contact}</dt><dd><a href={`tel:${p.phone.replace(/[^+0-9]/g,'')}`}>{p.phone}</a></dd></div>}</dl>{p.factNotes?.map(text=><p set:html={inline(text)}/>)}</section>}
<AttractionTripOffer placeId={p.id} locale={locale} copy={p.tripOfferCopy}/>
<AttractionVisitPrograms place={p} locale={locale}/>
<AttractionVisitPrograms place={p} locale={locale} kind="services"/>
<section class="experience-section" aria-labelledby="experience-heading"><h2 id="experience-heading">{isJim?'짐 톰슨 하우스에서는 무엇을 볼 수 있나요?':p.experienceHeading||u.experience}</h2>{p.experiences.map(item=><div class="story-block"><h3>{item.title}</h3>{item.paragraphs.map(text=><p set:html={inline(text)}/>)}</div>)}</section>
{isJim&&<><section class="visit-section" aria-labelledby="visit-heading"><h2 id="visit-heading">본관에 들어가기 전에 알아둘 점</h2><div class="visit-rules"><div class="visit-rule"><h3>신발은 벗고, 큰 가방은 맡겨주세요</h3><p>표를 직원에게 보여준 뒤 가이드와 함께 본관에 들어가요. 들어가기 전에는 <strong>신발을 벗고, 20cm를 넘는 가방은 보관함에 맡겨야 해요.</strong></p></div><div class="visit-rule"><h3>본관에는 엘리베이터가 없어요</h3><p>본관은 여러 곳의 계단을 오르내리며 관람해요. <strong>엘리베이터가 없어</strong> 휠체어나 유모차로 본관 전체를 둘러보기는 어려워요. 계단 이동이 어려운 분과 함께라면 본관을 관람할지 미리 상의해보세요.</p></div><div class="visit-rule"><h3>사진 촬영과 금연 규칙</h3><p>본관 안에서 사진을 찍을 수 있지만, <strong>플래시·셀피·개인 인물사진·동영상 촬영은 금지</strong>돼요.</p><p>박물관 전체는 금연 구역이에요. 전자담배를 비롯한 모든 흡연 기기도 사용할 수 없어요.</p></div></div></section>
</>}{!isJim&&p.rules?.length>0&&<section class="visit-section" aria-labelledby="visit-heading"><h2 id="visit-heading">{p.rulesHeading||u.rules}</h2><div class="visit-rules">{p.rules.map(item=><div class="visit-rule"><h3>{item.title}</h3>{item.paragraphs.map(text=><p set:html={inline(text)}/>)}</div>)}</div></section>}
{p.faq?.length>0&&<section aria-labelledby="faq-heading"><h2 id="faq-heading">{u.faq}</h2>{p.faq.map(([q,a])=><article class="question"><h3>{q}</h3><p>{a}</p></article>)}</section>}
{isJim&&<><section aria-labelledby="related-heading"><h2 id="related-heading">방콕 여행에 함께 필요한 정보</h2><div class="related-links"><a href="/ko/attractions/categories/museums-heritage/">박물관·역사유적에서 다른 관광지 찾기 →</a><a href="/ko/transport/bangkok/">내셔널스타디움역이 있는 BTS 실롬선 보기 →</a></div></section>
</>}{!isJim&&<section aria-labelledby="related-heading"><h2 id="related-heading">{u.related}</h2><div class="related-links"><a href={categoryUrl(p.category)}>{locale==='ko'?`${p.categoryName}에서 다른 곳 찾기`:`${p.categoryName} · ${u.back}`} →</a>{p.related?.map(([label,href])=><a href={href}>{label} →</a>)}</div></section>}
<section class="source-section" aria-label={u.sources}><p class="source-date">{u.checked}: <RuntimeDate kind="source" pagePath={Astro.url.pathname} locale={locale} fallback={p.sourceCheckedOn}/></p><details><summary>{u.sources} · {p.sources.length}{locale==='ko'?'개':''}</summary><ul>{p.sources.map(([label,href])=><li><a href={href} target="_blank" rel="noopener noreferrer">{label} ↗</a></li>)}</ul></details></section>
</main><SiteFooter locale={locale}/></body></html>
<script>
document.querySelector('[data-copy-attraction-address]')?.addEventListener('click',async()=>{const el=document.getElementById('museum-address'),status=document.querySelector('[data-address-status]');if(!el||!status)return;try{await navigator.clipboard.writeText(el.textContent||'');status.textContent=(document.querySelector('[data-copy-attraction-address]') as HTMLElement)?.dataset.copied||'';}catch{const selection=window.getSelection(),range=document.createRange();range.selectNodeContents(el);selection?.removeAllRanges();selection?.addRange(range);status.textContent=(document.querySelector('[data-copy-attraction-address]') as HTMLElement)?.dataset.copyFallback||'';}});
</script>
<style>
.attraction-detail .breadcrumbs{font-size:14px;line-height:1.8;color:#61717e;margin-bottom:24px}.attraction-detail .foreign-name{display:block;font-size:.55em;font-weight:500;line-height:1.6;margin-top:8px;letter-spacing:0;overflow-wrap:anywhere}.attraction-detail .place-kind{color:#61717e;font-size:15px!important}.attraction-detail a{color:#267e89;text-underline-offset:4px}.attraction-detail h3:not(:first-child){margin-top:32px!important}.attraction-detail .address-block{padding:24px;background:#edf3f6;border-radius:14px;margin:24px 0}.attraction-detail .address-block p{font-size:16px!important}.map-actions{display:flex;flex-wrap:wrap;gap:12px}.map-actions a,.map-actions button{display:inline-flex;align-items:center;min-height:46px;padding:10px 16px;border:1px solid #c9d9e0;border-radius:10px;background:white;font:600 15px/1.6 system-ui;color:#267e89;text-decoration:none;cursor:pointer;max-width:100%}.attraction-detail [data-address-status]{display:block;font-size:14px;color:#526572}.attraction-detail .taxi-name{padding:18px 20px;background:#edf3f6;border-radius:10px}.visit-facts{border:1px solid #c9d9e0;border-radius:14px;overflow:hidden;background:white;margin-bottom:24px}.visit-facts>div{display:grid;grid-template-columns:160px minmax(0,1fr);border-bottom:1px solid #e7edef}.visit-facts>div:last-child{border-bottom:0}.visit-facts dt,.visit-facts dd{margin:0;padding:16px 20px;overflow-wrap:anywhere}.visit-facts dt{background:#eff5f6;font-weight:600}.related-links{display:grid;gap:14px}.related-links a{min-height:44px;display:flex;align-items:center}.attraction-detail .source-section .source-date{font-size:14px!important;color:#61717e}.source-section ul{padding-left:22px}.source-section li,.source-section a{font-size:14px;overflow-wrap:anywhere}.attraction-detail :is(a,button,summary):focus-visible{outline:3px solid #66a7cd;outline-offset:4px}@media(max-width:600px){.visit-facts>div{grid-template-columns:104px minmax(0,1fr)}.visit-facts dt,.visit-facts dd{padding:12px;font-size:15px}.attraction-detail .address-block{padding:18px}.map-actions{display:grid;grid-template-columns:1fr}.map-actions a,.map-actions button{justify-content:center}}
</style>
<style>
.attraction-detail .experience-section,.attraction-detail .visit-section{border-top:2px solid #c9d9e0;padding-top:32px}.attraction-detail .story-block{padding-block:8px 28px}.attraction-detail .story-block+.story-block{border-top:1px solid #d3dfe3;padding-top:30px}.attraction-detail .story-block h3{border-left:3px solid #267e89;padding-left:16px;margin-top:0!important}.attraction-detail .story-block>:last-child{margin-bottom:0!important}.attraction-detail .visit-rules{display:grid;gap:20px}.attraction-detail .visit-rule{padding:26px 28px;background:#fff;border:1px solid #c9d9e0;border-radius:14px;min-width:0}.attraction-detail .visit-rule h3{margin-top:0!important;color:#267e89}.attraction-detail .visit-rule>:last-child{margin-bottom:0!important}@media(max-width:600px){.attraction-detail .experience-section,.attraction-detail .visit-section{padding-top:26px}.attraction-detail .story-block{padding-bottom:24px}.attraction-detail .story-block+.story-block{padding-top:26px}.attraction-detail .story-block h3{padding-left:12px}.attraction-detail .visit-rule{padding:22px 20px}.attraction-detail .visit-rules{gap:16px}}
</style>

<style>.attraction-gallery figure{margin:0}.attraction-gallery img{display:block;width:100%;height:auto;border-radius:14px}.attraction-gallery figcaption{font-size:13px;line-height:1.8;color:#61717e;margin-top:12px;overflow-wrap:anywhere}</style>
<style>
@media(max-width:600px){.attraction-detail:lang(ru) .visit-facts>div{grid-template-columns:128px minmax(0,1fr)}}
@media(max-width:360px){.attraction-detail:lang(ru) .visit-facts>div{grid-template-columns:1fr}}
</style>
