# Local development needs no secret. Copy to .env if overriding Astro settings.
# Public canonical origin; default is https://thailivenow.com
# SITE_URL=
# Release date explicitly approved by operator (YYYY-MM-DD), never today by default.
# SITE_DEPLOYMENT_DATE=
# Exact 40-character source commit for release generation.
# SITE_RELEASE_COMMIT=
# Build/date scripts read shell environment, not .env; export these when needed.
# Optional deploy-only credentials: obtain separately, never commit values.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# TLN_RELEASE_GRAPH and TLN_RELEASE_PATTERNS are internal release-runner variables.
