{
  "name": "thailivenow-shell-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run test:seo && astro build && node scripts/audit-seo.mjs",
    "preview": "astro preview",
    "test:seo": "node --test tests/page-seo.test.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "postbuild": "node scripts/postbuild-site-dates.mjs",
    "test:site-dates": "node --test tests/site-dates-runtime.test.mjs",
    "audit:site-dates": "node scripts/audit-site-dates.mjs",
    "release": "node scripts/release/run.mjs",
    "release:verify": "node scripts/release/verify.mjs",
    "test:release": "node --test tests/partial-release.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:handoff": "node scripts/check-handoff.mjs",
    "check:runtime": "node scripts/check-local-runtime.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "maplibre-gl": "^5.24.0",
    "parse5": "^7.3.0"
  },
  "engines": {
    "node": "24.13.x",
    "npm": "11.x"
  }
}
